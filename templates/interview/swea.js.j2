/* Official SWEA catalogue and per-problem workspace inside the algorithm log. */
var SWCAT=null,swLoading=false,swError='',swQuery='',swLevel='',swStatus='',swPage=0,swWork=null,swToken='',swSaveTimer=null;
function sweaNumber(a){var m=/^(\d+)\b/.exec(a.n||'');return a.s==='SWEA'&&m?Number(m[1]):null}
function sweaRecord(n){return S.algo.find(function(a){return sweaNumber(a)===n})}
function sweaDraftKey(p){return p.noteSlug?'note-'+p.noteSlug:'swea-'+p.number}
function sweaDraft(p){return S.algoDrafts[sweaDraftKey(p)]||{code:'# '+p.title+'\n# 문제의 입력 형식을 확인하고 Python 풀이를 작성하세요.\n',input:'',output:'',idea:'',expected:'',ts:0}}
function sweaFiltered(){return ((SWCAT||{}).items||[]).filter(function(p){if(swLevel&&p.level!==swLevel)return false;var rec=sweaRecord(p.number),draft=S.algoDrafts['swea-'+p.number];if(swStatus==='new'&&(rec||draft))return false;if(swStatus==='draft'&&(!draft||rec))return false;if(swStatus==='ok'&&(!rec||rec.r!=='ok'))return false;if(swStatus==='review'&&(!rec||rec.r==='ok'))return false;return !swQuery||(String(p.number)+' '+p.title).toLowerCase().includes(swQuery.toLowerCase())})}
function sweaSection(){var counts=(SWCAT||{}).counts||{};return '<section class="card" id="swea-catalog" style="margin-bottom:16px"><div class="row" style="justify-content:space-between"><div><h2 style="margin:0">SWEA D1–D4 문제 목록</h2><p class="faint small" style="margin:6px 0">'+(SWCAT?SWCAT.count+'문제 · '+['D1','D2','D3','D4'].map(function(k){return k+' '+counts[k]}).join(' · ')+' · 공식 공개 목록 수집 '+SWCAT.fetchedAt.slice(0,10):'공식 공개 문제 목록을 불러옵니다.')+'</p></div><a class="btn ghost sm" href="https://swexpertacademy.com/main/code/problem/problemList.do" target="_blank" rel="noopener">SWEA 원문 ↗</a></div><p class="small muted">번호·제목·난이도와 원문 링크를 수록했습니다. 문제 본문과 공식 채점은 SWEA에서 확인하고, 이곳에서는 내 풀이를 실행·기록합니다.</p><div class="row" style="align-items:end"><label class="small" style="flex:1;min-width:160px">문제 검색<input class="field" id="sw-query" value="'+esc(swQuery)+'" placeholder="번호 또는 제목"></label><label class="small">난이도<select class="field" id="sw-level"><option value="">D1–D4 전체</option>'+['D1','D2','D3','D4'].map(function(k){return '<option'+(swLevel===k?' selected':'')+'>'+k+'</option>'}).join('')+'</select></label><label class="small">상태<select class="field" id="sw-status">'+[['','전체'],['new','미시작'],['draft','작성 중'],['ok','혼자 풀었다'],['review','힌트·다시 풀기']].map(function(x){return '<option value="'+x[0]+'"'+(swStatus===x[0]?' selected':'')+'>'+x[1]+'</option>'}).join('')+'</select></label></div><div id="sw-list" style="margin-top:12px"></div><div id="sw-work" style="margin-top:16px"></div></section>'}
function sweaLoad(){if(SWCAT||swLoading)return;swLoading=true;swError='';fetch('lab/swea-catalog.json').then(function(r){if(!r.ok)throw Error('HTTP '+r.status);return r.json()}).then(function(d){if(!d||!Array.isArray(d.items)||d.items.length!==d.count||d.items.some(function(p){return !Number.isInteger(p.number)||!['D1','D2','D3','D4'].includes(p.level)||typeof p.title!=='string'||!/^https:\/\/swexpertacademy.com\/main\/code\/problem\/problemDetail.do\?/.test(p.url)}))throw Error('목록 형식을 확인하세요.');SWCAT=d;swLoading=false;if($('#swea-catalog')){var el=$('#swea-catalog');el.outerHTML=sweaSection();bindSWEA()}}).catch(function(e){swLoading=false;swError='문제 목록을 불러오지 못했습니다. '+e.message;renderSweaList()})}
function renderSweaList(){var el=$('#sw-list');if(!el)return;if(!SWCAT){el.innerHTML=swError?'<p role="alert">'+esc(swError)+'</p><button class="btn sm" id="sw-retry">다시 불러오기</button>':'<p class="faint small" role="status">문제 목록 로딩 중…</p>';var retry=$('#sw-retry');if(retry)retry.onclick=sweaLoad;return}var rows=sweaFiltered(),pages=Math.max(1,Math.ceil(rows.length/20));swPage=Math.max(0,Math.min(swPage,pages-1));el.innerHTML='<p class="faint small">검색 결과 '+rows.length+'문제 · '+(swPage+1)+' / '+pages+'쪽</p><div class="list">'+rows.slice(swPage*20,swPage*20+20).map(function(p){var r=sweaRecord(p.number),draft=S.algoDrafts['swea-'+p.number];return '<div class="li" style="gap:10px;flex-wrap:wrap"><span class="tag">'+p.level+'</span><span class="p" style="min-width:140px"><b>'+p.number+'. '+esc(p.title)+'</b><br><span class="faint small">'+(r?({ok:'✓ 혼자 풀었다',hint:'힌트·풀이 참고',fail:'다시 풀기'}[r.r]||'기록 있음'):draft?'작성 중':'미시작')+(r&&r.src==='drive'?' · 내 드라이브 풀이 기록':'')+'</span></span><a class="btn sm ghost" href="'+esc(p.url)+'" target="_blank" rel="noopener">원문 ↗</a><button class="btn sm" data-sw-open="'+p.number+'">풀이·실행</button></div>'}).join('')+(rows.length?'':'<p class="faint">해당하는 문제가 없습니다.</p>')+'</div><div class="row" style="justify-content:center;margin-top:12px"><button class="btn sm ghost" id="sw-prev"'+(swPage?'':' disabled')+'>← 이전</button><span class="small">'+(swPage+1)+' / '+pages+'</span><button class="btn sm ghost" id="sw-next"'+(swPage+1<pages?'':' disabled')+'>다음 →</button></div>';$$('[data-sw-open]').forEach(function(b){b.onclick=function(){openSweaWork(SWCAT.items.find(function(p){return p.number===Number(b.dataset.swOpen)}))}});$('#sw-prev').onclick=function(){swPage--;renderSweaList()};$('#sw-next').onclick=function(){swPage++;renderSweaList()}}
function bindSWEA(){if(!$('#swea-catalog'))return;$('#sw-query').oninput=function(){swQuery=this.value;swPage=0;renderSweaList()};$('#sw-level').onchange=function(){swLevel=this.value;swPage=0;renderSweaList()};$('#sw-status').onchange=function(){swStatus=this.value;swPage=0;renderSweaList()};renderSweaList();sweaLoad();if(swWork)openSweaWork(swWork,false);$$('[data-work-record]').forEach(function(b){b.onclick=function(){var a=S.algo.find(function(x){return x.id===b.dataset.workRecord});var n=sweaNumber(a||{});if(!n){toast('SWEA 번호가 있는 기록에서 코드를 열 수 있어요.');return}var p=SWCAT&&SWCAT.items.find(function(p){return p.number===n});openSweaWork(p||{number:n,title:a.n.replace(/^\d+\s*/,''),level:a.l||'SWEA'})}});try{var imported=JSON.parse(sessionStorage.getItem('study-lab-handoff')||'null');if(imported&&typeof imported.code==='string'&&imported.code.length<=50000&&/^[a-z0-9_]+$/.test(imported.note)&&Date.now()-imported.createdAt<600000){sessionStorage.removeItem('study-lab-handoff');var p={number:0,title:'강의 노트 코드 · '+imported.note,noteSlug:imported.note,level:'강의 노트'};S.algoDrafts[sweaDraftKey(p)]={code:imported.code,input:'',output:'',idea:'',expected:'',ts:stamp(0)};save();openSweaWork(p)}}catch(_){}}
function openSweaWork(p,scroll){if(!p)return;clearTimeout(swSaveTimer);if(swWork)save();swWork=p;swToken=crypto.randomUUID();var draft=sweaDraft(p),r=p.noteSlug?null:sweaRecord(p.number),box=$('#sw-work');if(!box)return;box.innerHTML='<div style="border-top:2px solid var(--line);padding-top:20px"><div class="row" style="justify-content:space-between"><div><span class="tag">'+esc(p.level)+'</span><h2 style="display:inline;margin-left:8px">'+(p.number?p.number+'. ':'')+esc(p.title)+'</h2></div><button class="btn ghost sm" id="sw-close">풀이 닫기</button></div><p class="small muted">코드·입력·풀이 메모는 이 브라우저에 자동 저장되고 기록 백업에 포함됩니다. 실행 성공은 SWEA 정답 판정과 다릅니다.</p><div class="row" style="align-items:end"><label class="small">기록 결과 (직접 선택)<select class="field" id="sw-result"><option value="hint">힌트·풀이 참고</option><option value="ok">혼자 풀었다</option><option value="fail">못 풀었다</option></select></label><label class="small">걸린 시간(분)<input class="field" id="sw-minutes" type="number" min="0" value="'+(r&&r.m||'')+'"></label><button class="btn" id="sw-save-record">풀이 기록에 저장</button><span class="small muted" id="sw-save-status" role="status">작성 내용 자동 저장</span></div><div class="grid g2" style="margin:12px 0"><label class="small">풀이 아이디어·회고<textarea class="field" id="sw-idea" rows="3">'+esc(draft.idea||r&&r.idea||'')+'</textarea></label><label class="small">예상 출력 (선택)<textarea class="field" id="sw-expected" rows="3">'+esc(draft.expected||'')+'</textarea></label></div><p class="small" id="sw-check" role="status"></p><iframe id="sw-frame" title="'+esc(p.title)+' Python 풀이 및 실행 과정" src="lab/index.html?embedded=1&amp;work='+encodeURIComponent(sweaDraftKey(p))+'&amp;token='+encodeURIComponent(swToken)+'" style="display:block;width:100%;height:1100px;border:1px solid var(--line);border-radius:12px;background:var(--card)"></iframe></div>';$('#sw-result').value=r&&r.r||'hint';$('#sw-close').onclick=function(){clearTimeout(swSaveTimer);save();swWork=null;swToken='';box.replaceChildren()};$('#sw-idea').oninput=$('#sw-expected').oninput=function(){var d=sweaDraft(p);d.idea=$('#sw-idea').value;d.expected=$('#sw-expected').value;d.ts=stamp(d.ts);S.algoDrafts[sweaDraftKey(p)]=d;save();sweaCompare(d)};$('#sw-save-record').onclick=saveSweaRecord;sweaCompare(draft);if(scroll!==false)box.scrollIntoView({behavior:'smooth',block:'start'})}
function sweaCompare(d){var el=$('#sw-check');if(!el)return;if(!d.expected){el.textContent='';return}if(d.error){el.textContent='실행 오류: '+d.error;el.style.color='var(--bad)';return}if(!d.ran){el.textContent='실행하면 예상 출력과 비교합니다.';return}var norm=function(s){return String(s||'').replace(/\r/g,'').split('\n').map(function(x){return x.trimEnd()}).join('\n').trim()};var match=norm(d.output)===norm(d.expected);el.textContent=match?'✓ 예상 출력과 일치합니다. (SWEA 공식 채점 결과는 아님)':'예상 출력과 다릅니다. 입력·코드·출력을 확인해 주세요.';el.style.color=match?'var(--ok)':'var(--bad)'}
function saveSweaRecord(){var p=swWork;if(!p)return;var d=sweaDraft(p),r=p.noteSlug?S.algo.find(function(a){return a.id===sweaDraftKey(p)}):sweaRecord(p.number),old=r&&r.r;var result=$('#sw-result').value;if(!r){r={id:p.noteSlug?sweaDraftKey(p):uid(),d:today(),s:p.noteSlug?'강의 노트':'SWEA',n:(p.number?p.number+' ':'')+p.title,l:p.level,t:[],src:'workspace'};S.algo.push(r)}r.r=result;r.m=Math.max(0,Number($('#sw-minutes').value)||0);r.idea=$('#sw-idea').value;r.code=d.code;r.input=d.input;r.output=d.output||'';r.ts=stamp(r.ts);if(result==='ok'&&old!=='ok')wadd('algo',1);else save();toast('풀이 코드와 결과를 알고리즘 기록에 저장했습니다.');algo()}
window.addEventListener('message',function(e){var f=$('#sw-frame'),m=e.data;if(!f||e.source!==f.contentWindow||e.origin!==location.origin||!m||m.token!==swToken||!swWork)return;if(m.type==='algo-work:height'){if(Number.isFinite(m.height))f.style.height=Math.max(600,Math.min(2600,m.height))+'px';return}if(m.type==='algo-work:ready'){var d=sweaDraft(swWork),r=!swWork.noteSlug&&sweaRecord(swWork.number);if(!d.ts&&r&&r.code){d.code=r.code;d.input=r.input||''}f.contentWindow.postMessage({type:'algo-work:load',token:swToken,problem:swWork,code:d.code,input:d.input},location.origin);return}if(m.type!=='algo-work:state'||typeof m.code!=='string'||m.code.length>100000||typeof m.input!=='string'||m.input.length>100000)return;var d=sweaDraft(swWork);d.code=m.code;d.input=m.input;d.output=typeof m.output==='string'?m.output.slice(0,100000):'';d.error=typeof m.error==='string'?m.error.slice(0,2000):'';d.ran=!!m.ran;d.ts=stamp(d.ts);S.algoDrafts[sweaDraftKey(swWork)]=d;clearTimeout(swSaveTimer);swSaveTimer=setTimeout(function(){var ok=save();var el=$('#sw-save-status');if(el)el.textContent=ok?'코드·입력 저장됨':'저장 실패 · 기록 백업을 확인하세요.'},500);sweaCompare(d)});
