/* Import only the problem the user has opened; no cross-origin scraping or login data. */
var BOJ_IMPORT=(function(){
 var pending=null;
 function collect(doc,url){
  var u=new URL(url),m=/^\/problem\/(\d+)\/?$/.exec(u.pathname);
  if(u.origin!=='https://www.acmicpc.net'||!m)throw Error('백준 문제 페이지에서 실행하세요.');
  function text(id){var el=doc.getElementById(id);if(!el)return '';var copy=el.cloneNode(true);copy.querySelectorAll('script,style,iframe,button,.MathJax,.MathJax_Preview').forEach(function(x){if(x.tagName==='SCRIPT'&&/^math\/tex/.test(x.type))x.replaceWith(doc.createTextNode(' $'+x.textContent+'$ '));else x.remove()});copy.querySelectorAll('br').forEach(function(x){x.replaceWith(doc.createTextNode('\n'))});copy.querySelectorAll('p,div,li,tr,h1,h2,h3').forEach(function(x){x.appendChild(doc.createTextNode('\n'))});copy.querySelectorAll('img').forEach(function(x){var src=new URL(x.getAttribute('src')||'',u);x.replaceWith(doc.createTextNode('[그림: '+(x.alt||'원문에서 확인')+(src.protocol==='https:'?' · '+src.href:'')+']'))});return (copy.textContent||'').replace(/\u00a0/g,' ').trim()}
  var title=text('problem_title'),description=text('problem_description');if(!title||!description)throw Error('문제 본문이 없습니다. 로그인 또는 접근 안내 화면인지 확인하세요.');
  var inputs=Array.from(doc.querySelectorAll('pre[id^="sample-input-"]')),samples=inputs.map(function(el){var id=el.id.slice(13),out=doc.getElementById('sample-output-'+id);if(!out)throw Error('예제 출력이 누락되었습니다.');return {input:(el.textContent||'').replace(/\r\n/g,'\n'),expected:(out.textContent||'').replace(/\r\n/g,'\n')}});
  return {format:'boj-problem-v1',number:Number(m[1]),title:title,source:u.origin+'/problem/'+m[1],description:description,inputDescription:text('problem_input'),outputDescription:text('problem_output'),hint:text('problem_hint'),samples:samples};
 }
 function validate(x){
  if(!x||x.format!=='boj-problem-v1'||!Number.isInteger(x.number)||x.number<1000||x.number>999999||x.source!=='https://www.acmicpc.net/problem/'+x.number)throw Error('백준 문제 파일 형식이나 출처가 올바르지 않습니다.');
  var p={format:x.format,number:x.number,source:x.source};['title','description','inputDescription','outputDescription','hint'].forEach(function(k){if(typeof x[k]!=='string'||x[k].length>(k==='title'?200:60000))throw Error('문제 텍스트의 형식이나 크기를 확인하세요.');p[k]=x[k]});if(!p.title.trim()||!p.description.trim())throw Error('제목과 문제 설명이 필요합니다.');
  if(!Array.isArray(x.samples)||x.samples.length>20)throw Error('예제는 최대 20개까지 가져올 수 있습니다.');p.samples=x.samples.map(function(c){if(!c||typeof c.input!=='string'||typeof c.expected!=='string'||c.input.length>100000||c.expected.length>100000)throw Error('예제 입력·출력 형식을 확인하세요.');return {input:c.input,expected:c.expected}});if(JSON.stringify(p).length>500000||statement(p).length>100000)throw Error('문제 파일이 너무 큽니다.');return p;
 }
 function statement(p){return p.title+'\n원문: '+p.source+'\n\n문제\n'+p.description+'\n\n입력\n'+p.inputDescription+'\n\n출력\n'+p.outputDescription+(p.hint?'\n\n힌트\n'+p.hint:'')}
 function transfer(collect,target){
  try{var data=collect(document,location.href),child=window.open(target+'/study/index.html#/boj/'+data.number,'_blank');
   function download(){var a=document.createElement('a'),url=URL.createObjectURL(new Blob([JSON.stringify(data,null,2)],{type:'application/json'}));a.href=url;a.download='boj_'+data.number+'_problem.json';a.click();setTimeout(function(){URL.revokeObjectURL(url)},10000);alert('문제 파일을 저장했습니다. 준비공간의 백준 문제 가져오기에서 파일을 선택하세요.')}
   if(!child){download();return}var done=false,timer=setInterval(function(){if(!child.closed)child.postMessage({type:'boj-problem-import',problem:data},target)},1000);
   function stop(){clearInterval(timer);window.removeEventListener('message',reply)}
   function reply(e){if(e.origin===target&&e.source===child&&e.data?.type==='boj-problem-received'){done=true;stop()}}
   window.addEventListener('message',reply);setTimeout(function(){stop();if(!done)download()},120000);
  }catch(e){alert(e.message)}
 }
 function bookmark(){return 'javascript:('+transfer.toString()+')('+collect.toString()+','+JSON.stringify(location.origin)+');void 0'}
 function panel(){return '<section class="card" style="margin:16px 0" aria-labelledby="boj-import-heading"><h2 id="boj-import-heading">백준 문제 가져오기</h2><p>백준에서 연 문제의 설명·예제 입력·예상 출력을 한 번에 가져옵니다. 먼저 아래 버튼을 브라우저 북마크바로 드래그해 등록하세요.</p><p><a class="btn" id="boj-bookmark">백준 → 준비공간</a></p><ol><li>북마크를 등록한 뒤 백준 원문 페이지를 엽니다.</li><li>백준 문제 페이지에서 등록한 북마크를 클릭합니다.</li><li>새 준비공간 탭에서 잠금을 해제하고 가져온 내용을 확인·적용합니다.</li></ol><p class="small muted">번호만으로 백준 서버를 조회하는 기능은 아닙니다. 새 탭 연결이 안 되면 2분 후 문제 JSON 파일을 내려받습니다. 팝업이 차단되면 바로 파일로 저장합니다. 그림·복잡한 수식은 원문에서도 확인하세요.</p><details><summary>파일로 가져오기 / 모바일 안내</summary><p class="small">북마크 실행이 제한되는 브라우저에서는 백준 문제 페이지를 HTML로 저장한 뒤 선택하세요. 가져오기 도구로 저장한 JSON도 지원합니다. 파일 내용은 브라우저에서만 읽습니다.</p><label>백준 문제 파일<input class="field" type="file" id="boj-import-file" accept=".json,.html,.htm,application/json,text/html"></label></details><p id="boj-import-status" role="status" class="small"></p><div id="boj-import-preview"></div></section>'}
 function preview(n){var host=$('#boj-import-preview');if(!host||!pending)return;var p=pending;host.innerHTML='<h3>'+esc(p.number+' · '+p.title)+'</h3><p class="small">예제 '+p.samples.length+'개 · 코드와 풀이 메모는 유지합니다. 적용하면 문제 제목·설명이 갱신되고 예제가 테스트 목록에 추가됩니다.</p><details open><summary>문제 설명 미리보기</summary><pre style="white-space:pre-wrap;overflow-wrap:anywhere;max-height:260px;overflow:auto">'+esc(statement(p))+'</pre></details>'+p.samples.map(function(c,i){return '<details><summary>예제 '+(i+1)+'</summary><b>입력</b><pre style="white-space:pre-wrap;overflow-wrap:anywhere">'+esc(c.input)+'</pre><b>예상 출력</b><pre style="white-space:pre-wrap;overflow-wrap:anywhere">'+esc(c.expected)+'</pre></details>'}).join('')+'<label class="small"><input type="checkbox" id="boj-import-replace"> 현재 테스트 입력·예상 출력을 첫 예제로 바꾸기 (선택하지 않으면 빈 입력에만 설정)</label><p><button class="btn" id="boj-import-apply">'+(p.number===n?'이 문제에 적용':'문제 '+p.number+'에 적용')+'</button> <button class="btn ghost" id="boj-import-cancel">취소</button></p>';
  $('#boj-import-cancel').onclick=function(){pending=null;host.replaceChildren();$('#boj-import-status').textContent='가져오기를 취소했습니다.'};$('#boj-import-apply').onclick=function(){apply(p,$('#boj-import-replace').checked)};
 }
 function apply(p,replace){
  var key='boj-'+p.number,old=S.algoDrafts[key],d=JSON.parse(JSON.stringify(sweaDraft(BOJ.problem(p.number)))),cases=d.cases||[],add=p.samples.filter(function(c){return !cases.some(function(x){return x.input===c.input&&x.expected===c.expected})});
  if(cases.length+add.length>20){$('#boj-import-status').textContent='테스트가 20개를 넘습니다. 기존 테스트를 정리한 뒤 다시 적용하세요. 기존 기록은 변경하지 않았습니다.';return}
  d.title=p.title;d.statement=statement(p);d.cases=cases.concat(add.map(function(c,i){return {id:crypto.randomUUID(),name:'백준 예제 '+(p.samples.indexOf(c)+1),input:c.input,expected:c.expected}}));
  if(p.samples.length&&(replace||(!d.input&&!d.expected))){if(replace&&typeof ALGO_CORE!=='undefined')d.versions=ALGO_CORE.addVersion(d.versions||[],d);d.input=p.samples[0].input;d.expected=p.samples[0].expected;d.output='';d.ran=false;delete d.error}
  d.ts=stamp(d.ts);S.algoDrafts[key]=d;if(!save()){if(old)S.algoDrafts[key]=old;else delete S.algoDrafts[key];$('#boj-import-status').textContent='저장하지 못했습니다. 저장 공간을 확인하고 다시 적용하세요.';return}pending=null;if(location.hash==='#/boj/'+p.number)BOJ.view(p.number);else location.hash='#/boj/'+p.number;toast('백준 문제 설명과 예제 '+p.samples.length+'개를 가져왔습니다.');
 }
 function bind(n){var host=$('#boj-import-host');if(!host)return;host.innerHTML=panel();$('#boj-bookmark').href=bookmark();$('#boj-bookmark').onclick=function(e){e.preventDefault();$('#boj-import-status').textContent='이 버튼을 북마크바로 드래그한 뒤, 백준 문제 페이지에서 등록한 북마크를 눌러주세요.'};$('#boj-import-file').onchange=async function(){var f=this.files[0];if(!f)return;try{if(f.size>2000000)throw Error('2MB 이하의 문제 파일을 선택하세요.');var raw=await f.text(),data;if(host!==$('#boj-import-host'))return;if(/\.html?$/i.test(f.name)){var doc=new DOMParser().parseFromString(raw,'text/html'),canonical=doc.querySelector('link[rel="canonical"]')?.getAttribute('href');if(!canonical)throw Error('원문 주소가 있는 백준 HTML 파일을 선택하세요.');data=collect(doc,canonical)}else data=JSON.parse(raw);pending=validate(data);$('#boj-import-status').textContent='가져온 내용을 확인한 뒤 적용하세요.';preview(n)}catch(e){if(host!==$('#boj-import-host'))return;pending=null;$('#boj-import-preview').replaceChildren();$('#boj-import-status').textContent=e.message||'파일을 읽지 못했습니다.'}finally{this.value=''}};preview(n)}
 window.addEventListener('message',function(e){if(e.origin!=='https://www.acmicpc.net'||!window.opener||e.source!==window.opener||e.data?.type!=='boj-problem-import')return;try{var p=validate(e.data.problem);pending=p;e.source.postMessage({type:'boj-problem-received'},e.origin);if(location.hash==='#/boj/'+p.number)bind(p.number);else location.hash='#/boj/'+p.number}catch(_){toast('백준 문제 데이터를 확인하지 못했습니다. 원문 페이지에서 다시 가져오세요.')}});
 return {bind:bind};
})();
