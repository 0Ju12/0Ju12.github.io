var ALGO_CORE={
 normalize:function(s){return String(s||'').replace(/\r/g,'').split('\n').map(function(x){return x.trimEnd()}).join('\n').trim()},
 verdict:function(result,expected){return result.error?'error':expected===''?'unchecked':this.normalize(result.output)===this.normalize(expected)?'pass':'fail'},
 validCases:function(cases){return Array.isArray(cases)&&cases.length<=20&&cases.every(function(c){return c&&typeof c.id==='string'&&typeof c.input==='string'&&c.input.length<=100000&&typeof c.expected==='string'&&c.expected.length<=100000&&typeof c.name==='string'&&c.name.length<=100})},
 version:function(data){return {id:crypto.randomUUID(),at:Date.now(),code:data.code||'',input:data.input||'',output:data.output||'',idea:data.idea||'',expected:data.expected||'',metrics:data.metrics||{},cases:JSON.parse(JSON.stringify(data.cases||[])),mistakes:(data.mistakes||[]).slice()}},
 addVersion:function(list,data){var next=this.version(data),last=(list||[]).slice(-1)[0];if(last&&last.code===next.code&&last.input===next.input&&(last.expected||'')===next.expected&&JSON.stringify(last.cases)===JSON.stringify(next.cases)){var same=(list||[]).slice(-20);same[same.length-1]=Object.assign({},last,{metrics:next.metrics,output:next.output,idea:next.idea});return same}return (list||[]).concat([next]).slice(-20)},
 diff:function(a,b){var left=String(a).split('\n'),right=String(b).split('\n');if(left.length>500||right.length>500)return {large:true,left:left,right:right,lines:[]};var table=Array.from({length:left.length+1},function(){return new Uint16Array(right.length+1)});for(var i=left.length-1;i>=0;i--)for(var j=right.length-1;j>=0;j--)table[i][j]=left[i]===right[j]?table[i+1][j+1]+1:Math.max(table[i+1][j],table[i][j+1]);var lines=[],i=0,j=0;while(i<left.length||j<right.length){if(i<left.length&&j<right.length&&left[i]===right[j]){lines.push({kind:'same',text:left[i++]});j++}else if(j<right.length&&(i===left.length||table[i][j+1]>=table[i+1][j]))lines.push({kind:'add',text:right[j++]});else lines.push({kind:'remove',text:left[i++]})}return {large:false,lines:lines}},
 reviewDate:function(date,count){var d=new Date(date+'T00:00:00');d.setDate(d.getDate()+[1,3,7,14,30][Math.min(count,4)]);return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')},
 remote:function(x){function walk(v,d){if(d>30)throw Error('자료가 너무 깊어요.');if(v&&typeof v==='object')Object.keys(v).forEach(function(k){if(['__proto__','constructor','prototype'].includes(k))throw Error('올바르지 않은 자료 키입니다.');walk(v[k],d+1)})}walk(x,0);if(JSON.stringify(x).length>5000000)throw Error('5MB 이하의 풀이만 가져올 수 있어요.');if(!x||x.schema!==1||typeof x.id!=='string'||x.id.length>150||typeof x.code!=='string'||x.code.length>100000||typeof x.input!=='string'||x.input.length>100000||typeof x.problem!=='string'||x.problem.length>500||!Number.isFinite(x.updatedAt))throw Error('풀이 파일 형식을 확인하세요.');for(var k of ['output','idea','statement','expected'])if(x[k]!=null&&(typeof x[k]!=='string'||x[k].length>100000))throw Error('텍스트 길이 또는 형식이 올바르지 않아요.');if(x.cases&&!this.validCases(x.cases))throw Error('테스트 케이스 형식이 올바르지 않아요.');if(x.versions&&(!Array.isArray(x.versions)||x.versions.length>20||x.versions.some(function(v){return !v||typeof v.code!=='string'||v.code.length>100000||typeof v.input!=='string'||v.input.length>100000})))throw Error('버전 이력을 확인하세요.');this.validateLearning(x);return x},
 validateLearning:function(x){if(x.cases&&!this.validCases(x.cases))throw Error('테스트 형식을 확인하세요.');if(x.mistakes&&(!Array.isArray(x.mistakes)||x.mistakes.length>30||x.mistakes.some(function(t){return typeof t!=='string'||t.length>200})))throw Error('오답 원인을 확인하세요.');if(x.metrics&&(!Number.isFinite(x.metrics.steps??0)||!Number.isFinite(x.metrics.elapsedMs??0)))throw Error('실행 통계를 확인하세요.');if(x.reviewAt!=null&&(typeof x.reviewAt!=='string'||!/^\d{4}-\d{2}-\d{2}$/.test(x.reviewAt)))throw Error('복습 일자를 확인하세요.');if(x.versions&&(!Array.isArray(x.versions)||x.versions.length>20||x.versions.some(function(v){return !v||typeof v.code!=='string'||v.code.length>100000||typeof v.input!=='string'||v.input.length>100000||!Number.isFinite(v.at)||typeof v.id!=='string'||(v.cases&&!ALGO_CORE.validCases(v.cases))})))throw Error('버전 이력을 확인하세요.');if(x.lastTests&&(!x.lastTests||typeof x.lastTests.code!=='string'||x.lastTests.code.length>100000||!Array.isArray(x.lastTests.results)||x.lastTests.results.length>20||x.lastTests.results.some(function(r){return !r||['input','expected','output','error','caseId','name'].some(function(k){return typeof r[k]!=='string'||r[k].length>100000})})))throw Error('검사 결과를 확인하세요.');return true}
};
