/* ---------- 공채 정보 ---------- */
var jobQ='',jobSort='fit';
function dots(n){var h='<span class="score" title="추천 '+n+' / 5">';for(var i=1;i<=5;i++)h+='<i class="'+(i<=n?'on':'')+'"></i>';return h+'</span>'}
function recos(SS,n){var all=[];SS.forEach(function(x){x.companies.forEach(function(co,ci){all.push({x:x,co:co,ci:ci})})});
  return all.filter(function(a){return a.co.match}).sort(function(a,b){return (b.co.match.score-a.co.match.score)||0}).slice(0,n)}
function jobs(sec){
  var R=D.recruit||{},SS=R.sectors||[];var focus='';if(sec&&sec.indexOf(':')>0){focus=sec;sec=sec.split(':')[0]}var cur=SS.filter(function(x){return x.id===sec})[0];
  var h='<h1>공채 정보</h1><p class="sub">IT · 금융 · 자원개발 공개채용의 지원 조건, 전형, 인재상, 면접 형식과 질문 예시를 모으고 내 조건에 맞춰 추천합니다. 월·목 정기 업데이트 · 확인일 '+esc(R.checked||'')+'. 회색 글씨는 출처 종류이며, 포털 요약·후기는 공고 원문과 다를 수 있으니 <b>지원 전 공식 공고를 꼭 확인</b>하세요.</p>';
  h+='<a class="card" href="https://0ju12.github.io/data-projects/jobs/" target="_blank" rel="noopener" style="display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px;text-decoration:none;color:inherit"><span><b>신입 IT 공고 달력</b><br><span class="muted small">점핏·카카오·쿠팡·당근 등 공개 공고를 매일 모아 마감일 달력으로 · 직무·신입 여부로 거르기 · ★ 공고 마감을 캘린더(.ics)로</span></span><span aria-hidden="true">↗</span></a>';
  if(R.me)h+='<div class="card" style="margin-bottom:12px"><b>내 준비 상태</b><div class="grid g4" style="margin-top:8px">'+R.me.map(function(m){return '<div><div class="faint small">'+esc(m.k)+'</div><div style="font-size:14px">'+esc(m.v)+'</div></div>'}).join('')+'</div></div>';
  if(!cur&&!jobQ){var rs=recos(SS,9);h+='<h2>내 조건 추천 <span class="muted small" style="font-weight:600">추천 점수 순 · 컨설팅 포함</span></h2>'+(R.match_rule?'<p class="muted small" style="margin:-4px 0 12px">'+esc(R.match_rule)+'</p>':'')+'<div class="rec-g" style="margin-bottom:26px">'+rs.map(function(a){var m=a.co.match;return '<a class="card rc" href="#/jobs/'+a.x.id+':'+a.ci+'"><div class="top2"><span class="sec-tag">'+esc(a.x.name)+'</span>'+dots(m.score)+'</div><h3>'+esc(a.co.name)+'</h3><div class="why">'+esc(m.why)+'</div>'+(m.gap?'<div class="gap">보완 · '+esc(m.gap)+'</div>':'')+(a.co.talent?'<div class="talent">'+a.co.talent.kw.slice(0,3).map(function(t){return '<span>'+esc(t.length>22?t.slice(0,21)+'…':t)+'</span>'}).join('')+'</div>':'')+'</a>'}).join('')+'</div>'}
  h+='<input class="search" id="jq" type="search" placeholder="기관 · 조건 검색 (예: 데이터, OPIc, NCS, 코딩테스트)" value="'+esc(jobQ)+'" aria-label="공채 정보 검색" style="margin-bottom:10px">';
  h+='<div class="chips" style="margin-bottom:14px"><button class="chip'+(cur?'':' on')+'" data-s="">전체 '+SS.reduce(function(a,x){return a+x.companies.length},0)+'</button>'+SS.map(function(x){return '<button class="chip'+(cur&&cur.id===x.id?' on':'')+'" data-s="'+x.id+'">'+esc(x.name)+' '+x.companies.length+'</button>'}).join('')+'<button class="chip'+(jobSort==='fit'?' on':'')+'" id="jsort" style="margin-left:auto">'+(jobSort==='fit'?'추천순':'기본순')+' ⇅</button></div>';
  var qn=jobQ.trim().toLowerCase(),hit=function(co){return !qn||JSON.stringify(co).toLowerCase().indexOf(qn)>=0},shown=0;
  (cur?[cur]:SS).forEach(function(x){
    var cs=x.companies.map(function(co,ci){return [co,ci]}).filter(function(a){return hit(a[0])});if(!cs.length)return;if(jobSort==='fit')cs.sort(function(a,b){return ((b[0].match||{}).score||0)-((a[0].match||{}).score||0)});shown+=cs.length;
    h+='<h2>'+esc(x.name)+' <span class="muted small">'+cs.length+'곳</span></h2><p class="muted small" style="margin:-6px 0 12px">'+esc(x.tip||'')+'</p><div class="grid g2">';
    cs.forEach(function(a){var co=a[0],ci=a[1],key=x.id+'-'+ci;
      h+='<div class="card co" id="co-'+key+'"><div><div class="row" style="justify-content:space-between"><h3>'+esc(co.name)+'</h3>'+(co.match?dots(co.match.score):'')+'</div><div class="faint small">'+esc(co.status||'')+'</div></div>';
      if(co.match)h+='<div class="fit" style="border-left-color:var(--gold);background:var(--gold-soft)"><b>추천 이유</b> · '+esc(co.match.why)+(co.match.gap?'<br><b>보완할 점</b> · '+esc(co.match.gap):'')+'</div>';
      if(co.talent)h+='<div><div class="lbl" style="margin-top:0">인재상'+(co.talent.ok?'<span class="okb y">공식·공고 문구</span>':'<span class="okb n">확인 필요</span>')+'</div><div class="talent">'+co.talent.kw.map(function(t){return '<span>'+esc(t)+'</span>'}).join('')+'</div><div class="src" style="margin:4px 0 0">출처 · '+(co.talent.url?'<a href="'+esc(co.talent.url)+'" target="_blank" rel="noopener">'+esc(co.talent.src)+' ↗</a>':esc(co.talent.src))+'</div></div>';
      if(co.conditions&&co.conditions.length)h+='<div><div class="lbl" style="margin-top:0">지원 조건</div><ul>'+co.conditions.map(function(c){return '<li>'+esc(c.t)+(c.src?'<span class="src">· '+esc(c.src)+'</span>':'')+'</li>'}).join('')+'</ul></div>';
      if(co.process&&co.process.length)h+='<div><div class="lbl" style="margin-top:0">전형</div><div class="flow">'+co.process.map(function(t){return '<span>'+esc(t)+'</span>'}).join('<i>→</i>')+'</div></div>';
      if(co.interview&&co.interview.length)h+='<div><div class="lbl" style="margin-top:0">면접 형식 (후기·공고)</div><ul>'+co.interview.map(function(t){return '<li>'+esc(t)+'</li>'}).join('')+'</ul></div>';
      if(co.questions&&co.questions.length)h+='<div><div class="lbl" style="margin-top:0">질문 예시</div><ul>'+co.questions.map(function(t){return '<li>'+esc(t.q)+(t.src?'<span class="src">· '+esc(t.src)+'</span>':'')+'</li>'}).join('')+'</ul><button class="btn sm ghost" style="margin-top:8px" data-jq="'+key+'">이 회사 질문으로 모의 면접</button></div>';
      if(co.fit)h+='<div class="fit"><b>내 준비 포인트</b> · '+esc(co.fit)+'</div>';
      if(co.consult)h+='<details class="consult"'+(focus===x.id+':'+ci?' open':'')+'><summary>면접 컨설팅 — 인재상에 내 경험 연결하기</summary>'+(co.consult.map&&co.consult.map.length?'<div class="lbl">인재상 → 내 경험</div><ul>'+co.consult.map.map(function(t){return '<li>'+esc(t)+'</li>'}).join('')+'</ul>':'')+(co.consult.ask&&co.consult.ask.length?'<div class="lbl">이 회사라서 나올 질문</div><ul>'+co.consult.ask.map(function(t){return '<li>'+esc(t)+'</li>'}).join('')+'</ul>':'')+(co.consult.tip?'<div class="lbl">준비 포인트</div><div style="font-size:14px">'+esc(co.consult.tip)+'</div>':'')+'</details>';
      if(co.links&&co.links.length)h+='<div class="links">'+co.links.map(function(l){return '<a href="'+esc(l.url)+'" target="_blank" rel="noopener">'+esc(l.label)+' ↗</a>'}).join('')+'</div>';
      h+='</div>';});
    h+='</div>';});
  if(!shown)h+='<div class="card empty">"'+esc(jobQ)+'"에 맞는 기관이 없습니다.</div>';
  if(R.guides)h+='<h2>답변 구조 참고</h2><div class="grid">'+R.guides.map(function(g){return '<div class="card"><a href="'+esc(g.url)+'" target="_blank" rel="noopener"><b>'+esc(g.label)+' ↗</b></a><div class="muted small">'+esc(g.note||'')+'</div></div>'}).join('')+'</div>';
  $('#app').innerHTML=h;
  $$('[data-s]').forEach(function(b){b.onclick=function(){location.hash='#/jobs'+(b.dataset.s?'/'+b.dataset.s:'')}});
  $('#jsort').onclick=function(){jobSort=jobSort==='fit'?'base':'fit';jobs(focus||sec)};
  if(focus){var fe=document.getElementById('co-'+focus.replace(':','-'));if(fe){setTimeout(function(){fe.scrollIntoView({block:'start'});fe.classList.add('hl');setTimeout(function(){fe.className=fe.className.replace(' hl','')},2200)},30)}}
  var ji=$('#jq');ji.onchange=function(){jobQ=ji.value;jobs(sec)};ji.onkeydown=function(e){if(e.key==='Enter'){jobQ=ji.value;jobs(sec)}};
  $$('[data-jq]').forEach(function(b){b.onclick=function(){var k=b.dataset.jq.split('-'),x=SS.filter(function(s){return s.id===k[0]})[0],co=x.companies[+k[1]];
    var src=(co.questions||[]).concat(((co.consult||{}).ask||[]).map(function(q){return {q:q,src:'면접 컨설팅 예상 질문'}}));
    var qs=src.map(function(t,i){var id='j:'+k[0]+':'+k[1]+':'+i;var q={id:id,c:'기타',g:co.name,q:t.q,a:'',guide:'출처: '+(t.src||'')+' / '+(co.fit||''),kind:'skeleton'};Q[id]=q;return q});
    startMock(qs,{sec:90,rec:false,label:co.name})}});
}
