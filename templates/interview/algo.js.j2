  h+='<div class="grid g2" style="margin-bottom:14px"><div class="card"><b>오늘 다시 풀 문제 '+due.length+'</b>'+(due.length?'<div style="margin-top:6px">'+due.slice(0,8).map(function(a){return '<div style="display:flex;align-items:center;gap:8px;padding:8px 0;border-top:1px solid var(--line)"><span style="flex:1;min-width:0">'+esc(a.s+' '+a.n)+'<br><span class="faint small">'+esc((a.t||[]).join(', '))+' · '+((a.re||[]).length?'다시 풀기 '+a.re.length+'회째':'처음 '+({hint:'힌트',fail:'못 풂'}[a.r]||'')+' '+a.d.slice(5))+'</span></span><button class="btn sm" data-reok="'+a.id+'">다시 풀었다 ✓</button><button class="btn sm ghost" data-rebad="'+a.id+'">또 막힘</button></div>'}).join('')+'</div>':'<p class="faint small">힌트를 봤거나 못 푼 문제는 3일 뒤, 다시 막히면 7일 뒤에 여기 나옵니다.</p>')+
    (later.length?'<p class="faint small" style="margin:8px 0 0">예정 '+later.length+'문제 · 다음: '+esc(later[0].n)+' ('+algoNext(later[0]).slice(5)+')</p>':'')+'</div>'+amockCard()+'</div>';
  h+='<div class="card" style="margin-bottom:14px"><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,150px),1fr));gap:10px;align-items:end">'+
    '<label class="small" style="font-weight:700">사이트<select class="field" id="as" style="margin-top:4px">'+['SWEA','백준','프로그래머스','코드트리','기타'].map(function(x){return '<option>'+x+'</option>'}).join('')+'</select></label>'+
    '<label class="small" style="font-weight:700">번호·제목<input class="field" id="an" placeholder="예: 1767 프로세서 연결하기" style="margin-top:4px"></label>'+
    '<label class="small" style="font-weight:700">난이도<input class="field" id="al" placeholder="D4 · 골드3" style="margin-top:4px"></label>'+
    '<label class="small" style="font-weight:700">결과<select class="field" id="ar" style="margin-top:4px"><option value="ok">혼자 풀었다</option><option value="hint">힌트·풀이 참고</option><option value="fail">못 풀었다</option></select></label>'+
    '<label class="small" style="font-weight:700">걸린 시간(분)<input class="field" id="am" type="number" min="0" style="margin-top:4px"></label></div>'+
