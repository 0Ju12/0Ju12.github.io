  var few=ATOP.filter(function(k){return !st[k]||st[k].n<2});
  var drv=S.algo.filter(function(a){return a.src==='drive'}).length;
  var weak=Object.keys(st).filter(function(k){return st[k].n>=2&&st[k].bad>0}).sort(function(a,b){return st[b].bad/st[b].n-st[a].bad/st[a].n}).slice(0,3);
  var done={};S.algo.forEach(function(a){var m=/^(\d{3,5})/.exec(a.n||'');if(m&&a.r==='ok')done[m[1]]=1});
  var nxt=[];weak.concat(few).forEach(function(k){(ARECO[k]||[]).filter(function(p){return !done[p[0]]&&!nxt.some(function(x){return x[0]===p[0]})}).slice(0,2).forEach(function(p){if(nxt.length<6)nxt.push([p[0],p[1],k])})});
  var h='<div class="hd"><div><span class="eyebrow">Algorithm log</span><h1 style="margin-top:6px">알고리즘 기록</h1><p class="sub" style="margin:0">이번 주 '+wk.length+' / '+tg+'문제 · 혼자 푼 문제를 추가하면 주간 체크에 자동으로 더해집니다.'+(drv?'<br><span class="small">드라이브 swea 풀이 코드에서 '+drv+'문제를 가져왔습니다 ('+esc((((D.algo_seed||{}).updated)||'').slice(0,10))+' 분석 · 월·목 갱신).</span>':'')+'</p></div><a class="btn ghost" href="#/tools">← 도구</a></div>';
