    '<div class="card"><b>다음에 연습할 주제</b>'+(weak.length?'<ul class="tails">'+weak.map(function(k){return '<li>'+anote(k)+' — 못 푼 비율 '+Math.round(st[k].bad/st[k].n*100)+'% ('+st[k].n+'문제)</li>'}).join('')+'</ul><a class="small" href="../study/index.html#/notes/algo">SW 알고리즘 노트로 복습 →</a>':'<p class="faint small">한 주제에 2문제 이상 기록하면 약한 주제를 골라 드립니다.</p>')+(nxt.length?'<div style="margin-top:12px"><b class="small">다음에 풀 문제 (SWEA)</b><ul class="tails">'+nxt.map(function(x){return '<li>'+x[0]+' '+esc(x[1])+' <span class="faint small">'+esc(x[2])+'</span></li>'}).join('')+'</ul></div>':'')+(few.length?'<p class="small" style="margin:10px 0 0"><b>기록이 적은 주제</b> · '+few.map(function(k){return anote(k)+' '+((st[k]||{}).n||0)}).join(' · ')+'</p>':'')+'</div></div>';
  var cardsN=S.algo.filter(function(a){return a.idea}).length;
  if(cardsN)h+='<div class="card" style="margin-top:14px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap"><div><b>풀이 카드</b><div class="faint small">문제 이름만 보고 핵심 아이디어·시간복잡도를 떠올린 뒤 뒤집어 확인 — 면접 직전 복습용 ('+cardsN+'장)</div></div><button class="btn" id="fcgo">카드 넘기기</button></div><div id="fc"></div>';
  h+='<h2>기록 <span class="muted small" style="font-weight:600">'+S.algo.length+'문제</span></h2><div class="card" style="overflow-x:auto">'+(S.algo.length?'<table style="width:100%;border-collapse:collapse;font-size:14px"><tr style="color:var(--muted);text-align:left"><th style="padding:6px 0">날짜</th><th>문제</th><th>주제</th><th>결과</th><th></th></tr>'+S.algo.map(function(a,i){return [a,i]}).sort(function(x,y){return x[0].d===y[0].d?y[1]-x[1]:(x[0].d<y[0].d?1:-1)}).map(function(p){return p[0]}).slice(0,80).map(function(a){return '<tr><td style="padding:6px 0;white-space:nowrap">'+esc(a.d.slice(5))+'</td><td>'+esc(a.s+' '+a.n)+(a.l?' <span class="faint">'+esc(a.l)+'</span>':'')+(a.src==='drive'?' <span class="tag" title="'+esc(a.file||'')+'">드라이브</span>':'')+(a.note||a.fid||a.gh?'<div class="faint small">'+esc(a.note||'')+(a.fid?' <a href="https://drive.google.com/file/d/'+esc(a.fid)+'/view" target="_blank" rel="noopener">드라이브 코드</a>':'')+(a.gh&&(D.algo_seed||{}).repo?' · <a href="'+esc(D.algo_seed.repo)+'/blob/main/'+esc(a.gh)+'" target="_blank" rel="noopener">GitHub</a>':'')+((a.re||[]).length?' · 다시 풀기 '+a.re.map(function(x){return x.d.slice(5)+(x.r==='ok'?' ✓':' ✕')}).join(', '):'')+'</div>':'')+'</td><td class="small muted">'+esc((a.t||[]).join(', '))+'</td><td>'+({ok:'✓',hint:'힌트',fail:'✕'}[a.r])+(a.m?' <span class="faint small">'+a.m+'분</span>':'')+'</td><td><button class="xbtn" data-adel="'+a.id+'" aria-label="삭제">✕</button></td></tr>'}).join('')+'</table>':'<p class="faint small">아직 기록이 없습니다.</p>')+'</div>';
  $('#app').innerHTML=h;
  var sel=[];$$('#at [data-t]').forEach(function(b){b.onclick=function(){var i=sel.indexOf(b.dataset.t);if(i>=0)sel.splice(i,1);else sel.push(b.dataset.t);b.classList.toggle('on')}});
  $('#aadd').onclick=function(){var n=$('#an').value.trim();if(!n){toast('번호나 제목을 입력하세요.');return}var r=$('#ar').value;
    S.algo.push({id:uid(),d:today(),s:$('#as').value,n:n,l:$('#al').value.trim(),r:r,m:+$('#am').value||0,t:sel.slice(),ts:Date.now()});if(r==='ok')wadd('algo',1);else save();toast(r==='ok'?'기록했습니다. 이번 주 알고리즘 +1':'기록했습니다.');algo()};
  $$('[data-adel]').forEach(function(b){b.onclick=function(){var a=S.algo.filter(function(x){return x.id===b.dataset.adel})[0];if(!a||!confirm('이 기록을 지울까요?'))return;markDeleted('algo',a.id);S.algo=S.algo.filter(function(x){return x!==a});if(a.src==='drive'&&S.algoHide.indexOf(a.id)<0)S.algoHide.push(a.id);if(a.r==='ok'&&a.d>=wkey()&&a.src!=='drive')wadd('algo',-1);else save();algo()}});
  function reMark(id,r){var a=S.algo.filter(function(x){return x.id===id})[0];if(!a)return;(a.re=a.re||[]).push({d:today(),r:r});a.ts=Date.now();if(r==='ok'){wadd('algo',1);toast('다시 풀었습니다. 이번 주 알고리즘 +1')}else{save();toast('7일 뒤에 다시 나옵니다.')}algo()}
  $$('[data-reok]').forEach(function(b){b.onclick=function(){reMark(b.dataset.reok,'ok')}});
  $$('[data-rebad]').forEach(function(b){b.onclick=function(){reMark(b.dataset.rebad,'fail')}});
  amockBind();
  var fcb=$('#fcgo');if(fcb)fcb.onclick=function(){var deck=shuffle(S.algo.filter(function(a){return a.idea}).slice()).sort(function(a,b){return (a.fc||0)-(b.fc||0)}),i=0,box=$('#fc');
    var show=function(open){var a=deck[i];if(!a){box.innerHTML='<div class="card" style="margin-top:10px">다 넘겼습니다. 헷갈린 카드는 다음에 먼저 나옵니다.</div>';return}
      box.innerHTML='<div class="card hero" style="margin-top:10px"><div class="faint small">'+(i+1)+' / '+deck.length+' · '+esc((a.t||[]).join(', '))+'</div><h2 style="margin:6px 0 10px">SWEA '+esc(a.n)+'</h2>'+(open?'<p style="margin:0 0 6px"><b>핵심</b> '+esc(a.idea)+'</p><p class="muted" style="margin:0 0 12px"><b>복잡도</b> '+esc(a.cx||'—')+'</p><div class="row"><button class="btn" data-fc="ok">기억났다</button><button class="btn ghost" data-fc="bad">헷갈렸다</button></div>':'<button class="btn" id="fcflip">뒤집기</button>')+'</div>';
      var f=$('#fcflip');if(f)f.onclick=function(){show(true)};
      $$('[data-fc]').forEach(function(b){b.onclick=function(){a.fc=(a.fc||0)+(b.dataset.fc==='ok'?1:-1);save();i++;show(false)}})};show(false)};
}
