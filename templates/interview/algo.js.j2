function anote(k,label){var n=ANOTE[k];return n?'<a href="../study/notes/'+n[0]+'.html" title="SW 노트: '+esc(n[1])+'">'+esc(label||k)+'</a>':esc(label||k)}
/* 다시 풀기: 힌트·못 푼 문제는 3일 뒤, 다시 풀어도 막히면 7일 뒤 */
function dplus(d,n){var t=new Date(d+'T00:00:00');t.setDate(t.getDate()+n);return t.getFullYear()+'-'+String(t.getMonth()+1).padStart(2,'0')+'-'+String(t.getDate()).padStart(2,'0')}
function algoNext(a){var re=a.re||[],last=re[re.length-1];if(last?last.r==='ok':a.r==='ok')return null;return dplus(last?last.d:a.d,re.length?7:3)}
function algoDue(){return S.algo.filter(function(a){var n=algoNext(a);return n&&n<=today()})}
var amockT=null;
/* 오늘 화면에 모으는 할 일: 복습 질문 · 다시 풀 문제 · 마감 · 자소서 · 잔디 */
function todayBoard(){var t=today(),items=[];
  var dq=due().length;if(dq)items.push(['#/mock','복습 질문 '+dq+'개','간격 반복 차례',0]);
  var da=algoDue().length;if(da)items.push(['#/algo','다시 풀 문제 '+da+'개','힌트·못 푼 SWEA',0]);
  if(S.amock)items.push(['#/algo','A형 모의 진행 중','타이머가 돌아가고 있습니다',0]);
  S.board.forEach(function(b){if(!b.due||b.stage==='done'||b.stage==='drop')return;var n=ddays(b.due);if(n!=null&&n>=0&&n<=14)items.push(['#/board',b.name+' 마감 D-'+n,(STAGES[b.stage]||'')+(b.role?' · '+b.role:''),n])});
  ((P.goals)||[]).forEach(function(g){var n=ddays(gdate(g));if(n!=null&&n>=0&&n<=21)items.push(['#/',g.name+' D-'+n,g.note||'목표',n])});
  var dr=(P.essays||[]).filter(function(e,i){var r=S.essay['e'+i];return r&&r.st==='draft'}).length;if(dr)items.push(['#/essay','자소서 초안 '+dr+'개','완성으로 바꾸면 주간 +1',99]);
  items.sort(function(a,b){return a[3]-b[3]});
  var hm={};Object.keys(S.days).forEach(function(k){hm[k]=(hm[k]||0)+S.days[k]});S.algo.forEach(function(a){if(a.src!=='drive')hm[a.d]=(hm[a.d]||0)+1;(a.re||[]).forEach(function(x){hm[x.d]=(hm[x.d]||0)+1})});(S.opic||[]).forEach(function(o){hm[o.d]=(hm[o.d]||0)+1});(S.speak||[]).forEach(function(o){hm[o.d]=(hm[o.d]||0)+1});
  return '<div class="grid g2" style="margin-top:12px;align-items:start"><div class="card"><b>오늘 할 일</b>'+(items.length?'<div style="margin-top:6px">'+items.slice(0,7).map(function(x){return '<a href="'+x[0]+'" style="display:flex;justify-content:space-between;gap:10px;padding:9px 0;border-top:1px solid var(--line);text-decoration:none;color:inherit"><span><b style="font-size:14.5px">'+esc(x[1])+'</b><br><span class="faint small">'+esc(x[2])+'</span></span><span class="muted">→</span></a>'}).join('')+'</div>':'<p class="faint small" style="margin:6px 0 0">급한 일은 없습니다. 아래에서 새 질문을 연습해 보세요.</p>')+'</div>'+heat(hm,16,'연습 잔디 (질문·알고리즘·말하기)').replace('class="card" style="margin-bottom:14px"','class="card"')+'</div>'}
/* 최근 N주 활동 잔디 (GitHub·LeetCode 식) — m: {날짜: 개수} */
function heat(m,weeks,label){var end=new Date(today()+'T00:00:00'),start=new Date(end);start.setDate(start.getDate()-end.getDay()-7*(weeks-1));var cells='',tot=0,days=0,max=1;Object.keys(m).forEach(function(k){max=Math.max(max,m[k])});
  for(var d=new Date(start);d<=end;d.setDate(d.getDate()+1)){var k=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'),v=m[k]||0;if(v){tot+=v;days++}var lv=v?Math.min(4,Math.ceil(v/max*4)):0;cells+='<i title="'+k+' · '+v+'" style="width:12px;height:12px;border-radius:3px;display:block;background:'+(lv?'color-mix(in srgb,var(--ok) '+(20+lv*20)+'%,var(--soft))':'var(--soft)')+'"></i>'}
  var streak=0;for(var s=new Date(end);;s.setDate(s.getDate()-1)){var sk=s.getFullYear()+'-'+String(s.getMonth()+1).padStart(2,'0')+'-'+String(s.getDate()).padStart(2,'0');if(m[sk])streak++;else if(+s!==+end)break;else continue;}
  return '<div class="card" style="margin-bottom:14px"><div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:6px"><b>'+esc(label)+'</b><span class="small muted">최근 '+weeks+'주 · '+days+'일 · '+tot+'회 · 연속 '+streak+'일</span></div><div style="display:grid;grid-auto-flow:column;grid-template-rows:repeat(7,12px);grid-auto-columns:12px;justify-content:start;gap:3px;margin-top:12px;overflow-x:auto;padding-bottom:2px">'+cells+'</div></div>'}
/* A형 모의: 추천 문제 2개 · 3시간 타이머 · 끝내면 결과가 기록에 들어감 */
function amockPick(){var st={},done={};S.algo.forEach(function(a){(a.t||[]).forEach(function(t){var o=st[t]||(st[t]={n:0,bad:0});o.n++;if(a.r!=='ok')o.bad++});var m=/^(\d{3,5})/.exec(a.n||'');if(m&&a.r==='ok')done[m[1]]=1});
  var order=ATOP.slice().sort(function(x,y){var a=st[x]||{n:0,bad:0},b=st[y]||{n:0,bad:0};return (b.bad/(b.n||1)-a.bad/(a.n||1))||(a.n-b.n)}),out=[];
  var free=function(k){return (ARECO[k]||[]).filter(function(p){return !done[p[0]]})[0]},out=[],a=free('구현·시뮬레이션');if(a)out.push([a[0],a[1],'구현·시뮬레이션']);
  order.some(function(k){if(k==='구현·시뮬레이션')return false;var p=free(k);if(p&&!out.some(function(x){return x[0]===p[0]})){out.push([p[0],p[1],k]);return true}return false});
  return out}
function amockCard(){var m=S.amock,log=S.amockLog||[];
  if(!m)return '<div class="card"><b>A형 모의 (3시간)</b><p class="faint small" style="margin:6px 0 10px">시뮬레이션 1문제 + 약한 주제 1문제를 골라 3시간을 잽니다. 끝내면 결과가 기록과 다시 풀기에 들어갑니다.</p><button class="btn" id="amgo">모의 시작</button>'+(log.length?'<p class="faint small" style="margin:10px 0 0">지난 모의: '+log.slice(-3).reverse().map(function(x){return x.d.slice(5)+' '+x.ok+'/'+x.n+' ('+Math.round(x.sec/60)+'분)'}).join(' · ')+'</p>':'')+'</div>';
  return '<div class="card"><b>A형 모의 진행 중</b> <span id="amclock" style="font-variant-numeric:tabular-nums;font-weight:800;margin-left:6px"></span><div class="list" style="margin-top:8px">'+m.probs.map(function(p,i){return '<div style="display:flex;align-items:center;gap:8px;padding:8px 0;border-top:1px solid var(--line)"><span style="flex:1;min-width:0">SWEA '+p[0]+' '+esc(p[1])+'<br><span class="faint small">'+anote(p[2])+'</span></span><select class="field" data-amr="'+i+'" style="width:auto"><option value="ok">풀었다</option><option value="hint">부분·힌트</option><option value="fail" selected>못 풀었다</option></select></div>'}).join('')+'</div><div class="row" style="margin-top:10px;justify-content:flex-end;gap:8px"><button class="btn ghost" id="amquit">그만두기</button><button class="btn" id="amend">끝내고 기록</button></div></div>'}
function amockBind(){clearInterval(amockT);var go=$('#amgo');if(go)go.onclick=function(){var p=amockPick();if(p.length<1){toast('추천할 문제가 없습니다.');return}S.amock={start:Date.now(),dur:180,probs:p};save();algo()};
  if(!S.amock)return;var tick=function(){var el=$('#amclock');if(!el){clearInterval(amockT);return}var left=S.amock.start+S.amock.dur*60000-Date.now(),neg=left<0,s=Math.abs(Math.round(left/1000));el.textContent=(neg?'시간 초과 +':'남은 시간 ')+Math.floor(s/3600)+':'+String(Math.floor(s%3600/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');el.style.color=neg?'var(--bad)':''};tick();amockT=setInterval(tick,1000);
  $('#amquit').onclick=function(){if(!confirm('모의를 그만둘까요? 기록은 남지 않습니다.'))return;S.amock=null;save();algo()};
  $('#amend').onclick=function(){var m=S.amock,sec=Math.round((Date.now()-m.start)/1000),ok=0;m.probs.forEach(function(p,i){var r=$('[data-amr="'+i+'"]').value;if(r==='ok'){ok++;wadd('algo',1)}S.algo.push({id:uid(),d:today(),s:'SWEA',n:p[0]+' '+p[1],l:'A형 모의',r:r,m:Math.round(sec/60/m.probs.length),t:[p[2]],ts:Date.now()})});
    (S.amockLog=S.amockLog||[]).push({d:today(),n:m.probs.length,ok:ok,sec:sec});S.amock=null;save();toast('모의 결과를 기록했습니다 ('+ok+'/'+m.probs.length+').');algo()}}
var ATOP=['구현·시뮬레이션','BFS/DFS','백트래킹','비트마스킹','DP','그리디','이분 탐색','투 포인터','최단 경로','그래프·트리','문자열','자료구조','수학'];
function algo(){
  var since=wkey(),wk=S.algo.filter(function(a){return a.d>=since}),tg=(((P.weekly||[]).filter(function(w){return w.id==='algo'})[0])||{}).target||10;
