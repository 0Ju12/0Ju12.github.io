/* SQL practice and project defense share the existing portable state. */
var PREP_LABS=(function(){
 var worker=null,record=null,audioURL='',epoch=0,sqlID='filter',projectID='',question=0;
 var prompts=[['문제 정의','이 프로젝트가 해결한 문제와 성공 기준은 무엇인가요?','다른 해결 방법과 비교해 왜 이 접근을 선택했나요?'],['내 기여','팀 전체 결과와 구분해 직접 설계·구현한 부분을 설명하세요.','내가 맡지 않은 부분과 협업 경계는 어디였나요?'],['기술 선택','사용한 데이터 구조·모델·저장소를 고른 근거는 무엇인가요?','데이터가 10배 늘어나면 어느 부분부터 바꾸겠나요?'],['검증','결과를 어떤 데이터·지표·비교 기준으로 검증했나요?','누수·중복·편향이나 실패 사례는 어떻게 확인했나요?'],['운영과 한계','현재 구현의 한계와 운영 시 예상되는 장애를 설명하세요.','다시 만든다면 무엇을 먼저 개선하고 어떻게 측정하겠나요?']];
 function stop(){epoch++;if(worker){worker.terminate();worker=null}if(record){record.stop();record=null}if(audioURL){URL.revokeObjectURL(audioURL);audioURL=''}}
 function table(r){return '<div style="overflow:auto"><table><thead><tr>'+r.columns.map(function(c){return '<th>'+esc(c)+'</th>'}).join('')+'</tr></thead><tbody>'+r.values.map(function(row){return '<tr>'+row.map(function(v){return '<td>'+esc(v===null?'NULL':String(v))+'</td>'}).join('')+'</tr>'}).join('')+'</tbody></table></div>'}
 function sql(){
  if(typeof SQL_PRACTICE_DATA==='undefined'){var token=epoch;$('#app').innerHTML='<h1>SQL 실전 연습장</h1><p role="status">문제를 불러오는 중…</p>';var script=document.createElement('script');script.src='lab/sql-exercises.js';script.onload=function(){if(token===epoch)sql()};script.onerror=function(){if(token!==epoch)return;$('#app').innerHTML='<h1>SQL 실전 연습장</h1><p>문제를 불러오지 못했습니다.</p><button class="btn" id="sql-retry">다시 시도</button>';$('#sql-retry').onclick=sql};document.head.append(script);return}

  var data=SQL_PRACTICE_DATA,ex=data.exercises.find(function(x){return x.id===sqlID})||data.exercises[0],saved=S.sqlPractice[ex.id]||{},only=false;
  $('#app').innerHTML='<div class="career-ui"><span class="eyebrow">SQL PRACTICE</span><h1>SQL 실전 연습장</h1><p class="sub">SQLite로 직접 실행합니다. 예제 데이터와 추가 데이터 두 세트로 결과를 비교합니다.</p><div class="row"><label><input type="checkbox" id="sql-review"> 미완료·오답만 보기</label><span id="sql-progress">완료 '+data.exercises.filter(function(x){return S.sqlPractice[x.id]?.passed}).length+' / '+data.exercises.length+'</span></div><label>문제<select class="field" id="sql-select">'+data.exercises.map(function(x){return '<option value="'+x.id+'"'+(x.id===ex.id?' selected':'')+'>'+x.title+(S.sqlPractice[x.id]?.passed?' · 통과':'')+'</option>'}).join('')+'</select></label><section class="card"><h2>'+esc(ex.title)+'</h2><p>'+esc(ex.prompt)+'</p><p class="small muted">열 이름도 문제와 일치시켜 주세요. '+(ex.ordered?'행 순서도 비교합니다.':'행 순서는 무시하되 중복 행은 구분합니다.')+'</p><details><summary>테이블 구조와 예제 데이터</summary><pre style="white-space:pre-wrap;overflow-wrap:anywhere">'+esc(data.setup)+'</pre></details><label>SQL<textarea class="field" id="sql-code" rows="7" maxlength="20000" spellcheck="false">'+esc(saved.code||'SELECT * FROM orders;')+'</textarea></label><div class="row"><button class="btn" id="sql-run">실행·결과 비교</button><button class="btn ghost" id="sql-cancel" disabled>실행 중단</button></div><p id="sql-state" role="status">'+(saved.passed?'마지막 실행: 두 데이터 세트 통과':'조회문을 작성해 실행하세요.')+'</p><div id="sql-output"></div><details><summary>힌트·해설</summary><p>'+esc(ex.hint)+'</p><details><summary>예시 SQL 보기</summary><pre style="white-space:pre-wrap">'+esc(ex.answer)+'</pre></details></details><label>오답·배운 점<textarea class="field" id="sql-note" rows="3" maxlength="20000">'+esc(saved.note||'')+'</textarea></label><p class="small muted">코드와 복습 메모는 이 브라우저에 자동 저장되며 기록 백업에 포함됩니다. 실행 시간 제한은 8초입니다.</p></section></div>';
  function patch(v){var old=S.sqlPractice[ex.id]||{};S.sqlPractice[ex.id]=Object.assign({code:$('#sql-code').value,note:$('#sql-note').value,passed:false,attempts:0},old,v,{ts:stamp(old.ts)});if(!save())$('#sql-state').textContent='저장 실패: 코드를 복사하거나 백업하세요.'}
  $('#sql-select').onchange=function(){stop();sqlID=this.value;sql()};$('#sql-review').onchange=function(){only=this.checked;Array.from($('#sql-select').options).forEach(function(o){o.hidden=only&&!!S.sqlPractice[o.value]?.passed})};
  $('#sql-code').oninput=function(){patch({code:this.value,passed:false})};$('#sql-note').oninput=function(){patch({note:this.value})};
  $('#sql-cancel').onclick=function(){stop();$('#sql-code').disabled=false;$('#sql-run').disabled=false;this.disabled=true;$('#sql-state').textContent='실행을 중단했습니다.'};
  $('#sql-run').onclick=function(){stop();var token=epoch,query=$('#sql-code').value;patch({code:query,passed:false,attempts:(S.sqlPractice[ex.id]?.attempts||0)+1});this.disabled=true;$('#sql-code').disabled=true;$('#sql-cancel').disabled=false;$('#sql-output').replaceChildren();$('#sql-state').textContent='SQLite 실행 중…';worker=new Worker('lab/sql-worker.js');var timeout=setTimeout(function(){if(token!==epoch)return;finish({ok:false,error:'8초 제한을 넘었습니다. 조인 조건과 재귀 쿼리를 확인하세요.'})},8000);function finish(r){clearTimeout(timeout);if(token!==epoch)return;stop();$('#sql-code').disabled=false;$('#sql-run').disabled=false;$('#sql-cancel').disabled=true;if(!r.ok){$('#sql-state').textContent='실행 오류: '+r.error;return}patch({passed:r.passed});$('#sql-state').textContent=r.passed?'통과: 두 데이터 세트의 결과가 일치합니다.':'다시 확인: '+r.checks.filter(Boolean).length+' / 2 세트 일치';$('#sql-output').innerHTML='<h3>실행 결과</h3>'+table(r.result)+(r.passed?'':'<details><summary>예제 데이터의 예상 결과</summary>'+table(r.expected)+'</details>');$('#sql-progress').textContent='완료 '+data.exercises.filter(function(x){return S.sqlPractice[x.id]?.passed}).length+' / '+data.exercises.length}
   worker.onmessage=function(e){finish(e.data)};worker.onerror=function(){finish({ok:false,error:'SQLite 파일을 불러오지 못했습니다. 연결을 확인하고 다시 실행하세요.'})};worker.postMessage({id:ex.id,query:query});
  };
 }
 function projects(){return DECKS.filter(function(x){return x.kind==='project'}).map(function(d){return {id:d.id,title:d.title,context:(d.slides||[]).map(function(s){return s.h+'\n'+(s.note||'')}).join('\n'),url:'#/deck/'+encodeURIComponent(d.id)}}).concat(S.experiences.map(function(e){return {id:'experience-'+e.id,title:e.title,context:[e.problem,e.role,e.decision,e.result].join('\n'),url:''}}))}
 function defense(){var list=projects();if(!list.length){$('#app').innerHTML='<h1>프로젝트 방어 면접</h1><p>프로젝트 발표 자료 또는 경험 보관함에 등록된 경험이 필요합니다.</p><a class="btn" href="#/career">경험 등록하기</a>';return}var p=list.find(function(x){return x.id===projectID})||list[0];projectID=p.id;var key=p.id+':'+question,saved=S.defense[key]||{},q=prompts[question];
  $('#app').innerHTML='<div class="career-ui"><span class="eyebrow">PROJECT DEFENSE</span><h1>프로젝트 방어 면접</h1><p class="sub">내 프로젝트 자료를 보며 기술 선택·검증·한계를 설명하는 연습입니다. 평가는 직접 기록합니다.</p><label>프로젝트<select class="field" id="def-project">'+list.map(function(x){return '<option value="'+esc(x.id)+'"'+(x.id===p.id?' selected':'')+'>'+esc(x.title)+'</option>'}).join('')+'</select></label><details><summary>프로젝트 근거 자료 확인</summary><p style="white-space:pre-wrap;overflow-wrap:anywhere">'+esc(p.context)+'</p>'+(p.url?'<a href="'+p.url+'">발표 자료 열기 →</a>':'')+'</details><section class="card" style="margin-top:18px"><p>'+ (question+1)+' / '+prompts.length+' · '+q[0]+'</p><h2>'+q[1]+'</h2><details><summary>꼬리 질문</summary><p>'+q[2]+'</p></details><div class="row"><button class="btn ghost" id="def-clock">연습 시간 시작</button><output id="def-time">0초</output><button class="btn ghost" id="def-record">녹음 시작</button><button class="btn ghost" id="def-stop" disabled>녹음 종료</button></div><p id="def-rec-state" role="status">녹음은 선택 사항입니다. 오디오는 직접 내려받아 보관하세요.</p><div id="def-audio"></div><label>내 답변<textarea class="field" id="def-answer" rows="7" maxlength="20000">'+esc(saved.answer||'')+'</textarea></label><label>자기평가<select class="field" id="def-rating"><option value="">평가 전</option>'+['근거 보강 필요','설명 가능','꼬리 질문까지 설명 가능'].map(function(v){return '<option'+(saved.rating===v?' selected':'')+'>'+v+'</option>'}).join('')+'</select></label><label>다음 개선점<textarea class="field" id="def-note" rows="3" maxlength="20000">'+esc(saved.note||'')+'</textarea></label><div class="row"><button class="btn ghost" id="def-prev"'+(question===0?' disabled':'')+'>이전 질문</button><button class="btn" id="def-next"'+(question===4?' disabled':'')+'>다음 질문</button><button class="btn ghost" id="def-export">답변 기록 내려받기</button></div><p id="def-save" role="status" class="small muted">답변·자기평가·개선점은 자동 저장됩니다. 녹음은 백업에 포함되지 않습니다.</p></section></div>';
  function patch(){var old=S.defense[key]||{};S.defense[key]={answer:$('#def-answer').value,note:$('#def-note').value,rating:$('#def-rating').value,ts:stamp(old.ts)};if(!save())$('#def-save').textContent='저장 실패: 답변을 복사하거나 백업하세요.'}
  $('#def-answer').oninput=patch;$('#def-note').oninput=patch;$('#def-rating').onchange=patch;
  function change(fn){stop();if(timer){clearInterval(timer);timer=null}fn();defense()}
  $('#def-project').onchange=function(){var id=this.value;change(function(){projectID=id;question=0})};$('#def-prev').onclick=function(){change(function(){question--})};$('#def-next').onclick=function(){change(function(){question++})};
  $('#def-clock').onclick=function(){if(timer){clearInterval(timer);timer=null;this.textContent='다시 시작';return}var start=Date.now();this.textContent='시간 멈추기';timer=setInterval(function(){$('#def-time').textContent=Math.floor((Date.now()-start)/1000)+'초'},250)};
  $('#def-record').onclick=async function(){var token=++epoch;record=createInterviewRecorder(window);this.disabled=true;$('#def-rec-state').textContent='마이크 권한 확인 중…';try{var ok=await record.start();if(token!==epoch)return;$('#def-stop').disabled=!ok;$('#def-record').disabled=ok;$('#def-rec-state').textContent=ok?'녹음 중 · 종료 후 듣기·내려받기 가능':'녹음을 사용할 수 없습니다. 텍스트 답변으로 연습하세요.'}catch(_){if(token===epoch){$('#def-record').disabled=false;$('#def-rec-state').textContent='마이크 권한을 확인하세요. 텍스트 연습은 계속할 수 있습니다.'}}};
  $('#def-stop').onclick=async function(){var token=epoch;this.disabled=true;var blob=record?await record.stop():null;if(token!==epoch)return;$('#def-record').disabled=false;if(!blob){$('#def-rec-state').textContent='녹음 데이터가 없습니다.';return}if(audioURL)URL.revokeObjectURL(audioURL);audioURL=URL.createObjectURL(blob);var box=$('#def-audio');box.replaceChildren();var player=document.createElement('audio');player.controls=true;player.src=audioURL;player.style.maxWidth='100%';var a=document.createElement('a');a.href=audioURL;a.download='프로젝트면접.'+(blob.type.includes('mp4')?'m4a':'webm');a.textContent='녹음 내려받기';box.append(player,a);$('#def-rec-state').textContent='녹음 완료. 화면을 떠나기 전에 내려받으세요.'};
  $('#def-export').onclick=function(){var lines=['# '+p.title+' 면접 연습',''];prompts.forEach(function(q,i){var a=S.defense[p.id+':'+i]||{};lines.push('## '+q[1],'꼬리 질문: '+q[2],'답변: '+(a.answer||''),'자기평가: '+(a.rating||'미평가'),'개선점: '+(a.note||''),'')});SYNC.save('프로젝트면접_'+today()+'.md',lines.join('\n'),'text/markdown')};
 }
 function packet(){
  var list=projects(),saved=S.portfolioDrafts.current||{title:'지원용 포트폴리오',intro:'',selected:[]},chosen=saved.selected.filter(function(id){return list.some(function(p){return p.id===id})});
  $('#app').innerHTML='<div class="career-ui"><h1>지원용 포트폴리오 구성</h1><p class="sub">내 프로젝트와 경험을 직접 고르고 순서를 정합니다. 근거 자료를 확인한 뒤 제출하세요.</p><label>제목<input class="field" id="packet-title" maxlength="2000" value="'+esc(saved.title)+'"></label><label>지원 직무에 맞춘 소개<textarea class="field" id="packet-intro" maxlength="20000">'+esc(saved.intro)+'</textarea></label><h2>포함할 프로젝트·경험</h2>'+list.map(function(p){return '<label><input type="checkbox" data-packet="'+esc(p.id)+'"'+(chosen.includes(p.id)?' checked':'')+'> '+esc(p.title)+'</label>'}).join('')+'<div class="row"><button class="btn" id="packet-save">구성 저장</button><button class="btn ghost" id="packet-print">인쇄 · PDF</button></div><p id="packet-state" role="status" class="small">소개문과 선택을 수정한 뒤 구성 저장을 누르세요.</p><h2>선택 순서</h2><div id="packet-order">'+chosen.map(function(id,i){var p=list.find(function(p){return p.id===id});return '<div class="row" style="margin:10px 0"><span>'+esc(p.title)+'</span><button class="btn sm ghost" data-up="'+i+'"'+(i?'':' disabled')+'>위로</button><button class="btn sm ghost" data-down="'+i+'"'+(i<chosen.length-1?'':' disabled')+'>아래로</button></div>'}).join('')+'</div></div>';
  function capture(){var checked=$$('[data-packet]:checked').map(function(b){return b.dataset.packet}),order=chosen.filter(function(id){return checked.includes(id)});checked.forEach(function(id){if(!order.includes(id))order.push(id)});return {title:$('#packet-title').value,intro:$('#packet-intro').value,selected:order,ts:stamp(saved.ts)}}
  function persist(value){S.portfolioDrafts.current=value;if(save()){packet();toast('포트폴리오 구성을 저장했습니다.')}else $('#packet-state').textContent='저장하지 못했습니다. 소개문을 복사해 보관하세요.'}
  $('#packet-save').onclick=function(){persist(capture())};
  $$('[data-up],[data-down]').forEach(function(b){b.onclick=function(){var x=capture(),i=Number(b.dataset.up||b.dataset.down),j=i+(b.hasAttribute('data-up')?-1:1);if(!x.selected[i]||!x.selected[j])return;var t=x.selected[i];x.selected[i]=x.selected[j];x.selected[j]=t;persist(x)}});
  $('#packet-print').onclick=function(){var x=capture();if(!x.selected.length){toast('프로젝트를 하나 이상 선택하세요.');return}var popup=window.open('','_blank');if(!popup){toast('인쇄 창을 열 수 없습니다. 팝업 허용을 확인하세요.');return}popup.document.write('<!doctype html><html lang="ko"><meta charset="utf-8"><title>'+esc(x.title)+'</title><style>body{font:15px/1.7 system-ui;max-width:850px;margin:40px auto;padding:20px;color:#16243a}section{break-inside:avoid;border-top:1px solid #ddd;margin-top:28px}p{white-space:pre-wrap;overflow-wrap:anywhere}@media print{button{display:none}body{margin:0}}</style><h1>'+esc(x.title)+'</h1><p>'+esc(x.intro)+'</p>'+x.selected.map(function(id){var p=list.find(function(p){return p.id===id});return '<section><h2>'+esc(p.title)+'</h2><p>'+esc(p.context)+'</p></section>'}).join('')+'<button onclick="window.print()">인쇄 · PDF 저장</button></html>');popup.document.close();popup.focus()};
 }
 window.addEventListener('pagehide',stop);return {sql:sql,defense:defense,packet:packet,stop:stop};
})();
