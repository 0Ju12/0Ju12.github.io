/* Audio stays in the user's browser. JSON progress backups do not contain these blobs. */
var OPIC_AUDIO=(function(){var memory=new Map(),dbPromise=null;
 function open(){if(!window.indexedDB)return Promise.reject(new Error('indexeddb'));if(!dbPromise)dbPromise=new Promise(function(resolve,reject){var r=indexedDB.open('interview-opic-audio-v1',1);r.onupgradeneeded=function(){var s=r.result.createObjectStore('recordings',{keyPath:'key'});s.createIndex('session','sessionId')};r.onsuccess=function(){resolve(r.result)};r.onerror=function(){dbPromise=null;reject(r.error)};r.onblocked=function(){dbPromise=null;reject(new Error('blocked'))}});return dbPromise}
 function put(row){memory.set(row.key,row);return open().then(function(db){return new Promise(function(ok,no){var tx=db.transaction('recordings','readwrite');tx.objectStore('recordings').put(row);tx.oncomplete=function(){ok('indexeddb')};tx.onerror=function(){no(tx.error)};tx.onabort=function(){no(tx.error)}})}).catch(function(){return 'memory'})}
 function list(id){return open().then(function(db){return new Promise(function(ok,no){var r=db.transaction('recordings').objectStore('recordings').index('session').getAll(id);r.onsuccess=function(){ok(r.result)};r.onerror=function(){no(r.error)}})}).then(function(rows){var map=new Map();rows.forEach(function(x){map.set(x.key,x)});memory.forEach(function(x){if(x.sessionId===id)map.set(x.key,x)});return Array.from(map.values()).sort(function(a,b){return a.index-b.index})}).catch(function(){return Array.from(memory.values()).filter(function(x){return x.sessionId===id}).sort(function(a,b){return a.index-b.index})})}
 function remove(id){memory.forEach(function(x,k){if(x.sessionId===id)memory.delete(k)});if(!window.indexedDB)return Promise.resolve();return open().then(function(db){return new Promise(function(ok,no){var tx=db.transaction('recordings','readwrite'),r=tx.objectStore('recordings').index('session').openCursor(IDBKeyRange.only(id));r.onsuccess=function(){var c=r.result;if(c){c.delete();c.continue()}};tx.oncomplete=ok;tx.onerror=function(){no(tx.error)}})})}
 return {put:put,list:list,remove:remove};})();
/* Small, uncompressed ZIP writer: owned recordings and a manifest, no CDN dependency. */
async function opicZip(rows,manifest){var table=new Uint32Array(256);for(var n=0;n<256;n++){var c=n;for(var k=0;k<8;k++)c=(c&1)?0xedb88320^(c>>>1):c>>>1;table[n]=c>>>0}var parts=[],central=[],offset=0,encoder=new TextEncoder();
 function crc(data){var c=0xffffffff;for(var i=0;i<data.length;i++)c=table[(c^data[i])&255]^(c>>>8);return (c^0xffffffff)>>>0}
 var files=[{name:'manifest.json',blob:new Blob([JSON.stringify(manifest,null,2)],{type:'application/json'})}].concat(rows.map(function(r){return {name:'answer-'+String(r.index+1).padStart(2,'0')+(r.blob.type.indexOf('mp4')>=0?'.m4a':r.blob.type.indexOf('ogg')>=0?'.ogg':'.webm'),blob:r.blob}}));
 var total=files.reduce(function(s,f){return s+f.blob.size},0);if(total>200*1024*1024)throw new Error('large');
 for(var f of files){var name=encoder.encode(f.name),bytes=new Uint8Array(await f.blob.arrayBuffer()),sum=crc(bytes),head=new Uint8Array(30+name.length),v=new DataView(head.buffer);v.setUint32(0,0x04034b50,true);v.setUint16(4,20,true);v.setUint16(6,0x800,true);v.setUint16(12,33,true);v.setUint32(14,sum,true);v.setUint32(18,bytes.length,true);v.setUint32(22,bytes.length,true);v.setUint16(26,name.length,true);head.set(name,30);parts.push(head,bytes);
 var cent=new Uint8Array(46+name.length),cv=new DataView(cent.buffer);cv.setUint32(0,0x02014b50,true);cv.setUint16(4,20,true);cv.setUint16(6,20,true);cv.setUint16(8,0x800,true);cv.setUint16(14,33,true);cv.setUint32(16,sum,true);cv.setUint32(20,bytes.length,true);cv.setUint32(24,bytes.length,true);cv.setUint16(28,name.length,true);cv.setUint32(42,offset,true);cent.set(name,46);central.push(cent);offset+=head.length+bytes.length;}
 var size=central.reduce(function(n,x){return n+x.length},0),end=new Uint8Array(22),ev=new DataView(end.buffer);ev.setUint32(0,0x06054b50,true);ev.setUint16(8,files.length,true);ev.setUint16(10,files.length,true);ev.setUint32(12,size,true);ev.setUint32(16,offset,true);return new Blob(parts.concat(central,[end]),{type:'application/zip'});}
function downloadOpicBlob(blob,name){var u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(function(){URL.revokeObjectURL(u)},5000)}
