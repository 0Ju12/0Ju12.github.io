/* Source freshness describes the packaged snapshot, never live private data. */
var releaseStatus='checking',latestRelease=null;
function displayTime(value){if(!value)return '확인일 없음';var d=new Date(value);return Number.isNaN(d.getTime())?String(value):d.toLocaleString('ko-KR',{timeZone:'Asia/Seoul'})+' (한국 시간)'}
function sourceAge(value){if(!value)return null;var d=new Date(value);if(Number.isNaN(d.getTime()))return null;return Math.max(0,Math.floor((Date.now()-d.getTime())/86400000))}
function freshnessHTML(){var m=D.metadata||{};return '<div class="card" style="margin:12px 0"><div class="row" style="justify-content:space-between"><span class="small muted">자료 빌드 · '+esc(displayTime(m.built_at))+'</span><a class="small" href="#/sources">자료 갱신 상태 확인 →</a></div><div id="release-status" class="small" role="status"></div></div>'}
function releaseMessage(){return releaseStatus==='new'?'새로 배포된 자료가 있습니다. 작성 중인 기록을 저장한 뒤 새로고침하세요.':releaseStatus==='current'?'현재 배포 버전과 일치합니다. 노션·공채 원문과 실시간 동기화하는 것은 아닙니다.':releaseStatus==='offline'?'최신 배포 상태를 확인하지 못했습니다. 현재 화면에 포함된 자료를 사용합니다.':'최신 배포 상태를 확인하고 있습니다…'}
function drawReleaseStatus(){var el=$('#release-status');if(!el)return;el.textContent=releaseMessage();if(releaseStatus==='new'){var b=document.createElement('button');b.className='btn sm ghost';b.textContent='저장하고 새 버전 열기';b.onclick=function(){if(save())location.reload()};el.appendChild(document.createTextNode(' '));el.appendChild(b)}}
function checkRelease(){releaseStatus='checking';drawReleaseStatus();return fetch('version.json',{cache:'no-store'}).then(function(r){if(!r.ok)throw new Error('version');return r.json()}).then(function(m){if(!m||typeof m.version!=='string')throw new Error('version');latestRelease=m;releaseStatus=m.version===(D.metadata||{}).version?'current':'new';drawReleaseStatus()}).catch(function(){releaseStatus='offline';drawReleaseStatus()})}
function sourcesView(){var m=D.metadata||{},sources=m.sources||[];var h='<h1>자료 갱신 상태</h1><p class="sub">이 앱은 배포 시 자료를 합칩니다. 원본의 변경은 다음 빌드·배포 후 반영됩니다.</p>'+freshnessHTML();h+='<div class="card"><p>현재 자료 버전 · <code>'+esc(m.version||'알 수 없음')+'</code></p><button class="btn ghost" id="check-release">최신 배포 다시 확인</button></div><h2>자료별 출처와 확인일</h2><div class="grid g2">';sources.forEach(function(s){var age=sourceAge(s.updated);h+='<article class="card"><b>'+esc(s.name)+'</b><p class="small">'+esc(s.description)+'</p><p class="muted small">'+esc(s.path)+'<br>확인·갱신일: '+esc(s.updated||'원본에 확인일 없음')+(age!==null?' · '+age+'일 전':'')+'</p>'+(age!==null&&age>7?'<p class="small" style="color:var(--mid)">확인일로부터 7일이 지났습니다. 지원 조건·마감은 공식 원문에서 다시 확인하세요.</p>':'')+'</article>'});h+='</div><div class="card" style="margin-top:16px"><b>분석·저장 방식 안내</b><p>답변 피드백은 길이·속도·반복 표현을 계산하는 규칙 기반 참고 지표입니다. AI 채점이나 OPIc 등급 판정이 아닙니다.</p><p class="small muted">음성 인식은 브라우저 제공자의 서버 처리가 포함될 수 있습니다. 앱이 저장하는 기록은 이 브라우저에 있으며 기기 간에는 암호 백업 파일로 합칩니다. 같은 브라우저의 여러 탭 변경은 자동으로 합칩니다.</p></div>';$('#app').innerHTML=h;$('#check-release').onclick=checkRelease;drawReleaseStatus()}
