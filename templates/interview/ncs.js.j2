/* ---------- NCS · 인적성 연습 ---------- */
function ri(a,b){return a+Math.floor(Math.random()*(b-a+1))}
function choices(ans,fmtf,spread){var set=[ans],guard=0;while(set.length<4&&guard++<50){var d=ans+(ri(1,4)*(Math.random()<.5?-1:1))*spread;d=Math.round(d*100)/100;if(d>0&&set.indexOf(d)<0)set.push(d)}while(set.length<4)set.push(ans+set.length*spread);return shuffle(set).map(function(v){return {v:v,t:fmtf(v)}})}
var GEN={
  speed:function(){var v1=ri(3,8)*10,v2=v1+ri(1,4)*10,t=ri(2,5),d=(v1+v2)*t;return {cat:'응용수리',q:'두 지점 사이 거리가 '+d+'km이다. A는 시속 '+v1+'km, B는 시속 '+v2+'km로 두 지점에서 서로를 향해 동시에 출발했다. 두 사람이 만나는 데 걸리는 시간은?',a:t,c:choices(t,function(x){return x+'시간'},1),ex:'만날 때까지 두 사람이 달린 거리의 합 = '+d+'km, 속력의 합 = '+(v1+v2)+'km/h → '+d+' ÷ '+(v1+v2)+' = '+t+'시간'}},
  conc:function(){var w1=ri(2,6)*50,p1=ri(2,8),w2=ri(2,6)*50,p2=ri(9,15),salt=w1*p1/100+w2*p2/100,ans=Math.round(salt/(w1+w2)*1000)/10;return {cat:'응용수리',q:p1+'% 소금물 '+w1+'g과 '+p2+'% 소금물 '+w2+'g을 섞었다. 섞은 소금물의 농도는? (소수 첫째 자리까지)',a:ans,c:choices(ans,function(x){return x+'%'},0.7),ex:'소금 = '+w1+'×'+p1+'% + '+w2+'×'+p2+'% = '+(Math.round(salt*10)/10)+'g, 전체 '+(w1+w2)+'g → '+ans+'%'}},
  work:function(){var a=[4,6,8,10,12][ri(0,4)],b=[6,8,12,15,24][ri(0,4)];if(a===b)b=a*2;var ans=Math.round(a*b/(a+b)*10)/10;return {cat:'응용수리',q:'어떤 일을 A가 혼자 하면 '+a+'일, B가 혼자 하면 '+b+'일 걸린다. 둘이 함께 하면 며칠 걸리는가? (소수 첫째 자리까지)',a:ans,c:choices(ans,function(x){return x+'일'},0.8),ex:'하루 일의 양 1/'+a+' + 1/'+b+' → '+a+'×'+b+' ÷ ('+a+'+'+b+') = '+ans+'일'}},
  price:function(){var c=ri(4,20)*1000,m=ri(2,5)*10,dc=ri(1,3)*10,sell=c*(1+m/100)*(1-dc/100),ans=Math.round(sell-c);return {cat:'응용수리',q:'원가 '+c.toLocaleString()+'원인 상품에 원가의 '+m+'%를 이익으로 붙여 정가를 정했다가, 정가의 '+dc+'%를 할인해 팔았다. 한 개를 팔 때 이익은?',a:ans,c:choices(ans,function(x){return Math.round(x).toLocaleString()+'원'},Math.max(100,Math.round(c*0.02/100)*100)),ex:'판매가 = '+c.toLocaleString()+' × '+(1+m/100)+' × '+(1-dc/100)+' = '+Math.round(sell).toLocaleString()+'원 → 이익 '+ans.toLocaleString()+'원'}},
  comb:function(){var n=ri(5,8),k=ri(2,3),f=function(x){return x<=1?1:x*f(x-1)},ans=f(n)/(f(k)*f(n-k));return {cat:'응용수리',q:'팀원 '+n+'명 중 발표자 '+k+'명을 뽑는 방법의 수는? (순서 상관없음)',a:ans,c:choices(ans,function(x){return x+'가지'},Math.max(2,Math.round(ans/6))),ex:n+'C'+k+' = '+ans}},
  table:function(){var base=ri(80,160)*10,ys=[2022,2023,2024,2025],vals=[base];for(var i=1;i<4;i++)vals.push(Math.round(vals[i-1]*(1+ri(-8,18)/100)));var j=ri(1,3),ans=Math.round((vals[j]-vals[j-1])/vals[j-1]*1000)/10;
    return {cat:'자료해석',q:'연도별 데이터 처리 건수가 다음과 같다. '+ys[j]+'년의 전년 대비 증가율은? (소수 첫째 자리까지)',tbl:[ys,vals],a:ans,c:choices(ans,function(x){return x+'%'},1.5),ex:'('+vals[j]+' − '+vals[j-1]+') ÷ '+vals[j-1]+' × 100 = '+ans+'%'}},
  share:function(){var items=['서울','부산','대전','광주'],v=items.map(function(){return ri(12,60)*10}),tot=v.reduce(function(a,b){return a+b},0),j=ri(0,3),ans=Math.round(v[j]/tot*1000)/10;
    return {cat:'자료해석',q:'지역별 지원자 수가 다음과 같다. 전체에서 '+items[j]+' 지원자가 차지하는 비율은? (소수 첫째 자리까지)',tbl:[items,v],a:ans,c:choices(ans,function(x){return x+'%'},2),ex:v[j]+' ÷ '+tot+' × 100 = '+ans+'%'}}
};
var LOGIC=[
  {q:'모든 데이터 엔지니어는 SQL을 쓴다. 어떤 SQL 사용자는 Python을 쓰지 않는다. 다음 중 반드시 참인 것은?',c:['모든 데이터 엔지니어는 Python을 쓴다','어떤 데이터 엔지니어는 Python을 쓰지 않는다','SQL을 쓰지 않는 사람은 데이터 엔지니어가 아니다','Python을 쓰는 사람은 모두 SQL을 쓴다'],a:2,ex:'"모든 A는 B"의 대우 "B가 아니면 A가 아니다"만 반드시 참입니다.'},
  {q:'A, B, C, D 네 명이 일렬로 앉는다. A는 B 바로 왼쪽, C는 맨 오른쪽, D는 B와 이웃하지 않는다. 맨 왼쪽에 앉은 사람은?',c:['A','B','C','D'],a:3,ex:'C가 맨 오른쪽이고 A-B가 붙어야 하므로 A B D C 또는 D A B C. D는 B와 이웃하면 안 되므로 D A B C → 맨 왼쪽은 D.'},
  {q:'"비가 오면 행사가 취소된다"가 참일 때, 반드시 참인 것은?',c:['행사가 취소되면 비가 온 것이다','비가 오지 않으면 행사가 열린다','행사가 열렸다면 비가 오지 않은 것이다','행사가 취소되지 않으면 비가 온다'],a:2,ex:'p→q 의 대우 ¬q→¬p 만 항상 참입니다.'},
  {q:'세 사람 중 한 명만 진실을 말한다. 갑: "을이 범인이다." 을: "나는 범인이 아니다." 병: "나는 범인이 아니다." 범인은? (범인은 한 명)',c:['갑','을','병','알 수 없음'],a:2,ex:'병이 범인이라고 두면 갑은 거짓, 을은 참, 병은 거짓 → 진실 1명으로 조건 충족. 갑·을이 범인인 경우는 진실이 2명이 됩니다.'},
  {q:'수열 2, 6, 12, 20, 30, ( ) 의 빈칸은?',c:['38','40','42','44'],a:2,ex:'차이가 4, 6, 8, 10, 12로 늘어남 → 30 + 12 = 42 (n(n+1) 꼴).'},
  {q:'수열 3, 5, 9, 17, 33, ( ) 의 빈칸은?',c:['49','57','63','65'],a:3,ex:'앞 수 × 2 − 1 → 33 × 2 − 1 = 65.'},
  {q:'어떤 프로젝트의 일정: 설계는 개발보다 먼저, 테스트는 개발 다음, 배포는 테스트 다음, 문서화는 설계 다음이고 배포보다 먼저다. 반드시 참인 것은?',c:['문서화는 개발보다 먼저다','설계가 가장 먼저다','테스트가 문서화보다 먼저다','개발이 두 번째다'],a:1,ex:'설계 → 개발 → 테스트 → 배포, 문서화는 설계 뒤·배포 앞. 모든 일보다 앞선 것은 설계뿐입니다.'},
  {q:'시계가 3시 30분을 가리킬 때 시침과 분침이 이루는 작은 각은?',c:['75°','80°','90°','105°'],a:0,ex:'분침 180°, 시침 90° + 30분×0.5° = 105° → 차이 75°.'},
  {q:'5명이 서로 한 번씩 악수하면 악수는 모두 몇 번?',c:['8','10','12','20'],a:1,ex:'5C2 = 10.'},
  {q:'A는 B보다 크고, C는 D보다 작으며, B는 D보다 크다. C와 A 중 큰 쪽은?',c:['A','C','같다','알 수 없음'],a:0,ex:'A > B > D > C 이므로 A가 큽니다.'},
  {q:'"데이터를 검증하지 않는 팀은 사고를 낸다. 우리 팀은 사고를 내지 않았다." 이로부터 알 수 있는 것은?',c:['우리 팀은 데이터를 검증했다','우리 팀은 운이 좋았다','사고를 낸 팀은 검증하지 않았다','검증하는 팀은 사고를 내지 않는다'],a:0,ex:'"검증하지 않으면 사고" 의 대우 "사고가 없으면 검증했다".'}
];
var ncsS=null;
function ncsMake(n){var g=Object.keys(GEN),out=[];for(var i=0;i<n;i++){if(i%3===2){var L=LOGIC[ri(0,LOGIC.length-1)];out.push({cat:'논리·추리',q:L.q,c:L.c.map(function(t,k){return {v:k,t:t}}),a:L.a,ex:L.ex})}else out.push(GEN[g[ri(0,g.length-1)]]())}return out}
function ncs(){
  if(ncsS&&ncsS.i<ncsS.qs.length)return ncsPlay();
  var h='<div class="hd"><div><span class="eyebrow">NCS · 인적성</span><h1 style="margin-top:6px">NCS · 인적성 연습</h1><p class="sub" style="margin:0">응용수리(속력·농도·일률·이익·경우의 수) · 자료해석(증가율·비율) · 논리·추리를 섞은 10문항입니다. 수리 문제는 매번 숫자가 새로 만들어집니다. 실제 시험(PSAT형·모듈형 등)은 기관마다 다르니 공고의 출제 유형을 확인하세요.</p></div><span class="row"><button class="btn" id="ngo">10문항 시작</button><a class="btn ghost" href="#/tools">← 도구</a></span></div>';
  if(S.ncs.length){var L=S.ncs.slice(-10);h+='<h2>최근 세트</h2><div class="card"><table style="width:100%;border-collapse:collapse;font-size:14px">'+L.slice().reverse().map(function(r){return '<tr><td style="padding:6px 0">'+esc(r.d)+'</td><td>'+r.ok+' / '+r.n+'</td><td>'+fmt(r.sec)+' (문항당 '+Math.round(r.sec/r.n)+'초)</td><td class="small muted">'+Object.keys(r.cat||{}).map(function(k){return k+' '+r.cat[k][0]+'/'+r.cat[k][1]}).join(' · ')+'</td></tr>'}).join('')+'</table></div>'}
  $('#app').innerHTML=h;$('#ngo').onclick=function(){ncsS={qs:ncsMake(10),i:0,res:[],t0:Date.now(),pick:null};ncsPlay()};
}
function ncsPlay(){var s=ncsS,q=s.qs[s.i];
  var h='<div class="q"><div class="row" style="justify-content:space-between"><span class="muted small">'+(s.i+1)+' / '+s.qs.length+' · '+esc(q.cat)+'</span><span class="muted small" id="nclk">'+fmt(Math.floor((Date.now()-s.t0)/1000))+'</span></div><div class="prompt" style="font-size:18px">'+esc(q.q)+'</div>';
  if(q.tbl)h+='<div class="card" style="overflow-x:auto;margin-bottom:12px;padding:10px 14px"><table style="width:100%;border-collapse:collapse;font-size:14px;text-align:center"><tr>'+q.tbl[0].map(function(x){return '<th style="padding:4px">'+esc(x)+'</th>'}).join('')+'</tr><tr>'+q.tbl[1].map(function(x){return '<td style="padding:4px">'+esc(Number(x).toLocaleString())+'</td>'}).join('')+'</tr></table></div>';
  h+='<div class="grid" style="gap:8px">'+q.c.map(function(c,k){var cls='';if(s.pick!=null){if(c.v===q.a)cls=' g-ok';else if(k===s.pick)cls=' g-bad'}return '<button class="ncs-o'+cls+'" data-k="'+k+'"'+(s.pick!=null?' disabled':'')+'>'+'①②③④'[k]+' '+esc(c.t)+'</button>'}).join('')+'</div>';
  if(s.pick!=null)h+='<div class="guide" style="margin-top:12px">'+esc(q.ex)+'</div><div class="row" style="justify-content:flex-end;margin-top:12px"><button class="btn" id="nnext">'+(s.i+1<s.qs.length?'다음':'결과 보기')+' →</button></div>';
  h+='<div class="row" style="margin-top:18px"><button class="btn ghost sm" id="nquit">그만하기</button></div></div>';
  $('#app').innerHTML=h;
  if(timer)clearInterval(timer);timer=setInterval(function(){var c=$('#nclk');if(c)c.textContent=fmt(Math.floor((Date.now()-s.t0)/1000))},1000);
  $$('[data-k]').forEach(function(b){b.onclick=function(){if(s.pick!=null)return;s.pick=+b.dataset.k;s.res.push(q.c[s.pick].v===q.a);ncsPlay()}});
  var nx=$('#nnext');if(nx)nx.onclick=function(){s.i++;s.pick=null;if(s.i<s.qs.length)ncsPlay();else ncsDone()};
  $('#nquit').onclick=function(){ncsS=null;ncs()};
  keyHandler=function(e){if(s.pick==null&&/^[1-4]$/.test(e.key)){var b=$('[data-k="'+(e.key-1)+'"]');if(b)b.click()}else if(s.pick!=null&&(e.key==='Enter'||e.key===' ')){e.preventDefault();if(nx)nx.click()}};
}
function ncsDone(){var s=ncsS,sec=Math.round((Date.now()-s.t0)/1000),cat={};s.qs.forEach(function(q,i){var c=cat[q.cat]||(cat[q.cat]=[0,0]);c[1]++;if(s.res[i])c[0]++});
  var ok=s.res.filter(Boolean).length;S.ncs.push({d:today(),n:s.qs.length,ok:ok,sec:sec,cat:cat});if(S.ncs.length>200)S.ncs=S.ncs.slice(-200);ncsS=null;wadd('apt',1);
  if(timer){clearInterval(timer);timer=null}
  $('#app').innerHTML='<div class="q"><h1>'+ok+' / '+s.qs.length+'</h1><p class="sub">'+fmt(sec)+' · 문항당 '+Math.round(sec/s.qs.length)+'초 · 이번 주 인적성 +1</p><div class="grid g3">'+Object.keys(cat).map(function(k){return '<div class="card kpi"><b>'+cat[k][0]+'/'+cat[k][1]+'</b><span>'+esc(k)+'</span></div>'}).join('')+'</div><div class="row" style="margin-top:18px"><button class="btn" id="nagain">한 세트 더</button><a class="btn ghost" href="#/tools">도구로</a></div></div>';
  $('#nagain').onclick=function(){ncsS={qs:ncsMake(10),i:0,res:[],t0:Date.now(),pick:null};ncsPlay()}}
