/* Original practice prompts. This is a transparent practice blueprint, not ACTFL's item-selection algorithm. */
var OPIC_TOPICS=[
{id:'home',ko:'집·거주지',noun:'your home',activity:'spending time at home',place:'your neighborhood',service:'a home repair appointment'},
{id:'study',ko:'학교·공부',noun:'a place where you study',activity:'studying or learning something new',place:'your school or study space',service:'a class registration'},
{id:'work',ko:'일·직장',noun:'a workplace you know',activity:'working on a project',place:'your workplace',service:'a meeting room reservation'},
{id:'music',ko:'음악',noun:'music you enjoy',activity:'listening to music',place:'a place where you listen to music',service:'a concert ticket reservation'},
{id:'movies',ko:'영화',noun:'a movie theater you like',activity:'watching movies',place:'a movie theater',service:'a movie ticket reservation'},
{id:'parks',ko:'공원',noun:'a park you know',activity:'visiting parks',place:'a park',service:'a park activity reservation'},
{id:'walking',ko:'걷기·조깅',noun:'a walking or jogging route you know',activity:'walking or jogging',place:'a walking trail',service:'a guided walking tour'},
{id:'travel',ko:'여행',noun:'a place you have visited or would like to visit',activity:'traveling',place:'a travel destination',service:'a hotel reservation'},
{id:'vacation',ko:'집에서 보내는 휴가',noun:'your ideal vacation at home',activity:'taking time off at home',place:'your neighborhood',service:'a local activity booking'},
{id:'cafes',ko:'카페',noun:'a cafe you know',activity:'visiting cafes',place:'a cafe',service:'a table reservation'},
{id:'cooking',ko:'요리',noun:'a meal you enjoy making',activity:'cooking',place:'a kitchen',service:'a cooking class reservation'},
{id:'shopping',ko:'쇼핑',noun:'a store you know',activity:'shopping',place:'a store',service:'an online order'},
{id:'exercise',ko:'운동',noun:'a sport or exercise you enjoy',activity:'exercising',place:'a gym or exercise space',service:'a fitness class registration'},
