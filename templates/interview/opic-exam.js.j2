/* OPIc-format independent simulator. Public procedure, original survey/prompts/UI, local audio only. */
var OX=null,opicClock=null,opicSpeech=null,opicSpeechDone=null,opicAudioURLs=[];
function opicRunning(){return OX&&['question','adjust','saving'].indexOf(OX.stage)>=0}
function opicHere(){return location.hash.split('/')[1]==='opic-exam'}
function opicVoice(){var voices=window.speechSynthesis?window.speechSynthesis.getVoices():[];return voices.filter(function(v){return v.voiceURI===(OX||{}).voice})[0]||voices.filter(function(v){return /^en[-_]/i.test(v.lang)})[0]||null}
function stopOpicSpeech(){if(opicSpeechDone)opicSpeechDone(false);if(window.speechSynthesis)window.speechSynthesis.cancel();opicSpeech=null;opicSpeechDone=null}
function speakOpic(text,onStart){stopOpicSpeech();if(!window.speechSynthesis||!window.SpeechSynthesisUtterance||!opicVoice())return Promise.resolve(false);
 return new Promise(function(resolve){var u=new SpeechSynthesisUtterance(text),finished=false,timeout;u.lang='en-US';u.voice=opicVoice();u.rate=1;u.volume=Number((OX||{}).volume||0.9);
 function done(ok){if(finished)return;finished=true;clearTimeout(timeout);if(opicSpeech===u){opicSpeech=null;opicSpeechDone=null}resolve(ok)}
 opicSpeech=u;opicSpeechDone=done;u.onstart=function(){if(onStart)onStart()};u.onend=function(){done(true)};u.onerror=function(){done(false)};timeout=setTimeout(function(){done(false);if(window.speechSynthesis)window.speechSynthesis.cancel()},90000);try{window.speechSynthesis.speak(u)}catch(_){done(false)}})
}
function newOpic(){stopOpicSpeech();if(OX&&OX.testURL)URL.revokeObjectURL(OX.testURL);if(OX&&OX.capture)OX.capture.stop();opicAudioURLs.forEach(function(u){URL.revokeObjectURL(u)});opicAudioURLs=[];OX={stage:'intro',mode:'strict',level:5,count:15,survey:{work:'',home:'',topics:[]},voice:'',volume:.9,audioOk:false,micOk:false,sampleOk:false,records:[],index:0,listens:0,phase:'ready',capture:createInterviewRecorder(window)};if(!Array.isArray(S.opicExams))S.opicExams=[];return OX}
function opicFrame(title,body,footer){return '<div class="ox-shell"><div class="ox-header"><div><b>SPEAKING SIMULATION</b><small>OPIc 형식 독립 연습 · 공식 시험 아님</small></div><span class="ox-clock" id="ox-clock">'+(opicRunning()?fmt(opicRemaining(OX.deadline)):OX.otDeadline?'OT '+fmt(opicRemaining(OX.otDeadline)):'ORIENTATION')+'</span></div><div class="ox-title"><h1>'+title+'</h1></div>'+body+(footer?'<div class="ox-footer">'+footer+'</div>':'')+'</div>'}
function opicRender(){if(opicHere())opicExam()}
function opicTick(){if(opicClock)clearInterval(opicClock);opicClock=setInterval(function(){if(!OX)return;var running=opicRunning(),deadline=running?OX.deadline:OX.otDeadline,el=$('#ox-clock');if(el&&deadline)el.textContent=(running?'':'OT ')+fmt(opicRemaining(deadline));if(running&&opicRemaining(OX.deadline)===0)finishOpic('timeout')},250)}
function opicExam(){if(!OX)newOpic();document.body.classList.toggle('opic-room',opicRunning());
 if(OX.stage==='intro')return opicIntro();if(OX.stage==='survey')return opicSurvey();if(OX.stage==='level')return opicAssessment();if(OX.stage==='devices')return opicDevices();if(OX.stage==='sample')return opicSample();if(OX.stage==='question'||OX.stage==='saving')return opicQuestion();if(OX.stage==='adjust')return opicAdjust();if(OX.stage==='result')return opicResults();}
function opicIntro(){var h='<div class="card"><h2 style="margin-top:0">취업 면접과 다른 시험 흐름</h2><div class="grid g3"><div><b>오리엔테이션 약 20분</b><p>배경 설문 → 자기평가 → 소리·녹음 확인 → 샘플 질문</p></div><div><b>본시험 전체 40분</b><p>문항별 강제 종료 없음 · 질문 2회까지 청취 · 1차 세션 후 난이도 재선택</p></div><div><b>종료 후 복습</b><p>시험 중 답안·받아쓰기·자기채점 숨김 · 종료 후 문항별 녹음 재생·다운로드</p></div></div><div class="guide">국내 공식 안내의 공개 절차를 반영했습니다. 설문 항목·난이도 설명·문항 조합은 연습용 모형이며, 공식 문항·음성·채점·비공개 출제 로직과 동일하지 않습니다. 이 앱은 공식 성적이나 예상 등급을 부여하지 않습니다.</div><p class="small muted">실전 모드는 영어 음성과 마이크 점검을 통과해야 시작합니다. 브라우저 영어 음성이 없으면 OS의 영어 음성을 설치하거나 다른 브라우저를 사용하세요. 텍스트 학습 모드도 별도로 제공합니다.</p><p class="small muted">화면 배치는 <a href="https://www.hrsa.gov/sites/default/files/hrsa/advisory-committees/national-health-service-corps/quinlan-son-language-test-international-nacnhsc-meeting-2024.pdf" target="_blank" rel="noopener">LTI 공개 소개 자료(2024, 22쪽)</a>를 참고했습니다. 현재 국내 시험장 UI의 완전한 복제는 아니며, 인터뷰어 그림과 질문 음성은 독자적인 연습용입니다.</p><label class="row"><input type="checkbox" id="ox-study"'+(OX.mode==='study'?' checked':'')+'> 텍스트 학습 모드 (질문 글 표시·녹음 선택, 실전 모드 아님)</label></div>';
 h+='<div class="card" style="margin-top:15px"><b>공식 근거와 차이</b><p class="small"><a href="https://www.opic.co.kr/opics/servlet/controller.opic.site.about.AboutServlet?p_process=move-introduce-opic" target="_blank" rel="noopener">국내 공식 진행 절차 ↗</a> · <a href="https://www.actfl.org/assessments/postsecondary-assessments/oral-proficiency-interview-computer-opic" target="_blank" rel="noopener">ACTFL 안내 ↗</a></p><p class="small muted">12·15문항 길이는 연습 설정입니다. 7문항 뒤 조정하며, 실제 문항수 결정 공식과 동일하다고 주장하지 않습니다. ‘이전 문항으로 돌아가지 않기’와 본시험 중 일시정지 금지는 집중 연습을 위한 시뮬레이터 규칙입니다. 녹음은 서버로 보내지 않고 이 브라우저의 IndexedDB에 보관합니다. JSON 기록 백업에는 녹음 파일이 포함되지 않습니다.</p></div>';
 if((S.opicExams||[]).length)h+='<h2>저장된 OPIc 형식 연습</h2><div class="grid">'+S.opicExams.slice(-10).reverse().map(function(s){return '<div class="card row" style="justify-content:space-between"><span>'+esc(s.date)+' · '+s.answers.length+'/'+s.count+'문항 · '+esc(s.status)+'</span><button class="btn ghost sm" data-ox-history="'+esc(s.id)+'">녹음 복습</button></div>'}).join('')+'</div>';
 $('#app').innerHTML=opicFrame('OPIc 형식 모의시험',h,'<a class="btn ghost" href="#/mock">취업 면접 연습</a><button class="btn" id="ox-begin-ot">오리엔테이션 시작 →</button>');$('#ox-study').onchange=function(e){OX.mode=e.target.checked?'study':'strict'};$('#ox-begin-ot').onclick=function(){OX.otDeadline=Date.now()+20*60*1000;OX.stage='survey';opicTick();opicRender()};$$('[data-ox-history]').forEach(function(b){b.onclick=function(){var saved=S.opicExams.find(function(s){return s.id===b.dataset.oxHistory});if(saved){OX.saved=saved;OX.stage='result';opicRender()}}});}
function opicSurvey(){var e=OX;var body='<div class="card"><p>본인의 실제 배경과 이야기할 수 있는 주제를 선택하세요. 아래는 원문 설문을 복제한 것이 아닌 간소화한 연습 설문입니다.</p><div class="grid g2"><label>하는 일<select class="field" id="ox-work"><option value="">선택하세요</option><option value="student">학생·교육 수강</option><option value="employed">직장인</option><option value="other">기타·일 경험 없음</option></select></label><label>주거 배경<select class="field" id="ox-home"><option value="">선택하세요</option><option value="alone">혼자 거주</option><option value="family">가족·다른 사람과 거주</option><option value="other">기타</option></select></label></div><h2>관심 주제</h2><p class="small muted">연습용으로 세 개 이상 선택하세요. 실제 설문 항목·선택 요건과 다를 수 있습니다. 선택하지 않은 생활 경험을 본인 사실로 가정하지 않습니다.</p><div class="ox-topics">'+OPIC_TOPICS.map(function(t){return '<label><input type="checkbox" value="'+t.id+'" data-ox-topic'+(e.survey.topics.includes(t.id)?' checked':'')+'> '+esc(t.ko)+'</label>'}).join('')+'</div><p id="ox-survey-error" role="status" class="small"></p></div>';
 $('#app').innerHTML=opicFrame('1. Background Survey',body,'<button class="btn" id="ox-to-level">다음 →</button>');$('#ox-work').value=e.survey.work;$('#ox-home').value=e.survey.home;$('#ox-to-level').onclick=function(){var topics=$$('[data-ox-topic]:checked').map(function(x){return x.value});if(!$('#ox-work').value||!$('#ox-home').value||topics.length<3){$('#ox-survey-error').textContent='배경 두 항목과 관심 주제 세 개 이상을 선택해주세요.';return}e.survey={work:$('#ox-work').value,home:$('#ox-home').value,topics:topics};e.stage='level';opicRender()};}
function opicAssessment(){var levels=['단어 중심으로 짧게 말하는 연습','사람·사물의 기본 정보를 말하는 연습','익숙한 일상을 간단한 문장으로 설명','친숙한 주제의 경험·이유를 이어서 설명','시제·비교·예상 밖 상황까지 연결해 설명','다른 관점·가정·문제 해결까지 자세히 논의'];var body='<div class="card"><p>본인의 현재 실력에 가까운 연습 난이도를 선택하세요. 아래 설명은 독자적인 연습용 요약이며 공식 음성 샘플·등급과의 일대일 대응이 아닙니다.</p><div class="grid">'+levels.map(function(t,i){return '<label class="ox-level"><input type="radio" name="ox-level" value="'+(i+1)+'"'+(OX.level===i+1?' checked':'')+'> <b>'+(i+1)+'</b> '+esc(t)+'</label>'}).join('')+'</div><h2>연습 길이</h2><select id="ox-count" class="field"><option value="15">15문항 · 기본 연습</option><option value="12">12문항 · 다른 길이 연습</option></select><p class="small muted">두 길이 모두 본시험 제한은 40분입니다. 난이도별 실제 문항수 배정은 비공개이므로 이 설정으로 동일하게 재현했다고 주장하지 않습니다.</p></div>';
 $('#app').innerHTML=opicFrame('2. Self Assessment',body,'<button class="btn ghost" id="ox-back-survey">설문 수정</button><button class="btn" id="ox-to-devices">다음 →</button>');$('#ox-count').value=String(OX.count);$('#ox-back-survey').onclick=function(){OX.stage='survey';opicRender()};$('#ox-to-devices').onclick=function(){OX.level=Number($('[name="ox-level"]:checked').value);OX.count=Number($('#ox-count').value);OX.stage='devices';opicRender()};}
function opicDevices(){var voices=window.speechSynthesis?window.speechSynthesis.getVoices().filter(function(v){return /^en[-_]/i.test(v.lang)}):[];if(!OX.voice&&voices[0])OX.voice=voices[0].voiceURI;var body='<div class="grid g2"><div class="card"><h2 style="margin-top:0">헤드폰·질문 음성</h2><p class="small muted">브라우저의 영어 TTS를 사용합니다. 공식 음성이 아닙니다. 헤드폰을 권장합니다.</p><select class="field" id="ox-voice">'+(voices.length?voices.map(function(v){return '<option value="'+esc(v.voiceURI)+'">'+esc(v.name)+' · '+esc(v.lang)+'</option>'}).join(''):'<option value="">영어 음성 없음</option>')+'</select><label class="small">볼륨<input id="ox-volume" type="range" min="0.1" max="1" step="0.1" value="'+OX.volume+'" style="width:100%"></label><button class="btn ghost" id="ox-audio-test"'+(!voices.length?' disabled':'')+'>시험 음성 확인</button><p class="small" id="ox-audio-status" role="status">'+(OX.audioOk?'음성 재생 완료':'음성을 확인하세요.')+'</p>'+(voices.length?'':'<p class="small">영어 음성이 없는 브라우저에서는 실전 모드를 시작할 수 없습니다. OS 영어 음성 설치 후 다시 열거나, 첫 화면에서 텍스트 학습 모드를 선택하세요.</p><button class="btn ghost sm" id="ox-refresh-voices">음성 목록 새로고침</button>')+'</div><div class="card"><h2 style="margin-top:0">마이크 녹음·재생</h2><p class="small muted">본시험에서 답변마다 자동 녹음합니다. 테스트 녹음은 직접 재생해 소리가 들리는지 확인해주세요.</p><div class="row"><button class="btn" id="ox-mic-test">테스트 녹음 시작</button><button class="btn ghost" id="ox-mic-stop" disabled>녹음 끝</button></div><p id="ox-mic-status" class="small" role="status">'+(OX.micOk?'마이크 테스트 완료':'브라우저 마이크 권한이 필요합니다.')+'</p><div id="ox-mic-playback"></div></div></div>';
 $('#app').innerHTML=opicFrame('3. Pre-Test Setup',body,'<button class="btn" id="ox-to-sample">샘플 질문 →</button>');$('#ox-voice').value=OX.voice;$('#ox-voice').onchange=function(e){OX.voice=e.target.value;OX.audioOk=false};$('#ox-volume').oninput=function(e){OX.volume=Number(e.target.value)};if($('#ox-refresh-voices'))$('#ox-refresh-voices').onclick=opicRender;
 $('#ox-audio-test').onclick=async function(){OX.audioOk=false;$('#ox-audio-status').textContent='재생 중…';var ok=await speakOpic('This is an audio check for your speaking practice. Please check your headphone volume.');if(OX.stage!=='devices'||!opicHere())return;OX.audioOk=ok;$('#ox-audio-status').textContent=ok?'재생 완료. 소리가 들렸다면 계속하세요.':'음성을 재생하지 못했습니다. 음성 설정을 확인하세요.'};
 $('#ox-mic-test').onclick=async function(){var token=OX;token.micOk=false;this.disabled=true;$('#ox-mic-status').textContent='마이크 연결 중…';try{var ok=await token.capture.start();if(OX!==token||token.stage!=='devices'||!opicHere())return;if(!ok)throw new Error('unsupported');$('#ox-mic-status').textContent='녹음 중입니다. 짧게 말한 뒤 녹음 끝을 누르세요.';$('#ox-mic-stop').disabled=false}catch(_){if($('#ox-mic-status'))$('#ox-mic-status').textContent='마이크를 사용할 수 없습니다. 브라우저·OS 권한과 HTTPS 연결을 확인하세요.';if($('#ox-mic-test'))$('#ox-mic-test').disabled=false}};
 $('#ox-mic-stop').onclick=async function(){this.disabled=true;var token=OX,blob=await token.capture.stop();if(OX!==token||token.stage!=='devices'||!opicHere())return;$('#ox-mic-test').disabled=false;if(!blob||!blob.size){$('#ox-mic-status').textContent='녹음된 데이터가 없습니다. 다시 확인하세요.';return}if(token.testURL)URL.revokeObjectURL(token.testURL);token.testURL=URL.createObjectURL(blob);$('#ox-mic-playback').innerHTML='<audio controls src="'+token.testURL+'" style="width:100%"></audio><label class="row small"><input type="checkbox" id="ox-heard"> 내 목소리가 들리는 것을 확인했습니다.</label>';$('#ox-heard').onchange=function(e){token.micOk=e.target.checked};$('#ox-mic-status').textContent='재생해서 녹음 품질을 확인하세요.'};
 $('#ox-to-sample').onclick=function(){if(OX.mode==='strict'&&(!OX.audioOk||!OX.micOk)){toast('실전 모드는 음성과 마이크 재생 확인이 필요합니다.');return}OX.capture.stop();stopOpicSpeech();OX.stage='sample';opicRender()};}
function opicSample(){var body='<div class="ox-room"><div class="ox-partner"><div class="ox-avatar" aria-hidden="true"><span class="ox-head"></span><span class="ox-shoulders"></span></div><b>Speaking Partner</b><small>독자적인 연습 인터뷰어</small></div><div class="card"><h2 style="margin-top:0">4. Sample Question</h2><p>Tell me about something you enjoy doing in your free time.</p><button class="btn ghost" id="ox-sample-play">샘플 질문 듣기</button><p id="ox-sample-status" role="status" class="small"></p><p class="small muted">여기서는 화면과 청취 방법을 확인합니다. 본시험에서는 자동으로 녹음이 시작되고, Next를 누르면 이전 문항으로 돌아갈 수 없습니다. 질문은 최대 두 번 듣고, 본시험 전체 40분 안에서 답변 시간을 스스로 배분합니다. 본시험에는 문항별 1분·2분 자동 종료가 없습니다.</p><label class="row small"><input type="checkbox" id="ox-fullscreen"> 본시험을 전체화면으로 열기</label><div class="guide">실전 모드는 질문 글·모범 답변·받아쓰기·자가채점을 시험 종료 전까지 숨깁니다. 새로고침하면 현재 문항의 녹음은 유실될 수 있고, 저장 완료한 문항만 복습할 수 있습니다. 녹음 파일은 별도 다운로드로 보관하세요.</div></div></div>';
 $('#app').innerHTML=opicFrame('연습 안내',body,'<button class="btn ghost" id="ox-back-devices">장치 다시 확인</button><button class="btn" id="ox-start-exam">40분 본시험 시작</button>');$('#ox-sample-play').onclick=async function(){var ok=await speakOpic('Tell me about something you enjoy doing in your free time.');if($('#ox-sample-status'))$('#ox-sample-status').textContent=ok?'샘플 재생 완료':'음성 재생 실패';OX.sampleOk=ok};$('#ox-back-devices').onclick=function(){stopOpicSpeech();OX.stage='devices';opicRender()};$('#ox-start-exam').onclick=function(){if(OX.mode==='strict'&&(!OX.sampleOk||!OX.audioOk||!OX.micOk)){toast('음성·마이크와 샘플 질문을 확인해주세요.');return}if($('#ox-fullscreen').checked&&document.documentElement.requestFullscreen)document.documentElement.requestFullscreen().catch(function(){});stopOpicSpeech();OX.plan=makeOpicPlan(OX.survey,OX.level,OX.count);OX.sessionId='opic-'+Date.now()+'-'+Math.random().toString(36).slice(2,8);OX.deadline=Date.now()+40*60*1000;OX.startedAt=Date.now();OX.stage='question';OX.index=0;OX.records=[];opicTick();prepareOpicQuestion()};}
function prepareOpicQuestion(){OX.listens=0;OX.phase='ready';OX.recState='none';OX.answerSeconds=0;OX.answerStart=null;OX.questionStart=Date.now();OX.stage='question';opicRender();if(OX.mode==='strict')playOpicPrompt();}
