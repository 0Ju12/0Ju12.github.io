/* ---------- OPIc 답변 분석 (브라우저 음성 인식) ---------- */
var SR=window.SpeechRecognition||window.webkitSpeechRecognition,recog=null;
var FILLERS=['um','uh','erm','like','you know','i mean','kind of','sort of','actually','basically'];
var speechEpoch=0;
function srStart(m,lang){srStop();if(!SR)return;var epoch=++speechEpoch;try{var current=new SR();recog=current;current.lang=lang||'en-US';current.continuous=true;current.interimResults=true;m.tr='';m.tri='';
  current.onresult=function(e){if(epoch!==speechEpoch)return;var fin='',tmp='';for(var i=e.resultIndex;i<e.results.length;i++){var result=e.results[i];if(result.isFinal)fin+=result[0].transcript+' ';else tmp+=result[0].transcript}m.tr+=fin;m.tri=tmp;var el=$('#live');if(el)el.textContent=(m.tr+m.tri).slice(-220)};
  current.onerror=function(e){if(e.error==='not-allowed'||e.error==='service-not-allowed'){current.onend=null;if(recog===current)recog=null;toast('음성 인식 권한을 사용할 수 없습니다. 받아쓰기 없이 진행합니다.')}};
  current.onend=function(){if(epoch===speechEpoch&&m.st==='talk'&&recog===current){try{current.start()}catch(_){}}};current.start()}catch(_){recog=null}}
function srStop(){var current=recog;recog=null;if(!current)return Promise.resolve();
  return new Promise(function(resolve){var finished=false,timeout;function done(){if(finished)return;finished=true;clearTimeout(timeout);current.onresult=null;current.onend=null;current.onerror=null;resolve()}
    current.onend=done;current.onerror=done;timeout=setTimeout(done,2000);try{current.stop()}catch(_){done()}})}
function analyze(text,sec){var t=(text||'').toLowerCase().replace(/[^a-z'\s]/g,' ').replace(/\s+/g,' ').trim(),w=t?t.split(' '):[];
  var fill={};FILLERS.forEach(function(f){var m=(' '+t+' ').split(' '+f+' ').length-1;if(m)fill[f]=m});
  var tri={};for(var i=0;i+2<w.length;i++){var k=w[i]+' '+w[i+1]+' '+w[i+2];tri[k]=(tri[k]||0)+1}
  var rep=Object.keys(tri).filter(function(k){return tri[k]>1}).sort(function(a,b){return tri[b]-tri[a]}).slice(0,5).map(function(k){return [k,tri[k]]});
  var uniq={};w.forEach(function(x){uniq[x]=1});
  var past=(t.match(/\b(\w+ed|was|were|went|had|did|saw|took|made|got|came|felt|thought)\b/g)||[]).length;
  var conn=(t.match(/\b(because|so|however|but|and then|after that|first|finally|also|although|while|when)\b/g)||[]).length;
  return {words:w.length,sec:sec||0,wpm:sec?Math.round(w.length/(sec/60)):0,fill:fill,fn:Object.keys(fill).reduce(function(a,k){return a+fill[k]},0),rep:rep,lex:w.length?Math.round(Object.keys(uniq).length/w.length*100):0,past:past,conn:conn}}
function analysisHTML(a){if(!a.words)return '<p class="muted small">받아 적은 말이 없습니다. 마이크 권한과 브라우저(Chrome·Edge·Safari)를 확인하세요.</p>';
  var tip=[];if(a.wpm&&a.wpm<90)tip.push('말이 느린 편입니다. 문장을 짧게 끊고 연결어로 이어 보세요.');if(a.words<120&&a.sec>=90)tip.push('IH는 문단 단위 답변이 필요합니다. 예시·이유를 하나 더 붙여 길이를 늘리세요.');
  if(a.fn>=5)tip.push('군말이 많습니다. 생각할 때는 "Let me think…" 같은 정해진 표현을 쓰세요.');if(a.conn<3)tip.push('연결어(because, after that, however)를 더 쓰면 문단처럼 들립니다.');if(a.rep.length)tip.push('같은 표현이 반복됩니다: "'+a.rep[0][0]+'"');
  return '<div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:8px;margin-top:10px">'+[['단어',a.words],['분당 단어',a.wpm||'—'],['군말',a.fn],['어휘 다양성',a.lex+'%'],['연결어',a.conn],['과거형',a.past]].map(function(x){return '<div class="card kpi" style="padding:10px 12px"><b style="font-size:20px">'+x[1]+'</b><span>'+x[0]+'</span></div>'}).join('')+'</div>'+
    (tip.length?'<ul class="tails" style="margin-top:10px">'+tip.map(function(t){return '<li>'+esc(t)+'</li>'}).join('')+'</ul>':'<p class="small" style="color:var(--ok);margin-top:10px">길이·속도·연결어 모두 무난합니다.</p>')+
    '<p class="faint small">자동 받아쓰기는 발음에 따라 틀릴 수 있어 참고용입니다. 기준(분당 단어 등)은 연습 목표로 잡은 값이며 OPIc 공식 채점 기준이 아닙니다.</p>'}
function opicView(){
  var h='<div class="hd"><div><span class="eyebrow">OPIc</span><h1 style="margin-top:6px">OPIc 답변 분석</h1><p class="sub" style="margin:0">OPIc 모의 면접에서 [답변 시작]을 누르면 녹음과 함께 영어 받아쓰기가 켜지고, 답변이 끝나면 길이·속도·군말·반복 표현을 보여 줍니다.'+(SR?'':' <b>이 브라우저는 음성 받아쓰기를 지원하지 않습니다 (Chrome·Edge·Safari 권장).</b>')+'</p></div><span class="row"><button class="btn" id="og">OPIc 실전 15문항</button><a class="btn ghost" href="#/tools">← 도구</a></span></div>';
  if(!S.opic.length)h+='<div class="card empty">아직 분석한 답변이 없습니다.</div>';
  else{var L=S.opic.slice(-40),avg=function(k){return Math.round(L.reduce(function(a,x){return a+(x[k]||0)},0)/L.length)};
    h+='<div class="grid g4"><div class="card kpi"><b>'+S.opic.length+'</b><span>분석한 답변</span></div><div class="card kpi"><b>'+avg('wpm')+'</b><span>평균 분당 단어 (최근 40)</span></div><div class="card kpi"><b>'+avg('words')+'</b><span>평균 단어 수</span></div><div class="card kpi"><b>'+avg('fn')+'</b><span>평균 군말</span></div></div>';
    h+='<h2>최근 답변</h2><div class="grid">'+S.opic.slice(-12).reverse().map(function(o){return '<details class="card qcard"><summary><b>'+esc(o.q)+'</b><span class="tag">'+esc(o.d)+'</span><span class="tag">'+o.words+'단어 · '+(o.wpm||'—')+'wpm</span></summary><div class="qbody"><div class="ans">'+esc(o.text)+'</div>'+analysisHTML(o)+'</div></details>'}).join('')+'</div>'}
  $('#app').innerHTML=h;$('#og').onclick=startOpic;
}

/* ---------- 국문 면접 답변 말하기 분석 (ko-KR 받아쓰기) ---------- */
var KFILL=['음','어','그','저','약간','뭔가','이제','그러니까','사실','좀','막','그냥','일단'],spk=null;
function kAnalyze(text,sec){var t=(text||'').replace(/\s+/g,' ').trim(),w=t?t.split(' '):[],syl=t.replace(/[^가-힣a-zA-Z0-9]/g,'').length;
  var fill={};KFILL.forEach(function(f){var n=w.filter(function(x){return x===f||x===f+','||x===f+'…'}).length;if(n)fill[f]=n});
  var bi={};for(var i=0;i+1<w.length;i++){var k=w[i]+' '+w[i+1];bi[k]=(bi[k]||0)+1}
  var rep=Object.keys(bi).filter(function(k){return bi[k]>1&&k.length>3}).sort(function(a,b){return bi[b]-bi[a]}).slice(0,4).map(function(k){return [k,bi[k]]});
  var end=(t.match(/(습니다|입니다|했습니다|있습니다|됩니다|어요|해요|죠)(?=[ .?!]|$)/g)||[]).length,sent=Math.max(1,(t.match(/(다|요|죠)[.?!]?(\s|$)/g)||[]).length);
  var first=w.slice(0,25).join(' '),concl=/(저는|제가|결론|핵심|한마디로|이유는|두 가지|세 가지)/.test(first);
  return {chars:syl,words:w.length,sec:sec||0,spm:sec?Math.round(syl/(sec/60)):0,fill:fill,fn:Object.keys(fill).reduce(function(a,k){return a+fill[k]},0),rep:rep,end:end,sent:sent,avgLen:Math.round(syl/sent),concl:concl}}
function kAnalysisHTML(a){if(!a.chars)return '<p class="muted small">받아 적은 말이 없습니다. 마이크 권한과 브라우저(Chrome·Edge·Safari)를 확인하세요.</p>';
  var tip=[];if(a.sec&&a.sec<40)tip.push('40초보다 짧습니다. 경험 하나와 결과 수치를 붙여 60~90초로 늘려 보세요.');if(a.sec>120)tip.push('2분을 넘었습니다. 결론 → 근거 1~2개 → 마무리로 줄여 보세요.');
  if(a.spm&&a.spm>380)tip.push('말이 빠른 편입니다. 문장 끝에서 한 박자 쉬어 보세요.');if(a.spm&&a.spm<220)tip.push('말이 느린 편입니다. 문장을 짧게 끊고 이어 말해 보세요.');
  if(a.fn>=4)tip.push('군말('+Object.keys(a.fill).slice(0,3).join(', ')+')이 '+a.fn+'번 나왔습니다. 생각할 땐 잠깐 멈추는 편이 낫습니다.');if(!a.concl)tip.push('첫머리에 결론이 잘 안 보입니다. "저는 ~입니다 / 이유는 두 가지입니다"로 시작해 보세요.');
  if(a.avgLen>90)tip.push('한 문장이 깁니다(평균 '+a.avgLen+'음절). 두 문장으로 나눠 보세요.');if(a.rep.length)tip.push('반복 표현: "'+a.rep[0][0]+'" '+a.rep[0][1]+'번');
  return '<div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:8px;margin-top:10px">'+[['말한 시간',a.sec+'초'],['분당 음절',a.spm||'—'],['군말',a.fn],['문장',a.sent],['평균 문장 길이',a.avgLen+'음절'],['결론 먼저',a.concl?'예':'아니오']].map(function(x){return '<div class="card kpi" style="padding:10px 12px"><b style="font-size:20px">'+x[1]+'</b><span>'+x[0]+'</span></div>'}).join('')+'</div>'+
    (tip.length?'<ul class="tails" style="margin-top:10px">'+tip.map(function(t){return '<li>'+esc(t)+'</li>'}).join('')+'</ul>':'<p class="small" style="color:var(--ok);margin-top:10px">길이·속도·구성이 무난합니다.</p>')+
    '<p class="faint small">자동 받아쓰기는 참고용이라 틀릴 수 있습니다. 분당 음절 기준(220~380)과 60~90초는 연습 목표로 잡은 값입니다.</p>'}
function speak(){var pool=QS.filter(function(q){return q.c!=='OPIc'&&q.kind!=='opic'});
  if(!pool.length){$('#app').innerHTML='<h1>면접 답변 말하기 분석</h1><p>연습할 질문이 아직 없습니다.</p>';return}
  if(!spk||!spk.q)spk={q:pool[Math.floor(Math.random()*pool.length)],st:'ready'};var m=spk;
  var h='<div class="hd"><div><span class="eyebrow">Speaking</span><h1 style="margin-top:6px">면접 답변 말하기 분석</h1><p class="sub" style="margin:0">질문을 소리 내어 답하면 한국어로 받아 적고, 말한 시간·속도·군말·결론 먼저 여부를 짚어 줍니다.'+(SR?'':' <b>이 브라우저는 음성 받아쓰기를 지원하지 않습니다 (Chrome·Edge·Safari 권장).</b>')+'</p></div><a class="btn ghost" href="#/tools">← 도구</a></div>';
  h+='<div class="card hero"><span class="tag">'+esc(m.q.c)+'</span><h2 style="margin:8px 0 12px">'+esc(m.q.q)+'</h2>';
  if(m.st==='ready')h+='<div class="row"><button class="btn" id="kgo"'+(SR?'':' disabled')+'>답변 시작</button><button class="btn ghost" id="knew">다른 질문</button></div>';
  else if(m.st==='finishing')h+='<p role="status">마지막 받아쓰기를 기다리고 있습니다…</p>';
  else if(m.st==='talk')h+='<div class="row"><b id="kclock" style="font-variant-numeric:tabular-nums">0:00</b><button class="btn" id="kend">답변 끝</button></div><p class="small muted" id="live" style="min-height:3em;margin-top:10px"></p>';
  else h+='<div class="ans">'+esc(m.text||'')+'</div>'+kAnalysisHTML(m.an)+'<div class="row" style="margin-top:12px"><button class="btn" id="knew">다음 질문</button><button class="btn ghost" id="kagain">같은 질문 다시</button></div>';
  h+='</div>';var L=(S.speak||[]);
  if(L.length){var avg=function(k){return Math.round(L.slice(-30).reduce(function(a,x){return a+(x[k]||0)},0)/Math.min(30,L.length))};
    h+='<h2>기록</h2><div class="grid g4"><div class="card kpi"><b>'+L.length+'</b><span>분석한 답변</span></div><div class="card kpi"><b>'+avg('sec')+'초</b><span>평균 길이</span></div><div class="card kpi"><b>'+avg('spm')+'</b><span>평균 분당 음절</span></div><div class="card kpi"><b>'+avg('fn')+'</b><span>평균 군말</span></div></div>'+
    '<div class="grid" style="margin-top:12px">'+L.slice(-10).reverse().map(function(o){return '<details class="card qcard"><summary><b>'+esc(o.q)+'</b><span class="tag">'+esc(o.d)+'</span><span class="tag">'+o.sec+'초 · 군말 '+o.fn+'</span></summary><div class="qbody"><div class="ans">'+esc(o.text)+'</div>'+kAnalysisHTML(o)+'</div></details>'}).join('')+'</div>'}
  $('#app').innerHTML=h;
  var go=$('#kgo');if(go)go.onclick=function(){m.st='talk';m.t0=Date.now();srStart(m,'ko-KR');speak();timer=setInterval(function(){var c=$('#kclock');if(!c)return;var s=Math.round((Date.now()-m.t0)/1000);c.textContent=Math.floor(s/60)+':'+String(s%60).padStart(2,'0')},500)};
  var en=$('#kend');if(en)en.onclick=async function(){if(m.st!=='talk')return;clearInterval(timer);timer=null;var sec=Math.round((Date.now()-m.t0)/1000);m.st='finishing';speak();await srStop();if(spk!==m||location.hash!=='#/speak')return;m.text=((m.tr||'')+' '+(m.tri||'')).trim();m.an=kAnalyze(m.text,sec);m.st='done';
    if(m.text){(S.speak=S.speak||[]).push(Object.assign({d:today(),q:m.q.q,text:m.text},m.an));if(S.speak.length>200)S.speak=S.speak.slice(-200);save()}speak()};
  var nw=$('#knew');if(nw)nw.onclick=function(){spk=null;speak()};var ag=$('#kagain');if(ag)ag.onclick=function(){spk={q:m.q,st:'ready'};speak()};
}
