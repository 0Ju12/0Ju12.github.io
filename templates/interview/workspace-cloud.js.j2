 async function upload(){if(busy||!ready()){show();return}if(navigator.locks&&navigator.locks.request)return navigator.locks.request('prep-cloud:'+cfg.account+':'+cfg.device,uploadNow);return uploadNow()}
 async function uploadNow(){if(busy||!ready()){show();return}busy=true;var account=cfg.account,start=seq;show();try{
