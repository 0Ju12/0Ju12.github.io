   var box=await SYNC.seal('interview',raw,password);guard(account);var q="trashed = false and appProperties has { key='createdBy' and value='0ju12-prep-workspace' } and appProperties has { key='prepDevice' and value='"+cfg.device.replace(/[^a-zA-Z0-9-]/g,'')+"' }";
   var found=await request('https://www.googleapis.com/drive/v3/files?'+new URLSearchParams({q:q,fields:'files(id)',pageSize:'100'}));guard(account);var file=(found.files||[])[0];
