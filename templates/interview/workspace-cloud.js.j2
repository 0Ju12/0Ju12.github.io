 async function list(){if(!identity().connected){message='Google 계정을 먼저 연결하세요.';show();return}busy=true;show();rows=[];try{var token='';do{var q="trashed = false and appProperties has { key='createdBy' and value='0ju12-prep-workspace' }";var d=await request('https://www.googleapis.com/drive/v3/files?'+new URLSearchParams({q:q,fields:'files(id,name,modifiedTime,size),nextPageToken',pageSize:'100',pageToken:token}));rows=rows.concat(d.files||[]);token=d.nextPageToken||'';if(rows.length>1000)throw Error('백업 파일이 너무 많습니다. Drive에서 이전 기기 백업을 정리하세요.')}while(token);renderList();message=rows.length+'개 기기 백업을 찾았습니다.'}catch(e){message=e.message}finally{busy=false;show()}}
 function renderList(){var host=$('#wc-files');if(!host)return;host.innerHTML=rows.map(function(f,i){return '<p><button class="btn ghost" data-cloud-preview="'+i+'">'+esc(f.name)+' · '+esc((f.modifiedTime||'').slice(0,10))+'</button></p>'}).join('')||'<p>아직 백업이 없습니다.</p>';$$('[data-cloud-preview]').forEach(function(b){b.onclick=function(){read(rows[Number(b.dataset.cloudPreview)])}})}
 async function read(file){preview=null;var pw=$('#wc-password').value;if(!pw){message='백업 암호를 입력하세요.';show();return}if(Number(file.size)>12*1024*1024){message='가져올 백업은 12MB 이하이어야 합니다.';show();return}busy=true;show();try{var account=identity().accountId,box=await request('https://www.googleapis.com/drive/v3/files/'+encodeURIComponent(file.id)+'?alt=media');if(box.app!=='interview'||!box.ct)throw Error('준비 공간 암호화 백업이 아닙니다.');var raw=await SYNC.open(box,pw),valid=validateState(raw);if(raw.study){var st=raw.study;if(!objectMap(st)||st.v!==1||['q','read','days','star'].some(function(k){return !objectMap(st[k])})||!Array.isArray(st.exams)||Object.values(st.q).some(function(v){return !objectMap(v)}))throw Error('강의 기록 형식을 확인할 수 없습니다.')}preview={state:valid,study:raw.study,account:account};$('#wc-preview').innerHTML='<div class="card"><h3>'+esc(file.name)+' 가져오기 미리보기</h3><p>지원 '+valid.board.length+' · 제출본 '+valid.submissions.length+' · 경험 '+valid.experiences.length+' · SQL '+Object.keys(valid.sqlPractice).length+' · 면접 답변 '+Object.keys(valid.defense).length+'</p><p>현재 기록과 병합합니다. 같은 항목은 기존 병합 규칙을 따르며 녹음은 포함되지 않습니다.</p><button class="btn" id="wc-restore">이 백업을 현재 기록에 합치기</button><button class="btn ghost" id="wc-cancel">취소</button></div>';$('#wc-cancel').onclick=function(){preview=null;$('#wc-preview').replaceChildren()};$('#wc-restore').onclick=restore;message='내용을 확인한 뒤 병합하세요.'}catch(e){message=['bad','pw'].includes(e.message)?'백업 암호를 확인하세요.':e.message}finally{busy=false;show()}}
 function restore(){if(!preview||preview.account!==identity().accountId||!identity().connected){message='계정이 변경되었습니다. 백업을 다시 선택하세요.';show();return}var next=JSON.parse(JSON.stringify(S));mergeState(next,preview.state);var previous=S;S=next;if(!save()){S=previous;message='저장 공간이 부족해 병합하지 못했습니다.';show();return}if(STUDY&&preview.study)STUDY.merge(preview.study);preview=null;$('#wc-preview').replaceChildren();message='백업을 현재 기기의 기록과 합쳤습니다.';changed();show()}
 function view(){preview=null;$('#app').innerHTML='<div class="career-ui"><h1>개인 기록 통합 동기화</h1><p class="sub">지원·제출본·첨부파일·경험·SQL·면접 답변·강의 학습 기록을 하나의 암호화 백업으로 보관합니다.</p><section class="card"><p id="wc-account"></p><div class="row"><button class="btn" id="wc-connect">Google Drive 연결</button><button class="btn ghost" id="wc-disconnect">연결 해제</button></div><label>백업 암호 (8자 이상)<input type="password" class="field" id="wc-password" autocomplete="off" minlength="8"></label><p class="small muted">새 기기에서도 같은 암호가 필요합니다. 암호·접근 토큰은 저장하지 않습니다. 창을 다시 열면 연결과 암호 입력이 필요합니다.</p><div class="row"><button class="btn" id="wc-enable" data-cloud-busy>이 계정에 자동 백업 켜기</button><button class="btn ghost" id="wc-upload" data-cloud-busy>지금 동기화</button><button class="btn ghost" id="wc-disable">자동 백업 끄기</button></div><p id="wc-status" role="status"></p><h2>다른 기기 기록 가져오기</h2><button class="btn ghost" id="wc-list" data-cloud-busy>백업 목록 불러오기</button><div id="wc-files"></div><div id="wc-preview"></div><p class="small muted">기기별 파일을 따로 보관합니다. 다른 기기의 변경은 백업을 선택해 병합하세요. 자동 백업은 이 페이지가 열려 있고 인증·암호가 유효할 때 실행됩니다. 녹음 파일은 별도로 내려받아 보관하세요.</p></section></div>';
  $('#wc-connect').onclick=ALGO_DRIVE.connect;$('#wc-disconnect').onclick=function(){password='';cfg.enabled=false;persist();ALGO_DRIVE.disconnect();show()};$('#wc-enable').onclick=function(){var a=identity(),pw=$('#wc-password').value;if(!a.connected){message='Google 계정을 먼저 연결하세요.';show();return}if(pw.length<8){message='백업 암호를 8자 이상 입력하세요.';show();return}password=pw;cfg.enabled=true;cfg.account=a.accountId;persist();changed();upload()};$('#wc-upload').onclick=upload;$('#wc-disable').onclick=function(){cfg.enabled=false;password='';clearTimeout(timer);persist();show()};$('#wc-list').onclick=list;ALGO_DRIVE.bind();show();
 }
 window.addEventListener('online',function(){if(dirty)upload()});window.addEventListener('prep-drive-change',show);window.addEventListener('storage',function(e){if(e.key==='study-app-v1'||e.key==='interview-app-v1')changed()});window.addEventListener('focus',show);show();return {view:view,changed:changed,status:status,show:show,upload:upload};
