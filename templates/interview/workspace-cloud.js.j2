   else{var boundary='prep_'+crypto.randomUUID(),meta={name:'준비공간_'+cfg.device.slice(0,8)+'.json',mimeType:'application/json',appProperties:{createdBy:'0ju12-prep-workspace',prepDevice:cfg.device}};var body='--'+boundary+'\r\nContent-Type: application/json\r\n\r\n'+JSON.stringify(meta)+'\r\n--'+boundary+'\r\nContent-Type: application/json\r\n\r\n'+JSON.stringify(box)+'\r\n--'+boundary+'--';var made=await request('https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&fields=id',{method:'POST',headers:{'Content-Type':'multipart/related; boundary='+boundary},body:body});cfg.file=made.id}
   guard(account);cfg.last=new Date().toISOString();dirty=seq!==start;persist();message=dirty?'백업 중 수정된 내용이 있어 한 번 더 저장합니다.':'이 기기의 전체 기록을 암호화해 Drive에 저장했습니다.';retries=0;
