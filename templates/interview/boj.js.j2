/* BOJ workspace reuses the traced Python editor with a separate problem namespace. */
var BOJ=(function(){
 function record(n){return S.algo.find(function(a){return a.s==='백준'&&Number(/^(\d+)/.exec(a.n||'')?.[1])===n})}
 function problem(n){var r=record(n),d=S.algoDrafts['boj-'+n];return {site:'BOJ',number:n,title:d?.title||r?.n.replace(/^\d+\s*/, '')||'백준 '+n,level:'백준'}}
 function view(raw){var n=Number(raw),valid=Number.isInteger(n)&&n>=1000&&n<=999999;if(swWork){save();swWork=null}var map=new Map();S.algo.filter(function(a){return a.s==='백준'}).forEach(function(a){var n=Number(/^(\d+)/.exec(a.n||'')?.[1]);if(n)map.set(n,a)});Object.keys(S.algoDrafts).filter(function(k){return /^boj-\d+$/.test(k)}).forEach(function(k){var n=Number(k.slice(4));if(!map.has(n))map.set(n,null)});
 $('#app').innerHTML='<div class="career-ui"><h1>백준 풀이 공간</h1><p class="sub">문제 번호로 원문을 연결하고 Python 코드·입력·시각화·복습 기록을 함께 관리합니다.</p><form class="card" id="boj-open"><div class="grid g2"><label>백준 문제 번호<input class="field" type="number" id="boj-number" min="1000" max="999999" required value="'+(valid?n:'')+'" placeholder="1000"></label><label>문제 제목 (선택)<input class="field" id="boj-title" maxlength="200" value="'+(valid?esc(problem(n).title):'')+'" placeholder="원문에서 확인한 제목"></label></div><button class="btn">풀이 열기</button></form>'+(valid?'<div class="row" style="margin:16px 0"><a class="btn ghost" id="boj-source" href="https://www.acmicpc.net/problem/'+n+'" target="_blank" rel="noopener">백준 원문·예제 보기</a><a class="btn ghost" href="https://www.acmicpc.net/submit/'+n+'" target="_blank" rel="noopener">백준에서 제출하기</a><button class="btn ghost" id="boj-download">코드 내려받기</button><a href="#/cloud">통합 Drive 백업</a></div><p class="small muted">문제 설명·예제 입력·예상 출력은 원문에서 복사하거나 TXT로 가져오세요. 이곳의 실행 결과는 공식 채점이 아닙니다. 정답 판정은 백준에서 제출 후 확인합니다.</p>':'')+'<div id="sw-work"></div><h2>내 백준 문제</h2><div id="boj-library">'+Array.from(map.entries()).sort(function(a,b){return a[0]-b[0]}).map(function(x){var p=problem(x[0]);return '<p><a href="#/boj/'+x[0]+'">'+x[0]+' · '+esc(p.title)+'</a> <span class="small muted">'+(x[1]?({ok:'혼자 풀었다',hint:'힌트 참고',fail:'다시 풀기'}[x[1].r]||'기록 있음'):'작성 중')+'</span></p>'}).join('')+'</div></div>';
 $('#boj-open').onsubmit=function(e){e.preventDefault();var value=Number($('#boj-number').value);if(!Number.isInteger(value)||value<1000||value>999999)return;var p=problem(value);p.title=$('#boj-title').value.trim()||'백준 '+value;var d=sweaDraft(p);d.title=p.title;d.ts=stamp(d.ts);S.algoDrafts[sweaDraftKey(p)]=d;if(!save()){toast('저장하지 못했습니다. 저장 공간을 확인하세요.');return}if(location.hash==='#/boj/'+value)view(value);else location.hash='#/boj/'+value};
 if(valid){openSweaWork(problem(n),false);$('#boj-download').onclick=function(){SYNC.save('boj_'+n+'.py',sweaDraft(problem(n)).code,'text/x-python')}}
 }
 return {view:view,problem:problem,record:record};
})();
