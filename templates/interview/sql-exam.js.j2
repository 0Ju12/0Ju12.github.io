/* Timed local practice: deadline is durable; grading is separate from practice. */
var SQL_EXAM=(function(){
 var active='',index=0,worker=null,rejectRun=null,generation=0,clock=null;
 function stop(){generation++;clearInterval(clock);clock=null;if(worker)worker.terminate();worker=null;if(rejectRun){rejectRun(Error('화면 이동으로 실행을 중단했습니다.'));rejectRun=null}}
 function run(id,query){return new Promise(function(resolve,reject){worker=new Worker('lab/sql-worker.js');var w=worker,t=setTimeout(function(){finish({ok:false,error:'8초 실행 제한을 넘었습니다.'})},8000);rejectRun=function(e){clearTimeout(t);reject(e)};function finish(r){clearTimeout(t);w.terminate();if(worker===w){worker=null;rejectRun=null}resolve(r)}w.onmessage=function(e){finish(e.data)};w.onerror=function(){finish({ok:false,error:'실행 파일을 불러오지 못했습니다.'})};w.postMessage({id:id,query:query||''})})}
 function saveExam(x){x.ts=stamp(x.ts);return save()}
 function load(){if(typeof SQL_PRACTICE_DATA!=='undefined')return Promise.resolve();return new Promise(function(resolve,reject){var s=document.createElement('script');s.src='lab/sql-exercises.js';s.onload=resolve;s.onerror=function(){reject(Error('SQL 문제를 불러오지 못했습니다. 새로고침 후 다시 시도하세요.'))};document.head.append(s)})}
 async function view(id){var token=generation;try{await load();if(token!==generation)return}catch(e){$('#app').textContent=e.message;return}if(id)active=id;var x=Object.prototype.hasOwnProperty.call(S.sqlExams,active)?S.sqlExams[active]:null;if(!x){setup();return}index=Math.min(index,x.ids.length-1);var ex=SQL_PRACTICE_DATA.exercises.find(function(e){return e.id===x.ids[index]});if(!ex){$('#app').textContent='현재 문제 목록에 없는 시험입니다. 기록 백업으로 내용을 확인하세요.';return}
 var done=x.status==='done',running=x.status==='running';$('#app').innerHTML='<div class="career-ui"><h1>SQL 실전 모의시험</h1><p class="sub">5문제 · 20분 · 제출 전 정답·힌트 숨김. SQLite 기반 연습이며 공식 채용 채점은 아닙니다.</p><p id="exam-clock" role="status"></p><div class="row">'+x.ids.map(function(id,i){return '<button class="btn ghost" data-exam-question="'+i+'" aria-pressed="'+(i===index)+'">'+(i+1)+'번</button>'}).join('')+'</div><section class="card" style="margin:16px 0"><h2>'+(index+1)+'. '+esc(ex.title)+'</h2><p>'+esc(ex.prompt)+'</p><details><summary>테이블·데이터</summary><pre style="white-space:pre-wrap;overflow-wrap:anywhere">'+esc(SQL_PRACTICE_DATA.setup)+'</pre></details><label>SQL 답안<textarea class="field" id="exam-code" rows="8" maxlength="20000"'+(!running?' readonly':'')+'>'+esc(x.answers[ex.id]||'')+'</textarea></label>'+(running?'<div class="row"><button class="btn ghost" id="exam-run">결과만 실행</button><button class="btn" id="exam-submit">시험 제출</button></div>':x.status==='grading'?'<button class="btn" id="exam-grade">채점 이어하기</button>':'')+'<p id="exam-state" role="status"></p><pre id="exam-output" style="white-space:pre-wrap;overflow-wrap:anywhere"></pre></section>'+(done?'<section class="card"><h2>결과: '+x.ids.filter(function(id){return x.results[id]?.passed}).length+' / '+x.ids.length+'</h2>'+x.ids.map(function(id){var q=SQL_PRACTICE_DATA.exercises.find(function(e){return e.id===id}),r=x.results[id]||{};return '<details><summary>'+esc(q.title)+' · '+(r.passed?'통과':'복습 필요')+'</summary><p>'+esc(r.error||q.hint)+'</p><pre style="white-space:pre-wrap">'+esc(q.answer)+'</pre><a href="#/sql/'+id+'">이 문제 복습</a></details>'}).join('')+'<p class="small muted">실패한 문제는 취약점 복습 목록에도 반영됩니다.</p></section>':'')+'<button class="btn ghost" id="exam-home">시험 목록</button></div>';
 $('#exam-home').onclick=function(){stop();active='';location.hash='#/sql-exam';setup()};$$('[data-exam-question]').forEach(function(b){b.onclick=function(){stop();index=Number(b.dataset.examQuestion);view(active)}});
 if(running){$('#exam-code').oninput=function(){var current=S.sqlExams[active];if(Date.now()>=current.deadline){grade();return}current.answers[ex.id]=this.value;if(!saveExam(current))$('#exam-state').textContent='저장 실패. 답안을 복사해 보관하세요.'};$('#exam-run').onclick=async function(){var id=active,token=generation;this.disabled=true;try{var r=await run(ex.id,$('#exam-code').value);if(token!==generation||id!==active)return;$('#exam-output').textContent=r.ok?JSON.stringify(r.result,null,2):r.error;$('#exam-run').disabled=false}catch(_){}};$('#exam-submit').onclick=function(){if(confirm('현재 답안을 제출하고 채점할까요? 제출 후에는 수정할 수 없습니다.'))grade()};function tick(){if(!$('#exam-clock'))return;var left=Math.max(0,Math.ceil((x.deadline-Date.now())/1000));$('#exam-clock').textContent='남은 시간 '+Math.floor(left/60)+':'+String(left%60).padStart(2,'0');if(!left){clearInterval(clock);grade()}}clock=setInterval(tick,500);tick()}
 else if(x.status==='grading'){$('#exam-clock').textContent='제출됨 · 채점 대기';$('#exam-grade').onclick=grade}else $('#exam-clock').textContent='제출 완료 · '+new Date(x.finishedAt).toLocaleString();
 }
 async function grade(){var x=Object.prototype.hasOwnProperty.call(S.sqlExams,active)?S.sqlExams[active]:null;if(!x||x.status==='done')return;stop();var token=generation,id=active;x.status='grading';x.finishedAt=x.finishedAt||Date.now();if(!saveExam(x)){toast('제출 상태를 저장하지 못했습니다. 기록을 백업하세요.');return}await view(id);if(token!==generation)return;$('#exam-grade').disabled=true;$('#exam-state').textContent='채점 중…';try{for(var qid of x.ids){var r=await run(qid,x.answers[qid]||'');if(token!==generation)return;var current=S.sqlExams[id];current.results[qid]={passed:!!(r.ok&&r.passed),error:r.ok?'':r.error};if(!saveExam(current))throw Error('채점 결과 저장 실패');x=S.sqlExams[id]}
 var current=S.sqlExams[id];current.status='done';current.ids.forEach(function(qid){var old=S.sqlPractice[qid]||{};S.sqlPractice[qid]={code:current.answers[qid]||'',note:old.note||'',passed:current.results[qid].passed,attempts:(old.attempts||0)+1,ts:stamp(old.ts)}});if(!saveExam(current))throw Error('채점 결과 저장 실패');await view(id)
 }catch(e){if(token===generation){$('#exam-state').textContent=e.message;$('#exam-grade').disabled=false}}}
 function setup(){var pending=Object.values(S.sqlExams).find(function(x){return x.status!=='done'});$('#app').innerHTML='<h1>SQL 실전 모의시험</h1><section class="card"><p>20분 동안 5문제를 풉니다. 힌트는 제출 후 공개합니다. 화면을 떠나거나 새로고침해도 종료 시각은 유지됩니다.</p><button class="btn" id="exam-start"'+(pending?' disabled':'')+'>20분 시험 시작</button>'+(pending?'<p>진행 중인 시험을 먼저 마쳐 주세요.</p>':'')+'</section><h2>시험 기록</h2>'+Object.values(S.sqlExams).sort(function(a,b){return b.startedAt-a.startedAt}).map(function(x){return '<p><a href="#/sql-exam/'+encodeURIComponent(x.id)+'">'+new Date(x.startedAt).toLocaleString()+' · '+({running:'응시 중',grading:'채점 대기',done:'결과 보기'}[x.status])+'</a></p>'}).join('');$('#exam-start').onclick=function(){var ids=shuffle(SQL_PRACTICE_DATA.exercises.slice()).slice(0,5).map(function(x){return x.id}),id=uid(),now=Date.now();S.sqlExams[id]={id:id,startedAt:now,deadline:now+20*60000,finishedAt:0,status:'running',ids:ids,answers:{},results:{},ts:stamp(0)};if(!save()){delete S.sqlExams[id];toast('시험을 저장하지 못했습니다. 저장 공간을 확인하세요.');return}active=id;index=0;location.hash='#/sql-exam/'+encodeURIComponent(id)}}
 return {view:view,stop:stop};
})();
