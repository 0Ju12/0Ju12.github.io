var DEMOS={calculator:{mode:'stack',input:'3*(2+4)+5',code:"expression = input().strip()\nvalues, operators = [], []\npriority = {'+': 1, '-': 1, '*': 2, '/': 2}\ndef apply():\n    b, a = values.pop(), values.pop()\n    op = operators.pop()\n    values.append(a+b if op=='+' else a-b if op=='-' else a*b if op=='*' else a//b)\nnumber = ''\nfor ch in expression + ' ':\n    if ch.isdigit():\n        number += ch\n        continue\n    if number:\n        values.append(int(number))\n        number = ''\n    if ch == '(': operators.append(ch)\n    elif ch == ')':\n        while operators[-1] != '(': apply()\n        operators.pop()\n    elif ch in priority:\n        while operators and operators[-1]!='(' and priority[operators[-1]] >= priority[ch]: apply()\n        operators.append(ch)\nwhile operators: apply()\nprint(values[0])"},bfs:{mode:'graph',input:'',code:"from collections import deque\ngraph = {0:[1,2], 1:[0,3], 2:[0,3], 3:[1,2]}\nqueue = deque([0])\nvisited = {0}\nparent = {}\norder = []\nwhile queue:\n    u = queue.popleft()\n    order.append(u)\n    for v in graph[u]:\n        if v not in visited:\n            visited.add(v)\n            parent[v] = u\n            queue.append(v)\nprint(order)"},recursion:{mode:'calls',input:'5',code:"def factorial(n):\n    if n <= 1:\n        return 1\n    result = n * factorial(n-1)\n    return result\nn = int(input())\nprint(factorial(n))"}};
