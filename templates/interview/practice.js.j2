 function send(m){var f=$('#sw-frame');if(f)f.contentWindow.postMessage(Object.assign({token:swToken},m),location.origin)}
 function cases(d){return d.cases||(d.cases=[])}
 function card(){return '<section id="sw-practice" class="card" style="margin:14px 0;padding:14px"><h3 style="margin:0 0 12px">테스트 · 풀이 이력 · 복습</h3><div class="row" id="sw-concept-examples"><button class="btn sm ghost" data-demo="calculator">계산기 두 스택 예제</button><button class="btn sm ghost" data-demo="bfs">BFS 큐·그래프 예제</button><button class="btn sm ghost" data-demo="recursion">재귀 호출 예제</button></div><p class="faint small">개념 예제는 SWEA 제출용 입력 형식과 다를 수 있습니다. 기존 코드를 바꾸기 전에 확인합니다.</p><details '+(swReview?'':'open')+' id="sw-tests"><summary>테스트 케이스 여러 개 실행</summary><div id="sw-case-editor"></div><div class="row" style="margin:10px 0"><button class="btn sm ghost" id="sw-case-add">현재 입력으로 추가</button><button class="btn sm" id="sw-batch-run">모두 실행</button><button class="btn sm ghost" id="sw-batch-cancel">검사 취소</button></div><div id="sw-batch-status" role="status" class="small"></div><div id="sw-case-results"></div></details><details id="sw-versions"'+(swReview?' hidden':'')+'><summary>풀이 버전 비교 · 최근 20개</summary><p class="faint small">풀이 기록을 저장할 때 코드·입력·테스트·추적 단계 수를 남깁니다. 시간 수치는 브라우저·추적 비용의 영향을 받습니다.</p><div id="sw-history"></div></details><div style="margin-top:12px"><b class="small">틀린 이유</b><div id="sw-mistakes" class="chips" style="margin:8px 0"></div><div class="row"><button class="btn sm ghost" id="sw-blind">이전 풀이 가리고 다시 풀기</button><button class="btn sm ghost" id="sw-reveal"'+(swReview?'':' hidden')+'>이전 풀이 보기</button><span class="faint small" id="sw-review-date"></span></div><div id="sw-reveal-code"></div></div></section>'}
 function bind(){var host=$('#sw-practice-host');if(!host||!swWork)return;host.innerHTML=card();var d=draft();renderCases();renderHistory();$('#sw-mistakes').innerHTML=SW_MISTAKES.map(function(t){return '<button class="chip '+((d.mistakes||[]).includes(t)?'on':'')+'" data-mistake="'+esc(t)+'">'+esc(t)+'</button>'}).join('');$$('[data-mistake]').forEach(function(b){b.onclick=function(){var d=draft();d.mistakes=d.mistakes||[];var i=d.mistakes.indexOf(b.dataset.mistake);if(i>=0)d.mistakes.splice(i,1);else d.mistakes.push(b.dataset.mistake);store(d);b.classList.toggle('on')}});var r=swWork.noteSlug?null:sweaRecord(swWork.number);$('#sw-review-date').textContent=r&&r.reviewAt?'다음 복습 '+r.reviewAt:'';
 $('#sw-versions').ontoggle=function(){if(this.open)renderHistory()};$('#sw-case-add').onclick=function(){var d=draft(),list=cases(d);if(list.length>=20){toast('테스트는 최대 20개까지 저장할 수 있어요.');return}list.push({id:crypto.randomUUID(),name:'케이스 '+(list.length+1),input:d.input||'',expected:d.expected||''});swCaseIndex=list.length-1;store(d);renderCases()};$('#sw-batch-run').onclick=runBatch;$('#sw-batch-cancel').onclick=function(){send({type:'algo-work:batch-cancel'});swBatchId='';$('#sw-batch-status').textContent='검사를 취소했어요.'};$('#sw-blind').onclick=blind;$('#sw-reveal').onclick=function(){var d=draft();d.reviewPeeked=true;store(d);$('#sw-result').value='hint';var r=swWork.noteSlug?null:sweaRecord(swWork.number);var last=r&&r.code||(draft().versions||[]).slice(-1)[0]?.code||'';var pre=document.createElement('pre');pre.className='codeComparison';pre.textContent=last||'이전 풀이가 없어요.';$('#sw-reveal-code').replaceChildren(pre);$('#sw-versions').hidden=false;$('#sw-versions').open=true};$$('[data-demo]').forEach(function(b){b.onclick=function(){var demo=DEMOS[b.dataset.demo];if(!confirm('개념 예제의 코드·입력으로 바꿀까요? 현재 코드는 버전으로 보관합니다.'))return;var d=draft();d.versions=ALGO_CORE.addVersion(d.versions||[],d);store(d);send({type:'algo-work:replace',code:demo.code,input:demo.input,mode:demo.mode});toast('개념 예제를 불러왔어요. 실행 후 시각화 방식을 선택해 보세요.')}});
 }
 function renderCases(){var d=draft(),list=cases(d),box=$('#sw-case-editor');if(!box)return;swCaseIndex=Math.max(0,Math.min(swCaseIndex,list.length-1));if(!list.length){box.innerHTML='<p class="faint small">현재 입력·예상 출력을 케이스로 추가하세요. 예상 출력이 비어 있으면 정답 여부를 판정하지 않습니다.</p>';return}box.innerHTML='<div class="row" style="margin:10px 0"><select class="field" id="sw-case-select" style="width:auto">'+list.map(function(c,i){return '<option value="'+i+'"'+(i===swCaseIndex?' selected':'')+'>'+esc(c.name)+'</option>'}).join('')+'</select><button class="btn sm ghost" id="sw-case-delete">이 케이스 삭제</button></div><label class="small">이름<input class="field" id="sw-case-name" maxlength="100" value="'+esc(list[swCaseIndex].name)+'"></label><div class="grid g2"><label class="small">입력<textarea class="field" id="sw-case-input" rows="3">'+esc(list[swCaseIndex].input)+'</textarea></label><label class="small">예상 출력<textarea class="field" id="sw-case-expected" rows="3">'+esc(list[swCaseIndex].expected)+'</textarea></label></div>';$('#sw-case-select').onchange=function(){swCaseIndex=Number(this.value);renderCases()};$('#sw-case-delete').onclick=function(){var current=draft();cases(current).splice(swCaseIndex,1);store(current);renderCases()};for(var key of ['name','input','expected'])$('#sw-case-'+key).oninput=(function(k){return function(){var current=draft(),c=cases(current)[swCaseIndex];if(this.value.length>100000){toast('100,000자 이하로 입력하세요.');return}c[k]=this.value;store(current)}})(key)
 }
 function runBatch(){var d=draft();if(!ALGO_CORE.validCases(cases(d))||!d.cases.length){toast('테스트 케이스를 먼저 추가하세요.');return}swBatchId=crypto.randomUUID();swBatchCode=d.code;swBatchResults=[];$('#sw-batch-status').textContent='Python을 준비하고 전체 케이스를 실행합니다…';send({type:'algo-work:batch',batchId:swBatchId,cases:d.cases})}
 function batch(m){if(m.batchId!==swBatchId)return;var d=draft();if(!d)return;if(m.type==='algo-work:batch-result'){var c=cases(d).find(function(c){return c.id===m.caseId});if(!c)return;var result={caseId:c.id,name:c.name,input:m.input,expected:m.expected,output:String(m.output||'').slice(0,100000),error:m.error||'',steps:m.steps||0,elapsedMs:m.elapsedMs||0};result.verdict=ALGO_CORE.verdict(result,result.expected);swBatchResults.push(result);d.lastTests={code:swBatchCode,at:Date.now(),results:swBatchResults.slice()};store(d);renderResults(d.lastTests);$('#sw-batch-status').textContent=swBatchResults.length+' / '+cases(d).length+'개 실행 완료'}if(m.type==='algo-work:batch-done'){$('#sw-batch-status').textContent='전체 검사 완료 · '+swBatchResults.filter(function(r){return r.verdict==='pass'}).length+'개 일치';swBatchId=''}}
 function renderResults(run){var host=$('#sw-case-results');if(!host||!run)return;host.replaceChildren();if(draft().code!==run.code||run.results.some(function(r){var c=cases(draft()).find(function(c){return c.id===r.caseId});return !c||c.input!==r.input||c.expected!==r.expected})){var stale=document.createElement('p');stale.className='small';stale.textContent='코드 또는 테스트가 변경되었습니다. 아래는 이전 검사의 결과입니다.';host.append(stale)}for(var [index,result] of run.results.entries()){var row=document.createElement('div');row.className='testResult '+result.verdict;var text=document.createElement('span');text.textContent=result.name+' · '+({pass:'✓ 일치',fail:'✕ 불일치',unchecked:'예상 출력 없음',error:'실행 오류'}[result.verdict])+' · '+result.steps+'단계';var detail=document.createElement('details');var summary=document.createElement('summary');summary.textContent='출력 보기';var pre=document.createElement('pre');var difference=typeof LEARNING_CORE!=='undefined'?LEARNING_CORE.firstDifference(result.output,result.expected):null;pre.textContent=(result.error||result.output)+'\n예상: '+result.expected+(result.verdict==='fail'&&difference?'\n첫 차이: '+difference.line+'줄 '+difference.column+'번째 문자 · 실제 '+JSON.stringify(difference.actualChar??'(끝)')+' / 예상 '+JSON.stringify(difference.expectedChar??'(끝)'):'');detail.append(summary,pre);var button=document.createElement('button');button.className='btn sm ghost';button.textContent='이 입력 시각화';button.onclick=(function(r,code){return function(){if(draft().code!==code&&!confirm('검사 당시 코드로 돌아가 이 입력을 실행할까요?'))return;var d=draft();d.versions=ALGO_CORE.addVersion(d.versions||[],d);store(d);send({type:'algo-work:replace',code:code,input:r.input,run:true})}})(result,run.code);row.append(text,button,detail);host.append(row)}}
 function renderHistory(){var d=draft(),versions=d.versions||[],host=$('#sw-history');if(!host)return;if(!versions.length){host.innerHTML='<p class="faint small">풀이 기록을 저장하면 버전이 쌓입니다.</p>';return}host.innerHTML='<div class="row"><select class="field" id="sw-version-left" style="width:auto">'+versions.map(function(v,i){return '<option value="'+i+'">'+(i+1)+' · '+new Date(v.at).toLocaleString()+'</option>'}).join('')+'</select><select class="field" id="sw-version-right" style="width:auto"><option value="current">현재 작성 중</option>'+versions.map(function(v,i){return '<option value="'+i+'">버전 '+(i+1)+'</option>'}).join('')+'</select><button class="btn sm ghost" id="sw-version-restore">왼쪽 버전 복원</button></div><p class="small" id="sw-version-metrics"></p><pre id="sw-version-diff" class="codeComparison"></pre>';$('#sw-version-left').value=String(versions.length-1);var compare=function(){var left=versions[Number($('#sw-version-left').value)],right=$('#sw-version-right').value==='current'?draft():versions[Number($('#sw-version-right').value)];var diff=ALGO_CORE.diff(left.code,right.code),box=$('#sw-version-diff');box.replaceChildren();if(diff.large){box.textContent='500줄 초과: 두 코드를 나란히 비교합니다.\n\n[이전]\n'+left.code+'\n\n[이후]\n'+right.code}else for(var line of diff.lines){var node=document.createElement('div');node.className='diff-'+line.kind;node.textContent=({add:'+ ',remove:'− ',same:'  '}[line.kind])+line.text;box.append(node)}$('#sw-version-metrics').textContent='이전 '+(left.metrics?.steps??'—')+'단계 / 현재 '+(right.metrics?.steps??'—')+'단계 · 검사 결과는 저장 시점 기준입니다.'};$('#sw-version-left').onchange=$('#sw-version-right').onchange=compare;$('#sw-version-restore').onclick=function(){var v=versions[Number($('#sw-version-left').value)];if(!confirm('선택한 버전의 코드·입력을 복원할까요? 현재 작성 중인 코드는 이력으로 보관합니다.'))return;var d=draft();d.versions=ALGO_CORE.addVersion(d.versions||[],d);store(d);send({type:'algo-work:replace',code:v.code,input:v.input});toast('버전을 복원했습니다. 다시 실행해 결과를 확인하세요.')};compare();renderResults(d.lastTests)}
 function blind(){if(!swWork)return;var d=draft();if(!confirm('이전 코드와 풀이 메모를 가리고 새 코드로 다시 풀까요? 현재 풀이는 버전으로 보관합니다.'))return;d.versions=ALGO_CORE.addVersion(d.versions||[],d);d.reviewMode=true;d.reviewPeeked=false;d.code='# 이전 풀이를 보지 않고 다시 풀어보세요.\n';d.idea='';d.mistakes=[];d.metrics={};delete d.lastTests;store(d);swReview=true;openSweaWork(swWork,false)}
 return {bind:bind,batch:batch,card:card,blind:blind,store:store};
