/* Bulk input review, exact mismatch locations, trace comparisons and export. */
var ALGO_LEARNING=(function(){
 var imported=[],comparison=null,comparisonToken='',localError='',position=0;
 function node(tag,text,cls){var e=document.createElement(tag);if(text!=null)e.textContent=text;if(cls)e.className=cls;return e}
 function dl(text,name,type){var u=URL.createObjectURL(new Blob([text],{type:type||'text/plain;charset=utf-8'})),a=node('a');a.href=u;a.download=name;a.click();setTimeout(function(){URL.revokeObjectURL(u)},1000)}
 function draft(){return sweaDraft(swWork)}
 function persist(d){d.ts=stamp(d.ts);S.algoDrafts[sweaDraftKey(swWork)]=d;var ok=save();localError=ok?'':'이 기기 저장 실패';status();return ok}
 function bind(){var host=$('#algo-bulk-panel');if(host){host.innerHTML='<details class="card" style="margin:12px 0"><summary><b>입력·출력 TXT / ZIP 일괄 등록</b></summary><p class="small">2001_input.txt 또는 2001/input.txt처럼 번호가 있는 파일은 자동 연결합니다. 번호가 없거나 여러 개면 직접 지정하세요. 검토 후 적용하며 SWEA 공식 채점과는 별개입니다.</p><label class="small">TXT 여러 개 또는 ZIP<input class="field" type="file" id="learn-files" accept=".txt,.zip" multiple></label><div id="learn-import-status" role="status"></div><div id="learn-import-preview"></div></details>';$('#learn-files').onchange=async function(){var files=Array.from(this.files);this.value='';try{if(files.length>100)throw Error('한 번에 파일 100개 이하만 선택하세요.');var next=[],total=0;for(var f of files){if(/\.zip$/i.test(f.name)){next.push(...await LEARNING_CORE.readZip(await f.arrayBuffer()))}else{var text=await ALGO_TEXT_FILES.read(f);next.push({name:f.name,text:text,...LEARNING_CORE.infer(f.name)})}if(next.length>100)throw Error('최대 100개 파일을 등록할 수 있어요.')}for(var x of next)total+=x.text.length;if(total>1000000)throw Error('전체 텍스트는 1,000,000자 이하로 나눠 등록하세요.');imported=next;preview();$('#learn-import-status').textContent=next.length+'개 파일을 검토하세요.'}catch(e){$('#learn-import-status').textContent=e.message}}}work()}
 function preview(){var host=$('#learn-import-preview');host.replaceChildren();for(var [i,item] of imported.entries()){var row=node('div',null,'row');row.style.margin='10px 0';var use=node('input');use.type='checkbox';use.checked=true;use.id='learn-use-'+i;use.setAttribute('aria-label',item.name+' 등록');var title=node('span',item.name+' · '+item.text.length+'자','small');title.style.overflowWrap='anywhere';var num=node('input');num.type='number';num.className='field';num.style.width='115px';num.placeholder='문제 번호';num.value=item.number||'';num.id='learn-number-'+i;num.setAttribute('aria-label',item.name+' 문제 번호');var kind=node('select',null,'field');kind.style.width='120px';kind.id='learn-kind-'+i;for(var x of [['input','입력'],['expected','예상 출력']]){var opt=node('option',x[1]);opt.value=x[0];kind.append(opt)}kind.value=item.kind;var view=node('details'),s=node('summary','내용 확인'),pre=node('pre',item.text.slice(0,3000));pre.style.whiteSpace='pre-wrap';view.append(s,pre);row.append(use,title,num,kind,view);host.append(row)}var label=node('label',null,'small'),overwrite=node('input');overwrite.type='checkbox';overwrite.id='learn-overwrite';label.append(overwrite,node('span','기존 입력·출력 교체 허용 (기존 버전 보관)'));var apply=node('button','검토한 파일 적용','btn sm');apply.id='learn-apply';apply.onclick=applyImport;host.append(label,apply)}
 function applyImport(){var jobs=[],keys=new Set(),skipped=0;try{for(var [i,item] of imported.entries()){if(!$('#learn-use-'+i).checked)continue;var n=Number($('#learn-number-'+i).value),kind=$('#learn-kind-'+i).value,p=SWCAT&&SWCAT.items.find(function(p){return p.number===n});if(!p)throw Error(item.name+': 목록에 있는 문제 번호를 지정하세요.');var key=n+':'+kind;if(keys.has(key))throw Error(n+'번 '+kind+' 파일이 중복돼요. 하나만 선택하세요.');keys.add(key);var d=sweaDraft(p);if(d[kind]&&d[kind]!==item.text&&!$('#learn-overwrite').checked){skipped++;continue}jobs.push({p:p,kind:kind,text:item.text})}if(!jobs.length)throw Error('적용할 파일이 없어요. 기존 값 교체 여부를 확인하세요.');var before=JSON.stringify(S.algoDrafts);for(var job of jobs){var d=sweaDraft(job.p);if(d[job.kind]&&d[job.kind]!==job.text)d.versions=ALGO_CORE.addVersion(d.versions||[],d);d[job.kind]=job.text;d.ts=stamp(d.ts);S.algoDrafts[sweaDraftKey(job.p)]=d}if(!save()){S.algoDrafts=JSON.parse(before);throw Error('저장 실패: 적용을 취소했어요. 기록을 백업하고 다시 시도하세요.')}$('#learn-import-status').textContent=jobs.length+'개 적용 · 기존 값 '+skipped+'개 유지. 원격 저장은 문제를 열어 기록 저장을 누르세요.';imported=[];$('#learn-import-preview').replaceChildren();renderSweaList();if(swWork)openSweaWork(swWork,false)}catch(e){$('#learn-import-status').textContent=e.message}}
 function status(){var host=$('#learn-save-state');if(!host||!swWork)return;var r=swWork.noteSlug?null:sweaRecord(swWork.number),d=draft();var state=function(job){if(!job)return '미설정';if(job.status==='synced'&&(!r||r.code!==d.code||r.input!==d.input))return '기록 이후 수정됨';return ({pending:job.error?'재시도 필요':'대기',synced:'저장 완료',conflict:'충돌'}[job.status]||'확인 필요')};host.textContent='이 기기: '+(localError||(typeof storageMessage!=='undefined'&&storageMessage)||'초안 저장')+' · Drive: '+state(r&&r.driveSync)+' · GitHub: '+state(r&&r.githubSync)}
 function work(){var host=$('#sw-learning-host');if(!host||!swWork)return;send({type:'algo-work:compare-cancel'});comparisonToken=crypto.randomUUID();comparison=null;host.innerHTML='<style>#sw-learning-host textarea{height:auto;min-height:100px}#sw-learning-host pre{max-height:420px;overflow:auto}#sw-learning-host .g2{grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr))}</style><section class="card" style="margin:12px 0"><p id="learn-save-state" role="status" class="small"></p><div id="learn-note-links" class="row"></div><details><summary>같은 입력으로 알고리즘 두 개 비교 실행</summary><p class="small">Python 코드 A·B를 같은 입력으로 각각 실행합니다. 첫 로딩·추적 비용이 시간에 포함되므로 채점 성능으로 해석하지 마세요. 추적은 6,000단계 제한입니다.</p><button id="learn-pair" class="btn sm ghost">부분집합 합: 완전탐색 / 가지치기 예제</button><div class="grid g2"><label>코드 A<textarea id="learn-code-a" class="field" rows="7"></textarea></label><label>코드 B<textarea id="learn-code-b" class="field" rows="7"></textarea></label></div><label>공통 입력<textarea class="field" id="learn-compare-input" rows="3"></textarea></label><div class="row"><button class="btn sm" id="learn-compare-run">두 코드 실행</button><button class="btn sm ghost" id="learn-compare-cancel">비교 취소</button></div><p id="learn-compare-status" role="status"></p><label>추적 단계 <input id="learn-compare-step" type="range" min="0" max="0" value="0" style="width:100%"></label><div class="grid g2"><pre id="learn-trace-a" style="white-space:pre-wrap;overflow-wrap:anywhere"></pre><pre id="learn-trace-b" style="white-space:pre-wrap;overflow-wrap:anywhere"></pre></div></details><details><summary>풀이 회고 Markdown 내보내기</summary><label class="small">시간·공간 복잡도와 근거 (직접 작성)<input class="field" id="learn-complexity" placeholder="시간 O(N), 공간 O(N) — 각 원소를 한 번 방문"></label><button class="btn sm ghost" id="learn-export">회고 초안 내려받기</button><p class="small">코드·입력·출력·메모를 포함한 로컬 파일입니다. 공개 전 내용을 확인하세요.</p></details></section>';$('#learn-code-a').value=draft().code||'';$('#learn-code-b').value=swReview?'':(draft().versions||[]).slice(-1)[0]?.code||draft().code||'';$('#learn-compare-input').value=draft().input||'';$('#learn-export').onclick=function(){dl(LEARNING_CORE.reflection(swWork,draft(),$('#learn-complexity').value),'swea-'+(swWork.number||'note')+'-reflection.md','text/markdown;charset=utf-8')};$('#learn-pair').onclick=function(){$('#learn-code-a').value=PAIR_A;$('#learn-code-b').value=PAIR_B;$('#learn-compare-input').value='8 10\n1 2 3 4 5 6 7 8'};$('#learn-compare-run').onclick=function(){var a=$('#learn-code-a').value,b=$('#learn-code-b').value,input=$('#learn-compare-input').value;if(!a.trim()||!b.trim()||a.length>100000||b.length>100000||input.length>100000){$('#learn-compare-status').textContent='코드 두 개와 100,000자 이하 입력을 확인하세요.';return}comparisonToken=crypto.randomUUID();comparison=null;$('#learn-compare-status').textContent='비교 실행 중…';send({type:'algo-work:compare',comparisonId:comparisonToken,codes:[a,b],input:input})};$('#learn-compare-cancel').onclick=function(){send({type:'algo-work:compare-cancel'});comparisonToken='';$('#learn-compare-status').textContent='비교를 취소했어요.'};$('#learn-compare-step').oninput=function(){position=Number(this.value);trace()};notes();status()}
 function send(m){var f=$('#sw-frame');if(f)f.contentWindow.postMessage(Object.assign({token:swToken},m),location.origin)}
 function trace(){if(!comparison)return;comparison.forEach(function(r,i){var event=(r.events||[])[Math.min(position,(r.events||[]).length-1)];$('#learn-trace-'+(i?'b':'a')).textContent=(i?'B':'A')+' · '+r.steps+'단계 · '+r.elapsedMs+' ms\n'+(r.error||'출력: '+r.output)+'\n'+(event?'줄 '+event.line+'\n'+JSON.stringify(event.vars,null,2):'추적 없음')})}
 function receive(m){if(m.type!=='algo-work:compare-result'||m.comparisonId!==comparisonToken)return;comparison=m.results;position=0;$('#learn-compare-step').max=String(Math.max(...comparison.map(x=>(x.events||[]).length),1)-1);$('#learn-compare-step').value='0';$('#learn-compare-status').textContent=comparison.some(x=>x.error)?'실행 오류: 아래 내용을 확인하세요.':LEARNING_CORE.normalize(comparison[0].output)===LEARNING_CORE.normalize(comparison[1].output)?'출력이 같습니다. 슬라이더로 변수와 탐색 횟수를 비교하세요.':'출력이 다릅니다. 알고리즘과 입력 조건을 확인하세요.';trace()}
 function notes(){var host=$('#learn-note-links'),title=swWork.title||'';var rule=/계산기|괄호|후위/.test(title)?['stack2','후위|계산기|중위']:/미로|경로|BFS|너비/.test(title)?['queue','BFS|너비']:/재귀|부분집합|순열/.test(title)?['exhaustive_search','부분집합|순열|재귀']:/정렬/.test(title)?['list1','정렬']:null;if(!rule){host.textContent='강의노트 문단 연결: 아래에서 노트를 선택하세요.'}var select=node('select',null,'field');select.style.maxWidth='100%';select.setAttribute('aria-label','강의노트 선택');var notes=typeof STUDY!=='undefined'&&STUDY&&STUDY.notes||[];for(var n of notes){var o=node('option',n.title);o.value=n.slug;select.append(o)}var sections=node('div',null,'row');host.append(select,sections);function render(){sections.replaceChildren();var n=notes.find(n=>n.slug===select.value);if(!n)return;for(var [i,s] of (n.sections||[]).entries()){var a=node('a',s,'btn sm ghost');a.href='notes/'+n.slug+'.html#learn-section-'+i;a.target='_blank';a.rel='noopener';sections.append(a);if(rule&&new RegExp(rule[1]).test(s))a.style.fontWeight='900'}}select.onchange=render;if(rule){var match=notes.find(n=>n.slug===rule[0])||notes.find(n=>new RegExp(rule[1]).test(n.title+' '+(n.sections||[]).join(' ')));if(match)select.value=match.slug}render()}
 function mismatch(d){if(!d.expected||!d.ran||d.error)return '';var diff=LEARNING_CORE.firstDifference(d.output,d.expected);if(!diff)return '';return '첫 차이: '+diff.line+'줄 '+diff.column+'번째 문자 · 예상 '+JSON.stringify(diff.expectedChar??'(출력 끝)')+' / 실제 '+JSON.stringify(diff.actualChar??'(출력 끝)')}
 var PAIR_A="n, target = map(int, input().split())\narr = list(map(int, input().split()))\nassert 0 <= n <= 12 and len(arr) == n and all(x > 0 for x in arr) and target >= 0\nvisits = 0\nsolutions = 0\ndef dfs(i, total):\n    global visits, solutions\n    visits += 1\n    if i == n:\n        solutions += total == target\n        return\n    dfs(i+1, total)\n    dfs(i+1, total+arr[i])\ndfs(0, 0)\nprint(solutions)";
 var PAIR_B=PAIR_A.replace('    if i == n:', '    if total > target:\n        return\n    if i == n:');
 setInterval(status,2000);
 return {bind:bind,work:work,receive:receive,mismatch:mismatch,status:status};
})();
