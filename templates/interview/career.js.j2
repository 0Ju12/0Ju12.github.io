/* Job requirements and reusable evidence; all data stays in the existing backup. */
var CAREER=(function(){
 var selected='',editing='';try{selected=sessionStorage.getItem('prep-career-position')||''}catch(_){}
 var states={gap:'경험 부족',draft:'정리 필요',proof:'증빙 있음'};
 function field(id,label,value,type){return '<label>'+label+'<input class="field" id="'+id+'" type="'+(type||'text')+'" value="'+esc(value||'')+'" maxlength="2000"></label>'}
 function area(id,label,value){return '<label>'+label+'<textarea class="field" id="'+id+'" rows="3" maxlength="20000">'+esc(value||'')+'</textarea></label>'}
 function link(s){try{var u=new URL(s);return ['http:','https:'].includes(u.protocol)?u.href:''}catch(_){return ''}}
 function job(){return S.board.find(function(x){return x.id===selected})}
 function data(j){return j.career||{source:'',text:'',requirements:[]}}
 function persist(j){j.ts=stamp(j.ts);return save()}
 function summary(){var jobs=S.board.filter(function(j){return j.stage!=='done'&&j.stage!=='drop'}).sort(function(a,b){return (a.due||'9999').localeCompare(b.due||'9999')});return jobs.slice(0,3).map(function(j){var todo=data(j).requirements.filter(function(r){return r.task&&!r.done})[0];return '<a class="card" style="display:block;margin-bottom:10px;text-decoration:none;color:inherit" href="#/career/'+encodeURIComponent(j.id)+'"><b>'+esc(j.name)+' · '+esc(j.role||'직무 미입력')+'</b><p class="small">'+(j.due?'마감 '+esc(j.due)+(j.due<today()?' · 마감 지남':''):'마감 미정')+' · '+esc(STAGES[j.stage]||'')+'</p><p class="muted small">'+esc(todo?todo.task:'다음 준비할 일을 등록하세요.')+'</p></a>'}).join('')}
 function view(id){
  if(id)selected=id;if(!job())selected=S.board[0]?.id||'';try{sessionStorage.setItem('prep-career-position',selected)}catch(_){};var j=job(),d=j?data(j):null;
  var h='<div class="hd"><div><span class="eyebrow">CAREER WORKSPACE</span><h1>지원 준비 보드</h1><p class="sub">공고 요건을 내 경험과 연결하고 다음 행동을 정하세요.</p></div><a class="btn ghost" href="#/board">지원 단계 보드</a></div><div class="row" style="margin-bottom:20px"><button class="btn ghost" id="career-calendar">마감 캘린더 내보내기</button><a class="btn ghost" href="#/essay">자소서 작성</a><a class="btn ghost" href="#/mock">면접 연습</a></div>'+summary();
  h+='<section class="card"><h2>지원할 공고 등록</h2><form id="career-new"><div class="grid g2">'+field('career-company','회사 이름')+field('career-role','직무')+'</div><button class="btn" style="margin-top:12px">공고 추가</button></form></section>';
  if(j){h+='<div class="row" style="margin:16px 0"><a class="btn ghost" href="#/submissions/'+encodeURIComponent(j.id)+'">이 지원 건의 제출본</a><a class="btn ghost" href="#/evidence">프로젝트 증빙 점검</a></div>';h+='<section class="card" style="margin-top:20px"><label>준비할 지원 건<select id="career-select" class="field">'+S.board.map(function(x){return '<option value="'+esc(x.id)+'"'+(j.id===x.id?' selected':'')+'>'+esc(x.name+' · '+x.role)+'</option>'}).join('')+'</select></label><form id="career-post"><div class="grid g2">'+field('career-name','회사 이름',j.name)+field('career-position','직무',j.role)+field('career-due','마감일 (날짜 기준)',j.due,'date')+'<label>지원 단계<select id="career-stage" class="field">'+SORDER.map(function(st){return '<option value="'+st+'"'+(j.stage===st?' selected':'')+'>'+STAGES[st]+'</option>'}).join('')+'</select></label></div>'+field('career-url','공고 원문 URL',d.source,'url')+area('career-text','공고 본문 붙여넣기',d.text)+'<p class="small muted">원문을 보관하고, 아래에 평가할 요건을 직접 등록합니다. 자동 분석 점수는 생성하지 않습니다.</p><button class="btn">공고 정보 저장</button></form><h2>요건과 준비 상태</h2><form id="career-req"><div class="grid g2">'+field('career-requirement','요건 (예: SQL 쿼리 최적화 경험)')+'<label>구분<select class="field" id="career-kind"><option value="required">필수</option><option value="preferred">우대</option></select></label></div><button class="btn ghost" style="margin-top:12px">요건 추가</button></form><div id="career-requirements">';
   h+=d.requirements.length?d.requirements.map(function(r){return '<form class="card" data-req="'+esc(r.id)+'" style="margin-top:14px;min-width:0"><h3 style="overflow-wrap:anywhere">'+(r.kind==='required'?'필수':'우대')+' · '+esc(r.title)+'</h3><label>연결할 경험<select class="field" name="experience"><option value="">연결 안 함</option>'+S.experiences.map(function(e){return '<option value="'+esc(e.id)+'"'+(r.experience===e.id?' selected':'')+'>'+esc(e.title)+'</option>'}).join('')+'</select></label><label>준비 상태<select class="field" name="status">'+Object.keys(states).map(function(k){return '<option value="'+k+'"'+(r.status===k?' selected':'')+'>'+states[k]+'</option>'}).join('')+'</select></label><label>다음 할 일<input class="field" name="task" maxlength="2000" value="'+esc(r.task)+'" placeholder="예: 중복 데이터 검증 결과를 README에 정리"></label><label><input type="checkbox" name="done"'+(r.done?' checked':'')+'> 할 일 완료</label><div class="row" style="margin-top:12px"><button class="btn sm">요건 상태 저장</button><button class="btn sm ghost" type="button" data-remove="'+esc(r.id)+'">요건 삭제</button></div></form>'}).join(''):'<p class="muted">공고의 필수·우대 요건을 하나씩 등록하세요.</p>';
   h+='</div><button class="btn ghost" id="career-export" style="margin-top:16px">지원 준비 요약 내려받기 (.md)</button></section>';
  }
  var e=S.experiences.find(function(x){return x.id===editing})||{};
  h+='<section class="card" style="margin-top:20px"><h2>경험·성과 보관함</h2><p class="muted">여러 지원 건에서 같은 경험을 연결할 수 있습니다. 증빙 URL에는 프로젝트·코드·강의 노트 주소를 넣으세요.</p><form id="career-experience">'+field('experience-title','경험 제목',e.title)+area('experience-problem','문제 / 목표',e.problem)+area('experience-role','내 역할',e.role)+area('experience-decision','판단 / 구현 과정',e.decision)+area('experience-result','결과 / 한계',e.result)+field('experience-url','증빙 URL',e.url,'url')+'<div class="row" style="margin-top:12px"><button class="btn">'+(e.id?'경험 수정 저장':'경험 추가')+'</button><button type="button" class="btn ghost" id="experience-clear">새 경험 작성</button></div></form><div style="margin-top:20px">'+S.experiences.map(function(x){return '<article style="padding:14px 0;border-top:1px solid var(--line);overflow-wrap:anywhere"><b>'+esc(x.title)+'</b><p style="white-space:pre-wrap">'+esc(x.result)+'</p><div class="row"><button class="btn sm ghost" data-edit="'+esc(x.id)+'">열기·수정</button>'+(link(x.url)?'<a class="btn sm ghost" href="'+esc(link(x.url))+'" target="_blank" rel="noopener">증빙 보기 ↗</a>':'')+'<button class="btn sm ghost" data-delete="'+esc(x.id)+'">삭제</button></div></article>'}).join('')+'</div></section><p class="small muted" role="status" id="career-status">저장 버튼으로 이 브라우저에 저장합니다. 기록·백업에서 다른 기기로 옮길 수 있습니다.</p>';
  $('#app').innerHTML='<div class="career-ui">'+h+'</div>';
  $('#career-calendar').onclick=exportICS;
  function done(ok){if(ok){view();toast('저장했습니다.')}else $('#career-status').textContent='저장하지 못했습니다. 현재 내용을 복사하거나 기록을 백업하세요.'}
  $('#career-new').onsubmit=function(ev){ev.preventDefault();var name=$('#career-company').value.trim();if(!name){toast('회사 이름을 입력하세요.');return}var x={id:uid(),name:name,role:$('#career-role').value.trim(),due:'',stage:'want',memo:'',ts:stamp(0)};S.board.push(x);selected=x.id;done(save())};
  if(j){$('#career-select').onchange=function(){location.hash='#/career/'+encodeURIComponent(this.value)};
   $('#career-post').onsubmit=function(ev){ev.preventDefault();var x=job(),name=$('#career-name').value.trim();if(!name){toast('회사 이름을 입력하세요.');return}x.name=name;x.role=$('#career-position').value.trim();x.due=$('#career-due').value;x.stage=$('#career-stage').value;x.career=data(x);x.career.source=$('#career-url').value.trim();x.career.text=$('#career-text').value;done(persist(x))};
   $('#career-req').onsubmit=function(ev){ev.preventDefault();var title=$('#career-requirement').value.trim();if(!title)return;var x=job();x.career=data(x);x.career.requirements.push({id:uid(),title:title,kind:$('#career-kind').value,experience:'',status:'gap',task:'',done:false});done(persist(x))};
   $$('[data-req]').forEach(function(f){f.onsubmit=function(ev){ev.preventDefault();var x=job(),r=data(x).requirements.find(function(r){return r.id===f.dataset.req}),v=new FormData(f),ex=S.experiences.find(function(e){return e.id===v.get('experience')});if(v.get('status')==='proof'&&(!ex||!link(ex.url))){toast('증빙 있음으로 저장하려면 증빙 URL이 있는 경험을 연결하세요.');return}Object.assign(r,{experience:v.get('experience'),status:v.get('status'),task:v.get('task').trim(),done:v.has('done')});done(persist(x))}});
   $$('[data-remove]').forEach(function(b){b.onclick=function(){if(!confirm('이 요건을 삭제할까요?'))return;var x=job();x.career.requirements=x.career.requirements.filter(function(r){return r.id!==b.dataset.remove});done(persist(x))}});
   $('#career-export').onclick=function(){var x=job(),d=data(x),lines=['# '+x.name+' · '+x.role,'','마감: '+(x.due||'미정'),'단계: '+STAGES[x.stage],'원문: '+d.source,''];d.requirements.forEach(function(r){var e=S.experiences.find(function(e){return e.id===r.experience});lines.push('## '+r.title,'구분: '+(r.kind==='required'?'필수':'우대'),'상태: '+states[r.status],'할 일: '+(r.done?'[완료] ':'')+r.task);if(e)lines.push('경험: '+e.title,'문제: '+e.problem,'내 역할: '+e.role,'판단: '+e.decision,'결과: '+e.result,'증빙: '+e.url);lines.push('')});SYNC.save('지원준비_'+today()+'.md',lines.join('\n'),'text/markdown')};
  }
  $('#experience-clear').onclick=function(){editing='';view()};
  $('#career-experience').onsubmit=function(ev){ev.preventDefault();var title=$('#experience-title').value.trim();if(!title){toast('경험 제목을 입력하세요.');return}var old=S.experiences.find(function(x){return x.id===editing}),x={id:old?old.id:uid(),title:title,problem:$('#experience-problem').value,role:$('#experience-role').value,decision:$('#experience-decision').value,result:$('#experience-result').value,url:$('#experience-url').value.trim(),ts:stamp(old?.ts)};if(old)S.experiences=S.experiences.filter(function(e){return e.id!==old.id});S.experiences.push(x);if(!link(x.url))S.board.forEach(function(j){data(j).requirements.forEach(function(r){if(r.experience===x.id&&r.status==='proof'){r.status='draft';j.ts=stamp(j.ts)}})});editing='';done(save())};
  $$('[data-edit]').forEach(function(b){b.onclick=function(){editing=b.dataset.edit;view();$('#experience-title').focus()}});
  $$('[data-delete]').forEach(function(b){b.onclick=function(){if(!confirm('경험을 삭제하고 연결된 요건을 정리 필요로 바꿀까요?'))return;var id=b.dataset.delete;markDeleted('experiences',id);S.experiences=S.experiences.filter(function(e){return e.id!==id});S.board.forEach(function(j){data(j).requirements.forEach(function(r){if(r.experience===id){r.experience='';r.status='draft';j.ts=stamp(j.ts)}})});editing='';done(save())}});
 }
 return {view:view,summary:summary};
})();
