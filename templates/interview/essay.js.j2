/* ---------- 자소서 ---------- */
var esG='';
function essayId(e,i){return e.id||'e'+i}
function essaySnapshot(r){if(!r||typeof r.t!=='string')return;r.history=r.history||[];if(!r.history.length||r.history[r.history.length-1].t!==r.t)r.history.push({t:r.t,ts:r.ts||Date.now()});r.history=r.history.slice(-5)}

function essay(g){
  var ES=P.essays||[],XP=P.experiences||[],XN={},changed=false;ES.forEach(function(e,i){var id=essayId(e,i),old=S.essay['e'+i],cur=S.essay[id];if(id!=='e'+i&&old&&(!old.migratedTo||old.migratedTo===id)&&(!cur||(old.ts||0)>(cur.ts||0))){old.migratedTo=id;S.essay[id]=JSON.parse(JSON.stringify(old));changed=true}else if(!cur&&e.draft){S.essay[id]={t:e.draft,st:'draft',x:(e.x||[]).slice(0,1),ts:1,seed:true};changed=true}});if(changed)save();XP.forEach(function(x){XN[x.id]=x});
  var groups=[];ES.forEach(function(e){if(groups.indexOf(e.g)<0)groups.push(e.g)});if(groups.indexOf(g)<0)g='';
  var used={};ES.forEach(function(e,i){var r=S.essay[essayId(e,i)];(r&&r.x||[]).forEach(function(x){used[x]=(used[x]||0)+1})});
  var st=function(i){var r=S.essay[essayId(ES[i],i)];return r&&r.st||''};
  var cnt={done:0,draft:0};ES.forEach(function(e,i){if(st(i))cnt[st(i)]++});
  var h='<h1>자소서 문항 은행</h1><p class="sub">자주 나오는 자소서 문항 '+ES.length+'개입니다. 회사별 실제 문항과 글자 수는 공고에서 확인하세요. 기존 글은 보존하고 빈 문항에는 자료 기반 초안을 제공합니다. 대괄호와 경험·포부를 확인해 수정하세요. 입력 즉시 이 브라우저에 저장되며, 기기 간 이동은 백업 가져오기가 필요합니다.</p>';
  h+='<div class="grid g4"><div class="card kpi"><b>'+cnt.done+'<span class="small"> / '+ES.length+'</span></b><span>완성</span></div><div class="card kpi"><b>'+cnt.draft+'</b><span>초안</span></div><div class="card kpi"><b>'+wget('essay')+'<span class="small"> / '+(((P.weekly||[]).filter(function(w){return w.id==='essay'})[0]||{}).target||5)+'</span></b><span>이번 주 완성</span></div><div class="card kpi"><b>'+Object.keys(used).length+'<span class="small"> / '+XP.length+'</span></b><span>쓴 핵심 경험</span></div></div>';
  h+='<h2>핵심 경험 사용 횟수 <span class="muted small">한 경험에 몰리지 않게</span></h2><div class="chips">'+XP.map(function(x){return '<span class="chip" title="'+esc(x.hint)+'" style="cursor:default">'+esc(x.name)+' · '+(used[x.id]||0)+'</span>'}).join('')+'</div>';
  var rows=ES.map(function(e,i){return {e:e,i:i,x:((S.essay[essayId(e,i)]||{}).x)||[]}}).filter(function(r){return !g||r.e.g===g});
  h+='<details class="card" style="margin-top:14px"'+(rows.some(function(r){return r.x.length})?' open':'')+'><summary><b>문항 ↔ 경험 매칭표</b> <span class="muted small">'+(g||'전체')+' · 한 경험을 세 문항 넘게 쓰면 빨간색</span></summary><div style="overflow-x:auto;margin-top:10px"><table style="width:100%;border-collapse:collapse;font-size:13px"><tr><th style="text-align:left;padding:6px 4px">문항</th>'+XP.map(function(x){return '<th style="padding:6px 4px;white-space:nowrap;color:'+((used[x.id]||0)>3?'var(--bad)':'var(--muted)')+'">'+esc(x.name.split(' · ')[0])+'<br><span class="small">'+(used[x.id]||0)+'</span></th>'}).join('')+'</tr>'+
    rows.map(function(r){return '<tr style="border-top:1px solid var(--line)"><td style="padding:6px 4px;max-width:340px">'+(r.i+1)+'. '+esc(r.e.q.length>34?r.e.q.slice(0,33)+'…':r.e.q)+(r.x.length?'':' <span class="small" style="color:var(--bad)">경험 미정</span>')+'</td>'+XP.map(function(x){var on=r.x.indexOf(x.id)>=0,rec=(r.e.x||[]).indexOf(x.id)>=0;return '<td style="text-align:center"><button class="xbtn" data-mx="'+essayId(r.e,r.i)+'" data-xx="'+x.id+'" title="'+(rec?'추천 경험':'')+'" style="width:26px;height:26px;border-radius:7px;border:1px solid '+(on?'var(--ink)':'var(--line)')+';background:'+(on?'var(--ink)':rec?'var(--soft)':'transparent')+';color:'+(on?'var(--on-ink)':'var(--faint)')+'">'+(on?'●':rec?'·':'')+'</button></td>'}).join('')+'</tr>'}).join('')+'</table></div><div class="row" style="margin-top:10px;justify-content:space-between"><span class="faint small">· = 문항별 추천 경험. 칸을 누르면 경험을 넣고 뺍니다.</span><button class="btn sm" id="mxauto">빈 문항 자동 배치</button></div></details>';
  h+='<div class="chips" style="margin:18px 0 12px"><button class="chip'+(g?'':' on')+'" data-eg="">전체</button>'+groups.map(function(x){return '<button class="chip'+(x===g?' on':'')+'" data-eg="'+esc(x)+'">'+esc(x)+'</button>'}).join('')+'<button class="btn sm ghost" id="etxt" style="margin-left:auto">쓴 글 전체 .txt로 받기</button></div><div class="grid">';
  ES.forEach(function(e,i){if(g&&e.g!==g)return;var id=essayId(e,i),r=S.essay[id]||{},t=r.t||'',x=r.x||[];
    h+='<details class="card qcard es"'+(t&&!r.st?'':'')+'><summary><b>'+(i+1)+'. '+esc(e.q)+'</b><span class="tag">'+esc(e.g)+'</span><span class="tag'+(r.st==='done'?' bank':r.st==='draft'?' trend':'')+'">'+(r.st==='done'?'완성':r.st==='draft'?'초안':'안 씀')+'</span></summary><div class="qbody">'+
      '<div class="guide">'+esc(e.tip||'')+'<p>'+esc(e.verify||'')+'</p>'+(e.sources||[]).map(function(x){return /^https:\/\//.test(x.url)?'<a target="_blank" rel="noopener" href="'+esc(x.url)+'">'+esc(x.title)+'</a>':''}).join(' · ')+'</div><div class="lbl">쓸 경험 고르기 <span class="faint">(추천: '+(e.x||[]).map(function(k){return esc((XN[k]||{}).name||k)}).join(', ')+')</span></div><div class="chips">'+XP.map(function(xx){return '<button class="xp'+(x.indexOf(xx.id)>=0?' on':'')+'" data-ex="'+id+'" data-x="'+xx.id+'" title="'+esc(xx.hint)+'">'+esc(xx.name)+'</button>'}).join('')+'</div>'+
      (e.draft?'<details class="consult" style="margin:12px 0"><summary>새로 작성한 초안 비교·적용</summary><p style="white-space:pre-wrap">'+esc(e.draft)+'</p><button class="btn sm ghost" data-eseed="'+id+'">이 초안을 내 글로 가져오기</button></details>':'')+'<div class="small muted">'+esc((e.outline||[]).join(' → '))+'</div><textarea aria-label="'+esc(e.q)+'" data-es="'+id+'" data-n="'+(e.n||0)+'" placeholder="'+esc(e.n?e.n+'자 안팎으로 써 보세요':'')+'">'+esc(t)+'</textarea><div class="row" style="justify-content:space-between;margin-top:6px"><span class="cnt" data-cnt="'+id+'"></span><select class="st-sel" data-est="'+id+'" aria-label="진행 상태"><option value="">안 씀</option><option value="draft"'+(r.st==='draft'?' selected':'')+'>초안</option><option value="done"'+(r.st==='done'?' selected':'')+'>완성</option></select></div><div class="row" style="margin-top:8px"><button class="btn sm" data-esave="'+id+'">저장·버전 남기기</button><button class="btn ghost sm" data-ehistory="'+id+'">이전 버전 복원</button><span class="small muted" data-esstatus="'+id+'" role="status">'+(r.ts>1?'마지막 수정 '+new Date(r.ts).toLocaleString():'자료 기반 초안 · 제출 전 확인 필요')+'</span></div></div></details>'});
  h+='</div>';
  $('#app').innerHTML=h;
  var put=function(id,f){var r=S.essay[id]||(S.essay[id]={});f(r);r.ts=stamp(r.ts);return save()};
  var count=function(ta){var v=ta.value,n=+ta.dataset.n,c=$('[data-cnt="'+ta.dataset.es+'"]');c.textContent='공백 포함 '+v.length+'자 · 제외 '+v.replace(/\s/g,'').length+'자'+(n?' / '+n+'자':'');c.classList.toggle('over',!!n&&v.length>n)};
  $$('[data-es]').forEach(function(ta){count(ta);ta.onfocus=function(){essaySnapshot(S.essay[ta.dataset.es])};ta.oninput=function(){count(ta);var ok=put(ta.dataset.es,function(r){r.t=ta.value;r.seed=false;if(ta.value&&!r.st)r.st='draft'});$('[data-esstatus="'+ta.dataset.es+'"]').textContent=ok?'저장됨 · '+new Date().toLocaleTimeString():'저장 실패 · 백업을 내려받으세요.'}});
  $$('[data-eseed]').forEach(function(b){b.onclick=function(){var id=b.dataset.eseed,e=ES.filter(function(x,i){return essayId(x,i)===id})[0],r=S.essay[id];if(r&&r.t&&!confirm('현재 글을 이전 버전으로 남기고 새 초안을 적용할까요?'))return;essaySnapshot(r);put(id,function(x){x.t=e.draft;x.st='draft';x.seed=true});essay(g)}});
  $$('[data-esave]').forEach(function(b){b.onclick=function(){var r=S.essay[b.dataset.esave];essaySnapshot(r);if(save())toast('현재 버전을 저장했습니다.')}});
  $$('[data-ehistory]').forEach(function(b){b.onclick=function(){var id=b.dataset.ehistory,r=S.essay[id],versions=(r.history||[]).filter(function(x){return x.t!==r.t});if(!versions.length)return toast('다른 이전 버전이 없습니다.');if(!confirm('직전 버전으로 복원할까요? 현재 글도 버전으로 남깁니다.'))return;var old=versions[versions.length-1].t;essaySnapshot(r);put(id,function(x){x.t=old});essay(g)}});
  $$('[data-ex]').forEach(function(b){b.onclick=function(){put(b.dataset.ex,function(r){r.x=r.x||[];var k=r.x.indexOf(b.dataset.x);if(k>=0)r.x.splice(k,1);else r.x.push(b.dataset.x)});b.classList.toggle('on')}});
  $$('[data-est]').forEach(function(sel){sel.onchange=function(){var id=sel.dataset.est,prev=(S.essay[id]||{}).st;put(id,function(r){r.st=sel.value});if(sel.value==='done'&&prev!=='done'){wadd('essay',1);toast('완성! 이번 주 자소서 +1')}else if(prev==='done'&&sel.value!=='done')wadd('essay',-1);var y=window.scrollY;essay(g);window.scrollTo(0,y)}});
  $$('[data-eg]').forEach(function(b){b.onclick=function(){location.hash='#/essay'+(b.dataset.eg?'/'+encodeURIComponent(b.dataset.eg):'')}});
  $$('[data-mx]').forEach(function(b){b.onclick=function(){put(b.dataset.mx,function(r){r.x=r.x||[];var k=r.x.indexOf(b.dataset.xx);if(k>=0)r.x.splice(k,1);else r.x.push(b.dataset.xx)});var y=window.scrollY;essay(g);window.scrollTo(0,y)}});
  $('#mxauto').onclick=function(){var cnt={};XP.forEach(function(x){cnt[x.id]=used[x.id]||0});var n=0;
    rows.forEach(function(r){if(r.x.length)return;var cand=(r.e.x&&r.e.x.length?r.e.x:XP.map(function(x){return x.id})).slice().sort(function(a,b){return (cnt[a]||0)-(cnt[b]||0)});var pick=cand[0];if(!pick)return;cnt[pick]=(cnt[pick]||0)+1;put(essayId(r.e,r.i),function(o){o.x=[pick]});n++});
    toast(n?'경험을 덜 쓴 순서로 '+n+'문항에 배치했습니다.':'빈 문항이 없습니다.');var y=window.scrollY;essay(g);window.scrollTo(0,y)};
  $('#etxt').onclick=function(){var out=ES.map(function(e,i){var r=S.essay[essayId(e,i)];return r&&r.t?(i+1)+'. '+e.q+'\n['+(r.st==='done'?'완성':'초안')+' · '+r.t.length+'자]\n\n'+r.t+'\n':''}).filter(Boolean).join('\n----------\n\n');
    if(!out){toast('아직 쓴 글이 없습니다.');return}SYNC.save('자소서_'+today()+'.txt',out,'text/plain')}
}
