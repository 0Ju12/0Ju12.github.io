/* Personal drafts use the same browser storage and encrypted-backup lifecycle. */
function getAnswer(q){var r=S.answers[q.id];return r&&!r.useOriginal?r.text:(q.a||'')}
function answerEstimate(text){return Math.round(String(text||'').length/6.5)}
function answerEditor(q){var text=getAnswer(q),r=S.answers[q.id];return '<details class="consult" style="margin-top:12px"><summary>내 답변으로 수정 · 약 1분 초안</summary><p class="muted small">입력한 답변은 이 브라우저에 저장됩니다. 다른 기기는 기록 백업으로 옮기세요. 예상 시간은 글자 수 기준이며 실제 말하기와 다를 수 있습니다.</p><textarea rows="8" data-answer="'+esc(q.id)+'" aria-label="'+esc(q.q)+' 답변 수정">'+esc(text)+'</textarea><div class="row" style="justify-content:space-between;margin-top:8px"><span class="muted small" data-answer-count="'+esc(q.id)+'">'+text.length+'자 · 약 '+answerEstimate(text)+'초</span><span><button class="btn sm" data-save-answer="'+esc(q.id)+'">답변 저장</button> <button class="btn sm ghost" data-reset-answer="'+esc(q.id)+'">원래 초안으로</button></span></div><div class="small muted" data-answer-status="'+esc(q.id)+'" role="status">'+(r&&!r.useOriginal?'내가 수정한 답변':'원본 초안')+'</div></details>'}
function showEditedAnswer(q){$$('[data-answer-output]').forEach(function(e){if(e.dataset.answerOutput===q.id)e.textContent=getAnswer(q)});$$('[data-answer-count]').forEach(function(e){if(e.dataset.answerCount===q.id)e.textContent=getAnswer(q).length+'자 · 약 '+answerEstimate(getAnswer(q))+'초'})}
function editAnswer(id,text,useOriginal){S.answers[id]={text:text,ts:stamp((S.answers[id]||{}).ts),useOriginal:!!useOriginal};if(Q[id])showEditedAnswer(Q[id])}
var answerSaveTimer;
document.addEventListener('input',function(e){var el=e.target;if(!el.matches||!el.matches('[data-answer]'))return;editAnswer(el.dataset.answer,el.value,false);clearTimeout(answerSaveTimer);answerSaveTimer=setTimeout(function(){var ok=save();$$('[data-answer-status]').forEach(function(x){if(x.dataset.answerStatus===el.dataset.answer)x.textContent=ok?'이 브라우저에 저장했습니다.':'저장하지 못했습니다. 답변을 복사해 보관하세요.'})},400)});
document.addEventListener('click',function(e){var b=e.target.closest&&e.target.closest('[data-save-answer],[data-reset-answer]');if(!b)return;var id=b.dataset.saveAnswer||b.dataset.resetAnswer,q=Q[id];if(!q)return;clearTimeout(answerSaveTimer);
  if(b.dataset.resetAnswer){editAnswer(id,'',true);$$('[data-answer]').forEach(function(x){if(x.dataset.answer===id)x.value=q.a||''})}
  if(save()){toast(b.dataset.resetAnswer?'원래 초안으로 되돌렸습니다.':'내 답변을 저장했습니다.');$$('[data-answer-status]').forEach(function(x){if(x.dataset.answerStatus===id)x.textContent=b.dataset.resetAnswer?'원본 초안':'내가 수정한 답변 · 저장 완료'})}
});
function exportDrafts(markdown){var rows=QS.map(function(q){return {id:q.id,c:q.c,g:q.g,q:q.q,a:getAnswer(q),sources:q.sources||[],verify:q.verify||'',tail:q.tail||[],target_seconds:60}});if(markdown){var text='# 내 면접 답변 초안\n\n'+rows.map(function(q,i){return '## '+(i+1)+'. '+q.q+'\n\n'+q.a+'\n\n'+(q.verify?'확인·수정: '+q.verify+'\n':'')}).join('\n');return SYNC.save('interview-drafts-'+today()+'.md',text,'text/markdown')}
return SYNC.save('interview-drafts-'+today()+'.json',JSON.stringify({schema_version:1,title:'내가 수정한 면접 답변',questions:rows},null,2),'application/json')}
async function importDrafts(file){if(!file)return;if(file.size>5*1024*1024)throw new Error('크기');var d=JSON.parse(await file.text());if(d.schema_version!==1||!Array.isArray(d.questions)||d.questions.length>5000)throw new Error('형식');var byText={};QS.forEach(function(q){byText[q.q]=q});var changes=[];d.questions.forEach(function(row){if(!row||typeof row.q!=='string'||typeof row.a!=='string'||row.a.length>20000)throw new Error('형식');var q=Q[row.id]||byText[row.q];if(q)changes.push([q.id,row.a])});changes.forEach(function(x){editAnswer(x[0],x[1],false)});if(!save())throw new Error('저장');return {changed:changes.length,skipped:d.questions.length-changes.length}}
function draftsView(){var a=D.personal_analysis||{},items=QS.filter(function(q){return q.kind==='draft'});if(!items.length)items=QS;
  var h='<h1>내 답변 초안</h1><p class="sub">자료에 근거한 약 1분 답변을 읽고 내 말로 바꿔 보세요. 초안의 자기평가·지원동기·계획은 제안이며 본인의 생각과 맞게 수정해야 합니다.</p>';
  if(D.draft_scope)h+='<div class="guide">'+esc(D.draft_scope)+'</div>';
  if(a.positioning)h+='<section class="card" style="margin-top:15px"><b>자료에서 정리한 나의 중심 메시지</b><p>'+esc(a.positioning)+'</p><div class="grid g2"><div><b>강점으로 연결할 근거</b><ul>'+((a.strengths)||[]).map(function(x){return '<li>'+esc(x)+'</li>'}).join('')+'</ul></div><div><b>면접 전에 확인할 점</b><ul>'+((a.facts_to_confirm)||[]).map(function(x){return '<li>'+esc(x)+'</li>'}).join('')+'</ul></div></div></section>';
  h+='<div class="row" style="margin:16px 0"><select class="field" id="draft-pool" aria-label="초안 모의 면접 범위" style="max-width:180px"><option value="">전체 초안</option><option value="인성">자기소개·인성</option><option value="프로젝트">프로젝트</option><option value="전문지식">기술·AI 트렌드</option><option value="기타">기업별 지원동기</option></select><button class="btn" id="draft-mock">초안으로 1분 모의 면접</button><button class="btn ghost" id="draft-json">답변 JSON 내보내기</button><button class="btn ghost" id="draft-md">답변 문서 내보내기</button><label class="btn ghost">수정한 JSON 가져오기<input id="draft-import" type="file" accept=".json" hidden></label></div><input class="search" id="draft-search" type="search" placeholder="질문·주제·답변 검색" aria-label="초안 검색"><p class="small muted" id="draft-count"></p><div class="grid" id="draft-list"></div>';
  $('#app').innerHTML=h;
  function draw(){var term=$('#draft-search').value.trim().toLowerCase();var rows=items.filter(function(q){return !term||(q.q+' '+q.g+' '+getAnswer(q)).toLowerCase().indexOf(term)>=0});$('#draft-count').textContent=rows.length+'문항 · 수정 '+rows.filter(function(q){return S.answers[q.id]&&!S.answers[q.id].useOriginal}).length+'문항';$('#draft-list').innerHTML=rows.length?rows.map(function(q){return '<details class="card qcard"><summary><span class="tag">'+esc(q.g)+'</span><b>'+esc(q.q)+'</b></summary><div class="qbody">'+answerHTML(q)+'</div></details>'}).join(''):'<p class="empty">검색 결과가 없습니다.</p>'}
  draw();$('#draft-search').oninput=draw;$('#draft-json').onclick=function(){exportDrafts(false)};$('#draft-md').onclick=function(){exportDrafts(true)};$('#draft-mock').onclick=function(){startMock(shuffle(items.filter(function(q){return !$('#draft-pool').value||q.c===$('#draft-pool').value})).slice(0,5),{sec:60,rec:false,label:'내 1분 답변 초안'})};$('#draft-import').onchange=async function(e){var f=e.target.files[0];e.target.value='';try{var n=await importDrafts(f);draftsView();toast(n.changed+'개 답변을 반영했습니다. 일치하는 질문 없음 '+n.skipped+'개.')}catch(_){toast('답변 파일의 형식·크기 또는 저장 공간을 확인하세요.')}};
}
