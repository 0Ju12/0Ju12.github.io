/* Local design iteration: derived views do not change the record schema. */
var DESIGN_REVIEW=(function(){
 var connectionsOpen=false;
 function recent(){return Object.entries(S.algoDrafts||{}).filter(function(x){return /^(swea|boj)-\d+$/.test(x[0])}).sort(function(a,b){return (b[1].ts||0)-(a[1].ts||0)}).slice(0,3)}
 function openNumber(n){location.hash='#/algo';var tries=0;function open(){if(SWCAT&&$('#sw-work')){var p=SWCAT.items.find(function(p){return p.number===n});if(p)openSweaWork(p);return}if(++tries<50)setTimeout(open,100)}setTimeout(open,0)}
 function home(){var host=$('#app');if(!host||location.hash&&location.hash!=='#/'&&location.hash!=='#')return;var rows=recent(),first=rows[0];var panel=document.createElement('section');panel.className='review-start';panel.innerHTML='<div><span class="eyebrow">CONTINUE YOUR WORK</span><h2>오늘은 여기서 이어가세요</h2><p>'+(first?'최근 작성한 '+(first[0].startsWith('boj-')?'백준 ':'SWEA ')+first[0].split('-')[1]+'번 풀이가 있습니다.':'작은 작업 하나를 정하고 시작해 보세요.')+'</p><button class="btn" id="review-resume">'+(first?'최근 풀이 계속하기':'오늘 할 일 확인')+'</button></div><div class="review-actions"><a href="#/review">복습할 강의 확인 →</a><a href="#/essay">지원서 이어 쓰기 →</a><a href="#/mock">면접 답변 연습 →</a></div>';host.prepend(panel);$('#review-resume').onclick=function(){if(first){if(first[0].startsWith('boj-'))location.hash='#/boj/'+first[0].split('-')[1];else openNumber(Number(first[0].split('-')[1]));}else{var target=host.querySelector('.review-start + *');if(target)target.scrollIntoView({behavior:'smooth'})}};
 }
 function search(){var dialog=document.createElement('dialog');dialog.className='review-search';dialog.innerHTML='<form method="dialog"><button class="btn ghost sm" style="float:right">닫기</button><h2>내 준비 자료 찾기</h2></form><label>검색어<input id="review-query" class="field" placeholder="문제 번호, 면접 질문, 노트 제목"></label><p class="small muted">잠금 해제된 현재 공간의 자료만 검색합니다.</p><div id="review-results"></div>';document.body.append(dialog);var button=document.createElement('button');button.className='iconbtn';button.textContent='자료 검색';button.onclick=function(){dialog.showModal();$('#review-query').focus()};document.querySelector('.top .in').append(button);$('#review-query').oninput=function(){var q=this.value.trim().toLowerCase(),results=$('#review-results');results.replaceChildren();if(!q)return;var items=QS.map(function(x){return {title:x.q,kind:'면접',url:'#/questions/'+encodeURIComponent(x.c)}});if(STUDY)items=items.concat(STUDY.notes.map(function(n){return {title:n.title+' '+(n.sections||[]).join(' '),kind:'강의',url:'notes/'+n.slug+'.html'}}));items=items.concat((SWCAT?.items||[]).map(function(p){return {title:p.number+' '+p.title,kind:'알고리즘',number:p.number}}));items=items.concat(Object.entries(S.algoDrafts||{}).filter(function(x){return /^boj-\d+$/.test(x[0])}).map(function(x){return {title:x[0].slice(4)+' '+(x[1].title||'백준 문제'),kind:'백준',url:'#/boj/'+x[0].slice(4)}}));var hits=items.filter(function(x){return x.title.toLowerCase().includes(q)}).slice(0,30);for(var x of hits){var b=document.createElement('button');b.className='review-result';b.textContent=x.kind+' · '+x.title;b.onclick=(function(item){return function(){dialog.close();if(item.number)openNumber(item.number);else location.href=item.url}})(x);results.append(b)}if(!hits.length)results.textContent='검색 결과가 없습니다. 알고리즘 목록은 알고리즘 화면을 한 번 열면 검색됩니다.'};
 }
 function connections(){var drive=$('#algo-drive-panel'),github=$('#algo-github-panel');if(!drive||!github||drive.closest('details.review-connections'))return;var wrap=document.createElement('details');wrap.className='review-connections';wrap.open=connectionsOpen;wrap.ontoggle=function(){if(wrap.isConnected)connectionsOpen=wrap.open};var summary=document.createElement('summary');summary.textContent='저장 연결 설정 · Google Drive / GitHub';drive.before(wrap);wrap.append(summary,drive,github)}
 search();return {home:home,connections:connections};
})();
