      if(co.questions&&co.questions.length)h+='<div><div class="lbl" style="margin-top:0">질문 예시</div><ul>'+co.questions.map(function(t){return '<li>'+esc(t.q)+(t.src?'<span class="src">· '+esc(t.src)+'</span>':'')+'</li>'}).join('')+'</ul><button class="btn sm ghost" style="margin-top:8px" data-jq="'+key+'">이 회사 질문으로 모의 면접</button></div>';
      if(co.fit)h+='<div class="fit"><b>내 준비 포인트</b> · '+esc(co.fit)+'</div>';
      if(co.consult)h+='<details class="consult"'+(focus===x.id+':'+ci?' open':'')+'><summary>면접 컨설팅 — 인재상에 내 경험 연결하기</summary>'+(co.consult.map&&co.consult.map.length?'<div class="lbl">인재상 → 내 경험</div><ul>'+co.consult.map.map(function(t){return '<li>'+esc(t)+'</li>'}).join('')+'</ul>':'')+(co.consult.ask&&co.consult.ask.length?'<div class="lbl">이 회사라서 나올 질문</div><ul>'+co.consult.ask.map(function(t){return '<li>'+esc(t)+'</li>'}).join('')+'</ul>':'')+(co.consult.tip?'<div class="lbl">준비 포인트</div><div style="font-size:14px">'+esc(co.consult.tip)+'</div>':'')+'</details>';
      if(co.links&&co.links.length)h+='<div class="links">'+co.links.map(function(l){return '<a href="'+esc(l.url)+'" target="_blank" rel="noopener">'+esc(l.label)+' ↗</a>'}).join('')+'</div>';
      h+='</div>';});
    h+='</div>';});
  if(!shown)h+='<div class="card empty">"'+esc(jobQ)+'"에 맞는 기관이 없습니다.</div>';
  if(R.guides)h+='<h2>답변 구조 참고</h2><div class="grid">'+R.guides.map(function(g){return '<div class="card"><a href="'+esc(g.url)+'" target="_blank" rel="noopener"><b>'+esc(g.label)+' ↗</b></a><div class="muted small">'+esc(g.note||'')+'</div></div>'}).join('')+'</div>';
  $('#app').innerHTML=h;
  $$('[data-s]').forEach(function(b){b.onclick=function(){location.hash='#/jobs'+(b.dataset.s?'/'+b.dataset.s:'')}});
  $('#jsort').onclick=function(){jobSort=jobSort==='fit'?'base':'fit';jobs(focus||sec)};
  if(focus){var fe=document.getElementById('co-'+focus.replace(':','-'));if(fe){setTimeout(function(){fe.scrollIntoView({block:'start'});fe.classList.add('hl');setTimeout(function(){fe.className=fe.className.replace(' hl','')},2200)},30)}}
  var ji=$('#jq');ji.onchange=function(){jobQ=ji.value;jobs(sec)};ji.onkeydown=function(e){if(e.key==='Enter'){jobQ=ji.value;jobs(sec)}};
  $$('[data-jq]').forEach(function(b){b.onclick=function(){var k=b.dataset.jq.split('-'),x=SS.filter(function(s){return s.id===k[0]})[0],co=x.companies[+k[1]];
    var src=(co.questions||[]).concat(((co.consult||{}).ask||[]).map(function(q){return {q:q,src:'면접 컨설팅 예상 질문'}}));
    var qs=src.map(function(t,i){var id='j:'+k[0]+':'+k[1]+':'+i;var q={id:id,c:'기타',g:co.name,q:t.q,a:'',guide:'출처: '+(t.src||'')+' / '+(co.fit||''),kind:'skeleton'};Q[id]=q;return q});
    startMock(qs,{sec:90,rec:false,label:co.name})}});
}

/* ---------- 기록 ---------- */
function log(){
  var h='<h1>기록</h1><p class="sub">연습 기록·메모·별표는 이 브라우저(localStorage)에만 있습니다. 다른 기기로 옮기려면 아래 [기기 옮기기]를 쓰세요.</p>';
  h+='<div class="card" style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:14px"><tr style="color:var(--muted);text-align:left"><th style="padding:6px 0">묶음</th><th>질문</th><th>연습</th><th>익힘</th><th>메모</th></tr>'+GROUPS.map(function(g){var qs=QS.filter(function(q){return q.g===g});return '<tr><td style="padding:6px 0"><b>'+esc(g)+'</b></td><td>'+qs.length+'</td><td>'+qs.filter(function(q){return S.q[q.id]}).length+'</td><td>'+qs.filter(function(q){var r=S.q[q.id];return r&&r.b>=3}).length+'</td><td>'+qs.filter(function(q){return S.memo[q.id]}).length+'</td></tr>'}).join('')+'</table></div>';
  var sy=SYNC.ui('interview',function(){return S},function(d){var n=mergeState(S,d);fix();save();return n},function(n){toast('합쳤습니다. 새로 들어온 항목 '+n+'개.');log()});
  h+=sy.html;
  $('#app').innerHTML=h;
  sy.bind(function(){if(confirm('면접 준비 기록·메모·자소서를 모두 지울까요? 되돌릴 수 없습니다.')){S=blank();save();log()}});
}

(function(){var r=document.documentElement,t=null;try{t=localStorage.getItem('theme')}catch(_){}if(t)r.dataset.theme=t;
  $('#theme').onclick=function(){var dark=r.dataset.theme?r.dataset.theme==='dark':matchMedia('(prefers-color-scheme: dark)').matches;r.dataset.theme=dark?'light':'dark';try{localStorage.setItem('theme',r.dataset.theme)}catch(_){}}})();
route();
})();
</script>
