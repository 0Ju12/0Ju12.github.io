<body>
<header class="top"><div class="in">
  <a class="brand" href="#/">면접 준비</a>
  <nav class="tabs" id="tabs" aria-label="면접 준비 메뉴"><a href="#/" data-v="home">오늘</a><a href="#/questions" data-v="questions">질문</a><a href="#/mock" data-v="mock">모의<span class="hide-m"> 면접</span></a><a href="#/decks" data-v="decks">발표</a><a href="#/essay" data-v="essay">자소서</a><a href="#/jobs" data-v="jobs">공채<span class="hide-m"> 정보</span></a><a href="#/tools" data-v="tools">도구</a><a href="#/opic-exam" data-v="opic-exam">OPIc 실전</a><a href="#/drafts" data-v="drafts">내 답변 초안</a><a href="#/sources" data-v="sources">자료 현황</a></nav>
  <select class="iconbtn" id="role" aria-label="지원 직무"></select>
  <button class="iconbtn" id="theme" type="button" aria-label="화면 테마 바꾸기">◐</button>
  <a class="iconbtn hide-m" href="../study/index.html">강의 노트</a>
</div></header>
<main id="app" aria-live="polite"></main>
<div id="pres" role="dialog" aria-label="발표자 모드"></div>
<div id="print" aria-hidden="true"></div>
<div class="toast" id="toast" role="status"></div>
<script id="data" type="application/json">{{ app|tojson }}</script>
<script>
(function(){
'use strict';
var D=JSON.parse(document.getElementById('data').textContent),QS=D.questions,DECKS=D.decks;
var $=function(s,r){return (r||document).querySelector(s)},$$=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))};
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
var Q={};QS.forEach(function(q){Q[q.id]=q});
var CATS=D.cats||['인성','프로젝트','전문지식','기타'];
var GROUPS=[];QS.forEach(function(q){if(GROUPS.indexOf(q.g)<0)GROUPS.push(q.g)});
function groupsOf(c){var g=[];QS.forEach(function(q){if((!c||q.c===c)&&g.indexOf(q.g)<0)g.push(q.g)});return g}
var KIND={mine:'내 답변',skeleton:'답변 뼈대',trend:'AI 트렌드',bank:'참고 답변',opic:'OPIc 답변 틀',draft:'자료 기반 1분 초안'};var P=D.prep||{};
function answerHTML(q,full){
  var h='';
  if(q.intent)h+='<div class="intent"><b>질문 의도</b> · '+esc(q.intent)+'</div>';
  if(q.kind==='bank'){
    if(q.exp)h+='<div class="lbl">예상 답변 (흔히 나오는 답)</div><div class="ans exp" style="margin-top:0">'+esc(q.exp)+'</div>';
    h+='<div class="lbl">참고 답변 · 본인 경험에 맞춰 검토</div><div class="ans best" data-answer-output="'+esc(q.id)+'" style="margin-top:0">'+esc(getAnswer(q))+'</div>';
  }else if(getAnswer(q))h+='<div class="lbl">'+(q.kind==='mine'?'내 답변':q.kind==='skeleton'?'답변 뼈대 (포트폴리오 사실)':q.kind==='opic'?'답변 틀 (이 순서로 영어로 말하기)':q.kind==='draft'?'자료 기반 1분 초안 · 수정 가능':'답변 예시')+'</div><div class="ans" data-answer-output="'+esc(q.id)+'" style="margin-top:0">'+esc(getAnswer(q))+'</div>';
  else h+='<p class="muted small">아직 답변이 없습니다. 아래에 내 답을 적어 보세요.</p>';
  if(q.guide)h+='<div class="lbl">'+(q.kind==='bank'?'왜 이렇게 답하나':'답변 가이드')+'</div><div class="guide" style="margin-top:0">'+esc(q.guide)+'</div>';
  if(full!==false&&q.tail&&q.tail.length)h+='<div class="lbl">예상 꼬리질문</div><ul class="tails">'+q.tail.map(function(t){return '<li>'+esc(t)+'</li>'}).join('')+'</ul>';
  if(q.verify)h+='<div class="guide"><b>본인 확인·수정</b> · '+esc(q.verify)+'</div>';
  if(q.sources&&q.sources.length)h+='<div class="links" style="margin-top:10px">'+q.sources.filter(function(x){return /^https:\/\//.test(x.url||'')}).map(function(x){return '<a href="'+esc(x.url)+'" target="_blank" rel="noopener">'+esc(x.title)+' ↗</a>'}).join('')+'</div>';
  h+=answerEditor(q);
  return h;
}
var INTERVAL=[0,1,3,7,14,30];
{% include '_sync.js.j2' %}

{% include 'interview/state.js.j2' %}
{% include 'interview/answers.js.j2' %}
function today(o){var d=new Date();d.setDate(d.getDate()+(o||0));return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}
function toast(t){var el=$('#toast');el.textContent=t;el.style.display='block';clearTimeout(toast.t);toast.t=setTimeout(function(){el.style.display='none'},2600)}
function record(id,res){var r=S.q[id]||{b:0,n:0,ok:0};r.n++;r.s=res;r.last=today();
  if(res==='ok'){r.ok++;r.b=Math.min(5,(r.b||0)+1);r.due=today(INTERVAL[r.b])}else if(res==='mid'){r.b=Math.max(1,r.b||0);r.due=today(1)}else{r.b=1;r.due=today()}
  S.q[id]=r;S.days[today()]=(S.days[today()]||0)+1;save()}
function due(){return QS.filter(function(q){var r=S.q[q.id];return r&&r.due&&r.due<=today()})}
function shuffle(a){for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t}return a}

/* 직무 선택 */
var roleSel=$('#role');Object.keys(D.roles).forEach(function(k){var o=document.createElement('option');o.value=k;o.textContent=D.roles[k];roleSel.appendChild(o)});
if(!S.role||!D.roles[S.role])S.role=Object.keys(D.roles)[0]||'';roleSel.value=S.role;
roleSel.onchange=function(){S.role=roleSel.value;save();route()};

/* ---------- 라우팅 ---------- */
var keyHandler=null,timer=null;
function route(){
  if(timer){clearInterval(timer);timer=null}discardRecording();if(typeof srStop==='function')srStop();
  var h=location.hash.replace(/^#\/?/,''),p=h.split('/'),v=p[0]||'home';
  var TV={deck:'decks',board:'tools',cv:'tools',algo:'tools',ncs:'tools',opic:'tools',speak:'tools',log:'tools'};$$('#tabs a').forEach(function(a){a.classList.toggle('on',a.dataset.v===(TV[v]||v))});
  keyHandler=null;window.scrollTo(0,0);
  if(v!=='opic-exam'&&opicRunning()){if(!confirm('시험 화면을 나가면 현재 답변까지 저장하고 중단합니다. 나갈까요?')){location.hash='#/opic-exam';return}finishOpic('interrupted')}
  if(v!=='opic-exam'){document.body.classList.remove('opic-room');if(OX&&OX.capture)OX.capture.stop();stopOpicSpeech()}
  if(v==='opic-exam')return opicExam();
  if(v==='drafts')return draftsView();
  if(v==='sources')return sourcesView();
  if(v==='questions')return questions(decodeURIComponent(p[1]||''),decodeURIComponent(p[2]||''));
  if(v==='jobs')return jobs(p[1]||'');
  if(v==='mock')return p[1]==='play'&&mock?mockPlay():mockSetup();
  if(v==='decks')return decks();
  if(v==='deck'){var d=DECKS.filter(function(x){return x.id===p[1]})[0];if(d)return deck(d,+(p[2]||0))}
  if(v==='log')return log();
  if(v==='tools')return tools();
  if(v==='board')return board();
  if(v==='cv')return cvView(decodeURIComponent(p[1]||''));
  if(v==='algo')return algo();
  if(v==='ncs')return ncs();
  if(v==='opic')return opicView();
  if(v==='speak')return speak();
  if(v==='essay')return essay(decodeURIComponent(p[1]||''));
  home();
}
window.addEventListener('hashchange',route);
document.addEventListener('keydown',function(e){if(e.metaKey||e.ctrlKey||e.altKey)return;var t=(e.target.tagName||'').toLowerCase();if(t==='textarea'||t==='input'||t==='select')return;if(keyHandler)keyHandler(e)});

{% include 'interview/goals.js.j2' %}
function startOpic(){if(location.hash==='#/opic-exam')opicExam();else location.hash='#/opic-exam'}

{% include 'interview/essay.js.j2' %}
{% include '_tools.js.j2' %}
{% include 'interview/sources.js.j2' %}
{% include 'interview/opic-engine.js.j2' %}
{% include 'interview/opic-storage.js.j2' %}
{% include 'interview/opic-exam.js.j2' %}
/* ---------- 오늘 ---------- */
function home(){
  var d=due(),tried=QS.filter(function(q){return S.q[q.id]}).length,ok=QS.filter(function(q){var r=S.q[q.id];return r&&r.b>=3}).length;
  var intro=DECKS.filter(function(x){return x.id==='intro-'+S.role})[0];
  var now=new Date();
  var h='<div class="hd"><div><span class="eyebrow">Interview Studio</span><h1 style="margin-top:6px">오늘의 면접 준비</h1>'+(D.pitch&&D.pitch.h1?'<p class="small" style="margin:0 0 4px;font-weight:700">내 한 줄 · '+esc(D.pitch.h1.join(' '))+'</p>':'')+'<p class="sub" style="margin:0">질문 '+QS.length+'개 · 발표 자료 '+DECKS.length+'개 · 공채 정보 '+(D.recruit&&D.recruit.sectors?D.recruit.sectors.reduce(function(a,x){return a+x.companies.length},0):0)+'곳. 답한 질문은 1·3·7·14·30일 간격으로 다시 나옵니다.</p></div><span class="date">'+(now.getMonth()+1)+'월 '+now.getDate()+'일 '+WD[now.getDay()]+'요일</span></div>';
  h+=goalsHTML()+'<div style="margin-top:12px">'+weekHTML()+'</div>'+todayBoard()+'<h2>오늘 연습</h2>';
  h+='<div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr))"><div class="card hero">'+(d.length?'<h2>다시 연습할 질문 '+d.length+'개</h2><p>복습 차례가 된 질문입니다. 시간을 재고 소리 내어 답해 보세요.</p><div class="row"><button class="btn" id="hdue">복습 모의 면접</button><a class="btn ghost" href="#/mock">범위 고르기</a></div>':'<h2>모의 면접 5문항</h2><p>질문이 나오면 60초 안에 소리 내어 답하고, 답변 뼈대와 비교해 스스로 채점합니다.</p><div class="row"><button class="btn" id="hquick">바로 시작</button><a class="btn ghost" href="#/mock">범위 고르기</a></div>')+'</div>';
  h+='<div class="card"><b>발표 연습</b><p class="muted small" style="margin:6px 0 12px">'+esc(D.roles[S.role]||'')+' 기준 자기소개부터 시작하세요. 발표자 모드에서는 메모와 경과 시간이 함께 보입니다.</p><div class="row">'+(intro?'<a class="btn" href="#/deck/'+intro.id+'">'+esc(intro.title)+'</a>':'')+'<a class="btn ghost" href="#/decks">전체 발표 자료</a></div></div><div class="card"><b>OPIc 형식 · 40분 모의시험</b><p class="muted small" style="margin:6px 0 12px">자기소개·묘사·루틴·과거·비교·롤플레이·돌발을 실제 순서처럼 섞어 냅니다. 문항당 2분, 녹음이 켜집니다.</p><div class="row"><button class="btn" id="hopic">OPIc 시작</button><a class="btn ghost" href="#/questions/OPIc">답변 틀 보기</a></div></div><div class="card"><b>자소서</b><p class="muted small" style="margin:6px 0 12px">문항 '+(P.essays||[]).length+'개 · 완성 '+essayDone()+'개. 핵심 경험 6개를 문항마다 골라 겹치지 않게 씁니다.</p><div class="row"><a class="btn" href="#/essay">이어서 쓰기</a></div></div></div>';
  h+='<div class="grid g4" style="margin-top:12px"><div class="card kpi"><b>'+tried+'<span class="small"> / '+QS.length+'</span></b><span>연습한 질문</span></div><div class="card kpi"><b>'+ok+'</b><span>익힌 질문 (3번 이상 알았다)</span></div><div class="card kpi"><b>'+Object.keys(S.memo).filter(function(k){return S.memo[k]}).length+'</b><span>내 메모를 단 질문</span></div><div class="card kpi"><b>'+S.mocks.length+'</b><span>모의 면접 횟수</span></div></div>';
  h+='<h2>질문 분류</h2><div class="grid g4">'+CATS.map(function(c){var qs=QS.filter(function(q){return q.c===c}),t=qs.filter(function(q){return S.q[q.id]}).length;return '<a class="card" style="text-decoration:none;color:inherit" href="#/questions/'+encodeURIComponent(c)+'"><b>'+esc(c)+'</b><div class="muted small">'+qs.length+'문항 · 연습 '+t+'</div><div class="faint small" style="margin-top:4px">'+esc(groupsOf(c).slice(0,4).join(' · '))+'</div></a>'}).join('')+'</div>';
  var RR=D.recruit||{},top=recos(RR.sectors||[],3);
  h+='<h2>내 조건 추천 회사 <a class="small" href="#/jobs" style="margin-left:auto;font-weight:600">공채 정보 전체 →</a></h2><div class="rec-g">'+top.map(function(a){var m=a.co.match;return '<a class="card rc" href="#/jobs/'+a.x.id+':'+a.ci+'"><div class="top2"><span class="sec-tag">'+esc(a.x.name)+'</span>'+dots(m.score)+'</div><h3>'+esc(a.co.name)+'</h3><div class="why">'+esc(m.why)+'</div>'+(m.gap?'<div class="gap">보완 · '+esc(m.gap)+'</div>':'')+'</a>'}).join('')+'</div><p class="faint small" style="margin-top:8px">IT · 금융 · 자원개발 '+(RR.sectors||[]).reduce(function(x,y){return x+y.companies.length},0)+'곳 · 인재상·면접 컨설팅 포함 · 확인일 '+esc(RR.checked||'')+' (월·목 정기 업데이트)</p>';
  $('#app').innerHTML=h;
  var a=$('#hdue');if(a)a.onclick=function(){startMock(shuffle(d.slice()).slice(0,10),{sec:90,rec:false,label:'복습'})};
  var b=$('#hquick');if(b)b.onclick=function(){startMock(shuffle(QS.filter(function(q){return q.c!=='OPIc'})).slice(0,5),{sec:60,rec:false,label:'바로 시작'})};
  $('#hopic').onclick=startOpic;bindGoals(home);
  $('#app').insertAdjacentHTML('beforeend',freshnessHTML());drawReleaseStatus();
}

{% include 'interview/questions.js.j2' %}
{% include 'interview/mock.js.j2' %}
{% include 'interview/decks.js.j2' %}
{% include 'interview/jobs.js.j2' %}
/* ---------- 기록 ---------- */
function log(){
  var h='<h1>기록</h1><p class="sub">연습 기록·메모·별표는 이 브라우저(localStorage)에만 있습니다. 다른 기기로 옮기려면 아래 [기기 옮기기]를 쓰세요.</p>';
  h+='<div class="card" style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:14px"><tr style="color:var(--muted);text-align:left"><th style="padding:6px 0">묶음</th><th>질문</th><th>연습</th><th>익힘</th><th>메모</th></tr>'+GROUPS.map(function(g){var qs=QS.filter(function(q){return q.g===g});return '<tr><td style="padding:6px 0"><b>'+esc(g)+'</b></td><td>'+qs.length+'</td><td>'+qs.filter(function(q){return S.q[q.id]}).length+'</td><td>'+qs.filter(function(q){var r=S.q[q.id];return r&&r.b>=3}).length+'</td><td>'+qs.filter(function(q){return S.memo[q.id]}).length+'</td></tr>'}).join('')+'</table></div>';
  var sy=SYNC.ui('interview',function(){return S},function(d){var n=mergeState(S,d);fix();save();return n},function(n){toast('합쳤습니다. 새로 들어온 항목 '+n+'개.');log()});
  h+=sy.html;
  $('#app').innerHTML=h;
  sy.bind(function(){if(confirm('면접 준비 기록·메모·자소서를 모두 지울까요? 되돌릴 수 없습니다.')){var reset=stamp(S.updatedAt);S=blank();S.resetAt=reset;save();log()}});
}

(function(){var r=document.documentElement,t=null;try{t=localStorage.getItem('theme')}catch(_){}if(t)r.dataset.theme=t;
  $('#theme').onclick=function(){var dark=r.dataset.theme?r.dataset.theme==='dark':matchMedia('(prefers-color-scheme: dark)').matches;r.dataset.theme=dark?'light':'dark';try{localStorage.setItem('theme',r.dataset.theme)}catch(_){}}})();
route();
checkRelease();
})();
</script>
