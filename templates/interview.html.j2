.review-start{display:grid;grid-template-columns:1.4fr 1fr;gap:24px;padding:28px;background:var(--card);border:1px solid var(--line);border-top:3px solid var(--ink);border-radius:14px;margin-bottom:26px}
.review-start h2{font-size:24px;margin:8px 0}.review-start p{color:var(--muted)}.review-actions{display:grid;align-content:center;gap:12px}.review-actions a{padding:12px;border-bottom:1px solid var(--line);text-decoration:none}
