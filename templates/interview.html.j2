function startRec(){if(!navigator.mediaDevices||!window.MediaRecorder){toast('이 브라우저는 녹음을 지원하지 않습니다.');return}
  navigator.mediaDevices.getUserMedia({audio:true}).then(function(st){chunks=[];recorder=new MediaRecorder(st);recorder.ondataavailable=function(e){if(e.data.size)chunks.push(e.data)};
