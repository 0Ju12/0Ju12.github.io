  var end=function(){if(timer){clearInterval(timer);timer=null}m.used=Math.round((Date.now()-m.t0)/1000);m.st='review';if(m.opt.rec){stopRec();setTimeout(mockPlay,250)}else mockPlay()};
  var b=$('#mstart');if(b)b.onclick=go;var s=$('#mskip');if(s)s.onclick=function(){m.st='review';m.used=null;mockPlay()};var e=$('#mend');if(e)e.onclick=end;
