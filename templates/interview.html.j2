  else{
    var main='';
    if(s.t==='stats')main='<div class="stats">'+(s.items||[]).map(function(x){return '<div><b>'+esc(x[0])+'</b>'+(x[1]?'<span>'+esc(x[1])+'</span>':'')+'</div>'}).join('')+'</div>';
    else if(s.t==='bullets')main='<ul>'+(s.items||[]).map(function(x){return '<li>'+esc(x)+'</li>'}).join('')+'</ul>';
    body='<div class="kick">'+esc(s.kicker||'')+'</div><h3>'+esc(s.h)+'</h3>'+(s.img&&s.t!=='stats'?'<div class="two"><div>'+main+'</div><img src="'+esc(s.img)+'" alt="" loading="lazy"></div>':main);
  }
  return '<div class="slide t-'+s.t+'"><div class="bar"></div><div class="in">'+body+'</div>'+(n?'<div class="pg">'+(i+1)+' / '+n+'</div>':'')+'</div>';
}
function decks(){
  var intro=DECKS.filter(function(d){return d.kind==='intro'}),proj=DECKS.filter(function(d){return d.kind==='project'});
  intro.sort(function(a,b){return (b.role===S.role)-(a.role===S.role)});
  var card=function(d){return '<a class="card" style="text-decoration:none;color:inherit;display:flex;flex-direction:column;gap:10px" href="#/deck/'+d.id+'">'+slideHTML(d.slides[0])+'<b>'+esc(d.title)+'</b><span class="muted small">슬라이드 '+d.slides.length+'장 · 약 '+d.min+'분</span></a>'};
  $('#app').innerHTML='<h1>발표 자료</h1><p class="sub">포트폴리오 내용으로 만든 슬라이드입니다. 열어서 <b>발표자 모드</b>(메모·시간)로 연습하고, <b>PDF</b>나 <b>PPTX</b>로 내려받아 다듬을 수 있습니다. 내려받은 파일은 이 기기에서 만들어집니다.</p><h2>자기소개</h2><div class="grid g3">'+intro.map(card).join('')+'</div><h2>프로젝트 발표</h2><div class="grid g3">'+proj.map(card).join('')+'</div>';
}
function deck(d,i){
  var n=d.slides.length;i=Math.max(0,Math.min(n-1,i||0));
  var h='<div class="deck-stage"><div class="row" style="justify-content:space-between;margin-bottom:12px"><span><a href="#/decks">← 발표 자료</a> · <b>'+esc(d.title)+'</b></span><span class="row"><button class="btn sm" id="dp">발표자 모드</button><button class="btn sm ghost" id="da">청중 화면</button><button class="btn sm ghost" id="dpdf">PDF</button><button class="btn sm ghost" id="dpptx">PPTX</button></span></div>';
  h+=slideHTML(d.slides[i],i,n)+'<div class="row" style="justify-content:space-between;margin-top:10px"><button class="btn ghost sm" id="dprev"'+(i?'':' disabled')+'>← 이전</button><span class="muted small">'+(i+1)+' / '+n+' · ← → 키로 이동</span><button class="btn sm" id="dnext"'+(i<n-1?'':' disabled')+'>다음 →</button></div>';
  h+='<div class="note"><b>발표 메모</b><br>'+esc(d.slides[i].note||'')+'</div><div class="thumbs">'+d.slides.map(function(s,k){return '<div data-k="'+k+'" class="'+(k===i?'cur':'')+'">'+slideHTML(s).replace('class="slide','class="slide'+(k===i?' cur':''))+'</div>'}).join('')+'</div></div>';
  $('#app').innerHTML=h;
  var go=function(k){history.replaceState(null,'','#/deck/'+d.id+'/'+k);deck(d,k)};
  $('#dprev').onclick=function(){go(i-1)};$('#dnext').onclick=function(){go(i+1)};
  $$('.thumbs [data-k]').forEach(function(t){t.onclick=function(){go(+t.dataset.k)}});
  $('#dp').onclick=function(){present(d,i,false)};$('#da').onclick=function(){present(d,i,true)};
  $('#dpdf').onclick=function(){printDeck(d)};$('#dpptx').onclick=function(){pptx(d,this)};
  keyHandler=function(e){if(e.key==='ArrowRight'&&i<n-1)go(i+1);else if(e.key==='ArrowLeft'&&i>0)go(i-1);else if(e.key==='p'||e.key==='P')present(d,i,false)};
}
function present(d,i,aud){
  var el=$('#pres'),n=d.slides.length,t0=Date.now(),tm;
  el.className='on'+(aud?' audience':'');
  var draw=function(){el.innerHTML='<div class="main">'+slideHTML(d.slides[i],i,n)+'</div><div class="side"><div class="ptime" id="pt">0:00<small>목표 '+d.min+'분 · '+(i+1)+'/'+n+'</small></div>'+(i<n-1?'<div class="small" style="color:#9ca3af">다음 슬라이드</div>'+slideHTML(d.slides[i+1]):'<div class="small" style="color:#9ca3af">마지막 슬라이드</div>')+'<div class="pnote">'+esc(d.slides[i].note||'')+'</div><div class="pbtn"><button id="pp">← 이전</button><button id="pn">다음 →</button><button id="px">끝내기 Esc</button></div></div>';
    $('#pp').onclick=function(){if(i>0){i--;draw()}};$('#pn').onclick=function(){if(i<n-1){i++;draw()}};$('#px').onclick=close;tick()};
  var tick=function(){var s=Math.floor((Date.now()-t0)/1000),e=$('#pt');if(e)e.firstChild.nodeValue=fmt(s);if(e)e.style.color=s>d.min*60?'#fb923c':''};
  var close=function(){clearInterval(tm);el.className='';el.innerHTML='';document.removeEventListener('keydown',kh,true);if(document.fullscreenElement)document.exitFullscreen().catch(function(){});deck(d,i)};
  var kh=function(e){if(e.key==='Escape'){e.preventDefault();close()}else if(e.key==='ArrowRight'||e.key===' '||e.key==='PageDown'){e.preventDefault();if(i<n-1){i++;draw()}}else if(e.key==='ArrowLeft'||e.key==='PageUp'){e.preventDefault();if(i>0){i--;draw()}}else if(e.key==='a'||e.key==='A'){el.classList.toggle('audience')}e.stopPropagation()};
  document.addEventListener('keydown',kh,true);tm=setInterval(tick,500);draw();
  if(el.requestFullscreen)el.requestFullscreen().catch(function(){});
}
function printDeck(d){var p=$('#print');p.innerHTML=d.slides.map(function(s,i){return slideHTML(s,i,d.slides.length)}).join('');
  var imgs=$$('img',p),left=imgs.length,fire=function(){setTimeout(function(){window.print()},150)};
