.review-search{width:min(680px,calc(100% - 32px));max-height:80vh;border:1px solid var(--line);border-radius:16px;padding:24px;background:var(--card);color:var(--text)}.review-search::backdrop{background:#10182888}.review-result{display:block;text-align:left;width:100%;padding:14px;background:transparent;color:inherit;border:0;border-bottom:1px solid var(--line);cursor:pointer;overflow-wrap:anywhere}
