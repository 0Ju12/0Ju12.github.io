.opic-room .top,.opic-room .storage-bar{display:none}.opic-room main{max-width:1180px;padding-top:15px}.ox-shell{border:1px solid var(--line);border-radius:18px;overflow:hidden;background:var(--bg)}.ox-header{background:#17324f;color:white;display:flex;justify-content:space-between;align-items:center;padding:18px 25px;gap:15px}.ox-header b{font-size:14px;letter-spacing:.08em}.ox-header small{display:block;font-size:11px;opacity:.75}.ox-clock{font:700 25px/1.2 ui-monospace,monospace;font-variant-numeric:tabular-nums;white-space:nowrap}.ox-title{padding:24px 25px 0}.ox-shell>.card,.ox-shell>.grid,.ox-shell>.guide,.ox-shell>.row,.ox-shell>p,.ox-shell>h2{margin:18px 25px}.ox-shell>.grid>.card{margin:0}.ox-shell>.ox-room{margin:20px 25px}.ox-footer{padding:20px 25px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;background:var(--card)}.ox-room{display:grid;grid-template-columns:240px minmax(0,1fr);gap:20px;align-items:stretch}.ox-partner{padding:40px 15px;text-align:center;border:1px solid var(--line);border-radius:16px;background:var(--card);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:16px}.ox-partner small{color:var(--muted)}.ox-avatar{width:120px;height:120px;border-radius:50%;background:linear-gradient(145deg,#365878,#16324f);color:#d6e4ed;font-size:65px;display:grid;place-items:center;box-shadow:0 0 0 10px var(--ink-soft)}.ox-avatar.talking{animation:ox-pulse 1s infinite alternate}.ox-wave{font-size:24px;letter-spacing:4px;color:var(--ink)}.ox-task{min-height:380px;display:flex;flex-direction:column;justify-content:center}.ox-task h2{font-size:24px;margin:25px 0 15px}.ox-mic{margin:20px 0 10px;padding:10px 14px;border:1px solid var(--line);border-radius:10px;font-weight:700}.ox-mic.on{color:var(--bad);border-color:var(--bad)}.ox-prompt{font-size:19px;line-height:1.7}.ox-topics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.ox-topics label,.ox-level{padding:12px;border:1px solid var(--line);border-radius:10px;cursor:pointer}.ox-topics label:has(input:checked),.ox-level:has(input:checked){background:var(--ink-soft);border-color:var(--ink)}.ox-level input{margin-right:8px}.ox-level b{margin-right:12px}.ox-adjust{min-height:70px;justify-content:center}.ox-shell audio{max-width:100%}.ox-room{grid-template-columns:280px minmax(0,1fr);gap:32px}.ox-shell{border-radius:5px}.ox-partner{border-radius:0;padding:20px 14px;background:#eef1f3}.ox-avatar{position:relative;overflow:hidden;width:210px;height:250px;border-radius:0;background:linear-gradient(120deg,#d9e3e7,#b2c4cd);box-shadow:none}.ox-head{position:absolute;width:80px;height:100px;top:38px;border-radius:44% 44% 48% 48%;background:#e4bb99;border:14px solid #394554;border-bottom-width:4px;box-sizing:content-box}.ox-shoulders{position:absolute;width:190px;height:130px;bottom:-28px;border-radius:50% 50% 0 0;background:#33465e}.ox-shoulders:before{content:"";display:block;margin:0 auto;width:42px;height:70px;background:#fafafa;clip-path:polygon(0 0,100% 0,50% 100%)}.ox-progress{display:flex;gap:5px;flex-wrap:wrap;margin:10px 0 22px}.ox-progress span{display:grid;place-items:center;width:27px;height:29px;font:600 12px system-ui;background:var(--bg);color:var(--muted);border:1px solid var(--line)}.ox-progress .current{background:#354758;color:white;border-color:#354758}.ox-progress .done{background:#e0ece7;color:#285849}.ox-task{border:0;box-shadow:none;padding:16px 0}.ox-task h2{font-size:21px}.ox-mic{border-radius:0;background:#eef2f5;text-align:center}.ox-mic.on{background:#4267d9;border-color:#4267d9;color:white}.ox-footer #ox-next{background:#ca5b32;border-color:#ca5b32;border-radius:3px;min-width:116px}.ox-footer #ox-next:disabled{opacity:.45}.ox-header{background:#f3f5f7;color:#273a4c;border-bottom:1px solid var(--line)}@media(max-width:650px){.ox-room{grid-template-columns:1fr;gap:12px}.ox-partner{padding:14px}.ox-avatar{width:110px;height:120px}.ox-head{transform:scale(.5);transform-origin:top center;top:12px}.ox-shoulders{transform:scale(.6);bottom:-45px}.ox-task{padding:12px}.ox-progress{gap:4px}.ox-progress span{width:25px;height:27px}}@keyframes ox-pulse{to{box-shadow:0 0 0 18px var(--ink-soft)}}@media(max-width:650px){.ox-room{grid-template-columns:1fr}.ox-partner{padding:20px;gap:8px}.ox-avatar{width:72px;height:72px;font-size:43px}.ox-partner small:not(.ox-number),.ox-wave{display:none}.ox-task{min-height:310px}.ox-header,.ox-footer{padding:16px}.ox-title{padding:20px 15px 0}.ox-shell>.card,.ox-shell>.grid,.ox-shell>.guide,.ox-shell>.row,.ox-shell>p,.ox-shell>h2,.ox-shell>.ox-room{margin:14px 15px}.ox-topics{grid-template-columns:repeat(2,minmax(0,1fr))}.ox-clock{font-size:21px}.ox-header b{font-size:11px}.ox-footer .small{order:3;flex-basis:100%}}


.codeComparison{max-height:350px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;font:11px/1.8 monospace;background:var(--soft);padding:12px;border-radius:8px}.testResult{display:flex;align-items:center;gap:8px;flex-wrap:wrap;border-left:3px solid var(--ok);padding:9px;margin:7px 0;background:var(--soft)}.testResult.fail,.testResult.error{border-color:var(--bad)}.testResult pre{max-height:170px;overflow:auto;white-space:pre-wrap}.diff-add{background:var(--ok-soft);color:var(--ok)}.diff-remove{background:var(--bad-soft);color:var(--bad)}

.compact-resume{padding:18px;gap:12px}.compact-resume .eyebrow{display:none}.compact-resume h2{font-size:18px}.compact-resume .review-actions{display:flex;flex-wrap:wrap;gap:6px}.compact-resume .review-actions a{font-size:14px;padding:6px}.home-more{margin-top:24px}.home-more>summary{padding:18px;border:1px solid var(--line);border-radius:12px;cursor:pointer;font-weight:700}.home-more[open]>summary{margin-bottom:18px}
/* Career forms need intrinsic textarea height and unclipped select text. */
