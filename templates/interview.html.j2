<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<title>면접 준비 · {{ profile.name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<style>
:root{--bg:#f7f7f8;--card:#fff;--text:#18181b;--muted:#5f6670;--faint:#9aa1ab;--line:#e4e6ea;--soft:#f0f2f5;--ink:#1f3a5f;--hero:#1f3a5f;--on-hero:#fff;--ink-soft:#e8edf5;--on-ink:#fff;--ok:#0f7b5f;--ok-soft:#e3f4ee;--bad:#c2410c;--bad-soft:#fdeee5;--mid:#a16207;--mid-soft:#fbf3dc;--acc:#d97706}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#0e1116;--card:#161a21;--text:#eef1f5;--muted:#a3abb7;--faint:#6f7884;--line:#29303a;--soft:#1d222b;--ink:#9db8dd;--hero:#1d3557;--on-hero:#eef1f5;--ink-soft:#1e2a3a;--on-ink:#0e1116;--ok:#34d399;--ok-soft:#10261f;--bad:#fb923c;--bad-soft:#2a1a10;--mid:#facc15;--mid-soft:#262110}}
:root[data-theme="dark"]{--bg:#0e1116;--card:#161a21;--text:#eef1f5;--muted:#a3abb7;--faint:#6f7884;--line:#29303a;--soft:#1d222b;--ink:#9db8dd;--hero:#1d3557;--on-hero:#eef1f5;--ink-soft:#1e2a3a;--on-ink:#0e1116;--ok:#34d399;--ok-soft:#10261f;--bad:#fb923c;--bad-soft:#2a1a10;--mid:#facc15;--mid-soft:#262110}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:15.5px/1.65 "Noto Sans KR",-apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo",system-ui,sans-serif;word-break:keep-all;-webkit-font-smoothing:antialiased}
a{color:var(--ink)}button,select,textarea{font:inherit;color:inherit}
.top{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.top .in{max-width:1100px;margin:0 auto;padding:10px 16px;display:flex;align-items:center;gap:6px}
.brand{font-weight:900;letter-spacing:-.02em;text-decoration:none;color:var(--text);margin-right:10px;white-space:nowrap}
.tabs{display:flex;gap:2px;overflow-x:auto;scrollbar-width:none;flex:1}.tabs::-webkit-scrollbar{display:none}
.tabs a{padding:7px 11px;border-radius:9px;text-decoration:none;color:var(--muted);font-weight:600;font-size:14px;white-space:nowrap}
.tabs a.on{background:var(--ink-soft);color:var(--ink)}
.iconbtn{border:1px solid var(--line);background:var(--card);border-radius:9px;height:34px;min-width:34px;padding:0 10px;cursor:pointer;color:var(--muted);text-decoration:none;display:inline-grid;place-items:center;font-size:13px;white-space:nowrap}
select.iconbtn{appearance:none;padding:0 10px}
main{max-width:1100px;margin:0 auto;padding:26px 16px 70px}
h1{font-size:clamp(22px,3.2vw,28px);letter-spacing:-.03em;margin:0 0 4px;line-height:1.3}
h2{font-size:17px;letter-spacing:-.02em;margin:30px 0 12px}
.sub{color:var(--muted);margin:0 0 20px}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px}
.grid{display:grid;gap:12px}.g2{grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))}.g3{grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr))}.g4{grid-template-columns:repeat(auto-fit,minmax(min(100%,150px),1fr))}
.btn{display:inline-flex;align-items:center;gap:6px;height:40px;padding:0 16px;border-radius:11px;border:1px solid var(--ink);background:var(--ink);color:var(--on-ink);font-weight:700;cursor:pointer;text-decoration:none;font-size:14.5px}
.btn.ghost{background:transparent;color:var(--ink);border-color:var(--line)}.btn.sm{height:32px;padding:0 11px;font-size:13px;border-radius:9px}.btn:disabled{opacity:.45;cursor:not-allowed}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{border:1px solid var(--line);background:var(--card);border-radius:99px;padding:4px 12px;font-size:13px;font-weight:600;color:var(--muted);cursor:pointer}
.chip.on{background:var(--ink);border-color:var(--ink);color:var(--on-ink)}
.tag{display:inline-block;font-size:12px;font-weight:600;color:var(--muted);background:var(--soft);border-radius:6px;padding:1px 7px}
.tag.mine{background:var(--ok-soft);color:var(--ok)}.tag.skeleton{background:var(--ink-soft);color:var(--ink)}.tag.trend{background:var(--mid-soft);color:var(--mid)}
.muted{color:var(--muted)}.faint{color:var(--faint)}.small{font-size:13px}
.kpi b{display:block;font-size:26px;letter-spacing:-.03em;line-height:1.2}.kpi span{color:var(--muted);font-size:13px}
.hero{background:var(--hero);color:var(--on-hero);border-color:var(--hero)}.hero h2{margin:0 0 6px;font-size:20px}.hero p{margin:0 0 14px;opacity:.85}
.hero .btn{background:var(--on-hero);color:var(--hero);border-color:var(--on-hero)}.hero .btn.ghost{background:transparent;color:var(--on-hero);border-color:color-mix(in srgb,var(--on-hero) 40%,transparent)}
.search{width:100%;height:44px;border:1px solid var(--line);border-radius:12px;background:var(--card);padding:0 14px}
.qcard{padding:0;overflow:hidden}
.qcard summary{list-style:none;cursor:pointer;padding:14px 16px;display:flex;gap:10px;align-items:flex-start}
.qcard summary::-webkit-details-marker{display:none}
.qcard summary b{flex:1;line-height:1.5}
.qbody{padding:0 16px 16px;border-top:1px solid var(--line)}
.ans{white-space:pre-wrap;background:var(--soft);border-radius:10px;padding:12px 14px;margin:12px 0 0;font-size:14.5px}
.guide{white-space:pre-wrap;border-left:3px solid var(--mid);background:var(--mid-soft);padding:8px 12px;border-radius:0 8px 8px 0;font-size:13.5px;margin-top:10px}
textarea{width:100%;border:1px solid var(--line);border-radius:12px;background:var(--card);padding:10px 12px;resize:vertical;margin-top:10px}
.star{border:0;background:none;cursor:pointer;font-size:18px;color:var(--faint);padding:0 4px}.star.on{color:var(--mid)}
.q{max-width:760px;margin:0 auto}
.prompt{font-size:21px;font-weight:800;letter-spacing:-.02em;line-height:1.5;margin:10px 0 18px}
.clock{font:800 44px/1 ui-monospace,"SF Mono",Menlo,monospace;letter-spacing:-.02em;text-align:center;margin:18px 0}
.clock.low{color:var(--bad)}
.grade{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}
.grade button{height:44px;border-radius:11px;border:1px solid var(--line);background:var(--card);font-weight:700;cursor:pointer}
.grade .g-ok{border-color:var(--ok);color:var(--ok)}.grade .g-mid{border-color:var(--mid);color:var(--mid)}.grade .g-bad{border-color:var(--bad);color:var(--bad)}
.rec{display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--bad);font-weight:700}.rec i{width:9px;height:9px;border-radius:50%;background:var(--bad);animation:bl 1s infinite}
@keyframes bl{50%{opacity:.25}}
.tag.bank{background:var(--ok-soft);color:var(--ok)}.tag.opic{background:var(--bad-soft);color:var(--bad)}
.wk{display:grid;gap:8px}.wk .it{display:grid;grid-template-columns:1fr auto;gap:4px 10px;align-items:center}
.wk .bar{grid-column:1/-1;height:7px;border-radius:9px;background:var(--soft);overflow:hidden}.wk .bar i{display:block;height:100%;background:var(--ink);border-radius:9px}
.wk .bar i.full{background:var(--ok)}.wk .ctl{display:flex;gap:4px;align-items:center}.wk .ctl button{width:30px;height:30px;border-radius:8px;border:1px solid var(--line);background:var(--card);cursor:pointer;font-weight:800}
.es textarea{min-height:150px}.es .cnt{font-size:12.5px;color:var(--muted)}.es .cnt.over{color:var(--bad);font-weight:700}
.xp{border:1px dashed var(--line);border-radius:99px;padding:3px 10px;font-size:12.5px;background:transparent;cursor:pointer;color:var(--muted)}.xp.on{border-style:solid;border-color:var(--ok);background:var(--ok-soft);color:var(--ok);font-weight:700}
.st-sel{border:1px solid var(--line);border-radius:8px;background:var(--card);height:30px;padding:0 6px;font-size:13px}
.field{width:100%;height:40px;border:1px solid var(--line);border-radius:10px;background:var(--card);padding:0 12px}
.lbl{font-size:12.5px;font-weight:800;color:var(--muted);margin:14px 0 4px;letter-spacing:.02em}
.ans.exp{background:transparent;border:1px dashed var(--line);color:var(--muted)}
.ans.best{background:var(--ok-soft)}
.intent{font-size:13.5px;color:var(--ink);background:var(--ink-soft);border-radius:8px;padding:6px 10px;margin-top:12px}
.tails{margin:4px 0 0;padding-left:18px;font-size:14px;color:var(--muted)}
.co{display:flex;flex-direction:column;gap:10px}
.co h3{margin:0;font-size:17px;letter-spacing:-.02em}
.co ul{margin:0;padding-left:18px;font-size:14px;line-height:1.6}
.co li{margin:2px 0}
.src{font-size:11.5px;color:var(--faint);margin-left:6px}
.flow{display:flex;flex-wrap:wrap;gap:4px;align-items:center;font-size:12.5px}
.flow span{background:var(--soft);border-radius:6px;padding:2px 8px;font-weight:600}
.flow i{color:var(--faint);font-style:normal}
.fit{border-left:3px solid var(--ok);background:var(--ok-soft);padding:8px 12px;border-radius:0 8px 8px 0;font-size:14px}
.links{display:flex;flex-wrap:wrap;gap:6px}
.links a{font-size:13px;border:1px solid var(--line);border-radius:8px;padding:3px 9px;text-decoration:none;background:var(--card)}
.toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);background:var(--text);color:var(--bg);padding:10px 16px;border-radius:11px;font-size:14px;display:none;z-index:90}
.empty{text-align:center;padding:40px 16px;color:var(--muted)}
.setup label{display:block;font-weight:700;font-size:14px;margin:16px 0 8px}
/* ---------- 슬라이드 (16:9, 글자 크기는 슬라이드 폭 기준) ---------- */
.slide{position:relative;aspect-ratio:16/9;container-type:inline-size;background:#fff;color:#18202b;border-radius:12px;overflow:hidden;border:1px solid var(--line);font-family:"Noto Sans KR",sans-serif}
.slide .in{position:absolute;inset:0;padding:6.5cqw 7cqw;display:flex;flex-direction:column;gap:2cqw}
.slide .kick{font-size:1.6cqw;font-weight:800;letter-spacing:.06em;color:#d97706;text-transform:uppercase}
.slide h3{margin:0;font-size:3.6cqw;line-height:1.3;letter-spacing:-.03em;font-weight:900;color:#1f3a5f}
.slide .sub{margin:0;color:#4b5563;font-size:2cqw;line-height:1.5}
.slide ul{margin:0;padding-left:2.4cqw;font-size:2.05cqw;line-height:1.55;color:#1f2937;display:flex;flex-direction:column;gap:1cqw}
.slide .bar{position:absolute;left:0;top:0;bottom:0;width:1.2cqw;background:#1f3a5f}
.slide.t-title .in,.slide.t-end .in{justify-content:center}
.slide.t-title h3{font-size:4.4cqw}.slide.t-end h3{font-size:5cqw;text-align:center}.slide.t-end .sub{text-align:center}
.slide.t-text h3{font-size:3.1cqw;font-weight:800;line-height:1.45}
.slide .two{display:grid;grid-template-columns:1.25fr 1fr;gap:3cqw;align-items:center;flex:1;min-height:0}
.slide .two img{width:100%;max-height:30cqw;object-fit:contain;border-radius:1cqw;background:#f3f4f6}
.slide .stats{display:grid;grid-template-columns:repeat(2,1fr);gap:1.6cqw;margin-top:1cqw}
.slide .stats div{background:#f1f5f9;border-radius:1.2cqw;padding:2cqw 2.2cqw}
.slide .stats b{display:block;font-size:2.6cqw;color:#1f3a5f;line-height:1.3;letter-spacing:-.02em}
.slide .stats span{font-size:1.5cqw;color:#6b7280}
.slide .pg{position:absolute;right:3cqw;bottom:2.4cqw;font-size:1.3cqw;color:#9ca3af}
.deck-stage{max-width:900px;margin:0 auto}
.thumbs{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-top:14px}
.thumbs .slide{cursor:pointer;border-radius:8px}.thumbs .slide.cur{outline:3px solid var(--ink);outline-offset:2px}
.note{margin-top:12px;background:var(--soft);border-radius:12px;padding:12px 14px;font-size:14.5px}
/* 발표자 모드 */
#pres{position:fixed;inset:0;z-index:80;background:#0b0f14;color:#e5e7eb;display:none;grid-template-columns:2.2fr 1fr;gap:18px;padding:18px}
#pres.on{display:grid}
#pres .main{display:flex;align-items:center;justify-content:center;min-width:0}#pres .main .slide{width:100%;border:0}
#pres .side{display:flex;flex-direction:column;gap:12px;min-width:0}
#pres .side .slide{border:0;opacity:.85}
#pres .ptime{font:800 34px/1 ui-monospace,Menlo,monospace}#pres .ptime small{font-size:14px;color:#9ca3af;margin-left:8px}
#pres .pnote{flex:1;overflow:auto;background:#151b23;border-radius:12px;padding:14px;font-size:17px;line-height:1.7}
#pres .pbtn{display:flex;gap:8px}#pres .pbtn button{flex:1;height:40px;border-radius:10px;border:1px solid #334155;background:#111827;color:#e5e7eb;font-weight:700;cursor:pointer}
#pres.audience{grid-template-columns:1fr}#pres.audience .side{display:none}
@media (max-width:760px){ #pres{grid-template-columns:1fr;overflow:auto}}
/* 인쇄 = PDF 저장 */
#print{display:none}
@media print{
  @page{size:13.333in 7.5in;margin:0}
  body{background:#fff}body>*:not(#print){display:none!important}
  #print{display:block}#print .slide{width:13.333in;height:7.5in;aspect-ratio:auto;border:0;border-radius:0;page-break-after:always;break-after:page}
}
@media (max-width:640px){.prompt{font-size:18px}main{padding-top:18px}.hide-m{display:none}}
a:focus-visible,button:focus-visible,select:focus-visible,summary:focus-visible,[tabindex]:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
@media (prefers-reduced-motion: reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
@media (max-width:640px){.top{backdrop-filter:none;-webkit-backdrop-filter:none;background:var(--bg)}.brand{flex:1;padding:6px 0}.tabs{position:fixed;left:0;right:0;bottom:0;z-index:40;display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);gap:2px;padding:6px 6px calc(6px + env(safe-area-inset-bottom));background:color-mix(in srgb,var(--card) 94%,transparent);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-top:1px solid var(--line);overflow:visible}.tabs a{display:flex;align-items:center;justify-content:center;min-height:42px;padding:6px 2px;font-size:12.5px;border-radius:10px;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.tabs a .n{margin-left:3px}main{padding-bottom:104px}.toast{bottom:calc(84px + env(safe-area-inset-bottom))}}
/* ===== premium skin (2026-11-10): 차분한 종이색 바탕 · 남색 + 금색 포인트 · Pretendard · 숫자는 tabular ===== */
:root{--bg:#f5f4f0;--card:#fff;--text:#16181d;--muted:#5d6370;--faint:#9097a3;--line:#e6e3dc;--soft:#f1efe9;--ink:#13294b;--hero:#13294b;--on-hero:#f7f3ea;--ink-soft:#e9edf4;--on-ink:#fff;--gold:#b07d2b;--gold-soft:#f6eedd;--ok:#1f7a5a;--ok-soft:#e6f2ec;--bad:#b4471f;--bad-soft:#f9ebe3;--mid:#9a6b12;--mid-soft:#f7efdc;--sh:0 1px 2px rgba(20,24,33,.04),0 10px 30px -18px rgba(20,24,33,.18)}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#0d1014;--card:#151920;--text:#eceef2;--muted:#a1a8b4;--faint:#6c7480;--line:#262c36;--soft:#1b2029;--ink:#a9c1e6;--hero:#17243a;--on-hero:#f2ece0;--ink-soft:#1c2738;--on-ink:#0d1014;--gold:#d9a54a;--gold-soft:#2a2214;--ok:#4cc79a;--ok-soft:#10261e;--bad:#f08a5d;--bad-soft:#2b1a12;--mid:#e3b341;--mid-soft:#29220f;--sh:0 1px 2px rgba(0,0,0,.3),0 12px 30px -18px rgba(0,0,0,.6)}}
:root[data-theme="dark"]{--bg:#0d1014;--card:#151920;--text:#eceef2;--muted:#a1a8b4;--faint:#6c7480;--line:#262c36;--soft:#1b2029;--ink:#a9c1e6;--hero:#17243a;--on-hero:#f2ece0;--ink-soft:#1c2738;--on-ink:#0d1014;--gold:#d9a54a;--gold-soft:#2a2214;--ok:#4cc79a;--ok-soft:#10261e;--bad:#f08a5d;--bad-soft:#2b1a12;--mid:#e3b341;--mid-soft:#29220f;--sh:0 1px 2px rgba(0,0,0,.3),0 12px 30px -18px rgba(0,0,0,.6)}
body{font-family:"Pretendard Variable",Pretendard,"Noto Sans KR",-apple-system,BlinkMacSystemFont,system-ui,sans-serif;font-size:15px;letter-spacing:-.005em;font-feature-settings:"tnum" 1}
h1{font-weight:800;letter-spacing:-.035em;font-size:clamp(24px,3.4vw,32px)}
h2{font-weight:750;letter-spacing:-.025em;font-size:16px;margin:34px 0 12px;display:flex;align-items:baseline;gap:8px}
.eyebrow{font-size:11.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}
.card{border-radius:18px;border-color:var(--line);box-shadow:var(--sh)}
.top{background:color-mix(in srgb,var(--bg) 82%,transparent);border-bottom-color:transparent;box-shadow:0 1px 0 var(--line)}
.brand{font-weight:800;letter-spacing:-.03em}.brand::before{content:"";display:inline-block;width:8px;height:8px;border-radius:2px;background:var(--gold);margin-right:8px;transform:translateY(-1px) rotate(45deg)}
.tabs a{font-weight:600;color:var(--muted);border-radius:10px}.tabs a.on{background:var(--ink);color:var(--on-ink)}
.btn{border-radius:12px;font-weight:700;letter-spacing:-.01em;box-shadow:0 1px 0 rgba(255,255,255,.12) inset,0 6px 14px -8px rgba(19,41,75,.5)}
.btn.ghost{box-shadow:none;background:var(--card)}
.chip{border-color:var(--line);font-weight:600}.chip.on{background:var(--ink);border-color:var(--ink)}
.hero{background:radial-gradient(120% 140% at 100% 0%,color-mix(in srgb,var(--gold) 28%,transparent) 0%,transparent 45%),var(--hero);border:0}
.hero .btn{box-shadow:none}
.kpi b{font-weight:800;letter-spacing:-.03em}
.iconbtn{border-radius:10px;border-color:var(--line)}
.sub{font-size:14.5px}
/* 오늘 — 머리말 */
.hd{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:22px;flex-wrap:wrap}
.hd .date{font-size:13px;color:var(--muted);font-weight:600}
/* 목표 패널 */
.gp{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1.6fr);gap:0;padding:0;overflow:hidden}
.gfeat{background:radial-gradient(130% 120% at 0% 0%,color-mix(in srgb,var(--gold) 30%,transparent),transparent 55%),var(--hero);color:var(--on-hero);padding:26px 26px 22px;display:flex;flex-direction:column;gap:6px;min-height:100%}
.gfeat .eyebrow{color:color-mix(in srgb,var(--gold) 70%,#fff)}
.gnum{font-size:64px;line-height:1;font-weight:800;letter-spacing:-.05em;margin:8px 0 4px}.gnum small{font-size:26px;font-weight:700;opacity:.7;margin-right:2px;letter-spacing:-.02em}
.gname{font-size:19px;font-weight:750;letter-spacing:-.02em}.gdate{font-size:13.5px;opacity:.75}
.gnote{font-size:12.5px;opacity:.7;margin-top:auto;padding-top:14px;line-height:1.5}
.glist{list-style:none;margin:0;padding:8px 6px}
.glist li{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2px 14px;align-items:center;padding:11px 16px;border-radius:12px}
.glist li+li{border-top:1px solid var(--line)}
.glist .nm{font-weight:650;font-size:14.5px;letter-spacing:-.015em}
.glist .meta{font-size:12.5px;color:var(--muted);display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.glist .dv{grid-row:1/3;grid-column:2;font-size:22px;font-weight:800;letter-spacing:-.03em;text-align:right;min-width:64px}
.glist .dv.soon{color:var(--bad)}.glist .dv.nd{font-size:12.5px;font-weight:600;color:var(--faint)}.glist .dv.past{color:var(--faint)}
.dpick{position:relative;display:inline-flex;align-items:center;gap:4px;font-size:12px;font-weight:600;color:var(--ink);background:var(--ink-soft);border-radius:99px;padding:2px 9px;cursor:pointer}
.dpick input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%}
.dpick.set{background:transparent;color:var(--muted);padding:2px 4px}
.pbar{height:4px;border-radius:9px;background:var(--soft);overflow:hidden;width:120px}.pbar i{display:block;height:100%;background:var(--gold)}
/* 이번 주 */
.wkp{padding:18px 18px 16px}
.wkh{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px}
.wkg{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:10px}
.wt{border:1px solid var(--line);border-radius:14px;padding:12px 12px 10px;display:flex;flex-direction:column;gap:8px;background:var(--card)}
.wt .rw{display:flex;align-items:center;gap:10px}
.wt svg{flex:none}.wt .ring-bg{stroke:var(--soft)}.wt .ring{stroke:var(--ink);transition:stroke-dashoffset .4s}.wt.full .ring{stroke:var(--ok)}.wt{min-width:0}
.wt .lb{font-size:13px;font-weight:650;letter-spacing:-.015em;line-height:1.3}
.wt .ct{display:flex;align-items:baseline;gap:4px;font-size:12.5px;color:var(--muted);white-space:nowrap;flex:1}
.wt .bt{display:flex;gap:4px;margin-left:auto}
.wt .ct b{color:var(--text);font-size:15px}
.wt button{width:24px;height:24px;border-radius:7px;border:1px solid var(--line);background:var(--card);cursor:pointer;font-weight:800;line-height:1;color:var(--muted);padding:0}
.wt button:hover{border-color:var(--ink);color:var(--ink)}
.wt .au{font-size:11.5px;color:var(--faint);line-height:1.4}
@media (max-width:860px){.gp{grid-template-columns:1fr}.gnum{font-size:52px}}
@media (max-width:640px){.wkg{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.wt{padding:10px}.wt .au{display:none}.wt svg{width:30px;height:30px}.wt .rw{gap:6px}.wt .ct .u{display:none}.wt button{width:26px;height:26px}.wt .lb{font-size:12.5px}.gfeat{padding:20px}.glist li{padding:10px 10px}}
/* 공채 — 추천 · 인재상 · 컨설팅 */
.rec-g{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:12px}
.rc{display:flex;flex-direction:column;gap:8px;text-decoration:none;color:inherit;padding:16px 18px}
.rc .top2{display:flex;justify-content:space-between;align-items:center;gap:8px}
.rc h3{margin:0;font-size:16px;letter-spacing:-.02em}
.score{display:inline-flex;gap:3px}.score i{width:8px;height:8px;border-radius:50%;background:var(--line)}.score i.on{background:var(--gold)}
.rc .why{font-size:13.5px;line-height:1.55}.rc .gap{font-size:12.5px;color:var(--bad)}
.sec-tag{font-size:11.5px;font-weight:700;color:var(--muted);background:var(--soft);border-radius:6px;padding:1px 7px}
.talent{display:flex;flex-wrap:wrap;gap:6px}.talent span{font-size:12.5px;font-weight:600;background:var(--gold-soft);color:var(--mid);border-radius:8px;padding:3px 9px}
.okb{font-size:11px;font-weight:700;border-radius:6px;padding:1px 6px;margin-left:6px}.okb.y{background:var(--ok-soft);color:var(--ok)}.okb.n{background:var(--bad-soft);color:var(--bad)}
.consult{border:1px solid var(--line);border-radius:12px;padding:10px 12px;background:var(--soft)}
.consult summary{cursor:pointer;font-weight:700;font-size:13.5px;list-style:none}.consult summary::-webkit-details-marker{display:none}
.consult summary::after{content:"＋";float:right;color:var(--faint)}.consult[open] summary::after{content:"－"}
.consult ul{margin:6px 0 0}
.co{scroll-margin-top:80px}.co.hl{outline:2px solid var(--gold);outline-offset:3px}
</style>
</head>
<body>
<header class="top"><div class="in">
  <a class="brand" href="#/">면접 준비</a>
  <nav class="tabs" id="tabs" aria-label="면접 준비 메뉴"><a href="#/" data-v="home">오늘</a><a href="#/questions" data-v="questions">질문</a><a href="#/mock" data-v="mock">모의<span class="hide-m"> 면접</span></a><a href="#/decks" data-v="decks">발표</a><a href="#/essay" data-v="essay">자소서</a><a href="#/jobs" data-v="jobs">공채<span class="hide-m"> 정보</span></a><a href="#/log" data-v="log">기록</a></nav>
  <select class="iconbtn" id="role" aria-label="지원 직무"></select>
  <button class="iconbtn" id="theme" type="button" aria-label="화면 테마 바꾸기">◐</button>
  <a class="iconbtn hide-m" href="../study/index.html">강의 노트</a>
</div></header>
<main id="app" aria-live="polite"></main>
<div id="pres" role="dialog" aria-label="발표자 모드"></div>
<div id="print" aria-hidden="true"></div>
<div class="toast" id="toast" role="status"></div>
<script id="data" type="application/json">{{ app|tojson }}</script>
<script>
(function(){
'use strict';
var D=JSON.parse(document.getElementById('data').textContent),QS=D.questions,DECKS=D.decks;
var $=function(s,r){return (r||document).querySelector(s)},$$=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))};
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
var Q={};QS.forEach(function(q){Q[q.id]=q});
var CATS=D.cats||['인성','프로젝트','전문지식','기타'];
var GROUPS=[];QS.forEach(function(q){if(GROUPS.indexOf(q.g)<0)GROUPS.push(q.g)});
function groupsOf(c){var g=[];QS.forEach(function(q){if((!c||q.c===c)&&g.indexOf(q.g)<0)g.push(q.g)});return g}
var KIND={mine:'내 답변',skeleton:'답변 뼈대',trend:'AI 트렌드',bank:'예상·합격 답변',opic:'OPIc 답변 틀'};var P=D.prep||{};
function answerHTML(q,full){
  var h='';
  if(q.intent)h+='<div class="intent"><b>질문 의도</b> · '+esc(q.intent)+'</div>';
  if(q.kind==='bank'){
    if(q.exp)h+='<div class="lbl">예상 답변 (흔히 나오는 답)</div><div class="ans exp" style="margin-top:0">'+esc(q.exp)+'</div>';
    h+='<div class="lbl">합격 답변 (구조·근거를 갖춘 답)</div><div class="ans best" style="margin-top:0">'+esc(q.a)+'</div>';
  }else if(q.a)h+='<div class="lbl">'+(q.kind==='mine'?'내 답변':q.kind==='skeleton'?'답변 뼈대 (포트폴리오 사실)':q.kind==='opic'?'답변 틀 (이 순서로 영어로 말하기)':'답변 예시')+'</div><div class="ans" style="margin-top:0">'+esc(q.a)+'</div>';
  else h+='<p class="muted small">아직 답변이 없습니다. 아래에 내 답을 적어 보세요.</p>';
  if(q.guide)h+='<div class="lbl">'+(q.kind==='bank'?'왜 이렇게 답하나':'답변 가이드')+'</div><div class="guide" style="margin-top:0">'+esc(q.guide)+'</div>';
  if(full!==false&&q.tail&&q.tail.length)h+='<div class="lbl">예상 꼬리질문</div><ul class="tails">'+q.tail.map(function(t){return '<li>'+esc(t)+'</li>'}).join('')+'</ul>';
  return h;
}
var INTERVAL=[0,1,3,7,14,30];
{% include '_sync.js.j2' %}

/* ---------- 저장 (이 브라우저에만) ---------- */
var KEY='interview-app-v1',S;
function blank(){return {v:1,q:{},memo:{},mt:{},star:{},days:{},mocks:[],role:'',goals:{},week:{},essay:{}}}
try{S=JSON.parse(localStorage.getItem(KEY))||blank()}catch(_){S=blank()}
function fix(){['q','memo','mt','star','days','goals','week','essay'].forEach(function(k){if(!S[k]||typeof S[k]!=='object')S[k]={}});if(!Array.isArray(S.mocks))S.mocks=[]}fix();
function save(){try{localStorage.setItem(KEY,JSON.stringify(S))}catch(_){toast('브라우저 저장 공간을 쓸 수 없어 기록이 남지 않습니다.')}}
function today(o){var d=new Date();d.setDate(d.getDate()+(o||0));return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}
function toast(t){var el=$('#toast');el.textContent=t;el.style.display='block';clearTimeout(toast.t);toast.t=setTimeout(function(){el.style.display='none'},2600)}
function record(id,res){var r=S.q[id]||{b:0,n:0,ok:0};r.n++;r.s=res;r.last=today();
  if(res==='ok'){r.ok++;r.b=Math.min(5,(r.b||0)+1);r.due=today(INTERVAL[r.b])}else if(res==='mid'){r.b=Math.max(1,r.b||0);r.due=today(1)}else{r.b=1;r.due=today()}
  S.q[id]=r;S.days[today()]=(S.days[today()]||0)+1;save()}
function due(){return QS.filter(function(q){var r=S.q[q.id];return r&&r.due&&r.due<=today()})}
function shuffle(a){for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t}return a}

/* 직무 선택 */
var roleSel=$('#role');Object.keys(D.roles).forEach(function(k){var o=document.createElement('option');o.value=k;o.textContent=D.roles[k];roleSel.appendChild(o)});
if(!S.role||!D.roles[S.role])S.role=Object.keys(D.roles)[0]||'';roleSel.value=S.role;
roleSel.onchange=function(){S.role=roleSel.value;save();route()};

/* ---------- 라우팅 ---------- */
var keyHandler=null,timer=null;
function route(){
  if(timer){clearInterval(timer);timer=null}stopRec();
  var h=location.hash.replace(/^#\/?/,''),p=h.split('/'),v=p[0]||'home';
  $$('#tabs a').forEach(function(a){a.classList.toggle('on',a.dataset.v===(v==='deck'?'decks':v))});
  keyHandler=null;window.scrollTo(0,0);
  if(v==='questions')return questions(decodeURIComponent(p[1]||''),decodeURIComponent(p[2]||''));
  if(v==='jobs')return jobs(p[1]||'');
  if(v==='mock')return p[1]==='play'&&mock?mockPlay():mockSetup();
  if(v==='decks')return decks();
  if(v==='deck'){var d=DECKS.filter(function(x){return x.id===p[1]})[0];if(d)return deck(d,+(p[2]||0))}
  if(v==='log')return log();
  if(v==='essay')return essay(decodeURIComponent(p[1]||''));
  home();
}
window.addEventListener('hashchange',route);
document.addEventListener('keydown',function(e){if(e.metaKey||e.ctrlKey||e.altKey)return;var t=(e.target.tagName||'').toLowerCase();if(t==='textarea'||t==='input'||t==='select')return;if(keyHandler)keyHandler(e)});

/* ---------- 목표 D-day · 이번 주 ---------- */
function wkey(){var d=new Date(),k=(d.getDay()+6)%7;d.setDate(d.getDate()-k);return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}
function wget(id){var w=S.week[wkey()]||{};return w[id]||0}
function wadd(id,n){var k=wkey(),w=S.week[k]||(S.week[k]={});w[id]=Math.max(0,(w[id]||0)+n);var ks=Object.keys(S.week).sort();while(ks.length>26)delete S.week[ks.shift()];save()}
function gdate(g){var o=S.goals[g.id];return o&&o.date!=null?o.date:(g.date||'')}
function ddays(ds){if(!ds)return null;var a=new Date(ds+'T00:00:00'),b=new Date(today()+'T00:00:00');return Math.round((a-b)/864e5)}
function essayDone(){return (P.essays||[]).filter(function(e,i){var r=S.essay['e'+i];return r&&r.st==='done'}).length}
var WD=['일','월','화','수','목','금','토'];
function kdate(ds){var d=new Date(ds+'T00:00:00');return (d.getMonth()+1)+'월 '+d.getDate()+'일 ('+WD[d.getDay()]+')'}
function dlab(n){return n==null?'미정':n===0?'D-day':n>0?'D-'+n:'D+'+(-n)}
function goalsHTML(){
  var gs=(P.goals||[]).slice().sort(function(a,b){var x=ddays(gdate(a)),y=ddays(gdate(b));if(x==null&&y==null)return 0;if(x==null)return 1;if(y==null)return -1;if((x<0)!==(y<0))return x<0?1:-1;return x-y});
  var nx=gs.filter(function(g){var n=ddays(gdate(g));return n!=null&&n>=0})[0];
  var feat=nx?(function(){var n=ddays(gdate(nx));return '<div class="gfeat"><span class="eyebrow">다음 목표</span><div class="gnum">'+(n===0?'D-day':'<small>D−</small>'+n)+'</div><div class="gname">'+esc(nx.name)+'</div><div class="gdate">'+kdate(gdate(nx))+'</div>'+(nx.note?'<div class="gnote">'+esc(nx.note)+'</div>':'')+'</div>'})():'<div class="gfeat"><span class="eyebrow">다음 목표</span><div class="gname" style="margin-top:12px">날짜가 정해진 목표가 없습니다</div><div class="gnote">오른쪽에서 시험일을 정해 주세요.</div></div>';
  var li=gs.filter(function(g){return g!==nx}).map(function(g){var ds=gdate(g),n=ddays(ds),cls=n==null?'nd':n<0?'past':n<=7?'soon':'';
    var pr=g.progress==='essay'?(function(){var d=essayDone(),t=(P.essays||[]).length||1;return '<span class="pbar" title="완성 '+d+'/'+t+'"><i style="width:'+Math.round(d/t*100)+'%"></i></span><span>완성 '+d+'/'+t+'</span>'})():'';
    return '<li title="'+esc(g.note||'')+'"><span class="nm">'+esc(g.name)+'</span><span class="dv '+cls+'">'+(n==null?'날짜 미정':dlab(n))+'</span><span class="meta"><label class="dpick'+(ds?' set':'')+'">'+(ds?kdate(ds)+' · 바꾸기':'＋ 날짜 정하기')+'<input type="date" value="'+esc(ds)+'" data-gd="'+esc(g.id)+'" aria-label="'+esc(g.name)+' 날짜"></label>'+pr+'</span></li>'}).join('');
  return '<div class="card gp">'+feat+'<ul class="glist">'+li+'</ul></div>'}
function ring(p){var r=18,c=2*Math.PI*r;return '<svg width="44" height="44" viewBox="0 0 44 44" aria-hidden="true"><circle class="ring-bg" cx="22" cy="22" r="'+r+'" fill="none" stroke-width="5"/><circle class="ring" cx="22" cy="22" r="'+r+'" fill="none" stroke-width="5" stroke-linecap="round" stroke-dasharray="'+c.toFixed(1)+'" stroke-dashoffset="'+(c*(1-Math.min(1,p))).toFixed(1)+'" transform="rotate(-90 22 22)"/></svg>'}
function weekHTML(){
  var W=P.weekly||[],done=W.filter(function(w){return wget(w.id)>=w.target}).length;
  return '<div class="card wkp"><div class="wkh"><b>이번 주 <span class="muted small" style="font-weight:600">· '+esc(wkey().slice(5).replace('-','/'))+' 월요일부터</span></b><span class="small muted">달성 '+done+' / '+W.length+'</span></div><div class="wkg">'+W.map(function(w){var n=wget(w.id),p=n/w.target;
    return '<div class="wt'+(p>=1?' full':'')+'"><span class="lb">'+esc(w.label)+'</span><div class="rw">'+ring(p)+'<span class="ct"><b>'+n+'</b>/ '+w.target+'<span class="u"> '+esc(w.unit||'')+'</span></span><span class="bt"><button data-wk="'+esc(w.id)+'" data-n="-1" aria-label="'+esc(w.label)+' 하나 빼기">−</button><button data-wk="'+esc(w.id)+'" data-n="1" aria-label="'+esc(w.label)+' 하나 더하기">+</button></span></div>'+(w.auto?'<span class="au">'+esc(w.auto)+'</span>':'')+'</div>'}).join('')+'</div></div>'}
function bindGoals(re){
  $$('[data-gd]').forEach(function(i){i.onchange=function(){S.goals[i.dataset.gd]={date:i.value,ts:Date.now()};save();re()}});
  $$('[data-wk]').forEach(function(b){b.onclick=function(){wadd(b.dataset.wk,+b.dataset.n);re()}})}

/* ---------- OPIc 실전 세트 ---------- */
function opicSet(){var by={};QS.forEach(function(q){if(q.kind==='opic')(by[q.ot]=by[q.ot]||[]).push(q)});
  var pick=function(t,n){return shuffle((by[t]||[]).slice()).slice(0,n)};
  return pick('intro',1).concat(pick('describe',2),pick('routine',2),pick('past',2),pick('compare',2),pick('roleplay',3),pick('issue',3))}
function startOpic(){var qs=opicSet();if(!qs.length){toast('OPIc 질문이 없습니다.');return}startMock(qs,{sec:120,rec:true,label:'OPIc 실전',opic:1})}

/* ---------- 자소서 ---------- */
var esG='';
function essay(g){
  var ES=P.essays||[],XP=P.experiences||[],XN={};XP.forEach(function(x){XN[x.id]=x});
  var groups=[];ES.forEach(function(e){if(groups.indexOf(e.g)<0)groups.push(e.g)});if(groups.indexOf(g)<0)g='';
  var used={};ES.forEach(function(e,i){var r=S.essay['e'+i];(r&&r.x||[]).forEach(function(x){used[x]=(used[x]||0)+1})});
  var st=function(i){var r=S.essay['e'+i];return r&&r.st||''};
  var cnt={done:0,draft:0};ES.forEach(function(e,i){if(st(i))cnt[st(i)]++});
  var h='<h1>자소서 문항 은행</h1><p class="sub">자주 나오는 자소서 문항 '+ES.length+'개입니다. 회사별 실제 문항과 글자 수는 공고에서 확인하세요. 쓴 글은 이 브라우저에만 저장되고, [기록]에서 암호를 걸어 다른 기기로 옮길 수 있습니다.</p>';
  h+='<div class="grid g4"><div class="card kpi"><b>'+cnt.done+'<span class="small"> / '+ES.length+'</span></b><span>완성</span></div><div class="card kpi"><b>'+cnt.draft+'</b><span>초안</span></div><div class="card kpi"><b>'+wget('essay')+'<span class="small"> / '+(((P.weekly||[]).filter(function(w){return w.id==='essay'})[0]||{}).target||5)+'</span></b><span>이번 주 완성</span></div><div class="card kpi"><b>'+Object.keys(used).length+'<span class="small"> / '+XP.length+'</span></b><span>쓴 핵심 경험</span></div></div>';
  h+='<h2>핵심 경험 사용 횟수 <span class="muted small">한 경험에 몰리지 않게</span></h2><div class="chips">'+XP.map(function(x){return '<span class="chip" title="'+esc(x.hint)+'" style="cursor:default">'+esc(x.name)+' · '+(used[x.id]||0)+'</span>'}).join('')+'</div>';
  h+='<div class="chips" style="margin:18px 0 12px"><button class="chip'+(g?'':' on')+'" data-eg="">전체</button>'+groups.map(function(x){return '<button class="chip'+(x===g?' on':'')+'" data-eg="'+esc(x)+'">'+esc(x)+'</button>'}).join('')+'<button class="btn sm ghost" id="etxt" style="margin-left:auto">쓴 글 전체 .txt로 받기</button></div><div class="grid">';
  ES.forEach(function(e,i){if(g&&e.g!==g)return;var id='e'+i,r=S.essay[id]||{},t=r.t||'',x=r.x||[];
    h+='<details class="card qcard es"'+(t&&!r.st?'':'')+'><summary><b>'+(i+1)+'. '+esc(e.q)+'</b><span class="tag">'+esc(e.g)+'</span><span class="tag'+(r.st==='done'?' bank':r.st==='draft'?' trend':'')+'">'+(r.st==='done'?'완성':r.st==='draft'?'초안':'안 씀')+'</span></summary><div class="qbody">'+
      '<div class="guide">'+esc(e.tip||'')+'</div><div class="lbl">쓸 경험 고르기 <span class="faint">(추천: '+(e.x||[]).map(function(k){return esc((XN[k]||{}).name||k)}).join(', ')+')</span></div><div class="chips">'+XP.map(function(xx){return '<button class="xp'+(x.indexOf(xx.id)>=0?' on':'')+'" data-ex="'+id+'" data-x="'+xx.id+'" title="'+esc(xx.hint)+'">'+esc(xx.name)+'</button>'}).join('')+'</div>'+
      '<textarea data-es="'+id+'" data-n="'+(e.n||0)+'" placeholder="'+esc(e.n?e.n+'자 안팎으로 써 보세요':'')+'">'+esc(t)+'</textarea><div class="row" style="justify-content:space-between;margin-top:6px"><span class="cnt" data-cnt="'+id+'"></span><select class="st-sel" data-est="'+id+'" aria-label="진행 상태"><option value="">안 씀</option><option value="draft"'+(r.st==='draft'?' selected':'')+'>초안</option><option value="done"'+(r.st==='done'?' selected':'')+'>완성</option></select></div></div></details>'});
  h+='</div>';
  $('#app').innerHTML=h;
  var put=function(id,f){var r=S.essay[id]||(S.essay[id]={});f(r);r.ts=Date.now();save()};
