          sl.addText([{text:x[0],options:{fontSize:20,bold:true,color:INK,breakLine:true}},{text:x[1]||'',options:{fontSize:12,color:'6B7280'}}],{x:cx+0.25,y:cy+0.15,w:5.1,h:1.6,fontFace:F,valign:'middle'})});
