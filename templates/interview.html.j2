      if(s.note)sl.addNotes(s.note)});
    return P.writeFile({fileName:'발표_'+d.title.replace(/[\\/:*?"<>| ]+/g,'_')+'.pptx'});
  }).then(function(){toast('PPTX를 내려받았습니다. 발표자 메모도 들어 있습니다.')}).catch(function(){toast('PPTX를 만들지 못했습니다. 인터넷 연결을 확인하고 다시 눌러 주세요.')}).then(function(){btn.disabled=false;btn.textContent='PPTX'});
