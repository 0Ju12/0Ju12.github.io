/* ---------- 기기 옮기기: 암호 파일 + 합치기 ---------- */
function mergeState(a,b){var n=0;
  Object.keys(b.q||{}).forEach(function(k){var x=a.q[k],y=b.q[k];if(!x||(y.n||0)>(x.n||0)||((y.n||0)===(x.n||0)&&(y.last||'')>(x.last||''))){a.q[k]=y;n++}});
  Object.keys(b.memo||{}).forEach(function(k){var y=b.memo[k];if(!y)return;var ta=a.mt[k]||0,tb=(b.mt||{})[k]||0;if(!a.memo[k]||tb>ta){if(a.memo[k]!==y)n++;a.memo[k]=y;a.mt[k]=tb}});
  Object.keys(b.star||{}).forEach(function(k){if(!a.star[k]){a.star[k]=1;n++}});
  Object.keys(b.days||{}).forEach(function(k){a.days[k]=Math.max(a.days[k]||0,b.days[k])});
  var seen={};a.mocks.forEach(function(m){seen[JSON.stringify(m)]=1});(b.mocks||[]).forEach(function(m){if(!seen[JSON.stringify(m)]){a.mocks.push(m);n++}});a.mocks.sort(function(x,y){return x.d<y.d?-1:1});
  Object.keys(b.goals||{}).forEach(function(k){if(!a.goals[k]||(b.goals[k].ts||0)>(a.goals[k].ts||0))a.goals[k]=b.goals[k]});
  Object.keys(b.week||{}).forEach(function(w){var x=a.week[w]||(a.week[w]={});Object.keys(b.week[w]).forEach(function(k){x[k]=Math.max(x[k]||0,b.week[w][k])})});
  Object.keys(b.essay||{}).forEach(function(k){var x=a.essay[k],y=b.essay[k];if(!x||(y.ts||0)>(x.ts||0)){a.essay[k]=y;n++}});
  return n}

