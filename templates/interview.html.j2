  <a class="iconbtn hide-m" href="../index.html">포트폴리오</a>
</div></header>
<nav class="subnav" id="subnav" aria-label="하위 메뉴"></nav>
<div class="storage-bar" style="max-width:1180px;margin:10px auto;padding:8px 16px;font-size:12px"><span id="save-status" role="status"></span><div class="row" style="margin-top:6px"><span class="muted"><span id="cloud-save-status" role="status">Drive 자동 백업 꺼짐</span> · <a href="#/cloud">동기화 설정</a></span><button class="btn ghost sm" id="backup-local">지금 백업</button><button class="btn ghost sm" id="recover-local">직전 저장본 복구</button><a href="#/log">백업 가져오기·기기 옮기기</a></div></div><main id="app" aria-live="polite"></main>
<div id="pres" role="dialog" aria-label="발표자 모드"></div>
<div id="print" aria-hidden="true"></div>
<div class="toast" id="toast" role="status"></div>
<script id="data" type="application/json">{{ app|tojson }}</script>
<script>
(function(){
'use strict';
var D=JSON.parse(document.getElementById('data').textContent),QS=D.questions,DECKS=D.decks;
var $=function(s,r){return (r||document).querySelector(s)},$$=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))};
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
var Q={};QS.forEach(function(q){Q[q.id]=q});
var CATS=D.cats||['인성','프로젝트','전문지식','기타'];
var GROUPS=[];QS.forEach(function(q){if(GROUPS.indexOf(q.g)<0)GROUPS.push(q.g)});
function groupsOf(c){var g=[];QS.forEach(function(q){if((!c||q.c===c)&&g.indexOf(q.g)<0)g.push(q.g)});return g}
var KIND={mine:'내 답변',skeleton:'답변 뼈대',trend:'AI 트렌드',bank:'참고 답변',opic:'OPIc 답변 틀',draft:'자료 기반 1분 초안'};var P=D.prep||{};
function answerHTML(q,full){
  var h='';
  if(q.intent)h+='<div class="intent"><b>질문 의도</b> · '+esc(q.intent)+'</div>';
  if(q.kind==='bank'){
    if(q.exp)h+='<div class="lbl">예상 답변 (흔히 나오는 답)</div><div class="ans exp" style="margin-top:0">'+esc(q.exp)+'</div>';
    h+='<div class="lbl">참고 답변 · 본인 경험에 맞춰 검토</div><div class="ans best" data-answer-output="'+esc(q.id)+'" style="margin-top:0">'+esc(getAnswer(q))+'</div>';
  }else if(getAnswer(q))h+='<div class="lbl">'+(q.kind==='mine'?'내 답변':q.kind==='skeleton'?'답변 뼈대 (포트폴리오 사실)':q.kind==='opic'?'답변 틀 (이 순서로 영어로 말하기)':q.kind==='draft'?'자료 기반 1분 초안 · 수정 가능':'답변 예시')+'</div><div class="ans" data-answer-output="'+esc(q.id)+'" style="margin-top:0">'+esc(getAnswer(q))+'</div>';
  else h+='<p class="muted small">아직 답변이 없습니다. 아래에 내 답을 적어 보세요.</p>';
  if(q.guide)h+='<div class="lbl">'+(q.kind==='bank'?'왜 이렇게 답하나':'답변 가이드')+'</div><div class="guide" style="margin-top:0">'+esc(q.guide)+'</div>';
  if(full!==false&&q.tail&&q.tail.length)h+='<div class="lbl">예상 꼬리질문</div><ul class="tails">'+q.tail.map(function(t){return '<li>'+esc(t)+'</li>'}).join('')+'</ul>';
  if(q.verify)h+='<div class="guide"><b>본인 확인·수정</b> · '+esc(q.verify)+'</div>';
  if(q.sources&&q.sources.length)h+='<div class="links" style="margin-top:10px">'+q.sources.filter(function(x){return /^https:\/\//.test(x.url||'')}).map(function(x){return '<a href="'+esc(x.url)+'" target="_blank" rel="noopener">'+esc(x.title)+' ↗</a>'}).join('')+'</div>';
  if(STUDY&&q.c==='전문지식')h+=STUDY.related(q);
  h+=answerEditor(q);
  return h;
}
var INTERVAL=[0,1,3,7,14,30];
{% include '_sync.js.j2' %}
{% include 'prep/study.js.j2' %}

{% include 'interview/practice-core.js.j2' %}
{% include 'interview/state.js.j2' %}
{% include 'interview/answers.js.j2' %}
function today(o){var d=new Date();d.setDate(d.getDate()+(o||0));return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}
function toast(t){var el=$('#toast');el.textContent=t;el.style.display='block';clearTimeout(toast.t);toast.t=setTimeout(function(){el.style.display='none'},2600)}
function record(id,res){var r=S.q[id]||{b:0,n:0,ok:0};r.n++;r.s=res;r.last=today();
  if(res==='ok'){r.ok++;r.b=Math.min(5,(r.b||0)+1);r.due=today(INTERVAL[r.b])}else if(res==='mid'){r.b=Math.max(1,r.b||0);r.due=today(1)}else{r.b=1;r.due=today()}
  S.q[id]=r;S.days[today()]=(S.days[today()]||0)+1;save()}
function due(){return QS.filter(function(q){var r=S.q[q.id];return r&&r.due&&r.due<=today()})}
function shuffle(a){for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t}return a}

/* 직무 선택 */
var roleSel=$('#role');Object.keys(D.roles).forEach(function(k){var o=document.createElement('option');o.value=k;o.textContent=D.roles[k];roleSel.appendChild(o)});
if(!S.role||!D.roles[S.role])S.role=Object.keys(D.roles)[0]||'';roleSel.value=S.role;
roleSel.onchange=function(){S.role=roleSel.value;save();route()};

/* ---------- 라우팅 ---------- */
var keyHandler=null,timer=null;
function route(){if(typeof PREP_FLOW!=='undefined')PREP_FLOW.before();if(typeof SQL_EXAM!=='undefined')SQL_EXAM.stop();loadImportedQuestions();if(typeof PREP_LABS!=='undefined')PREP_LABS.stop();
  if(timer){clearInterval(timer);timer=null}discardRecording();if(typeof srStop==='function')srStop();
  var h=location.hash.replace(/^#\/?/,''),p=h.split('/'),v=p[0]||'home';
  drawNav(v,p);if(STUDY)STUDY.reset();
  keyHandler=null;window.scrollTo(0,0);
  if(v!=='opic-exam'&&opicRunning()){if(!confirm('시험 화면을 나가면 현재 답변까지 저장하고 중단합니다. 나갈까요?')){location.hash='#/opic-exam';return}finishOpic('interrupted')}
  if(v!=='opic-exam'){document.body.classList.remove('opic-room');if(OX&&OX.capture)OX.capture.stop();stopOpicSpeech()}
  if(STUDY&&SVIEWS[v])return STUDY.view(v,p);
  if(v==='opic-exam')return opicExam();
  if(v==='drafts')return draftsView();
  if(v==='sources')return sourcesView();
  if(v==='questions')return questions(decodeURIComponent(p[1]||''),decodeURIComponent(p[2]||''));
  if(v==='jobs')return jobs(p[1]||'');
  if(v==='mock')return p[1]==='play'&&mock?mockPlay():mockSetup();
  if(v==='decks')return decks();
  if(v==='deck'){var d=DECKS.filter(function(x){return x.id===p[1]})[0];if(d)return deck(d,+(p[2]||0))}
  if(v==='log')return log();
  if(v==='tools')return tools();
  if(v==='sql')return PREP_LABS.sql(decodeURIComponent(p[1]||''));
  if(v==='sql-exam')return SQL_EXAM.view(decodeURIComponent(p[1]||''));
  if(v==='weakness')return CAREER_PLUS.weakness();
  if(v==='evidence')return CAREER_PLUS.evidence();
  if(v==='submissions')return CAREER_PLUS.submissions(decodeURIComponent(p[1]||''));
  if(v==='cloud')return WORKSPACE_CLOUD.view();
  if(v==='packet')return PREP_LABS.packet();
  if(v==='defense')return PREP_LABS.defense(decodeURIComponent(p[1]||''),p[2]);
  if(v==='career')return CAREER.view(decodeURIComponent(p[1]||''));
  if(v==='board')return board();
  if(v==='cv')return cvView(decodeURIComponent(p[1]||''));
  if(v==='boj')return BOJ.view(p[1]||'');
  if(v==='algo'){if(swWork&&swWork.site==='BOJ'){save();swWork=null}algo();if(/^\d+$/.test(p[1]||'')){var n=Number(p[1]),tries=0;function open(){if(location.hash.indexOf('#/algo')!==0)return;if(SWCAT&&$('#sw-work')){var x=SWCAT.items.find(function(x){return x.number===n});if(x)openSweaWork(x);return}if(tries++<50)setTimeout(open,100)}open()}return}
  if(v==='ncs')return ncs();
  if(v==='opic')return opicView();
  if(v==='speak')return speak();
  if(v==='essay')return essay(decodeURIComponent(p[1]||''));
  home();
}

/* ---------- 메뉴: 오늘 · 공부 · 면접 · 지원 · 기록 ---------- */
var SVIEWS={study:1,notes:1,cards:1,quiz:1,review:1,exam:1,glossary:1};
var SUBNAV={
  study:[['#','배우기'],['study','한눈에'],['notes','강의 노트'],['glossary','용어 사전'],['#','연습'],['quiz','문제'],['review','복습'],['weakness','취약점 복습'],['exam','모의고사'],['#','코딩'],['algo','알고리즘'],['boj','백준'],['sql','SQL 실습'],['sql-exam','SQL 모의시험'],['#','시험'],['ncs','인적성']],
  interview:[['defense','프로젝트 방어'],['questions','질문 은행'],['drafts','내 답변 정리'],['mock','모의 면접'],['decks','발표'],['opic-exam','OPIc'],['speak','말하기 분석']],
  apply:[['career','지원 준비'],['essay','자소서'],['jobs','공채 정보'],['board','지원 현황'],['cv','맞춤 이력서'],['packet','포트폴리오 구성'],['evidence','증빙 점검'],['submissions','제출본 보관']],
  log:[['cloud','통합 동기화'],['log','기록·백업'],['sources','자료 현황']]};
var GROUP_OF={home:'home',cards:'study',deck:'interview',opic:'interview',tools:'log'};
Object.keys(SUBNAV).forEach(function(g){SUBNAV[g].forEach(function(x){if(x[0]!=='#')GROUP_OF[x[0]]=g})});
if(!STUDY){SUBNAV.study=SUBNAV.study.filter(function(x){return !SVIEWS[x[0]]}).filter(function(x,i,a){return x[0]!=='#'||(a[i+1]&&a[i+1][0]!=='#')});GROUP_OF.study='study'}
var SUBALIAS={cards:'notes',deck:'decks',opic:'opic-exam'};
function drawNav(v,p){var g=GROUP_OF[v]||'home',cur=SUBALIAS[v]||v;
