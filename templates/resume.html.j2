{% import "_resume.j2" as R %}
{% set en = profile.name == profile.name_en %}
{% set L = R.LEN if en else R.LKO %}
<!doctype html>
<html lang="{{ 'en' if en else 'ko' }}">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex">
<title>{{ profile.name }} {{ 'Resume' if en else '이력서' }}</title>
{{ R.style(dense=false) }}
</head>
<body><div class="page">
{{ R.head(profile, L, en, profile.headline) }}
<p class="lede">{{ profile.summary }}</p>
<div class="facts">{% for h in highlights %}<span><b>{{ h.value }}</b>{{ h.label }}</span>{% endfor %}</div>

<h2>{{ L.edu }}</h2>
{% for e in education %}
<div class="it">
  <div class="when">{{ e.period_str }}</div>
  <div>
    <div class="t">{{ e.school }} <span class="s" style="display:inline;font-weight:400">· {{ e.major }} {{ e.degree }}{% if e.gpa %} · {{ e.gpa }}{% endif %}</span></div>
    {% if e.notes %}<ul class="b">{% for n in e.notes %}<li>{{ n }}</li>{% endfor %}</ul>{% endif %}
  </div>
</div>
{% endfor %}

<h2>{{ L.research }}</h2>
{% for a in (featured if featured else activities) %}
<div class="it">
  <div class="when">{{ a.period_str }}</div>
  <div>
    <div class="t">{{ a.title }}</div>
    <div class="s">{{ a.org }}{% if a.role %} · {{ a.role }}{% endif %}</div>
    {% for sp in (a.projects or [a]) %}{% set dg = sp.digest or {} %}{% set st = sp.star or {} %}
    <div class="sub">
      <div class="st">{{ sp.title if a.projects else '' }}{% if a.projects %}<span>{{ sp.period_str }}{% if sp.role %} · {{ sp.role }}{% endif %}{% if sp.case is defined %} · <a href="https://0ju12.github.io/projects/{{ sp.id }}{{ '-en' if en else '' }}.html">{{ L.detail }} ↗</a>{% endif %}</span>{% endif %}</div>
      <ul class="b">
        {% for x in (dg.did or st.action or []) %}<li>{{ x }}</li>{% endfor %}
        {% for x in (dg.result or st.result or []) %}<li class="r"><b>{{ x }}</b></li>{% endfor %}
      </ul>
    </div>
    {% endfor %}
    {% if a.tags %}<div class="kw">{{ a.tags|join(' · ') }}</div>{% endif %}
  </div>
</div>
{% endfor %}

{% set others = activities|rejectattr('featured')|list %}
{% if featured and others %}
<h2>{{ L.other }}</h2>
{% for a in others %}
<div class="it" style="margin-bottom:1.6mm">
  <div class="when">{{ a.period_str }}</div>
  <div><span class="t" style="font-size:9.6pt">{{ a.title }}</span>{% if a.org %} <span class="s" style="display:inline">· {{ a.org }}{% if a.role %} · {{ a.role }}{% endif %}</span>{% endif %}</div>
</div>
{% endfor %}
{% endif %}

{% if papers or talks %}
<h2>{{ L.pubs }}</h2>
{% for x in papers %}<div class="ln"><span><span class="k">{{ L.paper }}</span>{{ x.title }}{% if x.venue %} <span class="v">— {{ x.venue }}</span>{% endif %}</span><span class="y">{{ x.year }}</span></div>{% endfor %}
{% for x in talks %}<div class="ln"><span><span class="k">{{ L.talk }}</span>{{ x.title }}</span><span class="y">{{ x.year }}</span></div>{% endfor %}
{% endif %}

<h2>{{ L.awards }}</h2>
{% for x in awards %}<div class="ln"><span>{{ x.name }}{% if x.rank %} {{ x.rank }}{% endif %}{% if x.org %} <span class="v">— {{ x.org }}</span>{% endif %}</span><span class="y">{{ x.date }}</span></div>{% endfor %}
{% for x in certifications %}<div class="ln"><span>{{ x.name }}{% if x.org %} <span class="v">— {{ x.org }}</span>{% endif %}</span><span class="y">{{ x.date }}</span></div>{% endfor %}

<h2>{{ L.skills }}</h2>
<table class="sk">{% for s in skills %}<tr><th>{{ s.category }}</th><td>{{ s['items']|join(' · ') }}</td></tr>{% endfor %}</table>
</div></body>
</html>
