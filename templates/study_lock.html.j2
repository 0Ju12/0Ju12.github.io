<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{{ title }} · 잠김</title>
{% if pwa %}<link rel="manifest" href="{{ root }}manifest.webmanifest">
<meta name="theme-color" content="#1f3a5f">
<link rel="apple-touch-icon" href="{{ root }}icon-192.png">
<meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="학습 노트">{% endif %}
<style>
:root{--bg:#f7f7f8;--card:#fff;--text:#18181b;--muted:#5f5f68;--faint:#9b9ba3;--line:#e4e4e8;--ink:#18181b;--on-ink:#fafafa;--err:#dc2626}
@media (prefers-color-scheme: dark){:root{--bg:#0d0d10;--card:#17171a;--text:#f4f4f5;--muted:#a1a1aa;--faint:#71717a;--line:#27272a;--ink:#f4f4f5;--on-ink:#0d0d10;--err:#f87171}}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;display:grid;place-items:center;background:var(--bg);color:var(--text);font:16px/1.6 -apple-system,BlinkMacSystemFont,"Pretendard","Apple SD Gothic Neo","Noto Sans KR","Malgun Gothic",sans-serif;padding:20px}
.box{width:min(400px,100%);background:var(--card);border:1px solid var(--line);border-radius:24px;padding:30px 28px;box-shadow:0 18px 48px -18px rgba(0,0,0,.18)}
.ic{width:46px;height:46px;border-radius:14px;display:grid;place-items:center;background:var(--bg);border:1px solid var(--line);margin-bottom:16px}
h1{font-size:20px;letter-spacing:-.02em;margin:0 0 6px}
p{margin:0 0 18px;color:var(--muted);font-size:14.5px}
form{display:flex;gap:8px}
input{flex:1;min-width:0;height:46px;border:1px solid var(--line);border-radius:12px;background:var(--bg);color:var(--text);font:inherit;padding:0 14px}
input:focus{outline:2px solid var(--text);outline-offset:1px}
button{height:46px;border:0;border-radius:12px;background:var(--ink);color:var(--on-ink);font:inherit;font-weight:700;padding:0 18px;cursor:pointer}
button:disabled{opacity:.6;cursor:wait}
.keep{display:flex;gap:7px;align-items:center;margin-top:12px;font-size:13.5px;color:var(--muted);cursor:pointer}
.keep input{flex:none;width:16px;height:16px;margin:0}
.msg{min-height:22px;margin-top:10px;font-size:13.5px;color:var(--err)}
.back{display:inline-block;margin-top:14px;font-size:14px;color:var(--muted)}
</style>
</head>
<body>
<main class="box">
  <div class="ic" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></div>
  <h1>{{ title }}</h1>
  {% if box %}
  <p>{{ '강의 노트는' if pwa else '면접 준비 자료는' }} 암호를 입력해야 볼 수 있습니다. 강의 노트·면접 준비는 같은 암호이고, 한 번 열면 이 탭에서는 다시 묻지 않습니다.</p>
  <form id="f"><input id="pw" type="password" autocomplete="current-password" placeholder="암호" aria-label="암호" required autofocus><button id="go" type="submit">열기</button></form>
  {% if pwa %}<label class="keep"><input type="checkbox" id="keep"> 이 기기에서 기억 (홈 화면 앱으로 쓸 때)</label>{% endif %}
  <div class="msg" id="msg" role="alert"></div>
  {% else %}
  <p>이 빌드에는 암호가 설정되지 않아 내용을 넣지 않았습니다. 배포된 사이트에서 암호로 열 수 있습니다.</p>
  {% endif %}
  <a class="back" href="{{ home }}">← 포트폴리오로 돌아가기</a>
</main>
{% if box %}
<script id="box" type="application/json">{{ box|tojson }}</script>
<script>
(function(){
var box=JSON.parse(document.getElementById('box').textContent),K='study-key:'+box.salt;
function b(s){return Uint8Array.from(atob(s),function(c){return c.charCodeAt(0)})}
function e(u){var s='';new Uint8Array(u).forEach(function(x){s+=String.fromCharCode(x)});return btoa(s)}
async function dec(raw){var key=await crypto.subtle.importKey('raw',raw,'AES-GCM',false,['decrypt']);var pt=await crypto.subtle.decrypt({name:'AES-GCM',iv:b(box.iv)},key,b(box.ct));return new TextDecoder().decode(pt);}
function show(html){document.open();document.write(html);document.close();}
async function derive(pw){var base=await crypto.subtle.importKey('raw',new TextEncoder().encode(pw),'PBKDF2',false,['deriveBits']);return crypto.subtle.deriveBits({name:'PBKDF2',salt:b(box.salt),iterations:box.iter,hash:'SHA-256'},base,256);}
var saved=null;try{saved=sessionStorage.getItem(K)||localStorage.getItem(K)}catch(_){}
function whenReady(f){if(document.readyState==='complete')setTimeout(f,0);else window.addEventListener('load',function(){setTimeout(f,0)});}
if(saved){document.getElementById('f').style.visibility='hidden';dec(b(saved)).then(function(h){whenReady(function(){show(h)})}).catch(function(){try{sessionStorage.removeItem(K);localStorage.removeItem(K)}catch(_){}document.getElementById('f').style.visibility='';});}
document.getElementById('f').addEventListener('submit',async function(ev){ev.preventDefault();var go=document.getElementById('go'),msg=document.getElementById('msg');go.disabled=true;msg.textContent='';
  try{var raw=await derive(document.getElementById('pw').value);var html=await dec(raw);try{sessionStorage.setItem(K,e(raw));if(document.getElementById('keep')&&document.getElementById('keep').checked){Object.keys(localStorage).forEach(function(k){if(k.indexOf('study-key:')===0)localStorage.removeItem(k)});localStorage.setItem(K,e(raw))}}catch(_){}show(html);}
  catch(_){msg.textContent='암호가 맞지 않습니다.';go.disabled=false;}});
})();
</script>
{% endif %}
{% if pwa %}<script>if('serviceWorker' in navigator&&(location.protocol==='https:'||location.hostname==='localhost'))navigator.serviceWorker.register('{{ root }}sw.js',{scope:'{{ root or "./" }}'}).catch(function(){});</script>{% endif %}
</body>
</html>
