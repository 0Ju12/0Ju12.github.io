{% import "_resume.j2" as R %}
{% set en = profile.name == profile.name_en %}
{% set L = R.LEN if en else R.LKO %}
<!doctype html>
<html lang="{{ 'en' if en else 'ko' }}">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex">
<title>{{ profile.name }} {{ 'Resume' if en else '이력서' }}{% if variant_label %} ({{ variant_label }}){% endif %}</title>
<meta name="description" content="{{ profile.name_en if en else profile.name }} — {{ 'one-page resume' if en else '1쪽 이력서' }}">
{{ R.style(dense=true, en=en) }}
</head>
<body><div class="page">
{{ R.head(profile, L, en, profile.headline) }}
<div class="facts">{% for h in highlights %}<span><b>{{ h.value }}</b>{{ h.label }}</span>{% endfor %}</div>

<h2>{{ L.exp }}</h2>
{% for a in featured %}
<div class="it">
  <div class="when">{{ a.period_str }}</div>
  <div>
    <div class="t">{{ a.title }}</div>
    <div class="s">{{ a.org }}{% if a.role %} · {{ a.role }}{% endif %}</div>
    <ul class="b">{% for x in (a.brief or a.star.result) %}<li>{{ x }}</li>{% endfor %}</ul>
  </div>
</div>
{% endfor %}

<h2>{{ L.edu }}</h2>
{% for e in education %}
<div class="it" style="margin-bottom:1.2mm">
  <div class="when">{{ e.period_str }}</div>
  <div><span class="t" style="font-size:8.8pt">{{ e.school }}</span> <span class="s" style="display:inline">· {{ e.major }} {{ e.degree }}</span></div>
</div>
{% endfor %}

<div class="cols">
<div>
<h2>{{ L.pubs }}</h2>
{% for x in papers %}<div class="ln"><span><span class="k">{{ L.paper }}</span>{{ x.title }}{% if x.venue %} <span class="v">— {{ x.venue }}</span>{% endif %}</span><span class="y">{{ x.year }}</span></div>{% endfor %}
<div class="note">{{ '+ ' if en else '외 ' }}{{ L.talks_more }} {{ talks|length }}{{ '' if en else '건' }}</div>
</div>
<div>
<h2>{{ L.awards }}</h2>
{% for x in awards %}<div class="ln"><span>{{ x.name }}</span><span class="y">{{ x.date }}</span></div>{% endfor %}
{% for x in certifications %}<div class="ln"><span>{{ x.name }}</span><span class="y">{{ x.date }}</span></div>{% endfor %}
</div>
</div>

<h2>{{ L.skills }}</h2>
<div class="skg">{% for s in skills %}<div><b>{{ s.category }}</b>{{ s['items']|join(' · ') }}</div>{% endfor %}</div>
</div></body>
</html>
