{# 커리어 지도 — data/career_map.yaml + data/geo/basemap.json (build.py career_map). 사용: {% include "_map.j2" %} (en, career_map 필요)
   3D 지구본: deck.gl GlobeView (docs/assets/vendor/deck.gl-9.0.38.min.js, MIT) + 육지 윤곽 docs/assets/globe/land.json. 평면 지도는 대체 표시로 그대로 둔다. #}
{% if career_map %}
{% set M = career_map %}{% set B = M.base %}
{% set LY = {
  'stay': ('Where I worked' if en else '머문 곳'),
  'data': ('Regions I studied with data' if en else '데이터로 연구한 지역'),
  'partner': ('Partner institution' if en else '협력 기관'),
} %}
{% set cnt = {'stay': 0, 'data': 0, 'partner': 0} %}{% for pl in M.places %}{% set _ = cnt.update({pl.layer: cnt[pl.layer] + 1}) %}{% endfor %}
{% set kcount = M.places|selectattr('inset')|list|length %}
{% set home = (M.places|selectattr('id', 'equalto', 'jeonju')|first) %}
<style>
.cmap-plays{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px}
.cmap-play{display:inline-flex;align-items:center;gap:9px;border:1px solid var(--line);background:var(--card);color:var(--text);font:inherit;font-size:14px;font-weight:700;padding:9px 18px 9px 12px;border-radius:999px;cursor:pointer}
.cmap-play:hover{border-color:var(--text)}
.cmap-play i{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:var(--ink);color:var(--on-ink);font-style:normal;font-size:11px;padding-left:2px}
.cmap-play small{font-weight:500;color:var(--faint);font-size:12.5px}
.cmap-dlg{border:0;padding:0;background:var(--card);color:var(--text);border-radius:22px;overflow:hidden;width:min(960px,calc(100vw - 32px));max-height:calc(100vh - 32px)}
.cmap-dlg::backdrop{background:rgba(10,12,24,.72)}
.cmap-dlg video{display:block;width:100%;height:auto;aspect-ratio:16/9;background:#1b2340}
.cmap-dlg .bar{display:flex;align-items:center;gap:12px;padding:10px 12px 10px 18px;font-size:13.5px;color:var(--muted);line-height:1.5}
.cmap-dlg .bar b{color:var(--text)}
.cmap-dlg .bar span{flex:1;min-width:0}
.cmap-dlg .bar button{flex:none;border:1px solid var(--line);background:none;color:var(--text);font:inherit;font-size:13px;font-weight:700;padding:7px 14px;border-radius:999px;cursor:pointer}
.cmap{--stay:#5b6cff;--data:#ea7a0c;--partner:#16a34a;--land:color-mix(in srgb,var(--text) 11%,var(--card));--land2:color-mix(in srgb,var(--text) 5%,var(--card));--gsea:color-mix(in srgb,var(--stay) 9%,var(--card));--gland:color-mix(in srgb,var(--text) 20%,var(--card));--ggrid:color-mix(in srgb,var(--stay) 16%,var(--card))}
.cmap-f{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 14px}
.cmap-f button{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);background:var(--card);color:var(--muted);font:inherit;font-size:13.5px;font-weight:700;padding:7px 14px;border-radius:999px;cursor:pointer}
.cmap-f button[aria-pressed="true"]{background:var(--ink);color:var(--on-ink);border-color:var(--ink)}
.cmap-f i{width:9px;height:9px;border-radius:50%;display:inline-block}
.cmap-g{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr) 340px;grid-template-areas:'world world info' 'korea list info';gap:14px;align-items:start}
.cmap-world{grid-area:world}.cmap-inset{grid-area:korea}.cmap-list{grid-area:list}.cmap-info{grid-area:info;align-self:stretch}
.cmap-list{padding:16px 16px 12px}
.cmap-list ul{list-style:none;margin:0;padding:0;columns:2;column-gap:10px}
.cmap-list li{break-inside:avoid}
.cmap-list button{display:flex;align-items:flex-start;gap:9px;width:100%;text-align:left;border:0;background:none;font:inherit;color:var(--text);padding:6px 8px;border-radius:10px;cursor:pointer}
.cmap-list button:hover,.cmap-list button.on{background:var(--bg)}
.cmap-list button i{flex:none;width:8px;height:8px;border-radius:50%;background:var(--c);margin-top:6px}
.cmap-list button span{font-size:13.5px;font-weight:600;line-height:1.4;min-width:0}
.cmap-list button small{display:block;font-size:11.5px;font-weight:500;color:var(--faint)}
.cmap.hide-stay .cmap-list li.stay,.cmap.hide-data .cmap-list li.data,.cmap.hide-partner .cmap-list li.partner{display:none}
.cmap-card{position:relative;background:var(--card);border:1px solid var(--line);border-radius:26px;overflow:hidden}
.cmap-world{padding:14px}
.cmap-stage{position:relative}
.cmap-stage svg{display:block;width:100%;height:auto}
.cmap-stage .land{fill:var(--land)}
.cmap-stage .ctx{fill:var(--land2)}
.cmap-stage .kr{fill:var(--land);stroke:color-mix(in srgb,var(--text) 20%,transparent);stroke-width:.6}
.pin{position:absolute;transform:translate(-50%,-50%);width:22px;height:22px;border:0;padding:0;background:none;cursor:pointer;display:grid;place-items:center;z-index:2}
.pin i{display:block;width:10px;height:10px;border-radius:50%;background:var(--c);box-shadow:0 0 0 2px var(--card);transition:transform .15s}
.pin::before{content:"";position:absolute;inset:-7px;border-radius:50%}
.pin.data i{width:8px;height:8px}
.pin.partner i{border-radius:2px;transform:rotate(45deg)}
.pin.stay i::after{content:"";position:absolute;inset:-6px;border-radius:50%;border:2px solid var(--c);opacity:.45;animation:cmp 2.4s ease-out infinite}
.pin.stay i{position:relative}
@keyframes cmp{0%{transform:scale(.6);opacity:.6}100%{transform:scale(1.6);opacity:0}}
@media (prefers-reduced-motion: reduce){.pin.stay i::after{animation:none}}
.pin:hover i,.pin:focus-visible i,.pin.on i{transform:scale(1.5)}
.pin.partner:hover i,.pin.partner.on i{transform:rotate(45deg) scale(1.5)}
.pin:focus-visible{outline:2px solid var(--text);outline-offset:2px;border-radius:50%}
.pin.grp{width:28px;height:28px}
.pin.grp b{display:grid;place-items:center;width:22px;height:22px;border-radius:50%;background:color-mix(in srgb,var(--c) 72%,#000);color:#fff;font-size:11.5px;font-weight:800;box-shadow:0 0 0 2px var(--card);transition:transform .15s}
.pin.grp:hover b,.pin.grp.on b{transform:scale(1.15)}
.pin.grp.off,.plabel.off{display:none}
.cmap-info .mlist{list-style:none;margin:6px 0 0;padding:0}
.cmap-info .mlist button{display:flex;align-items:center;gap:10px;width:100%;text-align:left;border:0;background:none;font:inherit;font-size:14px;color:var(--text);padding:9px 10px;border-radius:12px;cursor:pointer}
.cmap-info .mlist button:hover{background:var(--bg)}
.cmap-info .mlist i{flex:none;width:9px;height:9px;border-radius:50%}
.pin.kgroup{width:auto;height:auto;transform:translate(-8px,-50%)}
.pin.kgroup span{display:inline-flex;align-items:center;gap:6px;background:var(--ink);color:var(--on-ink);font-size:11.5px;font-weight:700;padding:3px 9px 3px 4px;border-radius:999px;box-shadow:var(--shadow);white-space:nowrap}
.pin.kgroup span b{width:16px;height:16px;border-radius:50%;background:color-mix(in srgb,var(--stay) 72%,#000);display:grid;place-items:center;font-size:10px;color:#fff}
.plabel{position:absolute;transform:translate(10px,-50%);font-size:11.5px;font-weight:700;color:var(--muted);white-space:nowrap;pointer-events:none;z-index:1;text-shadow:0 0 4px var(--card),0 0 4px var(--card)}
.plabel.left{transform:translate(calc(-100% - 10px),-50%)}
.cmap.hide-stay .pin.stay:not(.grp),.cmap.hide-data .pin.data:not(.grp),.cmap.hide-partner .pin.partner:not(.grp),.cmap.hide-stay .plabel.stay:not(.grp-l),.cmap.hide-data .plabel.data:not(.grp-l),.cmap.hide-partner .plabel.partner:not(.grp-l){display:none}
.cmap-inset{padding:12px 12px 6px;align-self:stretch}
.cmap-list{align-self:stretch}
.cmap-inset h3,.cmap-info h3,.cmap-inset h4,.cmap-info h4,.cmap-list h4{margin:0 0 6px;font-size:13px;color:var(--faint);font-weight:700;letter-spacing:.02em}
.cmap-info{padding:18px 20px;min-height:180px}
.cmap-info .nm{font-size:17px;font-weight:800;letter-spacing:-.02em;line-height:1.4;margin:6px 0 2px}
.cmap-info .wh{font-size:13px;color:var(--faint);margin-bottom:10px}
.cmap-info p{margin:0 0 12px;font-size:14px;color:var(--muted);line-height:1.65}
.cmap-info .lb{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;padding:2px 10px;border-radius:999px;background:color-mix(in srgb,var(--c) 14%,transparent);color:color-mix(in srgb,var(--c) 60%,var(--mixc,#000))}
.cmap-info a.go{display:inline-flex;font-size:13.5px;font-weight:700;padding:8px 14px;border-radius:999px;background:var(--ink);color:var(--on-ink)}
.cmap-info figure{margin:4px 0 12px}
.cmap-info figure img{display:block;width:100%;height:auto;max-height:230px;object-fit:contain;border-radius:12px;background:var(--bg)}
.cmap-info figcaption{font-size:11.5px;color:var(--faint);margin-top:5px}
.cmap-info figcaption a{color:inherit}
.cmap-info .ab{color:var(--text)}
.cmap-info .src{font-size:12px;color:var(--faint);white-space:nowrap}
.cmap-info .hint{font-size:14px;color:var(--muted);margin:4px 0 12px}
.cmap-info ul{list-style:none;margin:0;padding:0;font-size:13.5px;color:var(--muted)}
.cmap-info li{display:flex;align-items:center;gap:8px;padding:3px 0}
.cmap-info li i{width:9px;height:9px;border-radius:50%;display:inline-block}
.cmap-swipe{display:none;font-size:12px;color:var(--faint);margin:-6px 2px 8px}
.pin.kgroup.left{transform:translate(calc(-100% + 8px),-50%)}
.cmap-note{font-size:12px;color:var(--faint);margin:10px 2px 0}
.cmap-globe{position:relative;height:clamp(360px,44vw,520px);border-radius:18px;overflow:hidden;background:radial-gradient(ellipse at 50% 45%,color-mix(in srgb,var(--stay) 7%,var(--card)) 0%,var(--card) 70%);touch-action:pan-y}
.cmap-globe canvas{outline:none}
.cmap-view{position:absolute;top:14px;right:14px;z-index:3;display:none;gap:2px;padding:3px;border-radius:999px;background:color-mix(in srgb,var(--card) 88%,transparent);border:1px solid var(--line);backdrop-filter:blur(8px)}
.cmap-view button{border:0;background:none;color:var(--muted);font:inherit;font-size:12.5px;font-weight:700;padding:6px 12px;border-radius:999px;cursor:pointer}
.cmap-view button[aria-pressed="true"]{background:var(--ink);color:var(--on-ink)}
.cmap.has-globe .cmap-view{display:inline-flex}
.cmap.has-globe.globe-on .cmap-world>.cmap-stage,.cmap.has-globe.globe-on .cmap-swipe{display:none!important}
.cmap:not(.globe-on) .cmap-globe{display:none}
.cmap-ghint{position:absolute;left:16px;bottom:12px;z-index:2;font-size:12px;color:var(--faint);pointer-events:none}
@media (max-width:960px){
  .cmap-g{grid-template-columns:1fr;grid-template-areas:'world' 'info' 'korea' 'list'}
  .cmap-info{position:static}
  .cmap-world{padding:8px;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:thin}
  .cmap-world .cmap-stage{width:760px}
  .cmap.globe-on .cmap-world{overflow:hidden}
  .cmap-swipe{display:block!important}
  .plabel{font-size:11.5px}
  .cmap-list ul{columns:1}
}
</style>
<section id="map" class="cmap">
  <div class="sec-t"><h2>{{ 'Footprints' if en else '발자취' }}</h2><p>{{ 'Where I worked and the regions I studied with data — tap a point to see what I did there.' if en else '머문 곳과 데이터로 연구한 지역입니다. 점을 누르면 그곳에서 한 일이 나옵니다.' }}</p></div>
  <div class="cmap-plays">
    <button type="button" class="cmap-play" data-film="painted" aria-haspopup="dialog"><i aria-hidden="true">▶</i>{{ 'Journey — animation' if en else '여정 애니메이션' }} <small>{{ '87s' if en else '1분 27초' }}</small></button>
    <button type="button" class="cmap-play" data-film="doc" aria-haspopup="dialog"><i aria-hidden="true">▶</i>{{ 'Journey — in real photos' if en else '여정 기록 영상' }} <small>{{ '93s' if en else '1분 33초' }}</small></button>
  </div>
  <dialog class="cmap-dlg" id="cmap-dlg" aria-label="{{ 'Journey video' if en else '여정 영상' }}">
    <video controls playsinline preload="none" width="1280" height="720"></video>
    <div class="bar"><span id="cmap-dlg-t"></span><button type="button" id="cmap-dlg-x">{{ 'Close' if en else '닫기' }}</button></div>
  </dialog>
  <script>(function(){var F={painted:['assets/journey/journey_painted{{ '_en' if en else '' }}.mp4','assets/journey/poster_painted{{ '_en' if en else '' }}.jpg',{{ ('<b>A road that follows a star</b> · with music. Scene art is AI-generated.' if en else '<b>별을 따라 걷는 길</b> · 배경 음악 있음. 전주 → 캘거리 → 로키 산맥 → 다시 한국. 장면 그림은 AI로 생성했습니다.')|tojson }}],doc:['assets/journey/journey_doc{{ '_en' if en else '' }}.mp4','assets/journey/poster_doc{{ '_en' if en else '' }}.jpg',{{ ('<b>A record of the journey</b> · with music. Real photos (credits at the end) and my own documents.' if en else '<b>여정의 기록</b> · 배경 음악 있음. 실제 장소 사진(출처는 영상 끝)과 본인 자료로 만들었습니다.')|tojson }}]};
var d=document.getElementById('cmap-dlg'),v=d.querySelector('video'),t=document.getElementById('cmap-dlg-t');
document.querySelectorAll('.cmap-play').forEach(function(b){b.addEventListener('click',function(){var f=F[b.dataset.film];if(window.stat)stat('video-'+b.dataset.film);if(v.getAttribute('src')!==f[0]){v.poster=f[1];v.src=f[0]}t.innerHTML=f[2];if(d.showModal)d.showModal();else d.setAttribute('open','');v.currentTime=0;var p=v.play();if(p&&p.catch)p.catch(function(){})})});
document.getElementById('cmap-dlg-x').addEventListener('click',function(){d.close()});d.addEventListener('click',function(e){if(e.target===d)d.close()});d.addEventListener('close',function(){v.pause()})})();</script>
  <div class="cmap-f" role="group" aria-label="{{ 'Layers' if en else '지도 층' }}">
    {% for k in ['stay', 'data', 'partner'] %}<button type="button" data-layer="{{ k }}" aria-pressed="true"><i style="background:var(--{{ k }})"></i>{{ LY[k] }} {{ cnt[k] }}</button>{% endfor %}
  </div>
  <p class="cmap-swipe">{{ '← Swipe the world map sideways →' if en else '← 세계 지도는 옆으로 밀어서 볼 수 있어요 →' }}</p>
  <div class="cmap-g">
    <div class="cmap-card cmap-world">
      {% if M.globe %}<div class="cmap-view" role="group" aria-label="{{ 'Map view' if en else '지도 보기' }}"><button type="button" data-view="globe" aria-pressed="true">{{ '3D globe' if en else '3D 지구본' }}</button><button type="button" data-view="flat" aria-pressed="false">{{ 'Flat map' if en else '평면 지도' }}</button></div>
      <div class="cmap-globe" id="cmap-globe" role="img" aria-label="{{ 'Rotating 3D globe of my career — arcs run from Jeonju to each place' if en else '돌려 볼 수 있는 커리어 3D 지구본 — 전주에서 각 장소로 이어지는 선' }}"><span class="cmap-ghint">{{ 'Drag to rotate · tap a point' if en else '끌어서 돌리기 · 점을 눌러 보기' }}</span></div>{% endif %}
      <div class="cmap-stage">
        <svg viewBox="0 0 {{ B.world.w }} {{ B.world.h }}" role="img" aria-label="{{ 'World map of my career' if en else '커리어 세계 지도' }}"><path class="land" d="{{ B.world.land }}"/></svg>
        {% set PB = {} %}{% for pl in M.places %}{% set _ = PB.update({pl.id: pl}) %}{% endfor %}
        {% for gr in M.groups %}{% set pl = PB[gr.members[0]] %}{% set t = pl.en if en else pl.ko %}
        {% set gx = (gr.x / B.world.w * 100)|round(2) %}{% set gy = (gr.y / B.world.h * 100)|round(2) %}
        {% if gr.members|length == 1 %}
        <button type="button" class="pin {{ pl.layer }}" style="left:{{ gx }}%;top:{{ gy }}%;--c:var(--{{ pl.layer }})" data-id="{{ pl.id }}" aria-label="{{ t.name }}" title="{{ t.name }}"><i></i></button>
        {% if gr.label %}<span class="plabel {{ pl.layer }}{% if gr.x > B.world.w * 0.8 %} left{% endif %}" style="left:{{ gx }}%;top:{{ gy }}%">{{ t.name.split(' (')[0] }}</span>{% endif %}
        {% else %}{% set rg = (pl.region.en if en else pl.region.ko) if pl.region else t.name.split(' (')[0] %}
        <button type="button" class="pin grp {{ gr.layers|join(' ') }}" style="left:{{ gx }}%;top:{{ gy }}%;--c:var(--{{ gr.layers[0] }})" data-members="{{ gr.members|join(',') }}" data-region="{{ rg }}" aria-label="{{ gr.members|length }} {{ rg }} — {{ 'places' if en else '곳' }}" title="{{ rg }}"><b>{{ gr.members|length }}</b></button>
        <span class="plabel grp-l {{ gr.layers|join(' ') }}{% if gr.x > B.world.w * 0.8 %} left{% endif %}" style="left:{{ gx }}%;top:{{ gy }}%;transform:translate(16px,-50%)">{{ rg }}</span>
        {% endif %}
        {% endfor %}
        {% if home %}<button type="button" class="pin kgroup stay{% if home.x > B.world.w * 0.8 %} left{% endif %}" style="left:{{ (home.x / B.world.w * 100)|round(2) }}%;top:{{ (home.y / B.world.h * 100)|round(2) }}%;--c:var(--stay)" data-id="jeonju" aria-label="{{ kcount }} {{ 'Korea — see the zoomed map' if en else '대한민국 — 확대 지도 보기' }}"><span><b>{{ kcount }}</b> {{ 'Korea' if en else '대한민국' }}</span></button>{% endif %}
      </div>
    </div>
      <div class="cmap-card cmap-inset" id="cmap-korea">
        <h3>{{ 'Korea (zoomed)' if en else '한반도 확대' }}</h3>
        <div class="cmap-stage">
          <svg viewBox="0 0 {{ B.korea.w }} {{ B.korea.h }}" role="img" aria-label="{{ 'Map of Korea' if en else '한반도 지도' }}"><path class="ctx" d="{{ B.korea.ctx }}"/><path class="kr" d="{{ B.korea.kr }}"/></svg>
          {% for pl in M.places if pl.inset %}{% set t = pl.en if en else pl.ko %}
          <button type="button" class="pin {{ pl.layer }}" style="left:{{ (pl.ix / B.korea.w * 100)|round(2) }}%;top:{{ (pl.iy / B.korea.h * 100)|round(2) }}%;--c:var(--{{ pl.layer }})" data-id="{{ pl.id }}" aria-label="{{ t.name }}" title="{{ t.name }}"><i></i></button>
          <span class="plabel {{ pl.layer }}{% if pl.ix > B.korea.w * 0.7 %} left{% endif %}" style="left:{{ (pl.ix / B.korea.w * 100)|round(2) }}%;top:{{ (pl.iy / B.korea.h * 100)|round(2) }}%">{{ t.name.split(' (')[0] }}</span>
          {% endfor %}
        </div>
      </div>
      <div class="cmap-card cmap-list">
        <h4>{{ 'All places' if en else '장소 목록' }}</h4>
        <ul>{% for k in ['stay', 'partner', 'data'] %}{% for pl in M.places if pl.layer == k %}{% set t = pl.en if en else pl.ko %}<li class="{{ k }}"><button type="button" data-goto="{{ pl.id }}" style="--c:var(--{{ k }})" title="{{ t.when }}"><i></i><span>{{ t.name.split(' (')[0] }}</span></button></li>{% endfor %}{% endfor %}</ul>
      </div>
      <div class="cmap-card cmap-info" id="cmap-info" aria-live="polite">
        <h4>{{ 'Details' if en else '자세히' }}</h4>
        <p class="hint">{{ 'Tap a point on the map.' if en else '지도의 점을 눌러 보세요.' }}</p>
        <ul>{% for k in ['stay', 'data', 'partner'] %}<li><i style="background:var(--{{ k }})"></i>{{ LY[k] }} · {{ cnt[k] }}</li>{% endfor %}</ul>
      </div>
  </div>
  <p class="cmap-note">{{ 'Locations are approximate; offshore fields and storage sites are shown at a nearby point. Country outlines: Natural Earth via world-atlas.' if en else '위치는 대략적입니다. 해상 광구·저장소는 근처 지점에 표시했습니다. 지도 윤곽: Natural Earth(world-atlas).' }}</p>
  <script type="application/json" id="cmap-data">{{ M.places|map(attribute='id')|list|tojson }}</script>
  {% set info = {} %}{% for pl in M.places %}{% set t = pl.en if en else pl.ko %}{% set ph = pl.photo or {} %}{% set _ = info.update({pl.id: {'n': t.name, 'w': t.when, 'd': t.desc, 'a': t.about or '', 'as': pl.about_src or '', 'ph': ph.src or '', 'cr': (ph.credit_en if en and ph.credit_en else ph.credit) or '', 'pg': ph.page or '', 'l': pl.layer, 'u': ('projects/' ~ pl.link ~ ('-en' if en else '') ~ '.html') if pl.link else ''}}) %}{% endfor %}
  <script type="application/json" id="cmap-info-data">{{ info|tojson }}</script>
  {% if M.globe %}{% set gp = [] %}{% for pl in M.places %}{% set t = pl.en if en else pl.ko %}{% set _ = gp.append({'id': pl.id, 'lat': pl.lat, 'lon': pl.lon, 'l': pl.layer, 'n': t.name.split(' (')[0], 'lab': (pl.label or pl.id == 'jeonju') and not pl.inset or pl.id == 'jeonju', 'k': pl.inset or False}) %}{% endfor %}
  <script type="application/json" id="cmap-globe-data">{{ gp|tojson }}</script>{% endif %}
</section>
<script>
(function(){
var root=document.querySelector('.cmap');if(!root)return;
var INFO=JSON.parse(document.getElementById('cmap-info-data').textContent),box=document.getElementById('cmap-info');
var LBL={stay:'{{ LY.stay }}',data:'{{ LY.data }}',partner:'{{ LY.partner }}'},GO='{{ "Project details →" if en else "관련 프로젝트 보기 →" }}';
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
var GLOBE=null;
function pick(id,btn){var p=INFO[id];if(!p)return;if(GLOBE)GLOBE.focus(id);
  root.querySelectorAll('[data-goto]').forEach(function(x){x.classList.toggle('on',x.dataset.goto===id)});
  root.querySelectorAll('.pin.on').forEach(function(x){x.classList.remove('on')});
  root.querySelectorAll('.pin[data-id="'+id+'"]').forEach(function(x){if(!x.classList.contains('kgroup'))x.classList.add('on')});
  box.innerHTML='<h3>{{ "Details" if en else "자세히" }}</h3><span class="lb" style="--c:var(--'+p.l+')">'+esc(LBL[p.l])+'</span><div class="nm">'+esc(p.n)+'</div><div class="wh">'+esc(p.w)+'</div>'+(p.ph?'<figure><img width="640" height="420" src="'+esc(p.ph)+'" alt="'+esc(p.n)+'" loading="lazy">'+(p.cr?'<figcaption>'+(p.pg?'<a href="'+esc(p.pg)+'" target="_blank" rel="noopener">':'')+esc(p.cr)+(p.pg?'</a>':'')+'</figcaption>':'')+'</figure>':'')+(p.a?'<p class="ab">'+esc(p.a)+(p.as?' <a class="src" href="'+esc(p.as)+'" target="_blank" rel="noopener">{{ "Wikipedia" if en else "출처: 위키백과" }} ↗</a>':'')+'</p>':'')+'<p>'+esc(p.d)+'</p>'+(p.u?'<a class="go" href="'+p.u+'">'+GO+'</a>':'');
  if(btn&&btn.classList.contains('kgroup')){var k=document.getElementById('cmap-korea');if(k&&k.scrollIntoView&&matchMedia('(max-width:960px)').matches)k.scrollIntoView({block:'nearest',behavior:'smooth'})}
}
var HID={};
function vis(id){return !HID[INFO[id].l]}
function list(btn){var ms=btn.dataset.members.split(',').filter(vis);root.querySelectorAll('.pin.on').forEach(function(x){x.classList.remove('on')});btn.classList.add('on');
  box.innerHTML='<h4>{{ "Details" if en else "자세히" }}</h4><div class="nm">'+esc(btn.dataset.region)+'</div><div class="wh">'+ms.length+'{{ " places — choose one" if en else "곳 — 하나를 골라 보세요" }}</div><ul class="mlist">'+ms.map(function(id){var p=INFO[id];return '<li><button type="button" data-pick="'+id+'"><i style="background:var(--'+p.l+')"></i>'+esc(p.n)+'</button></li>'}).join('')+'</ul>';
  box.querySelectorAll('[data-pick]').forEach(function(b){b.addEventListener('click',function(){pick(b.dataset.pick);btn.classList.add('on')})});}
root.querySelectorAll('[data-goto]').forEach(function(b){b.addEventListener('click',function(){pick(b.dataset.goto)})});
if(INFO.ghasha)pick('ghasha');
root.querySelectorAll('.pin').forEach(function(b){b.addEventListener('click',function(){if(b.classList.contains('grp'))list(b);else pick(b.dataset.id,b)})});
function regroup(){root.querySelectorAll('.pin.grp').forEach(function(g){var n=g.dataset.members.split(',').filter(vis).length;g.classList.toggle('off',!n);g.querySelector('b').textContent=n;var l=g.nextElementSibling;if(l&&l.classList.contains('grp-l'))l.classList.toggle('off',!n);})}
root.querySelectorAll('.cmap-f button').forEach(function(b){b.addEventListener('click',function(){var on=b.getAttribute('aria-pressed')!=='true';b.setAttribute('aria-pressed',on);root.classList.toggle('hide-'+b.dataset.layer,!on);HID[b.dataset.layer]=!on;regroup();if(GLOBE)GLOBE.refresh()})});
{% if M.globe %}
// ── 3D 지구본 (deck.gl GlobeView, 사이트 안에 둔 파일) — 지도 섹션에 가까워질 때만 불러온다. 실패하면 평면 지도가 그대로 남는다.
(function(){
  var host=document.getElementById('cmap-globe');if(!host||!window.IntersectionObserver)return;
  var PL=JSON.parse(document.getElementById('cmap-globe-data').textContent),HOME=PL.filter(function(p){return p.id==='jeonju'})[0];
  var probe=document.createElement('i');probe.style.display='none';root.appendChild(probe);
  function rgb(v,a){probe.style.color='var('+v+')';var c=getComputedStyle(probe).color,m=c.match(/[\d.]+/g)||[0,0,0];
    var x=c.indexOf('color(')===0?m.slice(0,3).map(function(n){return Math.round(+n*255)}):m.slice(0,3).map(Number);return x.concat([a==null?255:a])}
  function load(src){return new Promise(function(ok,no){var s=document.createElement('script');s.src=src;s.onload=ok;s.onerror=no;document.head.appendChild(s)})}
  var reduce=matchMedia('(prefers-reduced-motion: reduce)').matches,small=matchMedia('(max-width:960px)').matches;
  var fit=function(){var w=host.clientWidth||600,h=host.clientHeight||420;return Math.log2(0.88*Math.min(w,h)/375)};   // 지름 ≈ 375·2^zoom px → 짧은 변의 88%
  var view={longitude:HOME?HOME.lon-25:100,latitude:22,zoom:fit(),minZoom:-1,maxZoom:3},spin=!reduce,deckObj=null,LAND=null,sel=null;
  function grid(){var g=[];for(var lo=-180;lo<180;lo+=30){var a=[];for(var la=-80;la<=80;la+=4)a.push([lo,la]);g.push(a)}
    for(var la2=-60;la2<=60;la2+=30){var b=[];for(var lo2=-180;lo2<=180;lo2+=4)b.push([lo2,la2]);g.push(b)}return g}
  var GRID=grid();
  // 지금 보는 면의 중심에서 75° 안쪽만 (반대편 이름표가 지평선 너머로 비치지 않게)
  function front(p){var r=Math.PI/180,a=view.latitude*r,b=p.lat*r;return Math.sin(a)*Math.sin(b)+Math.cos(a)*Math.cos(b)*Math.cos((p.lon-view.longitude)*r)>0.26}
  var lastLab=0;function relabel(){var t=Date.now();if(t-lastLab>150){lastLab=t;draw()}}
  function layers(){
    var C={stay:rgb('--stay'),data:rgb('--data'),partner:rgb('--partner')},card=rgb('--card'),land=rgb('--gland'),line=rgb('--ggrid'),txt=rgb('--text'),sea=rgb('--gsea');
    var vis=PL.filter(function(p){return !HID[p.l]}),far=vis.filter(function(p){return !p.k});
    return [
      new deck.SolidPolygonLayer({id:'sea',data:[[[-180,90],[0,90],[180,90],[180,-90],[0,-90],[-180,-90]]],getPolygon:function(d){return d},getFillColor:sea,updateTriggers:{getFillColor:sea.join()}}),
      new deck.SolidPolygonLayer({id:'land',data:LAND,getPolygon:function(d){return d},getFillColor:land,updateTriggers:{getFillColor:land.join()}}),
      new deck.PathLayer({id:'grid',data:GRID,getPath:function(d){return d},getColor:line,getWidth:.6,widthUnits:'pixels',updateTriggers:{getColor:line.join()}}),
      new deck.ArcLayer({id:'arcs',data:HOME?far:[],greatCircle:true,getSourcePosition:function(){return[HOME.lon,HOME.lat]},getTargetPosition:function(p){return[p.lon,p.lat]},
        getSourceColor:C.stay.slice(0,3).concat([200]),getTargetColor:function(p){return C[p.l].slice(0,3).concat([230])},getWidth:function(p){return p.id===sel?3:1.6},widthUnits:'pixels',getHeight:.12,
        updateTriggers:{getTargetColor:JSON.stringify(C),getWidth:sel}}),
      new deck.ScatterplotLayer({id:'pts',data:vis,getPosition:function(p){return[p.lon,p.lat]},radiusUnits:'pixels',getRadius:function(p){return (p.id===sel?3:0)+(p.l==='stay'?7:p.l==='partner'?6:5)},
        getFillColor:function(p){return C[p.l]},stroked:true,getLineColor:card,lineWidthUnits:'pixels',getLineWidth:2,pickable:true,autoHighlight:true,highlightColor:txt.slice(0,3).concat([90]),
        updateTriggers:{getFillColor:JSON.stringify(C),getLineColor:card.join(),getRadius:sel},transitions:{getRadius:200}}),
      new deck.TextLayer({id:'lab',data:vis.filter(function(p){return p.lab&&front(p)}),getPosition:function(p){return[p.lon,p.lat]},getText:function(p){return p.n},characterSet:'auto',
        fontFamily:getComputedStyle(document.body).fontFamily,fontWeight:700,getSize:12,getColor:txt,getPixelOffset:[10,0],getTextAnchor:'start',getAlignmentBaseline:'center',
        fontSettings:{sdf:true},outlineWidth:4,outlineColor:card,updateTriggers:{getColor:txt.join()}})];
  }
  function draw(){if(deckObj)deckObj.setProps({layers:layers()})}
  function tick(){if(!spin||!deckObj)return;view=Object.assign({},view,{longitude:view.longitude+0.06});deckObj.setProps({initialViewState:view});relabel();requestAnimationFrame(tick)}
  function stop(){spin=false}
  function start(){
    root.classList.add('has-globe','globe-on');   // 먼저 보이게 해야 크기를 잴 수 있다
    view=Object.assign({},view,{zoom:fit()});
    deckObj=new deck.Deck({parent:host,views:new deck._GlobeView({resolution:10}),initialViewState:view,controller:{scrollZoom:false,touchZoom:true,keyboard:false},
      layers:layers(),getCursor:function(s){return s.isHovering?'pointer':'grab'},
      onViewStateChange:function(e){view=e.viewState;relabel();return e.viewState},
      onInteractionStateChange:function(s){if(s.isDragging||s.isZooming||s.isRotating)stop()},
      onClick:function(info){if(info.object&&info.layer.id==='pts'){stop();pick(info.object.id)}},
      getTooltip:function(info){return info.object&&info.layer.id==='pts'?{text:info.object.n,style:{fontFamily:getComputedStyle(document.body).fontFamily,fontSize:'12.5px',padding:'5px 9px',borderRadius:'8px',background:'rgba('+rgb('--card').slice(0,3).join()+',.95)',color:'rgb('+rgb('--text').slice(0,3).join()+')',border:'1px solid rgba('+rgb('--line').slice(0,3).join()+',1)'}}:null}});
    GLOBE={focus:function(id){var p=PL.filter(function(x){return x.id===id})[0];if(!p)return;sel=id;stop();
        view=Object.assign({},view,{longitude:p.lon,latitude:Math.max(-50,Math.min(60,p.lat)),zoom:Math.max(view.zoom,fit()+0.7),transitionDuration:reduce?0:1200,transitionInterpolator:new deck.FlyToInterpolator()});
        deckObj.setProps({initialViewState:view});draw()},refresh:draw};
    if(spin)requestAnimationFrame(tick);
    var mo=new MutationObserver(draw);mo.observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change',draw);
  }
  root.querySelectorAll('.cmap-view button').forEach(function(b){b.addEventListener('click',function(){var g=b.dataset.view==='globe';
    root.classList.toggle('globe-on',g);root.querySelectorAll('.cmap-view button').forEach(function(x){x.setAttribute('aria-pressed',x===b)});if(g&&deckObj)deckObj.redraw(true)})});
  var io=new IntersectionObserver(function(es){if(!es.some(function(e){return e.isIntersecting}))return;io.disconnect();
    Promise.all([load('assets/vendor/deck.gl-9.0.38.min.js'),fetch('assets/globe/land.json').then(function(r){if(!r.ok)throw 0;return r.json()})])
      .then(function(r){LAND=r[1];if(!window.deck||!deck._GlobeView)throw 0;start()})
      .catch(function(){host.remove()});   // 실패하면 평면 지도 그대로
  },{rootMargin:'600px 0px'});
  io.observe(root);
})();
{% endif %}
})();
</script>
{% endif %}
