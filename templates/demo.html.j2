{% import "_head.j2" as h %}
{% set T = {
  'title': 'Citation check demo' if en else '근거 번호 검증 데모',
  'lead': ('The LLM is told to cite evidence as [Evidence N], yet it sometimes cites numbers that do not exist. This page replays, in your browser, the rule my Heritage RAG guide uses: fix the numbers at retrieval, parse every citation in the answer, drop the ones that do not exist, and show only the evidence the answer actually used.') if en else ('LLM에게 "[근거 N]을 붙여 답하라"고 해도 없는 번호를 붙일 때가 있습니다. 국보 입문 가이드(RAG)가 쓰는 규칙 — 근거 번호를 검색 단계에서 고정하고, 답변의 인용을 코드로 파싱해 없는 번호를 지우고, 실제로 인용한 근거만 보여 주는 과정 — 을 브라우저에서 그대로 재현합니다.'),
  'note': ('Example data. The parsing and filtering code is the same rule as the real service; no LLM is called here.') if en else ('예시 데이터로 동작합니다. 파싱·검사 규칙은 실제 서비스와 같고, 이 페이지는 LLM을 호출하지 않습니다.'),
  'pick': 'Pick a question' if en else '예시 질문 고르기',
  's1': 'Evidence numbers fixed at retrieval' if en else '검색 단계에서 고정한 근거 번호',
  's2': 'Raw LLM answer — edit it and watch the check rerun' if en else 'LLM 답변 원문 — 직접 고쳐 보면 아래 검사가 바로 다시 돌아갑니다',
  's3': 'Citations parsed by code' if en else '코드가 찾은 인용',
  's4': 'Answer shown to the user' if en else '사용자에게 보여 주는 답',
  'kept': 'kept' if en else '유지', 'drop': 'removed — no such evidence' if en else '삭제 — 없는 근거',
  'used': 'evidence used in the answer' if en else '답변에 사용한 근거', 'found': 'evidence retrieved' if en else '검색된 근거',
  'none': 'No evidence was cited in this answer.' if en else '답변에 인용된 근거가 없습니다.',
  'refusal': 'Fixed “not in the documents” sentence detected' if en else '문서에 없는 질문 → 고정 문장으로 답함',
  'limit': ('The code checks that a cited number exists. Whether the sentence is supported by that evidence is handled by the answer rules and by tests with a fake LLM.') if en else ('코드는 인용한 번호가 실제로 있는지를 검사합니다. 문장이 그 근거로 뒷받침되는지는 답변 생성 규칙과 가짜 LLM 테스트로 따로 다룹니다.'),
  'reset': 'Reset answer' if en else '원래 답으로',
  'read': 'Read how it was built' if en else '설계 글 읽기', 'code': 'Source code' if en else '소스 코드',
  'back': 'Portfolio' if en else '포트폴리오', 'ev': 'Evidence' if en else '근거',
  'none_found': 'No [Evidence N] tags found.' if en else '[근거 N] 표기가 없습니다.',
} %}
{% set SC = [
  {'q': ('When was Sungnyemun built, and what happened to it recently?' if en else '숭례문은 언제 지어졌고, 최근에 어떤 일이 있었나요?'),
   'ev': [
     {'s': ('Heritage metadata' if en else '국보 메타데이터'), 't': ('Sungnyemun · National Treasure · architecture · 7th year of King Taejo of Joseon (1398) · Jung-gu, Seoul' if en else '숭례문 · 국보 · 유적건조물 · 조선 태조 7년(1398) · 서울 중구')},
     {'s': 'Wikipedia', 't': ('Sungnyemun was the main gate of Hanyang, the Joseon capital, completed in 1398.' if en else '숭례문은 조선의 수도 한양 도성의 정문으로, 1398년에 완공되었다.')},
     {'s': 'Wikipedia', 't': ('Its pavilion was badly damaged by arson in February 2008 and reopened in May 2013 after restoration.' if en else '2008년 2월 방화로 누각이 크게 훼손되었고, 복구를 거쳐 2013년 5월 다시 공개되었다.')},
     {'s': ('Heritage Service description' if en else '국가유산청 설명'), 't': ('The south gate of the city wall, also called Namdaemun.' if en else '한양 도성의 남쪽 정문으로 남대문이라고도 부른다.')},
     {'s': 'Wikipedia', 't': ('Heunginjimun is the east gate of the city wall.' if en else '흥인지문은 한양 도성의 동쪽 정문이다.')},
     {'s': 'Wikipedia', 't': ('The name plaque of Sungnyemun is written vertically.' if en else '숭례문의 현판은 세로로 쓰여 있다.')}],
   'a': ('Sungnyemun is the main gate of Hanyang, completed in 1398 [Evidence 1, 2]. Its pavilion was damaged by arson in 2008 and restored in 2013 [Evidence 3, 8]. It is also called Namdaemun [Evidence4][Evidence 7].' if en else '숭례문은 조선 태조 7년(1398)에 완공된 한양 도성의 정문입니다[근거 1, 2]. 2008년 방화로 누각이 크게 훼손되었다가 2013년에 복구되었습니다[근거 3, 8]. 흔히 남대문이라고도 부릅니다[근거4][근거 7].')},
  {'q': ('Which period is the Dabotap pagoda from?' if en else '다보탑은 어느 시대의 탑인가요?'),
   'ev': [
     {'s': ('Heritage metadata' if en else '국보 메타데이터'), 't': ('Dabotap Pagoda of Bulguksa · National Treasure · stone · Unified Silla · Gyeongju' if en else '불국사 다보탑 · 국보 · 석조 · 통일신라 · 경북 경주시')},
     {'s': 'Wikipedia', 't': ('It stands in front of the main hall of Bulguksa, facing Seokgatap to the east and west.' if en else '불국사 대웅전 앞마당에 석가탑과 동서로 마주 서 있다.')},
     {'s': 'Wikipedia', 't': ('It is thought to have been built around 751, when Bulguksa was built.' if en else '751년 무렵 불국사를 지을 때 함께 세운 것으로 본다.')},
     {'s': 'Wikipedia', 't': ('The official name of Seokgatap is the Three-story Stone Pagoda of Bulguksa.' if en else '석가탑의 정식 이름은 불국사 삼층석탑이다.')},
     {'s': 'Wikipedia', 't': ('Dabotap appears on the front of the Korean 10-won coin.' if en else '10원 동전 앞면에 다보탑이 새겨져 있다.')}],
   'a': ('Dabotap is a stone pagoda from Unified Silla [Evidence 1]. It is thought to date from around 751 [Evidence 3–9] and faces Seokgatap [Evidence 2、4]. It is on the 10-won coin [Evidence5].' if en else '다보탑은 통일신라 시대의 석탑입니다[근거 1]. 751년 무렵 불국사를 지을 때 함께 세운 것으로 보며[근거 3–9], 석가탑과 마주 서 있습니다[근거 2、4]. 10원 동전에도 새겨져 있습니다[근거5].')},
  {'q': ('How much is the Hunminjeongeum Haerye edition worth today?' if en else '훈민정음 해례본의 현재 가격은 얼마인가요?'),
   'ev': [
     {'s': ('Heritage metadata' if en else '국보 메타데이터'), 't': ('Hunminjeongeum · National Treasure · documentary heritage · 28th year of King Sejong (1446) · Seongbuk-gu, Seoul' if en else '훈민정음 · 국보 · 기록유산 · 조선 세종 28년(1446) · 서울 성북구')},
     {'s': 'Wikipedia', 't': ('Inscribed on the UNESCO Memory of the World Register in 1997.' if en else '1997년 유네스코 세계기록유산에 등재되었다.')},
     {'s': 'Wikipedia', 't': ('It includes the Haerye, which explains why and how the script was made.' if en else '글자를 만든 목적과 원리를 설명한 해례가 함께 실려 있다.')}],
   'a': ('This is not confirmed in the provided documents. For reference, it was inscribed on the UNESCO Memory of the World Register in 1997 [Evidence 2][Evidence 12].' if en else '제공된 문서에서 확인되지 않습니다. 참고로 1997년 유네스코 세계기록유산에 등재되었습니다[근거 2][근거 12].')},
] %}
<!doctype html>
<html lang="{{ 'en' if en else 'ko' }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ T.title }} — {{ profile.name }}</title>
{{ h.meta(T.title ~ ' — ' ~ profile.name, T.lead, 'demo' ~ ('-en' if en else '') ~ '.html', '', en, 'og/ssafy-16' ~ ('-en' if en else '') ~ '.png') }}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<style>
:root{--bg:#f6f7f9;--card:#fff;--text:#18181b;--muted:#5f6670;--faint:#9aa1ab;--line:#e2e5ea;--ink:#1f3a5f;--on-ink:#fff;--ok:#15803d;--ok-bg:#e8f5ec;--bad:#b42318;--bad-bg:#fdecea;--mark:#e8edf5;--mono:ui-monospace,"SFMono-Regular",Menlo,Consolas,monospace}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#0e1116;--card:#171b22;--text:#eef1f5;--muted:#a3abb7;--faint:#6f7884;--line:#2a313b;--ink:#9db8dd;--on-ink:#0e1116;--ok:#4ade80;--ok-bg:#14271b;--bad:#f87171;--bad-bg:#2c1414;--mark:#1d2633}}
:root[data-theme="dark"]{--bg:#0e1116;--card:#171b22;--text:#eef1f5;--muted:#a3abb7;--faint:#6f7884;--line:#2a313b;--ink:#9db8dd;--on-ink:#0e1116;--ok:#4ade80;--ok-bg:#14271b;--bad:#f87171;--bad-bg:#2c1414;--mark:#1d2633}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.7 "Pretendard Variable",Pretendard,system-ui,sans-serif;word-break:keep-all;overflow-wrap:break-word}
.w{max-width:980px;margin:0 auto;padding:0 20px}
.bar{border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--bg) 88%,transparent);position:sticky;top:0;z-index:5;backdrop-filter:blur(10px)}
.bar .w{display:flex;align-items:center;gap:12px;height:56px;font-size:14px;font-weight:600}
.bar a{color:inherit;text-decoration:none}.bar a.back{margin-right:auto}
.bar a.l{color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:4px 12px;font-size:13px}
header{padding:48px 0 18px}
h1{font-size:clamp(28px,4.4vw,42px);line-height:1.2;letter-spacing:-.035em;margin:0 0 14px;text-wrap:balance}
.lead{color:var(--muted);font-size:17px;max-width:68ch;margin:0 0 10px}
.note{font-size:13.5px;color:var(--faint);margin:0}
.picks{display:flex;flex-wrap:wrap;gap:8px;margin:22px 0 8px}
.picks button{font:inherit;font-size:14px;font-weight:600;border:1px solid var(--line);background:var(--card);color:var(--text);padding:9px 14px;border-radius:12px;cursor:pointer;text-align:left}
.picks button[aria-pressed="true"]{background:var(--ink);color:var(--on-ink);border-color:var(--ink)}
.step{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:18px 20px;margin:14px 0}
.step h2{display:flex;align-items:center;gap:10px;font-size:15.5px;margin:0 0 12px}
.step h2 i{flex:none;font-style:normal;width:26px;height:26px;border-radius:50%;display:grid;place-items:center;font-size:13px;background:var(--ink);color:var(--on-ink)}
.ev{list-style:none;margin:0;padding:0;display:grid;gap:6px}
.ev li{display:grid;grid-template-columns:auto minmax(0,1fr);gap:10px;align-items:baseline;font-size:14.5px;padding:8px 10px;border-radius:10px;background:var(--bg)}
.ev li.used{background:var(--ok-bg)}
.ev b{font-family:var(--mono);font-size:12.5px;color:var(--ink);white-space:nowrap}
.ev small{display:block;color:var(--faint);font-size:12px}
textarea{width:100%;min-height:118px;font:15px/1.7 inherit;font-family:inherit;color:var(--text);background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:12px 14px;resize:vertical}
textarea:focus,button:focus-visible{outline:2px solid var(--ink);outline-offset:1px}
.row{display:flex;justify-content:flex-end;margin-top:8px}
.row button{font:inherit;font-size:13px;border:1px solid var(--line);background:var(--card);color:var(--muted);border-radius:999px;padding:5px 12px;cursor:pointer}
table{width:100%;border-collapse:collapse;font-size:14px}
th,td{text-align:left;padding:8px 6px;border-top:1px solid var(--line);vertical-align:top}
th{font-size:12.5px;color:var(--faint);font-weight:600;border-top:0}
td code{font-family:var(--mono);font-size:13px;background:var(--mark);padding:1px 6px;border-radius:6px}
.n{display:inline-block;font-family:var(--mono);font-size:12.5px;padding:1px 7px;border-radius:6px;margin:0 3px 3px 0}
.n.ok{background:var(--ok-bg);color:var(--ok)}.n.bad{background:var(--bad-bg);color:var(--bad);text-decoration:line-through}
.final{font-size:16px;line-height:1.8}
.final mark{background:var(--mark);color:var(--ink);font-weight:700;border-radius:5px;padding:0 4px}
.count{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0 6px;font-size:14px}
.count span{padding:4px 10px;border-radius:999px;background:var(--bg);border:1px solid var(--line)}
.count b{color:var(--ink)}
.flag{display:inline-block;font-size:13px;font-weight:700;color:var(--ink);background:var(--mark);border-radius:8px;padding:3px 10px;margin-bottom:10px}
.empty{color:var(--muted);font-size:14px}
.limit{font-size:13.5px;color:var(--muted);border-left:3px solid var(--line);padding:2px 0 2px 12px;margin:18px 0 0}
.links{display:flex;flex-wrap:wrap;gap:8px;margin:26px 0 60px}
.links a{font-size:14px;font-weight:700;text-decoration:none;padding:9px 16px;border-radius:999px;border:1px solid var(--line);background:var(--card);color:var(--text)}
.links a:first-child{background:var(--ink);color:var(--on-ink);border-color:var(--ink)}
@media (max-width:640px){.step{padding:14px}.ev li{grid-template-columns:1fr}}
</style>
</head>
<body>
<nav class="bar"><div class="w"><a class="back" href="{{ 'en.html' if en else 'index.html' }}">← {{ T.back }}</a><a class="l" href="{{ 'demo.html' if en else 'demo-en.html' }}">{{ 'KO' if en else 'EN' }}</a></div></nav>
<main class="w">
  <header>
    <h1>{{ T.title }}</h1>
    <p class="lead">{{ T.lead }}</p>
    <p class="note">{{ T.note }}</p>
  </header>
  <div class="picks" role="group" aria-label="{{ T.pick }}">{% for s in SC %}<button type="button" data-i="{{ loop.index0 }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ s.q }}</button>{% endfor %}</div>

  <section class="step"><h2><i>1</i>{{ T.s1 }}</h2><ul class="ev" id="ev"></ul></section>
  <section class="step"><h2><i>2</i>{{ T.s2 }}</h2><label class="sr" for="ans" hidden>{{ T.s2 }}</label><textarea id="ans" spellcheck="false"></textarea><div class="row"><button type="button" id="reset">{{ T.reset }}</button></div></section>
  <section class="step"><h2><i>3</i>{{ T.s3 }}</h2><div id="parse"></div></section>
  <section class="step"><h2><i>4</i>{{ T.s4 }}</h2><div id="final"></div></section>
  <p class="limit">{{ T.limit }}</p>
  <div class="links">{% if en %}<a href="posts/2026-11-rag-citation-verify.html" hreflang="ko">How it was built (article in Korean) →</a>{% else %}{% for w in posts if w.slug and 'rag-citation' in w.slug %}<a href="posts/{{ w.slug }}.html">{{ T.read }} →</a>{% endfor %}{% endif %}<a href="https://github.com/0Ju12/heritage-rag-guide" target="_blank" rel="noopener">{{ T.code }} ↗</a><a href="projects/ssafy-16{{ '-en' if en else '' }}.html">SSAFY 16 →</a></div>
</main>
<script type="application/json" id="sc">{{ SC|tojson }}</script>
<script>
(function(){
var SC=JSON.parse(document.getElementById('sc').textContent),L={{ T|tojson }},EN={{ 'true' if en else 'false' }};
var WORD=EN?'Evidence':'근거',REFUSAL=EN?'not confirmed in the provided documents':'제공된 문서에서 확인되지 않습니다';
// 실제 서비스와 같은 규칙: [근거 …] 묶음을 찾고, 2,4 / 2·4 / 2、4 는 나열, 3~5 / 3-5 / 3–5 는 범위(최대 20개)
var RE=new RegExp('\\['+WORD+'\\s*([0-9][0-9\\s,·、~\\-–]*)\\]','g');
function nums(body){var out=[];body.split(/[,·、]/).forEach(function(part){part=part.trim();if(!part)return;var m=part.match(/^(\d+)\s*[~\-–]\s*(\d+)$/);
  if(m){var a=+m[1],b=+m[2];if(b<a){var t=a;a=b;b=t}for(var k=a;k<=b&&k<a+20;k++)out.push(k)}else if(/^\d+$/.test(part))out.push(+part)});return out}
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
var cur=0,ta=document.getElementById('ans');
function run(){var s=SC[cur],n=s.ev.length,text=ta.value,rows=[],used={};
  var final=text.replace(RE,function(all,body){var got=nums(body),keep=[],drop=[];got.forEach(function(k){if(k>=1&&k<=n){if(keep.indexOf(k)<0)keep.push(k)}else drop.push(k)});
    keep.forEach(function(k){used[k]=1});rows.push({raw:all,got:got,keep:keep,drop:drop});
    return keep.length?'\u0000'+WORD+' '+keep.join(', ')+'\u0001':''});
  var P=document.getElementById('parse');
  P.innerHTML=rows.length?'<table><thead><tr><th>'+(EN?'Found in answer':'답변 속 표기')+'</th><th>'+(EN?'Numbers':'풀어낸 번호')+'</th></tr></thead><tbody>'+rows.map(function(r){
      return '<tr><td><code>'+esc(r.raw)+'</code></td><td>'+r.keep.map(function(k){return '<span class="n ok" title="'+L.kept+'">'+k+'</span>'}).join('')+r.drop.map(function(k){return '<span class="n bad" title="'+L.drop+'">'+k+'</span>'}).join('')+'</td></tr>'}).join('')+'</tbody></table>'
    :'<p class="empty">'+L.none_found+'</p>';
  var ids=Object.keys(used).map(Number).sort(function(a,b){return a-b});
  document.querySelectorAll('#ev li').forEach(function(li,i){li.classList.toggle('used',!!used[i+1])});
  var html=esc(final.replace(/\s+([.,])/g,'$1')).replace(/\u0000([^\u0001]*)\u0001/g,'<mark>[$1]</mark>');
  var F=document.getElementById('final');
  F.innerHTML=(text.indexOf(REFUSAL)>=0?'<span class="flag">'+L.refusal+'</span>':'')+'<div class="final">'+html+'</div>'
    +'<div class="count"><span><b>'+ids.length+'</b> '+L.used+'</span><span><b>'+n+'</b> '+L.found+'</span></div>'
    +(ids.length?'<ul class="ev">'+ids.map(function(k){var e=s.ev[k-1];return '<li class="used"><b>['+WORD+' '+k+']</b><span>'+esc(e.t)+'<small>'+esc(e.s)+'</small></span></li>'}).join('')+'</ul>':'<p class="empty">'+L.none+'</p>');
}
function load(i){cur=i;var s=SC[i];
  document.querySelectorAll('.picks button').forEach(function(b){b.setAttribute('aria-pressed',+b.dataset.i===i)});
  document.getElementById('ev').innerHTML=s.ev.map(function(e,k){return '<li><b>['+WORD+' '+(k+1)+']</b><span>'+esc(e.t)+'<small>'+esc(e.s)+'</small></span></li>'}).join('');
  ta.value=s.a;run()}
document.querySelectorAll('.picks button').forEach(function(b){b.addEventListener('click',function(){load(+b.dataset.i)})});
ta.addEventListener('input',run);document.getElementById('reset').addEventListener('click',function(){load(cur)});
load(0);
})();
</script>
</body>
</html>
