<section id="selected-cases" style="padding-top:30px" aria-label="대표 프로젝트">
<div class="sec-t"><h2>{{ 'Selected projects' if en else '먼저 볼 프로젝트 3개' }}</h2><p>{{ 'Choose a role below.' if en else '직무를 선택하면 대표 프로젝트가 바뀝니다.' }}</p></div>
    {% if RV %}<div class="roleswitch" role="group" aria-label="{{ T.role_aria }}"><button type="button" data-role="all" aria-pressed="true">{{ T.role_all }}</button>{% for k, rv in RV.items() %}<button type="button" data-role="{{ k }}" aria-pressed="false">{{ rv.label }}</button>{% endfor %}</div>{% endif %}
{% for role, ids in selected_cases.items() %}<div class="rv rv-{{ role }}"><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr));gap:12px">{% for id in ids %}{% set sp = project_lookup.get(id) %}{% if sp %}<article style="padding:20px;border:1px solid var(--line);border-radius:16px;background:var(--card);min-width:0"><span class="chip">{{ loop.index }} · {{ sp.type }}</span><h3 style="font-size:20px;margin:12px 0">{{ sp.short or sp.title }}</h3><p style="font-size:14px">{{ sp.tagline or sp.summary }}</p><p style="font-size:13px;color:var(--muted)">{{ sp.role }}</p><p style="font-size:14px"><b>{{ sp.key }}</b></p><a href="projects/{{ sp.id }}{{ '-en' if en else '' }}.html">{{ 'View case →' if en else '역할·구현·검증 보기 →' }}</a></article>{% endif %}{% endfor %}</div></div>{% endfor %}
<div class="row" style="display:flex;flex-wrap:wrap;gap:12px;margin:18px 0"><a class="btn" href="learning-demo.html">{{ 'Try algorithm app' if en else '알고리즘 앱 공개 체험' }}</a><a class="btn" href="evaluation.html">{{ 'RAG evaluation evidence' if en else 'RAG 평가·운영 지표 보기' }}</a></div>
</section>
