<section id="selected-cases" style="padding-top:30px" aria-label="대표 프로젝트">
<div class="sec-t"><h2>{{ 'Selected projects' if en else '먼저 볼 프로젝트 3개' }}</h2><p>{{ 'Choose a role below.' if en else '직무를 선택하면 대표 프로젝트가 바뀝니다.' }}</p></div>
    {% if RV %}<div class="roleswitch" role="group" aria-label="{{ T.role_aria }}"><button type="button" data-role="all" aria-pressed="true">{{ T.role_all }}</button>{% for k, rv in RV.items() %}<button type="button" data-role="{{ k }}" aria-pressed="false">{{ rv.label }}</button>{% endfor %}</div>{% endif %}
{% for role, ids in selected_cases.items() %}<div class="rv rv-{{ role }}"><div class="sc-grid">{% for id in ids %}{% set sp = project_lookup.get(id) %}{% if sp %}<article class="sc" style="--c:{{ ['#5b6cff', '#16a34a', '#ea7a0c'][loop.index0 % 3] }}"><div class="sc-k"><span class="sc-n">0{{ loop.index }}</span><span class="chip">{{ sp.type }}</span></div><h3><a href="projects/{{ sp.id }}{{ '-en' if en else '' }}.html">{{ sp.short or sp.title }}</a></h3><p class="sc-t">{{ sp.tagline or sp.summary }}</p><p class="sc-r">{{ sp.role }}</p>{% if sp.key %}<p class="sc-key"><small>{{ 'KEY RESULT' if en else '핵심 결과' }}</small>{{ sp.key|hl }}</p>{% endif %}<span class="sc-go">{{ 'View case' if en else '역할·구현·검증 보기' }} <i aria-hidden="true">→</i></span></article>{% endif %}{% endfor %}</div></div>{% endfor %}
</section>
