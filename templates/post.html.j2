{% import "_head.j2" as h %}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ post.title }} · {{ profile.name }}</title>
{{ h.meta(post.title ~ ' · ' ~ profile.name, post.summary, 'posts/' ~ post.slug ~ '.html', '../') }}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#ffffff;--surface:#f7f7f8;--text:#0d0d0f;--muted:#5d5f66;--line:#e7e7ea;--accent:#0a7c66;--accent-2:#14b8a6;--chip:#eef2f1;--code:#0f1117;--code-text:#e6e6e6}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#0d0d0f;--surface:#17171a;--text:#f4f4f5;--muted:#a1a1aa;--line:#26262b;--accent:#2dd4bf;--accent-2:#5eead4;--chip:#1f2422;--code:#000;--code-text:#e6e6e6}}
:root[data-theme="dark"]{--bg:#0d0d0f;--surface:#17171a;--text:#f4f4f5;--muted:#a1a1aa;--line:#26262b;--accent:#2dd4bf;--accent-2:#5eead4;--chip:#1f2422;--code:#000;--code-text:#e6e6e6}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:17px/1.85 "Noto Sans KR",system-ui,sans-serif;-webkit-font-smoothing:antialiased}
a{color:var(--accent)}
.wrap{max-width:740px;margin:0 auto;padding:0 20px}
nav{display:flex;align-items:center;gap:16px;padding:14px 0;border-bottom:1px solid var(--line)}
nav a{color:var(--muted);text-decoration:none;font-size:14px;font-weight:500;padding:10px 2px}
nav .home{font-weight:900;color:var(--text);margin-right:auto}
#theme{background:none;border:1px solid var(--line);color:var(--muted);border-radius:999px;padding:4px 12px;font:inherit;font-size:12px;cursor:pointer}
header.post{padding:56px 0 28px;border-bottom:2px solid var(--text);margin-bottom:36px}
header.post .meta{color:var(--accent);font-weight:700;font-size:14px;letter-spacing:.04em}
header.post h1{font-size:clamp(28px,5vw,42px);line-height:1.25;letter-spacing:-.03em;margin:10px 0 14px;font-weight:900}
header.post p{color:var(--muted);margin:0 0 16px}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{font-size:12px;padding:3px 10px;border-radius:999px;background:var(--chip);color:var(--muted)}
article h2{font-size:24px;letter-spacing:-.02em;margin:48px 0 14px;font-weight:900}
article h3{font-size:19px;margin:32px 0 10px}
article p,article li{margin:0 0 16px}
article ul,article ol{padding-left:22px}
article li{margin-bottom:6px}
article blockquote{margin:24px 0;padding:14px 20px;border-left:4px solid var(--accent);background:var(--surface);border-radius:0 12px 12px 0;font-weight:700}
article blockquote p{margin:0}
article code{font-family:"JetBrains Mono",ui-monospace,monospace;font-size:.86em;background:var(--chip);padding:2px 6px;border-radius:6px}
article pre{background:var(--code);color:var(--code-text);padding:18px 20px;border-radius:14px;overflow-x:auto;line-height:1.6;margin:0 0 20px}
article pre code{background:none;padding:0;font-size:13.5px;color:inherit}
article table{width:100%;border-collapse:collapse;margin:0 0 20px;font-size:15px;display:block;overflow-x:auto}
article th,article td{border-bottom:1px solid var(--line);padding:9px 12px;text-align:left;vertical-align:top}
article th{background:var(--surface)}
.endcard{margin:56px 0 0;padding:24px;border:1px solid var(--line);border-radius:18px;background:var(--surface);display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between}
.endcard b{display:block}
.endcard span{color:var(--muted);font-size:14px}
.btn{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:999px;font-weight:600;font-size:14px;text-decoration:none;border:1px solid var(--line);color:var(--text);background:var(--bg)}
.others{margin:40px 0 0}
.others a{display:block;padding:14px 0;border-bottom:1px solid var(--line);text-decoration:none;color:var(--text);font-weight:700}
.others a span{display:block;color:var(--muted);font-weight:400;font-size:14px}
footer{padding:64px 0 40px;color:var(--muted);font-size:13px}
.readbar{position:fixed;top:0;left:0;height:3px;width:0;background:var(--text);z-index:60;transition:width .1s linear}
.series{margin:36px 0 0;padding:20px 22px;border:1px solid var(--line);border-radius:18px;background:var(--card)}
.series b{font-size:15px}.series ol{margin:10px 0 0;padding-left:20px;font-size:14.5px;line-height:1.6}.series li{padding:3px 0}.series li small{color:var(--muted);margin-left:8px;font-size:12.5px}.series li.me a{font-weight:800;text-decoration:none}
</style>
</head>
<body>
<div class="readbar" id="readbar"></div>
<div class="wrap">
  <nav><a class="home" href="../index.html">{{ profile.name_en }}</a><a href="../index.html#writing">Writing</a><a href="../index.html#work">Work</a><button id="theme" type="button">테마</button></nav>
  <header class="post">
    <div class="meta">{% if post.series %}<a href="ai-trend.html" style="color:inherit">AI 트렌드 노트</a> #{{ post.episode }}{% else %}WRITING{% endif %} · {{ post.date }}{% if post.minutes %} · {{ post.minutes }}분 읽기{% endif %}</div>
    <h1>{{ post.title }}</h1>
    <p>{{ post.summary }}</p>
    <div class="chips">{% for t in post.tags %}<span class="chip">{{ t }}</span>{% endfor %}</div>
  </header>
  <article>{{ post.html|safe }}</article>
  {% if post.series %}
  {% set ns = trend_posts %}{% set i = ns|map(attribute='slug')|list %}{% set k = i.index(post.slug) %}
  <div class="endcard">
    <div><b>AI 트렌드 노트 · {{ ns|length }}편</b><span>에이전트 개념부터 차례로 이어서 쓰는 시리즈입니다.{% if post.next_topic %} 다음 회차: {{ post.next_topic }}{% endif %}</span></div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">{% if k > 0 %}<a class="btn" href="{{ ns[k-1].slug }}.html">← #{{ ns[k-1].episode }}</a>{% endif %}<a class="btn" href="ai-trend.html">전체 목록</a>{% if k + 1 < ns|length %}<a class="btn" href="{{ ns[k+1].slug }}.html">#{{ ns[k+1].episode }} →</a>{% endif %}</div>
  </div>
  {% else %}
  {% set same = posts|selectattr('project', 'equalto', post.project)|sort(attribute='date')|list if post.project else [] %}
  {% if same|length > 1 %}{% set si = same|map(attribute='slug')|list %}{% set sk = si.index(post.slug) %}
  <div class="series"><b>{{ post.project_title or '같은 프로젝트' }} 글 {{ same|length }}편 · {{ sk + 1 }}번째</b>
    <ol>{% for o in same %}<li{% if o.slug == post.slug %} class="me"{% endif %}><a href="{{ o.slug }}.html">{{ o.title }}</a><small>{{ o.date }}{% if o.minutes %} · {{ o.minutes }}분{% endif %}</small></li>{% endfor %}</ol>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px">{% if sk > 0 %}<a class="btn" href="{{ same[sk-1].slug }}.html">← 이전 글</a>{% endif %}{% if sk + 1 < same|length %}<a class="btn" href="{{ same[sk+1].slug }}.html">다음 글 →</a>{% endif %}</div>
  </div>{% endif %}
  <div class="endcard">
    <div><b>{{ post.project_title or '관련 프로젝트' }}</b><span>{% if post.repo %}이 글에서 다룬 코드는 저장소에서 볼 수 있습니다.{% else %}자세한 내용은 포트폴리오의 해당 활동에서 볼 수 있습니다.{% endif %}</span></div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">{% if post.repo %}<a class="btn" href="{{ post.repo }}" target="_blank" rel="noopener">GitHub 저장소 →</a>{% endif %}<a class="btn" href="../index.html#work">포트폴리오로</a></div>
  </div>
  {% endif %}
  {% set rest = (trend_posts|reverse|list if post.series else posts)|rejectattr('slug', 'equalto', post.slug)|list %}
  {% if rest %}<div class="others"><b style="font-size:14px;color:var(--muted)">다른 글</b>{% for o in rest %}<a href="{{ o.slug }}.html">{{ o.title }}<span>{{ o.summary }}</span></a>{% endfor %}</div>{% endif %}
  <footer>© {{ profile.name_en }} · {{ profile.email }}</footer>
</div>
<script>
(function(){var r=document.documentElement,K='theme';
try{var s=localStorage.getItem(K);if(s)r.setAttribute('data-theme',s)}catch(e){}
var b=document.getElementById('theme');if(b)b.addEventListener('click',function(){
var c=r.getAttribute('data-theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');
var n=c==='dark'?'light':'dark';r.setAttribute('data-theme',n);try{localStorage.setItem(K,n)}catch(e){}});})();
</script>
<script>(function(){var b=document.getElementById('readbar'),a=document.querySelector('article');if(!b||!a)return;function f(){var r=a.getBoundingClientRect(),h=r.height-innerHeight*0.6,p=Math.min(1,Math.max(0,-r.top/(h>0?h:1)));b.style.width=(p*100)+'%'}addEventListener('scroll',function(){requestAnimationFrame(f)},{passive:true});f()})();</script>
</body>
</html>
