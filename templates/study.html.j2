  $('#app').innerHTML='<h1>배운 것으로 만든 것</h1><p class="sub">노트에서 배운 내용을 실제 코드로 옮긴 결과물입니다.</p><div class="grid g2">'+MADE.map(function(m){var t=TRACK[m[3]];return '<div class="card prog"><span class="tag">'+esc(m[0])+'</span><b>'+esc(m[1])+'</b><p>'+esc(m[2])+'</p><div class="row">'+'<a class="btn sm" href="'+m[4]+'" target="_blank" rel="noopener">코드 보기 ↗</a>'+(t?'<a class="btn sm ghost" href="#/notes/'+t.id+'">'+esc(t.name)+' 노트</a>':'')+'</div></div>'}).join('')+'</div>'}

/* ---------- 기록 ---------- */
function log(){keyHandler=null;
  var h='<h1>학습 기록</h1><p class="sub">기록은 이 브라우저(localStorage)에만 있습니다. 다른 기기에서 이어 보려면 내보내기 → 가져오기를 쓰세요.</p>';
  h+='<div class="card" style="overflow-x:auto"><table><thead><tr><th>트랙</th><th>읽은 노트</th><th>풀어 본 문제</th><th>최근 정답</th><th>익힌 문제</th></tr></thead><tbody>'+TRACKS.map(function(t){var ns=NOTES.filter(function(n){return n.track===t.id}),qs=ALLQ.filter(function(q){return NOTE[q.slug].track===t.id}),s=stat(qs);return '<tr><td><b>'+esc(t.name)+'</b></td><td>'+ns.filter(function(n){return S.read[n.slug]}).length+' / '+ns.length+'</td><td>'+s.tried+' / '+s.total+'</td><td>'+s.ok+'</td><td>'+s.master+' ('+s.pct+'%)</td></tr>'}).join('')+'</tbody></table></div>';
  h+='<h2>백업</h2><div class="card row"><button class="btn" id="exp">기록 내보내기</button><label class="btn ghost" style="cursor:pointer">가져오기<input type="file" id="imp" accept="application/json" hidden></label><button class="btn ghost" id="rst" style="margin-left:auto;color:var(--bad)">기록 지우기</button></div>';
  $('#app').innerHTML=h;
  $('#exp').onclick=function(){var b=new Blob([JSON.stringify(S,null,1)],{type:'application/json'}),u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download='study-progress-'+today()+'.json';document.body.appendChild(a);a.click();a.remove();setTimeout(function(){URL.revokeObjectURL(u)},1000)};
  $('#imp').onchange=function(e){var f=e.target.files[0];if(!f)return;f.text().then(function(t){var d=JSON.parse(t);if(!d||d.v!==1||typeof d.q!=='object')throw 0;S=d;['q','read','days','star'].forEach(function(k){if(!S[k])S[k]={}});save();toast('기록을 가져왔습니다.');log()}).catch(function(){toast('이 앱에서 내보낸 기록 파일이 아닙니다.')})};
  $('#rst').onclick=function(){if(confirm('이 브라우저의 학습 기록을 모두 지울까요? 되돌릴 수 없습니다.')){S=blank();save();toast('기록을 지웠습니다.');log()}};
}

