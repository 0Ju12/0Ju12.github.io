<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Study Notes · {{ profile.name }}</title>
<meta name="description" content="{{ profile.name }}의 학습 공간 — SSAFY 강의 노트 {{ notes|length }}편과 직접 만든 실습 프로그램">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;900&display=swap" rel="stylesheet">
<style>
:root{--bg:#ffffff;--surface:#f7f7f8;--text:#0d0d0f;--muted:#5d5f66;--line:#e7e7ea;--accent:#0a7c66;--accent-2:#14b8a6;--chip:#eef2f1;--hero:#0d0d0f;--hero-text:#f4f4f5}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#0d0d0f;--surface:#17171a;--text:#f4f4f5;--muted:#a1a1aa;--line:#26262b;--accent:#2dd4bf;--accent-2:#5eead4;--chip:#1f2422;--hero:#000}}
:root[data-theme="dark"]{--bg:#0d0d0f;--surface:#17171a;--text:#f4f4f5;--muted:#a1a1aa;--line:#26262b;--accent:#2dd4bf;--accent-2:#5eead4;--chip:#1f2422;--hero:#000}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.7 "Noto Sans KR",system-ui,sans-serif;-webkit-font-smoothing:antialiased}
a{color:var(--accent)}
.wrap{max-width:1120px;margin:0 auto;padding:0 20px}
header.hero{background:var(--hero);color:var(--hero-text);position:relative;overflow:hidden}
header.hero::after{content:"";position:absolute;inset:auto -10% -50% 45%;height:480px;background:radial-gradient(closest-side,rgba(20,184,166,.32),transparent);pointer-events:none}
.topbar{display:flex;align-items:center;gap:20px;padding:24px 0;position:relative;z-index:1}
.topbar .logo{font-weight:900;margin-right:auto;color:#f4f4f5;text-decoration:none}
.topbar a{color:#a1a1aa;text-decoration:none;font-size:14px;font-weight:500}.topbar a:hover{color:#fff}
#theme{background:none;border:1px solid #3f3f46;color:#a1a1aa;border-radius:999px;padding:4px 12px;font:inherit;font-size:12px;cursor:pointer}
.herobody{padding:64px 0 48px;position:relative;z-index:1}
.herobody .kicker{color:var(--accent-2);font-weight:700;letter-spacing:.1em;font-size:13px}
.herobody h1{font-size:clamp(32px,5vw,58px);line-height:1.1;letter-spacing:-.04em;margin:12px 0 18px;font-weight:900}
.herobody p{color:#a1a1aa;max-width:640px;margin:0;font-size:17px}
.stats{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #27272a;position:relative;z-index:1}
.stats div{padding:22px 20px 26px;border-right:1px solid #27272a}.stats div:last-child{border-right:0}
.stats b{display:block;font-size:28px;font-weight:900;letter-spacing:-.03em}.stats span{font-size:13px;color:#a1a1aa}
.toolbar{position:sticky;top:0;z-index:5;background:var(--bg);border-bottom:1px solid var(--line);padding:14px 0}
.toolbar .wrap{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.search{flex:1 1 260px;display:flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:999px;padding:8px 16px;background:var(--surface)}
.search input{border:0;background:none;font:inherit;color:var(--text);width:100%;outline:none}
.tabs{display:flex;flex-wrap:wrap;gap:6px}
.tabs button{border:1px solid var(--line);background:var(--bg);color:var(--muted);border-radius:999px;padding:6px 14px;font:inherit;font-size:14px;font-weight:600;cursor:pointer}
.tabs button[aria-pressed="true"]{background:var(--text);color:var(--bg);border-color:var(--text)}
section{padding:64px 0 0;scroll-margin-top:80px}
.sechead{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:28px;border-bottom:2px solid var(--text);padding-bottom:14px}
.sechead h2{font-size:clamp(24px,3.4vw,38px);letter-spacing:-.03em;margin:0;font-weight:900;line-height:1.1}
.sechead span{color:var(--muted);font-size:14px}
.notes{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.note{display:flex;flex-direction:column;gap:8px;background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:20px;text-decoration:none;color:var(--text);transition:transform .15s,border-color .15s}
.note:hover{transform:translateY(-2px);border-color:var(--accent)}
.note .meta{display:flex;justify-content:space-between;font-size:12.5px;color:var(--accent);font-weight:700}
.note b{font-size:17px;line-height:1.4;letter-spacing:-.01em}
.note p{margin:0;color:var(--muted);font-size:14px;flex:1}
.chips{display:flex;flex-wrap:wrap;gap:5px}
.chip{font-size:11.5px;padding:2px 9px;border-radius:999px;background:var(--chip);color:var(--muted)}
.empty{color:var(--muted);padding:24px 0;display:none}
.progs{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.prog{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:22px;display:flex;flex-direction:column;gap:8px}
.prog .tag{font-size:12.5px;color:var(--accent);font-weight:700}
.prog b{font-size:17px}.prog p{margin:0;color:var(--muted);font-size:14px;flex:1}
.prog a.go{font-weight:700;font-size:14px;text-decoration:none}
.tl{display:grid;grid-template-columns:110px 1fr;gap:14px;padding:12px 0;border-bottom:1px solid var(--line)}
.tl .d{color:var(--muted);font-size:14px;font-weight:500}.tl a{text-decoration:none;color:var(--text);font-weight:600}.tl a:hover{color:var(--accent)}
.tl small{color:var(--muted);margin-left:8px}
.note-src{margin-top:40px;padding:18px 20px;border:1px dashed var(--line);border-radius:14px;color:var(--muted);font-size:14px}
footer{padding:64px 0 40px;color:var(--muted);font-size:13px}
[hidden]{display:none!important}
@media (max-width:900px){.notes,.progs{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}.stats div:nth-child(2){border-right:0}.stats div:nth-child(-n+2){border-bottom:1px solid #27272a}.topbar a.hide-m{display:none}.tl{grid-template-columns:1fr;gap:2px}}
</style>
</head>
<body>
<header class="hero">
  <div class="wrap">
    <div class="topbar"><a class="logo" href="../index.html">{{ profile.name_en }}</a><a class="hide-m" href="#notes">Notes</a><a class="hide-m" href="#programs">Programs</a><a class="hide-m" href="#timeline">Timeline</a><a href="../index.html">Portfolio</a><button id="theme" type="button">테마</button></div>
    <div class="herobody">
      <div class="kicker">STUDY NOTES · SSAFY 16기</div>
      <h1>배운 것을 정리하고,<br>직접 만들어 봅니다.</h1>
      <p>SSAFY에서 들은 강의를 주제별로 다시 정리한 노트와, 그 내용으로 직접 만든 프로그램을 모았습니다. 각 노트는 핵심 요약 · 검토 코멘트 · 키워드 · 확인 문제로 구성되어 있습니다.</p>
    </div>
  </div>
  <div class="wrap"><div class="stats">
    <div><b>{{ notes|length }}편</b><span>강의 노트</span></div>
    <div><b>{{ tracks|length }}개</b><span>학습 트랙</span></div>
    <div><b>{{ timeline[0].date[5:] if timeline else '' }} – {{ timeline[-1].date[5:] if timeline else '' }}</b><span>학습 기간 (2026)</span></div>
    <div><b>7개</b><span>실습 프로그램</span></div>
  </div></div>
</header>

<div class="toolbar"><div class="wrap">
  <label class="search"><span aria-hidden="true">🔍</span><input id="q" type="search" placeholder="노트 검색 (예: ORM, BFS, Transformer)" aria-label="노트 검색"></label>
  <div class="tabs" role="group" aria-label="트랙 필터"><button type="button" data-track="all" aria-pressed="true">전체</button>{% for t in tracks %}<button type="button" data-track="{{ t.id }}" aria-pressed="false">{{ t.name }} {{ t.notes|length }}</button>{% endfor %}</div>
</div></div>

<main class="wrap">
  <div id="notes">
  {% for t in tracks %}
  <section class="track" data-track="{{ t.id }}" id="track-{{ t.id }}">
    <div class="sechead"><h2>{{ t.name }}</h2><span>{{ t.desc }} · {{ t.notes|length }}편</span></div>
    <div class="notes">
      {% for n in t.notes %}
      <a class="note" href="notes/{{ n.slug }}.html" data-text="{{ (n.title ~ ' ' ~ n.sections|join(' ') ~ ' ' ~ n.summary)|lower }}">
        <div class="meta"><span>{{ t.name }}</span><span>{{ n.date }}</span></div>
        <b>{{ n.name }}</b>
        {% if n.summary %}<p>{{ n.summary }}</p>{% endif %}
        <div class="chips">{% for s in n.sections[:4] %}<span class="chip">{{ s|truncate(22, True, '…') }}</span>{% endfor %}</div>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endfor %}
  <p class="empty" id="empty">검색 결과가 없습니다.</p>
  </div>

  <section id="programs">
    <div class="sechead"><h2>Programs</h2><span>배운 내용으로 직접 만든 것</span></div>
    <div class="progs">
      <div class="prog"><span class="tag">Python · 관통 1</span><b>도서 데이터 분석</b><p>JSON 도서 데이터를 파싱해 집계·분류·정렬. → Python 노트</p><a class="go" href="https://github.com/0Ju12/ssafy-thread/tree/main/01-python-data" target="_blank" rel="noopener">코드 보기 →</a></div>
      <div class="prog"><span class="tag">API · LLM · 관통 2</span><b>도서 수집 + AI 분류 파이프라인</b><p>알라딘 API 수집(페이지네이션·중복 제거) → LLM 분류 → gTTS 음성 변환. → AI 01 노트</p><a class="go" href="https://github.com/0Ju12/ssafy-thread/tree/main/02-api-llm-pipeline" target="_blank" rel="noopener">코드 보기 →</a></div>
      <div class="prog"><span class="tag">WEB · 관통 3</span><b>반응형 도서 커뮤니티 화면</b><p>Navbar·Carousel·Grid·Modal을 조합한 반응형 페이지. → WEB 01~03 노트</p><a class="go" href="https://github.com/0Ju12/ssafy-thread/tree/main/03-responsive-web" target="_blank" rel="noopener">코드 보기 →</a></div>
      <div class="prog"><span class="tag">Django · 관통 4</span><b>인증 + AI 도서 서비스</b><p>커스텀 User·오픈 리다이렉트 방어·AI 작가 정보/추천, 테스트 45개. → Django 04~13 노트</p><a class="go" href="https://github.com/0Ju12/ssafy-thread/tree/main/04-django-auth-ai" target="_blank" rel="noopener">코드 보기 →</a></div>
      <div class="prog"><span class="tag">Data · LLM · 관통 5</span><b>댓글 수집·LLM 분석 파이프라인</b><p>Selenium 수집 → LLM 판단 → pandas 정제 → IQR → 증강·요약, 테스트 41개. → AI 02·06·07 노트</p><a class="go" href="https://github.com/0Ju12/ssafy-thread/tree/main/05-crawling-llm-pipeline" target="_blank" rel="noopener">코드 보기 →</a></div>
      <div class="prog"><span class="tag">Deep Learning</span><b>산불 확산 예측 U-LSTM</b><p>CNN 인코더–LSTM–디코더로 다음 시점 화선 예측. → AI 08·09 노트</p><a class="go" href="https://github.com/0Ju12/wildfire-spread-prediction" target="_blank" rel="noopener">코드 보기 →</a></div>
      <div class="prog"><span class="tag">Desktop Tool · 개인 개발</span><b>CaptureToPDF — 화면 캡처 → 목차 PDF</b><p>강의 화면을 F8로 한 장씩 캡처해 북마크·OCR이 들어간 PDF로 묶는 데스크톱 도구. 공부 자료 정리용으로 직접 개발.</p><a class="go" href="https://github.com/0Ju12/0ju12.github.io/tree/main/programs/capture-to-pdf" target="_blank" rel="noopener">코드 보기 →</a></div>
    </div>
  </section>

  <section id="timeline">
    <div class="sechead"><h2>Timeline</h2><span>강의를 들은 순서</span></div>
    {% for n in timeline %}<div class="tl"><span class="d">{{ n.date }}</span><div><a href="notes/{{ n.slug }}.html">{{ n.title }}</a><small>{{ (tracks|selectattr('id','equalto',n.track)|first).name }}</small></div></div>{% endfor %}
  </section>

  <p class="note-src">강의 노트는 SSAFY 16기 수업을 들으며 직접 다시 정리한 학습 기록입니다. 강의 원본 자료(교안·슬라이드)는 포함하지 않았습니다.</p>
  <footer>© {{ profile.name_en }} · <a href="../index.html">포트폴리오로 돌아가기</a></footer>
</main>
<script>
(function(){var r=document.documentElement,K='theme';
try{var s=localStorage.getItem(K);if(s)r.setAttribute('data-theme',s)}catch(e){}
var b=document.getElementById('theme');b&&b.addEventListener('click',function(){var c=r.getAttribute('data-theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');var n=c==='dark'?'light':'dark';r.setAttribute('data-theme',n);try{localStorage.setItem(K,n)}catch(e){}});
var q=document.getElementById('q'),tabs=[].slice.call(document.querySelectorAll('.tabs button')),cur='all';
function apply(){var term=q.value.trim().toLowerCase(),any=false;
document.querySelectorAll('.track').forEach(function(sec){var show=0;
sec.querySelectorAll('.note').forEach(function(n){var ok=(cur==='all'||sec.dataset.track===cur)&&(!term||n.dataset.text.indexOf(term)>=0);n.hidden=!ok;if(ok)show++});
sec.hidden=!show;if(show)any=true});
document.getElementById('empty').style.display=any?'none':'block';}
q.addEventListener('input',apply);
tabs.forEach(function(t){t.addEventListener('click',function(){cur=t.dataset.track;tabs.forEach(function(x){x.setAttribute('aria-pressed',x===t)});apply()})});
})();
</script>
</body>
</html>
