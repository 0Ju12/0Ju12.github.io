var keyHandler=null;
document.addEventListener('keydown',function(e){if(e.metaKey||e.ctrlKey||e.altKey)return;var tag=(e.target.tagName||'').toLowerCase();if((tag==='input'&&e.target.id==='q'))return;if(keyHandler)keyHandler(e)});
(function(){var k='theme',r=document.documentElement,t=null;try{t=localStorage.getItem(k)}catch(_){}if(t)r.dataset.theme=t;
  $('#theme').onclick=function(){var dark=r.dataset.theme?r.dataset.theme==='dark':matchMedia('(prefers-color-scheme: dark)').matches;r.dataset.theme=dark?'light':'dark';try{localStorage.setItem(k,r.dataset.theme)}catch(_){}}})();
route();
})();
</script>
