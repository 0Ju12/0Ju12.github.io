<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>학습 노트 · {{ profile.name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;900&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#f7f7f8;--card:#fff;--text:#18181b;--muted:#5f6670;--faint:#9aa1ab;--line:#e4e6ea;--soft:#f0f2f5;--ink:#1f3a5f;--ink-soft:#e8edf5;--on-ink:#fff;--ok:#0f7b5f;--ok-soft:#e3f4ee;--bad:#c2410c;--bad-soft:#fdeee5;--mid:#a16207;--mid-soft:#fbf3dc;--code:#f4f5f7}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#0e1116;--card:#161a21;--text:#eef1f5;--muted:#a3abb7;--faint:#6f7884;--line:#29303a;--soft:#1d222b;--ink:#9db8dd;--ink-soft:#1e2a3a;--on-ink:#0e1116;--ok:#34d399;--ok-soft:#10261f;--bad:#fb923c;--bad-soft:#2a1a10;--mid:#facc15;--mid-soft:#262110;--code:#11151b}}
:root[data-theme="dark"]{--bg:#0e1116;--card:#161a21;--text:#eef1f5;--muted:#a3abb7;--faint:#6f7884;--line:#29303a;--soft:#1d222b;--ink:#9db8dd;--ink-soft:#1e2a3a;--on-ink:#0e1116;--ok:#34d399;--ok-soft:#10261f;--bad:#fb923c;--bad-soft:#2a1a10;--mid:#facc15;--mid-soft:#262110;--code:#11151b}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--text);font:15.5px/1.65 "Noto Sans KR",-apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo",system-ui,sans-serif;word-break:keep-all;-webkit-font-smoothing:antialiased}
a{color:var(--ink)}
button,input,select,textarea{font:inherit;color:inherit}
.top{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.top .in{max-width:1080px;margin:0 auto;padding:10px 16px;display:flex;align-items:center;gap:6px}
.brand{font-weight:900;letter-spacing:-.02em;text-decoration:none;color:var(--text);margin-right:10px;white-space:nowrap}
.brand small{font-weight:500;color:var(--faint);margin-left:6px;font-size:12px}
.tabs{display:flex;gap:2px;overflow-x:auto;scrollbar-width:none;flex:1}
.tabs::-webkit-scrollbar{display:none}
.tabs a{padding:7px 11px;border-radius:9px;text-decoration:none;color:var(--muted);font-weight:600;font-size:14px;white-space:nowrap}
.tabs a:hover{background:var(--soft);color:var(--text)}
.tabs a.on{background:var(--ink-soft);color:var(--ink)}
.tabs a .n{font-size:11px;margin-left:4px;padding:0 6px;border-radius:99px;background:var(--bad);color:#fff;vertical-align:1px}
.iconbtn{border:1px solid var(--line);background:var(--card);border-radius:9px;height:34px;min-width:34px;padding:0 10px;cursor:pointer;color:var(--muted);text-decoration:none;display:inline-grid;place-items:center;font-size:13px;white-space:nowrap}
main{max-width:1080px;margin:0 auto;padding:26px 16px 70px}
h1{font-size:clamp(22px,3.2vw,28px);letter-spacing:-.03em;margin:0 0 4px;line-height:1.3}
h2{font-size:17px;letter-spacing:-.02em;margin:30px 0 12px}
.sub{color:var(--muted);margin:0 0 20px}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px}
.grid{display:grid;gap:12px}
.g2{grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))}
.g4{grid-template-columns:repeat(auto-fit,minmax(min(100%,150px),1fr))}
.btn{display:inline-flex;align-items:center;gap:6px;height:40px;padding:0 16px;border-radius:11px;border:1px solid var(--ink);background:var(--ink);color:var(--on-ink);font-weight:700;cursor:pointer;text-decoration:none;font-size:14.5px}
.btn.ghost{background:transparent;color:var(--ink);border-color:var(--line)}
.btn.sm{height:32px;padding:0 11px;font-size:13px;border-radius:9px}
.btn:disabled{opacity:.45;cursor:not-allowed}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{text-decoration:none;border:1px solid var(--line);background:var(--card);border-radius:99px;padding:4px 12px;font-size:13px;font-weight:600;color:var(--muted);cursor:pointer}
.chip.on{background:var(--ink);border-color:var(--ink);color:var(--on-ink)}
.tag{display:inline-block;font-size:12px;font-weight:600;color:var(--muted);background:var(--soft);border-radius:6px;padding:1px 7px}
.muted{color:var(--muted)}.faint{color:var(--faint)}.small{font-size:13px}
.kpi b{display:block;font-size:26px;letter-spacing:-.03em;line-height:1.2}
.kpi span{color:var(--muted);font-size:13px}
.bar{height:6px;background:var(--soft);border-radius:99px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--ink);border-radius:99px}
.today{display:grid;grid-template-columns:1.4fr 1fr;gap:12px}
@media (max-width:760px){.today{grid-template-columns:1fr}}
.hero{background:var(--ink);color:var(--on-ink);border-color:var(--ink)}
.hero h2{margin:0 0 6px;font-size:20px}
.hero p{margin:0 0 14px;opacity:.85}
.hero .btn{background:var(--on-ink);color:var(--ink);border-color:var(--on-ink)}
.hero .btn.ghost{background:transparent;color:var(--on-ink);border-color:color-mix(in srgb,var(--on-ink) 40%,transparent)}
.days{display:flex;gap:4px;align-items:flex-end;height:58px;margin-top:10px}
.days i{flex:1;background:var(--ink-soft);border-radius:4px 4px 2px 2px;min-height:4px}
.days i.has{background:var(--ink)}
.trk{display:flex;flex-direction:column;gap:8px}
.trk .t{display:flex;justify-content:space-between;gap:8px;font-weight:700}
.trk .t small{font-weight:500;color:var(--muted)}
.search{width:100%;height:44px;border:1px solid var(--line);border-radius:12px;background:var(--card);padding:0 14px}
.search:focus,textarea:focus,input:focus{outline:2px solid var(--ink);outline-offset:1px}
.note{display:flex;flex-direction:column;gap:8px}
.note .h{display:flex;gap:10px;align-items:flex-start}
.note .h b{font-size:16px;letter-spacing:-.02em;line-height:1.4;flex:1}
.note p{margin:0;color:var(--muted);font-size:14px}
.note .meta{display:flex;align-items:center;gap:10px;font-size:13px;color:var(--muted)}
.note .meta .bar{flex:1;max-width:140px}
.read{width:22px;height:22px;border-radius:7px;border:1.5px solid var(--line);background:transparent;cursor:pointer;flex:none;display:grid;place-items:center;color:transparent;font-size:13px}
.read.on{background:var(--ok);border-color:var(--ok);color:#fff}
.q{max-width:760px;margin:0 auto}
.qhead{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:10px;font-size:13px;color:var(--muted)}
.progress{height:4px;background:var(--soft);border-radius:99px;margin-bottom:18px;overflow:hidden}
.progress i{display:block;height:100%;background:var(--ink)}
.prompt{font-size:18px;font-weight:700;letter-spacing:-.02em;line-height:1.55;margin:4px 0 16px;white-space:pre-wrap}
.opts{display:grid;gap:8px}
.opt{text-align:left;border:1px solid var(--line);background:var(--card);border-radius:12px;padding:12px 14px;cursor:pointer;display:flex;gap:10px;align-items:flex-start;line-height:1.5}
.opt:hover:not(:disabled){border-color:var(--ink)}
.opt .k{flex:none;width:24px;height:24px;border-radius:7px;background:var(--soft);display:grid;place-items:center;font-size:12px;font-weight:700;color:var(--muted)}
.opt.ok{border-color:var(--ok);background:var(--ok-soft)}.opt.ok .k{background:var(--ok);color:#fff}
.opt.bad{border-color:var(--bad);background:var(--bad-soft)}.opt.bad .k{background:var(--bad);color:#fff}
.opt:disabled{cursor:default}
textarea,.input{width:100%;border:1px solid var(--line);border-radius:12px;background:var(--card);padding:12px 14px;resize:vertical}
.input{height:46px}
.fb{margin-top:14px;border-radius:12px;padding:14px 16px;border:1px solid var(--line);background:var(--soft)}
.fb.ok{background:var(--ok-soft);border-color:color-mix(in srgb,var(--ok) 40%,transparent)}
.fb.bad{background:var(--bad-soft);border-color:color-mix(in srgb,var(--bad) 40%,transparent)}
.fb b{display:block;margin-bottom:4px}
.fb .ans{white-space:pre-wrap}
.fb .ex{color:var(--muted);font-size:14px;margin-top:6px;white-space:pre-wrap}
.grade{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}
.grade button{height:44px;border-radius:11px;border:1px solid var(--line);background:var(--card);font-weight:700;cursor:pointer}
.grade .g-ok{border-color:var(--ok);color:var(--ok)}.grade .g-mid{border-color:var(--mid);color:var(--mid)}.grade .g-bad{border-color:var(--bad);color:var(--bad)}
.qfoot{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:16px}
.kbd{font:600 11px/1 "JetBrains Mono",monospace;border:1px solid var(--line);border-bottom-width:2px;border-radius:5px;padding:2px 5px;color:var(--faint)}
.star{border:0;background:none;cursor:pointer;font-size:18px;color:var(--faint);padding:0 4px}
.star.on{color:var(--mid)}
.flash{max-width:720px;margin:0 auto}
.fcard{min-height:260px;cursor:pointer;display:flex;flex-direction:column;gap:10px}
.fcard .nm{font-size:22px;font-weight:900;letter-spacing:-.03em}
pre{background:var(--code);border:1px solid var(--line);border-radius:10px;padding:12px 14px;overflow-x:auto;font:13px/1.6 "JetBrains Mono",ui-monospace,monospace;margin:4px 0}
.warn{border-left:3px solid var(--mid);padding:6px 12px;background:var(--mid-soft);border-radius:0 8px 8px 0;font-size:14px}
.list{display:flex;flex-direction:column;gap:6px}
.li{display:flex;gap:10px;align-items:flex-start;padding:10px 12px;border:1px solid var(--line);border-radius:11px;background:var(--card);font-size:14px}
.li .p{flex:1}
.empty{text-align:center;padding:40px 16px;color:var(--muted)}
table{width:100%;border-collapse:collapse;font-size:14px}
th,td{text-align:left;padding:9px 8px;border-bottom:1px solid var(--line)}
th{color:var(--muted);font-weight:600;font-size:13px}
.prog{display:flex;flex-direction:column;gap:6px}
.prog p{margin:0;color:var(--muted);font-size:14px}
.toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);background:var(--text);color:var(--bg);padding:10px 16px;border-radius:11px;font-size:14px;display:none;z-index:50}
.setup label{display:block;font-weight:700;font-size:14px;margin:16px 0 8px}
.hide-m{display:inline}
@media (max-width:640px){.hide-m{display:none}.prompt{font-size:16.5px}main{padding-top:18px}}
</style>
</head>
<body>
<header class="top"><div class="in">
  <a class="brand" href="#/">학습 노트<small class="hide-m">SSAFY 16기</small></a>
  <nav class="tabs" id="tabs" aria-label="학습 메뉴">
    <a href="#/" data-v="home">오늘</a><a href="#/notes" data-v="notes">노트</a><a href="#/quiz" data-v="quiz">문제</a><a href="#/review" data-v="review">복습</a><a href="#/made" data-v="made">만든 것</a><a href="#/log" data-v="log">기록</a>
  </nav>
  <button class="iconbtn" id="theme" type="button" aria-label="화면 테마 바꾸기">◐</button>
  <a class="iconbtn hide-m" href="../index.html">포트폴리오</a>
</div></header>
<main id="app" aria-live="polite"></main>
<div class="toast" id="toast" role="status"></div>
<script id="data" type="application/json">{{ app|tojson }}</script>
<script>
(function(){
'use strict';
var D=JSON.parse(document.getElementById('data').textContent);
var $=function(s,r){return (r||document).querySelector(s)},$$=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))};
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
var NOTES=D.notes,TRACKS=D.tracks,UNITS=D.units;
var NOTE={};NOTES.forEach(function(n){NOTE[n.slug]=n});
var TRACK={};TRACKS.forEach(function(t){TRACK[t.id]=t});
var Q={},ALLQ=[];
NOTES.forEach(function(n){(UNITS[n.slug].questions||[]).forEach(function(q){q.slug=n.slug;Q[q.id]=q;ALLQ.push(q)})});
var TYPE={M:'객관식',S:'단답',W:'서술'};
var INTERVAL=[0,1,3,7,14,30];

/* ---------- 저장 (이 브라우저에만) ---------- */
var KEY='study-app-v1',S;
function blank(){return {v:1,q:{},read:{},days:{},star:{},last:null}}
try{S=JSON.parse(localStorage.getItem(KEY))||blank()}catch(_){S=blank()}
['q','read','days','star'].forEach(function(k){if(!S[k])S[k]={}});
function save(){try{localStorage.setItem(KEY,JSON.stringify(S))}catch(_){toast('브라우저 저장 공간을 쓸 수 없어 기록이 남지 않습니다.')}}
function today(off){var d=new Date();d.setDate(d.getDate()+(off||0));return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}
function toast(t){var el=$('#toast');el.textContent=t;el.style.display='block';clearTimeout(toast.t);toast.t=setTimeout(function(){el.style.display='none'},2600)}

/* 간격 반복: 맞히면 상자 +1(다음 복습 1·3·7·14·30일 뒤), 헷갈리면 내일, 틀리면 상자 1·오늘 다시 */
function record(id,res){
  var r=S.q[id]||{b:0,n:0,ok:0};
  r.pb=r.b||0;r.n++;r.last=today();r.s=res;
  if(res==='ok'){r.ok++;r.b=Math.min(5,(r.b||0)+1);r.due=today(INTERVAL[r.b])}
  else if(res==='mid'){r.b=Math.max(1,r.b||0);r.due=today(1)}
  else{r.b=1;r.due=today()}
  S.q[id]=r;S.days[today()]=(S.days[today()]||0)+1;save();
}
function isDue(id){var r=S.q[id];return r&&r.due&&r.due<=today()}
function dueList(){return ALLQ.filter(function(q){return isDue(q.id)})}
function wrongList(){return ALLQ.filter(function(q){var r=S.q[q.id];return r&&r.s==='bad'})}
function stat(qs){var tried=0,ok=0,master=0;qs.forEach(function(q){var r=S.q[q.id];if(r){tried++;if(r.s==='ok')ok++;if(r.b>=3)master++}});return {total:qs.length,tried:tried,ok:ok,master:master,pct:qs.length?Math.round(master/qs.length*100):0}}
function noteQs(slug){return (UNITS[slug].questions||[])}
function openNote(slug){S.read[slug]=today();S.last=slug;save();location.href='notes/'+slug+'.html'}

/* ---------- 라우팅 ---------- */
var session=null;
function route(){
  var h=location.hash.replace(/^#\/?/,''),parts=h.split('/'),v=parts[0]||'home';
  $$('#tabs a').forEach(function(a){a.classList.toggle('on',a.dataset.v===(v==='cards'?'notes':v))});
  var dueN=dueList().length,rv=$('#tabs a[data-v="review"]');rv.innerHTML='복습'+(dueN?'<span class="n">'+dueN+'</span>':'');
  window.scrollTo(0,0);
  if(v==='notes')return notes(decodeURIComponent(parts[1]||''));
  if(v==='quiz'){if(parts[1]&&NOTE[parts[1]]){startQuiz(shuffle(noteQs(parts[1]).slice()),NOTE[parts[1]].title);return}if(session&&parts[1]==='play')return play();return setup()}
  if(v==='review')return review();
  if(v==='cards'&&NOTE[parts[1]])return cards(parts[1],0);
  if(v==='made')return made();
  if(v==='log')return log();
  home();
}
window.addEventListener('hashchange',route);

/* ---------- 오늘 ---------- */
function home(){
  var due=dueList().length,st=stat(ALLQ),readN=Object.keys(S.read).filter(function(k){return NOTE[k]}).length;
  var last=S.last&&NOTE[S.last]?NOTE[S.last]:null;
  var days=[];for(var i=13;i>=0;i--){var d=today(-i);days.push(S.days[d]||0)}
  var mx=Math.max.apply(null,days.concat([1]));
  var studied=days.filter(function(x){return x}).length;
  var weak=NOTES.map(function(n){var qs=noteQs(n.slug),t=0,o=0;qs.forEach(function(q){var r=S.q[q.id];if(r){t+=r.n;o+=r.ok}});return {n:n,t:t,acc:t?o/t:1}}).filter(function(x){return x.t>=3}).sort(function(a,b){return a.acc-b.acc}).slice(0,3);
  var h='<h1>오늘 공부할 것</h1><p class="sub">노트 '+NOTES.length+'편 · 문제 '+ALLQ.length+'개. 맞힌 문제는 1·3·7·14·30일 간격으로 다시 나옵니다.</p>';
  h+='<div class="today"><div class="card hero">';
  if(due){h+='<h2>복습할 문제 '+due+'개</h2><p>오늘 다시 볼 차례가 된 문제입니다. 틀렸던 문제부터 나옵니다.</p><div class="row"><button class="btn" data-go="due">복습 시작</button><a class="btn ghost" href="#/quiz">범위 골라 풀기</a></div>'}
  else if(st.tried){h+='<h2>오늘 복습은 끝났어요</h2><p>아직 풀지 않은 문제 '+(st.total-st.tried)+'개가 남아 있습니다.</p><div class="row"><button class="btn" data-go="new">새 문제 10개</button><a class="btn ghost" href="#/quiz">범위 골라 풀기</a></div>'}
  else{h+='<h2>처음 오셨네요</h2><p>노트를 읽고, 그 노트의 문제로 바로 확인해 보세요. 기록은 이 브라우저에만 저장됩니다.</p><div class="row"><button class="btn" data-go="new">아무 문제 10개</button><a class="btn ghost" href="#/notes">노트 둘러보기</a></div>'}
  h+='</div><div class="card"><div class="row" style="justify-content:space-between"><b>최근 2주</b><span class="muted small">'+studied+'일 공부</span></div><div class="days" aria-label="최근 14일 푼 문제 수">'+days.map(function(x,i){return '<i class="'+(x?'has':'')+'" style="height:'+Math.max(6,Math.round(x/mx*100))+'%" title="'+today(i-13)+' · '+x+'문제"></i>'}).join('')+'</div>';
  if(last)h+='<p class="small" style="margin:14px 0 0">이어서 보기 · <a href="notes/'+last.slug+'.html">'+esc(last.title)+'</a></p>';
  h+='</div></div>';
  h+='<div class="grid g4" style="margin-top:12px"><div class="card kpi"><b>'+readN+'<span> / '+NOTES.length+'</span></b><span>읽은 노트</span></div><div class="card kpi"><b>'+st.tried+'<span> / '+st.total+'</span></b><span>풀어 본 문제</span></div><div class="card kpi"><b>'+st.master+'</b><span>익힌 문제 (3번 이상 연속 맞힘)</span></div><div class="card kpi"><b>'+wrongList().length+'</b><span>최근에 틀린 문제</span></div></div>';
  h+='<h2>트랙별 진도</h2><div class="grid g2">'+TRACKS.map(function(t){var ns=NOTES.filter(function(n){return n.track===t.id}),qs=ALLQ.filter(function(q){return NOTE[q.slug].track===t.id}),s=stat(qs),rd=ns.filter(function(n){return S.read[n.slug]}).length;
    return '<a class="card trk" style="text-decoration:none;color:inherit" href="#/notes/'+t.id+'"><div class="t"><span>'+esc(t.name)+'</span><small>노트 '+rd+'/'+ns.length+' · 문제 '+qs.length+'</small></div><div class="bar" title="익힌 문제 비율"><i style="width:'+s.pct+'%"></i></div><small class="muted">'+esc(t.desc)+(qs.length?' · 익힘 '+s.pct+'%':'')+'</small></a>'}).join('')+'</div>';
  if(weak.length)h+='<h2>정답률이 낮은 노트</h2><div class="list">'+weak.map(function(w){return '<div class="li"><span class="p"><b>'+esc(w.n.title)+'</b><br><span class="muted small">정답률 '+Math.round(w.acc*100)+'% · '+w.t+'번 풀이</span></span><a class="btn sm ghost" href="notes/'+w.n.slug+'.html">노트</a><a class="btn sm" href="#/quiz/'+w.n.slug+'">다시 풀기</a></div>'}).join('')+'</div>';
  $('#app').innerHTML=h;
  $$('[data-go]').forEach(function(b){b.onclick=function(){if(b.dataset.go==='due')startQuiz(orderDue(dueList()),'오늘 복습');else startQuiz(shuffle(ALLQ.filter(function(q){return !S.q[q.id]})).slice(0,10),'새 문제')}});
}
function orderDue(qs){return qs.sort(function(a,b){var ra=S.q[a.id],rb=S.q[b.id];return (ra.s==='bad'?0:1)-(rb.s==='bad'?0:1)||(ra.b-rb.b)})}

/* ---------- 노트 ---------- */
var noteQuery='';
function notes(track){
  track=TRACK[track]?track:'';
  var h='<h1>강의 노트</h1><p class="sub">노트를 열면 읽음으로 표시됩니다. 노트 안에서도 맨 위의 "문제 풀기"로 바로 넘어올 수 있어요.</p>';
  h+='<input class="search" id="q" type="search" placeholder="제목 · 목차 · 요약 검색 (예: ORM, 백트래킹, Transformer)" value="'+esc(noteQuery)+'" aria-label="노트 검색">';
  h+='<div class="chips" style="margin:12px 0 16px"><a class="chip'+(track?'':' on')+'" href="#/notes">전체 '+NOTES.length+'</a>'+TRACKS.map(function(t){return '<a class="chip'+(track===t.id?' on':'')+'" href="#/notes/'+t.id+'">'+esc(t.name)+' '+NOTES.filter(function(n){return n.track===t.id}).length+'</a>'}).join('')+'</div>';
  h+='<div class="grid g2" id="nl"></div>';
  $('#app').innerHTML=h;
  var draw=function(){
    var q=noteQuery.trim().toLowerCase();
    var list=NOTES.filter(function(n){return (!track||n.track===track)&&(!q||(n.title+' '+n.sections.join(' ')+' '+n.summary).toLowerCase().indexOf(q)>=0)});
    $('#nl').innerHTML=list.length?list.map(function(n){var s=stat(noteQs(n.slug)),u=UNITS[n.slug];
      return '<article class="card note"><div class="h"><button class="read'+(S.read[n.slug]?' on':'')+'" data-read="'+n.slug+'" aria-label="읽음 표시" title="읽음 표시">✓</button><b>'+esc(n.title)+'</b><span class="tag">'+esc(TRACK[n.track].name)+'</span></div>'+
      (n.summary?'<p>'+esc(n.summary)+'</p>':'')+
      (n.sections.length?'<div class="chips">'+n.sections.slice(0,4).map(function(x){return '<span class="tag">'+esc(x.length>20?x.slice(0,19)+'…':x)+'</span>'}).join('')+'</div>':'')+
      '<div class="meta">'+(n.date?'<span>'+esc(n.date.slice(5))+'</span>':'')+(s.total?'<span>문제 '+s.total+'</span><span class="bar" title="익힌 문제 비율"><i style="width:'+s.pct+'%"></i></span><span>'+s.pct+'%</span>':'<span class="faint">문제 없음</span>')+'</div>'+
      '<div class="row"><button class="btn sm" data-open="'+n.slug+'">노트 열기</button>'+(s.total?'<a class="btn sm ghost" href="#/quiz/'+n.slug+'">문제 풀기</a>':'')+(u.concepts.length?'<a class="btn sm ghost" href="#/cards/'+n.slug+'">개념 카드 '+u.concepts.length+'</a>':'')+'</div></article>'}).join(''):'<div class="empty card">"'+esc(noteQuery)+'"에 맞는 노트가 없습니다.</div>';
    $$('[data-open]').forEach(function(b){b.onclick=function(){openNote(b.dataset.open)}});
    $$('[data-read]').forEach(function(b){b.onclick=function(){var k=b.dataset.read;if(S.read[k])delete S.read[k];else S.read[k]=today();save();b.classList.toggle('on')}});
  };
  draw();
  $('#q').oninput=function(e){noteQuery=e.target.value;draw()};
}

/* ---------- 개념 카드 ---------- */
function cards(slug,i){
  var cs=UNITS[slug].concepts,n=NOTE[slug];i=(i+cs.length)%cs.length;var c=cs[i],flip=false;
  var draw=function(){
    $('#app').innerHTML='<div class="flash"><div class="qhead"><a href="#/notes/'+n.track+'">← '+esc(n.title)+'</a><span>'+(i+1)+' / '+cs.length+'</span></div>'+
    '<div class="card fcard" id="fc" tabindex="0" role="button" aria-label="카드 뒤집기"><span class="tag">개념 '+(i+1)+'</span><div class="nm">'+esc(c.name)+'</div><p style="margin:0">'+esc(c.core)+'</p>'+
    (flip?(c.detail?'<p class="muted" style="margin:0">'+esc(c.detail)+'</p>':'')+(c.code?'<pre><code>'+esc(c.code)+'</code></pre>':'')+(c.note?'<div class="warn">'+esc(c.note)+'</div>':''):'<p class="faint small" style="margin-top:auto">눌러서 자세히 보기 · 예시 코드 · 주의할 점</p>')+'</div>'+
    '<div class="qfoot"><button class="btn ghost" id="pv">← 이전</button><a class="btn ghost" href="#/quiz/'+slug+'">이 단원 문제</a><button class="btn" id="nx">다음 →</button></div><p class="faint small" style="text-align:center"><span class="kbd">←</span> <span class="kbd">→</span> 이동 · <span class="kbd">Space</span> 뒤집기</p></div>';
    $('#fc').onclick=function(){flip=!flip;draw()};$('#pv').onclick=function(){cards(slug,i-1)};$('#nx').onclick=function(){cards(slug,i+1)};
  };
  draw();
  keyHandler=function(e){if(e.key==='ArrowRight')cards(slug,i+1);else if(e.key==='ArrowLeft')cards(slug,i-1);else if(e.key===' '){e.preventDefault();flip=!flip;draw()}};
}

/* ---------- 문제: 범위 고르기 ---------- */
var cfg={tracks:[],types:['M','S','W'],count:10,mode:'mix'};
function setup(){
  keyHandler=null;
  var h='<h1>문제 풀기</h1><p class="sub">객관식·단답은 바로 채점하고, 서술형은 모범답안과 비교해 스스로 채점합니다.</p><div class="card setup">';
  h+='<label>트랙</label><div class="chips" id="ct">'+TRACKS.map(function(t){var c=ALLQ.filter(function(q){return NOTE[q.slug].track===t.id}).length;return c?'<button class="chip'+(cfg.tracks.indexOf(t.id)>=0?' on':'')+'" data-t="'+t.id+'">'+esc(t.name)+' '+c+'</button>':''}).join('')+'</div><p class="faint small" style="margin:6px 0 0">아무것도 고르지 않으면 전체에서 냅니다.</p>';
  h+='<label>유형</label><div class="chips" id="cy">'+['M','S','W'].map(function(k){return '<button class="chip'+(cfg.types.indexOf(k)>=0?' on':'')+'" data-y="'+k+'">'+TYPE[k]+' '+ALLQ.filter(function(q){return q.t===k}).length+'</button>'}).join('')+'</div>';
  h+='<label>어떤 문제부터</label><div class="chips" id="cm">'+[['mix','안 푼 문제 먼저'],['wrong','틀린 문제만'],['due','복습 차례만'],['star','별표한 문제만'],['all','무작위']].map(function(m){return '<button class="chip'+(cfg.mode===m[0]?' on':'')+'" data-m="'+m[0]+'">'+m[1]+'</button>'}).join('')+'</div>';
  h+='<label>문제 수</label><div class="chips" id="cc">'+[10,20,30,0].map(function(c){return '<button class="chip'+(cfg.count===c?' on':'')+'" data-c="'+c+'">'+(c||'전부')+'</button>'}).join('')+'</div>';
  h+='<div class="row" style="margin-top:20px;justify-content:space-between"><span class="muted small" id="avail"></span><button class="btn" id="go">시작</button></div></div>';
  h+='<h2>노트별로 풀기</h2><div class="grid g2">'+TRACKS.map(function(t){var ns=NOTES.filter(function(n){return n.track===t.id&&n.nq});return ns.length?'<div class="card"><b>'+esc(t.name)+'</b><div class="list" style="margin-top:10px">'+ns.map(function(n){var s=stat(noteQs(n.slug));return '<a class="li" style="text-decoration:none;color:inherit" href="#/quiz/'+n.slug+'"><span class="p">'+esc(n.title)+'</span><span class="muted small">'+s.tried+'/'+s.total+'</span></a>'}).join('')+'</div></div>':''}).join('')+'</div>';
  $('#app').innerHTML=h;
  var pool=function(){var qs=ALLQ.filter(function(q){return (!cfg.tracks.length||cfg.tracks.indexOf(NOTE[q.slug].track)>=0)&&cfg.types.indexOf(q.t)>=0});
    if(cfg.mode==='wrong')qs=qs.filter(function(q){var r=S.q[q.id];return r&&r.s==='bad'});
    if(cfg.mode==='due')qs=qs.filter(function(q){return isDue(q.id)});
    if(cfg.mode==='star')qs=qs.filter(function(q){return S.star[q.id]});
    return qs};
  var upd=function(){var n=pool().length;$('#avail').textContent='조건에 맞는 문제 '+n+'개';$('#go').disabled=!n};
  $$('#ct [data-t]').forEach(function(b){b.onclick=function(){var i=cfg.tracks.indexOf(b.dataset.t);if(i>=0)cfg.tracks.splice(i,1);else cfg.tracks.push(b.dataset.t);b.classList.toggle('on');upd()}});
  $$('#cy [data-y]').forEach(function(b){b.onclick=function(){var i=cfg.types.indexOf(b.dataset.y);if(i>=0){if(cfg.types.length>1){cfg.types.splice(i,1);b.classList.remove('on')}}else{cfg.types.push(b.dataset.y);b.classList.add('on')}upd()}});
  $$('#cm [data-m]').forEach(function(b){b.onclick=function(){cfg.mode=b.dataset.m;$$('#cm .chip').forEach(function(x){x.classList.toggle('on',x===b)});upd()}});
  $$('#cc [data-c]').forEach(function(b){b.onclick=function(){cfg.count=+b.dataset.c;$$('#cc .chip').forEach(function(x){x.classList.toggle('on',x===b)})}});
  $('#go').onclick=function(){var qs=pool();
    if(cfg.mode==='mix')qs=shuffle(qs.filter(function(q){return !S.q[q.id]})).concat(shuffle(qs.filter(function(q){return S.q[q.id]})));
    else if(cfg.mode==='due')qs=orderDue(qs);else qs=shuffle(qs);
    startQuiz(cfg.count?qs.slice(0,cfg.count):qs,'선택한 범위')};
  upd();
}
function shuffle(a){for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t}return a}

/* ---------- 문제: 풀이 ---------- */
function startQuiz(qs,label){
  if(!qs.length){toast('풀 문제가 없습니다.');return}
  session={qs:qs,i:0,label:label,res:[],state:null};
  if(location.hash==='#/quiz/play')play();else location.hash='#/quiz/play';
}
function norm(s){return String(s).toLowerCase().replace(/[`'"“”‘’;:.,()\s]/g,'')}
function play(){
  var s=session;if(!s)return setup();
  if(s.i>=s.qs.length)return summary();
  var q=s.qs[s.i],n=NOTE[q.slug],st=s.state;
  var h='<div class="q"><div class="qhead"><span>'+esc(s.label)+' · <a href="notes/'+q.slug+'.html">'+esc(n.title)+'</a></span><span><button class="star'+(S.star[q.id]?' on':'')+'" id="star" aria-label="별표" title="별표">★</button>'+(s.i+1)+' / '+s.qs.length+'</span></div>';
  h+='<div class="progress"><i style="width:'+Math.round(s.i/s.qs.length*100)+'%"></i></div><span class="tag">'+TYPE[q.t]+'</span><div class="prompt">'+esc(q.q)+'</div>';
  if(q.t==='M'&&q.o){h+='<div class="opts">'+q.o.map(function(o,k){var cls='';if(st){if(String(k)===String(q.a))cls=' ok';else if(String(k)===st.pick)cls=' bad'}return '<button class="opt'+cls+'" data-k="'+k+'"'+(st?' disabled':'')+'><span class="k">'+(k+1)+'</span><span>'+esc(o)+'</span></button>'}).join('')+'</div>'}
  else if(q.t==='S'){h+='<input class="input" id="ans" autocomplete="off" placeholder="답을 입력하고 Enter" '+(st?'disabled value="'+esc(st.pick)+'"':'')+'>'}
  else{h+='<textarea id="ans" rows="4" placeholder="떠오르는 대로 적어 보세요. 적지 않고 답을 봐도 됩니다."'+(st?' disabled':'')+'>'+(st?esc(st.pick):'')+'</textarea>'}
  if(st){
    if(st.res==='self'){h+='<div class="fb"><b>모범답안</b><div class="ans">'+esc(q.a)+'</div>'+(q.e?'<div class="ex">'+esc(q.e)+'</div>':'')+'</div><p class="small muted" style="margin:12px 0 0">내 답과 비교해 보고 골라 주세요.</p><div class="grade"><button class="g-ok" data-g="ok">알았다 <span class="kbd">1</span></button><button class="g-mid" data-g="mid">헷갈렸다 <span class="kbd">2</span></button><button class="g-bad" data-g="bad">몰랐다 <span class="kbd">3</span></button></div>'}
    else{var ok=st.res==='ok';h+='<div class="fb '+(ok?'ok':'bad')+'"><b>'+(ok?'정답':'오답')+'</b>'+(q.t==='M'?'':'<div class="ans">정답: '+esc(q.a)+'</div>')+(q.e?'<div class="ex">'+esc(q.e)+'</div>':'')+'</div>'+(q.t==='S'&&!ok?'<div class="row" style="margin-top:8px"><button class="btn sm ghost" id="override">맞게 쓴 답이에요</button></div>':'')}
  }
  h+='<div class="qfoot"><a class="btn ghost sm" href="#/quiz">그만하기</a>';
  if(!st&&q.t==='S')h+='<button class="btn" id="submit">채점 <span class="kbd">Enter</span></button>';
  else if(!st&&q.t!=='M')h+='<button class="btn" id="submit">답 보기 <span class="kbd">Enter</span></button>';
  else if(st&&st.res!=='self')h+='<button class="btn" id="next">다음 <span class="kbd">Enter</span></button>';
  h+='</div></div>';
  $('#app').innerHTML=h;
  var a=$('#ans');if(a&&!st)a.focus();
  $('#star').onclick=function(){if(S.star[q.id])delete S.star[q.id];else S.star[q.id]=1;save();this.classList.toggle('on')};
  $$('.opt').forEach(function(b){b.onclick=function(){if(s.state)return;var k=b.dataset.k,res=k===String(q.a)?'ok':'bad';s.state={pick:k,res:res};finish(res)}});
  var sb=$('#submit');if(sb)sb.onclick=submit;
  var nx=$('#next');if(nx)nx.onclick=next;
  var ov=$('#override');if(ov)ov.onclick=function(){var r=S.q[q.id];s.res[s.res.length-1].res='ok';r.ok++;r.s='ok';r.b=Math.min(5,r.pb+1);r.due=today(INTERVAL[r.b]);save();s.state.res='ok';play()};
  $$('[data-g]').forEach(function(b){b.onclick=function(){grade(b.dataset.g)}});
  keyHandler=function(e){
    var tag=(e.target.tagName||'').toLowerCase();
    if(!s.state&&q.t==='M'&&/^[1-9]$/.test(e.key)){var b=$('.opt[data-k="'+(e.key-1)+'"]');if(b)b.click();return}
    if(s.state&&s.state.res==='self'&&/^[123]$/.test(e.key)&&tag!=='textarea'){grade(['ok','mid','bad'][e.key-1]);return}
    if(e.key==='Enter'&&!(tag==='textarea'&&e.shiftKey)){if(!s.state&&q.t!=='M'){e.preventDefault();submit()}else if(s.state&&s.state.res!=='self'){e.preventDefault();next()}}
  };
  function submit(){var v=a?a.value.trim():'';if(q.t==='S'){var res=norm(v)&&norm(v)===norm(q.a)?'ok':'bad';s.state={pick:v,res:res};finish(res)}else{s.state={pick:v,res:'self'};play()}}
  function grade(g){s.res.push({id:q.id,res:g});record(q.id,g);next()}
}
function finish(res){var s=session,q=s.qs[s.i];s.res.push({id:q.id,res:res});record(q.id,res);play()}
function next(){session.i++;session.state=null;play()}
function summary(){
  keyHandler=null;var s=session,ok=s.res.filter(function(r){return r.res==='ok'}).length,bad=s.res.filter(function(r){return r.res==='bad'});
  var h='<div class="q"><h1>'+s.res.length+'문제 중 '+ok+'개 맞힘</h1><p class="sub">헷갈림 '+s.res.filter(function(r){return r.res==='mid'}).length+' · 틀림 '+bad.length+'. 틀린 문제는 오늘 복습 목록에 다시 들어갑니다.</p>';
  if(bad.length)h+='<div class="list">'+bad.map(function(r){var q=Q[r.id];return '<div class="li"><span class="p">'+esc(q.q.length>90?q.q.slice(0,89)+'…':q.q)+'<br><span class="muted small">'+esc(NOTE[q.slug].title)+'</span></span><a class="btn sm ghost" href="notes/'+q.slug+'.html">노트</a></div>'}).join('')+'</div>';
  h+='<div class="row" style="margin-top:18px">'+(bad.length?'<button class="btn" id="again">틀린 것만 다시</button>':'')+'<a class="btn ghost" href="#/quiz">다른 범위</a><a class="btn ghost" href="#/">오늘로</a></div></div>';
  $('#app').innerHTML=h;
  var ag=$('#again');if(ag)ag.onclick=function(){startQuiz(shuffle(bad.map(function(r){return Q[r.id]})),'다시 풀기')};
}

/* ---------- 복습 ---------- */
function review(){
  keyHandler=null;var due=orderDue(dueList()),wr=wrongList(),stars=ALLQ.filter(function(q){return S.star[q.id]});
  var group=function(qs){var g={};qs.forEach(function(q){(g[q.slug]=g[q.slug]||[]).push(q)});return Object.keys(g).map(function(k){return '<div class="card"><div class="row" style="justify-content:space-between"><b>'+esc(NOTE[k].title)+'</b><span class="row"><a class="btn sm ghost" href="notes/'+k+'.html">노트</a></span></div><div class="list" style="margin-top:10px">'+g[k].map(function(q){var r=S.q[q.id]||{};return '<div class="li"><span class="p">'+esc(q.q.length>110?q.q.slice(0,109)+'…':q.q)+'</span><span class="muted small">'+(r.n?r.ok+'/'+r.n:'')+'</span></div>'}).join('')+'</div></div>'}).join('')};
  var h='<h1>복습</h1><p class="sub">맞힌 문제는 1·3·7·14·30일 뒤에, 틀린 문제는 오늘 다시 나옵니다.</p>';
  h+='<div class="grid g4"><div class="card kpi"><b>'+due.length+'</b><span>오늘 복습할 문제</span><div style="margin-top:10px"><button class="btn sm" id="rdue"'+(due.length?'':' disabled')+'>시작</button></div></div><div class="card kpi"><b>'+wr.length+'</b><span>최근에 틀린 문제</span><div style="margin-top:10px"><button class="btn sm ghost" id="rwr"'+(wr.length?'':' disabled')+'>틀린 것만</button></div></div><div class="card kpi"><b>'+stars.length+'</b><span>별표한 문제</span><div style="margin-top:10px"><button class="btn sm ghost" id="rst"'+(stars.length?'':' disabled')+'>별표만</button></div></div><div class="card kpi"><b>'+[1,2,3,4,5].map(function(b){return ALLQ.filter(function(q){var r=S.q[q.id];return r&&r.b===b}).length}).join(' · ')+'</b><span>상자 1~5에 있는 문제</span></div></div>';
  h+=wr.length?'<h2>최근에 틀린 문제</h2><div class="grid g2">'+group(wr)+'</div>':'<div class="empty card" style="margin-top:16px">틀린 문제가 없습니다. 문제를 풀면 여기에 모입니다.</div>';
  $('#app').innerHTML=h;
  $('#rdue').onclick=function(){startQuiz(due,'오늘 복습')};$('#rwr').onclick=function(){startQuiz(shuffle(wr.slice()),'틀린 문제')};$('#rst').onclick=function(){startQuiz(shuffle(stars.slice()),'별표한 문제')};
}

