{# report · gallery · pipeline 시안 공통 조각 (data/projects_index.yaml 사용) #}

{% macro post_title(posts, slug) -%}
{%- for w in posts if w.slug == slug %}{{ w.title }}{% endfor -%}
{%- endmacro %}

{% macro detail(x, posts, arrow) -%}
<ul class="pts">{% for t in x.points %}<li>{{ t }}</li>{% endfor %}</ul>
<div class="stack">{% for s in x.stack %}<span>{{ s }}</span>{% endfor %}</div>
<div class="plinks">
  {% for l in x.links or [] %}<a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }} {{ arrow }}</a>{% endfor %}
  {% if x.post %}<a href="posts/{{ x.post }}.html">글 · {{ post_title(posts, x.post) }} {{ arrow }}</a>{% endif %}
</div>
{%- endmacro %}

{% macro intro() -%}
지구물리 데이터를 다루며 SCIE 제1저자 논문을 쓴 석사(2026)입니다. 지금은 SSAFY 16기에서 LLM 파이프라인·RAG·모델 앙상블을 만들고 있습니다. 모델이 낸 답을 그대로 쓰지 않고, 코드와 테스트로 다시 확인하는 방식으로 일합니다.
{%- endmacro %}

{# 이미지가 있으면 그림, 없으면 접근 과정 단계 (수치 강조 없음) #}
{% macro visual(x, cls='') -%}
{% if x.image %}<figure class="vis {{ cls }}"><img src="{{ x.image }}" alt="{{ x.caption or x.title }}" loading="lazy">{% if x.caption %}<figcaption>{{ x.caption }}</figcaption>{% endif %}</figure>
{% else %}<div class="vis flow {{ cls }}"><span class="flow-l">접근 과정</span><ol>{% for st in x.flow or x.stack %}<li><i>{{ loop.index }}</i>{{ st }}</li>{% endfor %}</ol></div>{% endif %}
{%- endmacro %}

{% macro links(x, posts) -%}
{% for l in x.links or [] %}<a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }} ↗</a>{% endfor %}{% if x.post %}<a href="posts/{{ x.post }}.html">글 · {{ post_title(posts, x.post)|truncate(34) }} →</a>{% endif %}
{%- endmacro %}

{% macro theme_btn(label='테마') -%}<button id="theme" type="button" aria-label="밝은/어두운 테마 전환">{{ label }}</button>{%- endmacro %}

