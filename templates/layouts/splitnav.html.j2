{% import "layouts/_parts.j2" as p %}
{% import "layouts/_v2.j2" as v %}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ profile.name }} — {{ profile.title }}</title>
<meta name="description" content="{{ profile.title }} · {{ profile.headline }}">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#121416;--panel:#181b1e;--text:#e4e7ea;--muted:#8f979f;--faint:#5f676f;--line:#262a2f;--accent:#9fd3b4;--chip:rgba(159,211,180,.1)}
@media (prefers-color-scheme: light){:root:not([data-theme="dark"]){--bg:#f6f7f5;--panel:#ffffff;--text:#16191c;--muted:#5d656d;--faint:#8b929a;--line:#e1e4e0;--accent:#1f7a4d;--chip:rgba(31,122,77,.09)}}
:root[data-theme="light"]{--bg:#f6f7f5;--panel:#ffffff;--text:#16191c;--muted:#5d656d;--faint:#8b929a;--line:#e1e4e0;--accent:#1f7a4d;--chip:rgba(31,122,77,.09)}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--muted);font:16px/1.7 "Pretendard Variable",Pretendard,system-ui,sans-serif;-webkit-font-smoothing:antialiased;word-break:keep-all}
body::before{content:"";position:fixed;inset:0;pointer-events:none;background:radial-gradient(600px circle at var(--mx,20%) var(--my,10%),rgba(159,211,180,.06),transparent 60%);z-index:0}
a{color:inherit;text-decoration:none}
.mono{font-family:"IBM Plex Mono",ui-monospace,monospace}
.shell{position:relative;z-index:1;max-width:1180px;margin:0 auto;padding:0 32px;display:grid;grid-template-columns:44% 1fr;gap:56px}
.left{position:sticky;top:0;height:100vh;padding:88px 0;display:flex;flex-direction:column}
.left h1{color:var(--text);font-size:clamp(36px,4.2vw,50px);line-height:1.1;letter-spacing:-.035em;margin:0;font-weight:800}
.left h2{color:var(--text);font-size:19px;font-weight:600;margin:12px 0 16px;letter-spacing:-.01em}
.left p.tag{max-width:340px;margin:0}
.nav{list-style:none;margin:56px 0 0;padding:0}
.nav a{display:flex;align-items:center;gap:14px;padding:10px 0;font:500 12px "IBM Plex Mono",monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--faint)}
.nav a::before{content:"";width:32px;height:1px;background:currentColor;transition:width .2s}
.nav a:hover,.nav a.on{color:var(--text)}
.nav a:hover::before,.nav a.on::before{width:64px}
.social{margin-top:auto;display:flex;gap:18px;align-items:center}
.social a{color:var(--muted)}.social a:hover{color:var(--text)}
#theme{background:none;border:1px solid var(--line);color:var(--muted);border-radius:6px;font:12px "IBM Plex Mono",monospace;padding:4px 10px;cursor:pointer}
.right{padding:88px 0 80px}
section{scroll-margin-top:24px;margin-bottom:112px}
.stickyh{display:none}
.about p{margin:0 0 16px}
.about b{color:var(--text);font-weight:600}
.about .me{display:flex;gap:16px;align-items:center;margin-bottom:22px}
.about .avatar{width:64px;height:64px;border-radius:50%;object-fit:cover;font-size:22px;filter:saturate(.8)}
.about .me small{display:block;color:var(--faint);font-size:13px}
.item{display:grid;grid-template-columns:120px 1fr;gap:16px;padding:20px;margin:0 -20px 8px;border-radius:10px;border:1px solid transparent;transition:background .2s,border-color .2s}
.item:hover{background:var(--panel);border-color:var(--line)}
.item .when{font:500 12px/1.9 "IBM Plex Mono",monospace;color:var(--faint);text-transform:uppercase;letter-spacing:.04em}
.item h3{margin:0;color:var(--text);font-size:17px;line-height:1.45;font-weight:600}
.item .org{font-size:13.5px;color:var(--faint);margin-top:2px}
.item p{margin:10px 0 0;font-size:14.5px}
.item .pts{margin:10px 0 0;padding-left:16px;font-size:14px}.item .pts li{margin:3px 0}
.item .vis{margin:14px 0 0}
.item .vis img{width:100%;max-width:420px;aspect-ratio:16/9;object-fit:cover;object-position:top;border-radius:6px;border:1px solid var(--line);display:block;background:#fff}
.item .vis figcaption{font-size:12px;color:var(--faint);margin-top:4px}
.item .vis.flow{border:1px solid var(--line);border-radius:8px;padding:12px 14px;max-width:420px}
.flow-l{display:block;font:500 11px "IBM Plex Mono",monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin-bottom:6px}
.item .vis.flow ol{margin:0;padding:0;list-style:none;font-size:13.5px}
.item .vis.flow li{padding:2px 0;color:var(--text)}
.item .vis.flow li i{font-style:normal;color:var(--faint);font-family:"IBM Plex Mono",monospace;margin-right:8px}
.tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:14px}
.tags span{font:500 12px "IBM Plex Mono",monospace;color:var(--accent);background:var(--chip);padding:3px 10px;border-radius:999px}
.plinks{display:flex;flex-wrap:wrap;gap:4px 16px;margin-top:12px;font-size:13.5px;font-weight:600}
.plinks a{color:var(--text)}.plinks a:hover{color:var(--accent)}
.post{display:grid;grid-template-columns:120px 1fr;gap:16px;padding:14px 20px;margin:0 -20px;border-radius:10px}
.post:hover{background:var(--panel)}
.post .when{font:500 12px/2 "IBM Plex Mono",monospace;color:var(--faint)}
.post b{color:var(--text);font-weight:600}
.post:hover b{color:var(--accent)}
.cvrow{display:grid;grid-template-columns:120px 1fr;gap:16px;padding:10px 0;font-size:14.5px;border-top:1px solid var(--line)}
.cvrow .when{font:500 12px/2 "IBM Plex Mono",monospace;color:var(--faint)}
.cvrow b{color:var(--text);font-weight:600}
.more{display:inline-flex;gap:8px;margin-top:18px;color:var(--text);font-weight:600;font-size:14.5px;border-bottom:1px solid var(--accent);padding-bottom:2px}
.foot{font-size:13px;color:var(--faint);max-width:420px}
@media (max-width:1000px){
  .shell{grid-template-columns:1fr;gap:0;padding:0 20px}
  .left{position:static;height:auto;padding:56px 0 24px}
  .nav{display:none}
  .social{margin-top:28px}
  .right{padding-top:24px}
  .stickyh{display:block;position:sticky;top:0;z-index:5;margin:0 -20px 16px;padding:14px 20px;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(8px);font:500 12px "IBM Plex Mono",monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--text)}
  section{margin-bottom:72px}
  .item,.post,.cvrow{grid-template-columns:1fr;gap:4px}
}
</style>
</head>
<body>
<div class="shell">
  <header class="left">
    <h1>{{ profile.name }}</h1>
    <h2>{{ profile.title }}</h2>
    <p class="tag">데이터를 모으고, 모델을 검증하고, 결과로 증명합니다.</p>
    <ul class="nav"><li><a href="#about">About</a></li><li><a href="#work">Work</a></li>{% if posts %}<li><a href="#writing">Writing</a></li>{% endif %}<li><a href="#cv">CV</a></li></ul>
    <div class="social">{% for l in profile.links if 'github' in l.label|lower or 'linkedin' in l.label|lower %}<a href="{{ l.url }}" target="_blank" rel="noopener" aria-label="{{ l.label }}">{{ p.link_icon(l.label) }}</a>{% endfor %}{% if profile.email %}<a href="mailto:{{ profile.email }}" aria-label="이메일">{{ p.icon('mail', 20) }}</a>{% endif %}<a href="resume-1page.pdf" download aria-label="이력서">{{ p.icon('doc', 20) }}</a>{% if alt_lang %}<a class="mono" href="{{ alt_lang.url }}" style="font-size:12px">{{ alt_lang.label }}</a>{% endif %}{{ v.theme_btn('theme') }}</div>
  </header>

  <main class="right">
    <section id="about" class="about">
      <div class="stickyh">About</div>
      <div class="me">{{ p.avatar(profile) }}<div><b>{{ profile.name }} · {{ profile.name_en }}</b><small>전북대 석사(2026) · SSAFY 16기</small></div></div>
      <p>{{ v.intro() }}</p>
      <p>연구실에서는 <b>중력·자력·탄성파 자료</b>를 다뤘고, 캘거리대·칼리파대와의 <b>국제 공동연구</b>로 논문을 썼습니다. 지금은 <b>LLM 파이프라인과 RAG</b>를 만들며, 모델 응답을 코드로 검증하는 구조를 고민합니다.</p>
    </section>

    <section id="work">
      <div class="stickyh">Work</div>
      {% for x in projects_index %}
      <article class="item">
        <span class="when">{{ x.period }}</span>
        <div>
          <h3>{{ x.title }}</h3><div class="org">{{ x.org }} · {{ x.team }}</div>
          <p>{{ x.oneliner }}</p>
          <ul class="pts">{% for t in x.points[:2] %}<li>{{ t }}</li>{% endfor %}</ul>
          {{ v.visual(x) }}
          <div class="tags">{% for s in x.stack %}<span>{{ s }}</span>{% endfor %}</div>
          <div class="plinks">{{ v.links(x, posts) }}</div>
        </div>
      </article>
      {% endfor %}
      <a class="more" href="resume.pdf" download>상세 이력서 보기 →</a>
    </section>

    {% if posts %}
    <section id="writing">
      <div class="stickyh">Writing</div>
      {% for w in posts %}<a class="post" href="posts/{{ w.slug }}.html"><span class="when">{{ w.date }}</span><b>{{ w.title }}</b></a>{% endfor %}
      {% if study_notes %}<a class="more" href="study/index.html">SSAFY 강의 노트 {{ study_notes|length }}편 →</a>{% endif %}
    </section>
    {% endif %}

    <section id="cv">
      <div class="stickyh">CV</div>
      {% for e in education %}<div class="cvrow"><span class="when">{{ e.period_str }}</span><div><b>{{ e.school }}</b> · {{ e.major }} {{ e.degree }}</div></div>{% endfor %}
      {% for x in papers %}<div class="cvrow"><span class="when">{{ x.year }} · paper</span><div>{% if x.url %}<a href="{{ x.url }}" target="_blank" rel="noopener"><b>{{ x.title }}</b></a>{% else %}<b>{{ x.title }}</b>{% endif %} · {{ x.venue }}</div></div>{% endfor %}
      {% for x in awards + certifications %}<div class="cvrow"><span class="when">{{ x.date }}</span><div><b>{{ x.name }}</b> · {{ x.org }}</div></div>{% endfor %}
    </section>
    <p class="foot">data/portfolio.yaml 하나에서 사이트·이력서를 자동 생성합니다. © {{ profile.name_en }} · <a href="private/index.html" rel="nofollow">Private</a></p>
  </main>
</div>
{{ p.theme_script() }}
<script>
(function(){
document.addEventListener('pointermove',function(e){document.body.style.setProperty('--mx',e.clientX+'px');document.body.style.setProperty('--my',e.clientY+'px')});
var links=document.querySelectorAll('.nav a');if(!('IntersectionObserver' in window))return;
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)links.forEach(function(a){a.classList.toggle('on',a.getAttribute('href')==='#'+e.target.id)})})},{rootMargin:'-30% 0px -60% 0px'});
document.querySelectorAll('main section').forEach(function(s){io.observe(s)});
})();
</script>
</body>
</html>
