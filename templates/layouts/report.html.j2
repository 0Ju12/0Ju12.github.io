{% import "layouts/_parts.j2" as p %}
{% import "layouts/_v2.j2" as v %}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ profile.name }} 포트폴리오</title>
<meta name="description" content="{{ profile.title }} · {{ profile.headline }}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@500;700;900&family=Noto+Sans+KR:wght@400;500;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#fbfaf6;--surface:#f3f1ea;--text:#1c1b19;--muted:#6b675e;--line:#e2ded3;--accent:#b4441c;--accent-2:#d9773f;--on-accent:#fff;--chip:#efece3}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#151412;--surface:#1d1c19;--text:#ecE8df;--muted:#a19c90;--line:#2e2c27;--accent:#f08a5d;--accent-2:#f5a77f;--on-accent:#151412;--chip:#24221e}}
:root[data-theme="dark"]{--bg:#151412;--surface:#1d1c19;--text:#ece8df;--muted:#a19c90;--line:#2e2c27;--accent:#f08a5d;--accent-2:#f5a77f;--on-accent:#151412;--chip:#24221e}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font:16.5px/1.75 "Noto Sans KR",system-ui,sans-serif;-webkit-font-smoothing:antialiased}
a{color:inherit}
.mono{font-family:"JetBrains Mono",ui-monospace,monospace}
.wrap{max-width:980px;margin:0 auto;padding:0 24px}
.narrow{max-width:720px}
nav.top{display:flex;align-items:center;gap:20px;padding:22px 0;border-bottom:1px solid var(--line);font-size:14px}
nav.top .logo{font-family:"Noto Serif KR",serif;font-weight:900;margin-right:auto;text-decoration:none;font-size:17px}
nav.top a{text-decoration:none;color:var(--muted)}nav.top a:hover{color:var(--text)}
#theme{background:none;border:1px solid var(--line);color:var(--muted);border-radius:4px;padding:3px 10px;font:inherit;font-size:12px;cursor:pointer}
.hero{display:grid;grid-template-columns:1fr 132px;gap:40px;align-items:start;padding:72px 0 48px}
.kicker{font-family:"JetBrains Mono",monospace;font-size:12.5px;letter-spacing:.08em;color:var(--accent);text-transform:uppercase}
.hero h1{font-family:"Noto Serif KR",serif;font-weight:900;font-size:clamp(34px,5vw,54px);line-height:1.18;letter-spacing:-.03em;margin:14px 0 22px}
.hero h1 em{font-style:normal;color:var(--accent)}
.hero p{margin:0 0 22px;max-width:640px;color:var(--text);font-size:17.5px}
.hero .avatar{width:132px;height:132px;border-radius:50%;object-fit:cover;filter:grayscale(.2);border:1px solid var(--line);font-size:38px}
.inline-links{display:flex;flex-wrap:wrap;gap:6px 20px;font-size:14.5px}
.inline-links a{text-decoration:none;border-bottom:1px solid var(--line);padding-bottom:1px}
.inline-links a:hover{border-color:var(--accent);color:var(--accent)}
.facts{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--text);border-bottom:1px solid var(--line);margin-bottom:24px}
.facts div{padding:16px 16px 18px 0}
.facts b{display:block;font-family:"Noto Serif KR",serif;font-size:24px;font-weight:900;letter-spacing:-.02em}
.facts span{font-size:12.5px;color:var(--muted)}
section{padding:64px 0 0;scroll-margin-top:16px}
.sh{display:flex;align-items:baseline;gap:14px;margin:0 0 18px}
.sh h2{font-family:"Noto Serif KR",serif;font-size:28px;font-weight:900;letter-spacing:-.02em;margin:0}
.sh .n{font-family:"JetBrains Mono",monospace;font-size:12.5px;color:var(--muted)}
.sh .rule{flex:1;height:1px;background:var(--line);align-self:center}
/* 프로젝트 인덱스 */
.idx{border-top:1px solid var(--text)}
.idx details{border-bottom:1px solid var(--line)}
.idx summary{list-style:none;display:grid;grid-template-columns:120px 1fr 170px;gap:20px;padding:20px 0;cursor:pointer;align-items:start}
.idx summary::-webkit-details-marker{display:none}
.idx .when{font-family:"JetBrains Mono",monospace;font-size:12.5px;color:var(--muted);padding-top:4px}
.idx h3{font-family:"Noto Serif KR",serif;font-size:20px;line-height:1.4;margin:0 0 4px;letter-spacing:-.01em}
.idx summary:hover h3{color:var(--accent)}
.idx .org{font-size:13px;color:var(--muted)}
.idx .one{font-size:15px;margin:8px 0 0;color:var(--text)}
.idx .met{text-align:right}
.idx .met b{display:block;font-family:"JetBrains Mono",monospace;font-size:22px;font-weight:600;color:var(--accent);letter-spacing:-.02em;line-height:1.2}
.idx .met span{font-size:12px;color:var(--muted)}
.idx .tog{font-family:"JetBrains Mono",monospace;font-size:12px;color:var(--muted);margin-top:10px;display:inline-block}
.idx details[open] .tog::after{content:" − 접기"}.idx details:not([open]) .tog::after{content:" + 자세히"}
.body{display:grid;grid-template-columns:120px 1fr 260px;gap:20px;padding:0 0 26px}
.body .fig{grid-column:3;grid-row:1}
.body .fig img{width:100%;border:1px solid var(--line);border-radius:4px;display:block;background:#fff}
.body .fig figcaption{font-size:12px;color:var(--muted);margin-top:4px}
.body .txt{grid-column:2}
.pts{margin:0 0 12px;padding-left:18px}.pts li{margin:4px 0;font-size:15px}
.stack{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px}
.stack span{font-family:"JetBrains Mono",monospace;font-size:11.5px;padding:2px 8px;border:1px solid var(--line);border-radius:3px;color:var(--muted)}
.plinks{display:flex;flex-direction:column;gap:4px;font-size:14px}
.plinks a{color:var(--accent);text-decoration:none}.plinks a:hover{text-decoration:underline}
/* 글 */
.wl{list-style:none;margin:0;padding:0}
.wl li{display:grid;grid-template-columns:120px 1fr;gap:20px;padding:12px 0;border-bottom:1px dashed var(--line)}
.wl .d{font-family:"JetBrains Mono",monospace;font-size:12.5px;color:var(--muted);padding-top:3px}
.wl a{text-decoration:none;font-weight:500}.wl a:hover{color:var(--accent)}
.wl small{display:block;color:var(--muted);font-size:13.5px;margin-top:2px}
.studyline{margin-top:16px;font-size:14.5px}.studyline a{color:var(--accent)}
/* 논문 */
.refs{margin:0;padding-left:22px}
.refs li{padding:8px 0;font-size:15px}
.refs li::marker{font-family:"JetBrains Mono",monospace;color:var(--muted);font-size:13px}
.refs small{color:var(--muted)}
.refs a{color:var(--accent)}
.talks{margin-top:8px}.talks summary{cursor:pointer;color:var(--accent);font-size:14px}
.talks ol{margin:6px 0 0;padding-left:22px;font-size:14px;color:var(--muted)}
/* 이력 */
.cv{display:grid;grid-template-columns:1fr 1fr;gap:8px 40px}
.cv h4{font-family:"JetBrains Mono",monospace;font-size:12px;letter-spacing:.08em;color:var(--muted);margin:0 0 6px;font-weight:600;text-transform:uppercase}
.cv dl{margin:0 0 24px}
.cv dt{font-weight:700;font-size:15px}
.cv dd{margin:0 0 10px;font-size:13.5px;color:var(--muted)}
.skills p{margin:0 0 6px;font-size:14.5px}.skills b{display:inline-block;min-width:150px}
footer{margin:80px 0 0;padding:28px 0 48px;border-top:1px solid var(--text);display:flex;flex-wrap:wrap;gap:12px 24px;justify-content:space-between;font-size:14px}
footer .big{font-family:"Noto Serif KR",serif;font-size:22px;font-weight:900}
footer a{color:var(--accent)}
footer small{color:var(--muted)}
@media (max-width:760px){
  nav.top a.opt{display:none}
  .hero{grid-template-columns:1fr;padding:40px 0 32px;gap:20px}
  .hero .avatar{width:88px;height:88px;order:-1}
  .facts{grid-template-columns:repeat(2,1fr)}
  .idx summary{grid-template-columns:1fr;gap:6px}
  .idx .met{text-align:left;display:flex;gap:8px;align-items:baseline}
  .idx .met b{display:inline}
  .body{grid-template-columns:1fr}
  .body .fig,.body .txt{grid-column:1;grid-row:auto}
  .wl li{grid-template-columns:1fr;gap:0}
  .cv{grid-template-columns:1fr}
  .skills b{display:block}
}
</style>
</head>
<body>
<div class="wrap">
<nav class="top"><a class="logo" href="#">{{ profile.name }}<span style="color:var(--accent)">.</span></a><a class="opt" href="#projects">Projects</a><a class="opt" href="#writing">Writing</a><a class="opt" href="#publications">Publications</a><a class="opt" href="#cv">CV</a>{% if alt_lang %}<a href="{{ alt_lang.url }}" hreflang="{{ alt_lang.code }}">{{ alt_lang.label }}</a>{% endif %}<button id="theme" type="button">테마</button></nav>

<header class="hero">
  <div>
    <div class="kicker">{{ profile.title }} · Data &amp; AI Engineer</div>
    <h1>데이터를 모으고,<br>모델로 검증하고,<br><em>결과로 증명합니다.</em></h1>
    <p>{{ v.intro() }}</p>
    <div class="inline-links">
      <a href="resume-1page.pdf" download>이력서 (1장)</a><a href="resume.pdf" download>상세 이력서</a>
      {% for l in profile.links %}<a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }}</a>{% endfor %}
      {% if profile.email %}<a href="mailto:{{ profile.email }}">{{ profile.email }}</a>{% endif %}
    </div>
  </div>
  {{ p.avatar(profile) }}
</header>
<div class="facts">{% for h in highlights %}<div><b>{{ h.value }}</b><span>{{ h.label }}</span></div>{% endfor %}</div>

<section id="projects">
  <div class="sh"><h2>Projects</h2><span class="rule"></span><span class="n">{{ projects_index|length }} entries · 클릭하면 펼쳐집니다</span></div>
  <div class="idx">
  {% for x in projects_index %}
  <details{% if loop.first %} open{% endif %}>
    <summary>
      <span class="when">{{ x.period }}</span>
      <div><h3>{{ x.title }}</h3><div class="org">{{ x.org }} · {{ x.team }}</div><p class="one">{{ x.oneliner }}</p><span class="tog"></span></div>
      <div class="met"><b>{{ x.metric.value }}</b><span>{{ x.metric.label }}</span></div>
    </summary>
    <div class="body">
      <div class="txt">{{ v.detail(x, posts, '→') }}</div>
      {% if x.image %}<figure class="fig" style="margin:0"><img src="{{ x.image }}" alt="{{ x.title }}" loading="lazy"></figure>{% endif %}
    </div>
  </details>
  {% endfor %}
  </div>
</section>

{% if posts %}
<section id="writing">
  <div class="sh"><h2>Writing</h2><span class="rule"></span><span class="n">{{ posts|length }} posts</span></div>
  <ul class="wl">{% for w in posts %}<li><span class="d">{{ w.date }}</span><div><a href="posts/{{ w.slug }}.html">{{ w.title }}</a><small>{{ w.summary|truncate(110) }}</small></div></li>{% endfor %}</ul>
  {% if study_notes %}<p class="studyline">SSAFY 강의 노트 {{ study_notes|length }}편은 <a href="study/index.html">학습 공간</a>에 정리해 두었습니다.</p>{% endif %}
</section>
{% endif %}

<section id="publications">
  <div class="sh"><h2>Publications</h2><span class="rule"></span><span class="n">{{ papers|length }} papers · {{ talks|length }} talks</span></div>
  <ol class="refs">{% for x in papers %}<li>{% if x.url %}<a href="{{ x.url }}" target="_blank" rel="noopener">{{ x.title }}</a>{% else %}{{ x.title }}{% endif %} <small>— {{ x.venue }}, {{ x.year }}</small></li>{% endfor %}</ol>
  <details class="talks"><summary>학회 발표 {{ talks|length }}건</summary><ol>{% for x in talks %}<li>{{ x.title }} ({{ x.year }})</li>{% endfor %}</ol></details>
</section>

<section id="cv">
  <div class="sh"><h2>CV</h2><span class="rule"></span></div>
  <div class="cv">
    <div><h4>Education</h4><dl>{% for e in education %}<dt>{{ e.school }}</dt><dd>{{ e.major }} {{ e.degree }} · {{ e.period_str }}</dd>{% endfor %}</dl></div>
    <div><h4>Awards · Certifications</h4><dl>{% for x in awards %}<dt>{{ x.name }}</dt><dd>{{ x.org }} · {{ x.date }}</dd>{% endfor %}{% for x in certifications %}<dt>{{ x.name }}</dt><dd>{{ x.org }} · {{ x.date }}</dd>{% endfor %}</dl></div>
  </div>
  <h4 class="mono" style="font-size:12px;letter-spacing:.08em;color:var(--muted);margin:8px 0 8px">SKILLS</h4>
  <div class="skills">{% for s in skills %}<p><b>{{ s.category }}</b>{{ s['items']|join(', ') }}</p>{% endfor %}</div>
</section>

<footer id="contact"><div><div class="big">함께 일할 기회를 기다립니다.</div>{% if profile.email %}<a href="mailto:{{ profile.email }}">{{ profile.email }}</a>{% endif %}</div><small>© {{ profile.name_en }} · data/portfolio.yaml 에서 자동 생성 · <a href="private/index.html" rel="nofollow">🔒 Private</a></small></footer>
</div>
{{ p.theme_script() }}
</body>
</html>
