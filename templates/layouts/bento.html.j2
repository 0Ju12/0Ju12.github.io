{% import "layouts/_parts.j2" as p %}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ profile.name }} 포트폴리오</title>
<meta name="description" content="{{ profile.title }} · {{ profile.headline }}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f2f2f0;--surface:#fff;--text:#161616;--muted:#5f6368;--line:#e6e6e3;--accent:#ff5a1f;--accent-2:#ffb21f;--on-accent:#fff;--chip:#f3f3f1;--ink:#161616;--tile-dark:#161616;--tile-dark-text:#f5f5f3}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#0e0e0e;--surface:#1a1a1a;--text:#f2f2f0;--muted:#a3a3a3;--line:#2a2a2a;--accent:#ff7a45;--accent-2:#ffc145;--on-accent:#0e0e0e;--chip:#242424;--tile-dark:#f2f2f0;--tile-dark-text:#161616}}
:root[data-theme="dark"]{--bg:#0e0e0e;--surface:#1a1a1a;--text:#f2f2f0;--muted:#a3a3a3;--line:#2a2a2a;--accent:#ff7a45;--accent-2:#ffc145;--on-accent:#0e0e0e;--chip:#242424;--tile-dark:#f2f2f0;--tile-dark-text:#161616}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.65 "IBM Plex Sans KR",system-ui,sans-serif;-webkit-font-smoothing:antialiased}
a{color:var(--accent)}
.wrap{max-width:1160px;margin:0 auto;padding:0 20px}
nav.top{display:flex;align-items:center;gap:18px;padding:22px 0}
nav.top .logo{font-weight:700;font-size:18px;margin-right:auto;letter-spacing:-.02em}
nav.top a{color:var(--muted);text-decoration:none;font-size:14px;font-weight:500}
nav.top a:hover{color:var(--text)}
#theme{background:var(--surface);border:1px solid var(--line);color:var(--muted);border-radius:999px;padding:5px 12px;font:inherit;font-size:12px;cursor:pointer}
.bento{display:grid;grid-template-columns:repeat(6,1fr);grid-auto-rows:minmax(120px,auto);gap:14px}
.tile{background:var(--surface);border:1px solid var(--line);border-radius:28px;padding:26px;position:relative;overflow:hidden}
.hero{grid-column:span 4;grid-row:span 2;display:flex;flex-direction:column;justify-content:flex-end;gap:14px;padding:34px}
.hero .hello{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:var(--muted);background:var(--chip);border-radius:999px;padding:5px 12px;align-self:flex-start}
.hero .hello i{width:8px;height:8px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 4px rgba(34,197,94,.2)}
.hero h1{font-size:clamp(28px,3.6vw,44px);line-height:1.18;margin:0;letter-spacing:-.03em}
.hero h1 em{font-style:normal;background:linear-gradient(90deg,var(--accent),var(--accent-2));-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{color:var(--muted);margin:0;max-width:560px}
.hero .cta{display:flex;flex-wrap:wrap;gap:8px}
.photo{grid-column:span 2;grid-row:span 2;padding:0;display:flex}
.photo .avatar{width:100%;height:100%;min-height:260px;object-fit:cover;border-radius:0;font-size:64px}
.photo .namecard{position:absolute;left:16px;right:16px;bottom:16px;background:rgba(255,255,255,.88);backdrop-filter:blur(8px);color:#161616;border-radius:18px;padding:12px 16px}
.photo .namecard b{display:block;font-size:18px}.photo .namecard span{font-size:13px;color:#555}
.stat{grid-column:span 1;display:flex;flex-direction:column;justify-content:space-between}
.stat b{font-size:28px;line-height:1.1;letter-spacing:-.02em}
.stat span{font-size:12.5px;color:var(--muted);line-height:1.4}
.stat.dark{background:var(--tile-dark);color:var(--tile-dark-text);border-color:transparent}
.stat.dark span{color:inherit;opacity:.7}
.stat.accent{background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#fff;border-color:transparent}
.stat.accent span{color:#fff;opacity:.9}
.stack{grid-column:span 2}
.stack h3,.edu h3,.contact h3{margin:0 0 12px;font-size:14px;color:var(--muted);font-weight:600}
.edu{grid-column:span 3}
.edu ul{list-style:none;margin:0;padding:0;display:grid;gap:8px;font-size:14px}
.edu li b{display:block;font-size:15px}
.edu li span{color:var(--muted);font-size:12.5px}
.contact{grid-column:span 3;display:flex;flex-direction:column}
.contact .social{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:auto}
.contact .social a{display:flex;flex-direction:column;align-items:center;gap:6px;padding:12px 6px;border-radius:16px;background:var(--chip);color:var(--text);text-decoration:none;font-size:12px;font-weight:600}
.contact .social a:hover{background:var(--accent);color:#fff}
h2.sec{font-size:28px;letter-spacing:-.02em;margin:72px 0 18px;display:flex;align-items:baseline;gap:10px}
h2.sec small{font-size:14px;color:var(--muted);font-weight:500}
.projects{display:grid;grid-template-columns:repeat(6,1fr);gap:14px}
.proj{grid-column:span 3;display:flex;flex-direction:column;gap:12px;cursor:default;transition:transform .2s,box-shadow .2s}
.proj:hover{transform:translateY(-3px);box-shadow:0 14px 34px rgba(0,0,0,.07)}
.proj.big{grid-column:span 6;display:grid;grid-template-columns:1.2fr 1fr;gap:26px;align-items:center}
.proj .cover{border-radius:20px;aspect-ratio:16/10;background:linear-gradient(135deg,#fff1ea,#ffe2c7);display:grid;place-items:center;overflow:hidden}
.proj .cover img{width:100%;height:100%;object-fit:contain;background:#fff}
.proj .cover .ic{font-size:44px}
.proj .cover .kpi{position:absolute}
.proj .badge{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--accent);background:color-mix(in srgb,var(--accent) 12%,transparent);padding:3px 10px;border-radius:999px;align-self:flex-start}
.proj h3{margin:0;font-size:20px;line-height:1.35;letter-spacing:-.01em}
.proj p{margin:0;color:var(--muted);font-size:15px}
.proj .kpirow{display:flex;align-items:baseline;gap:8px}
.proj .kpirow b{font-size:26px;letter-spacing:-.02em}
.proj .kpirow span{font-size:13px;color:var(--muted)}
.more{background:none;border:0;color:var(--text);font:inherit;font-weight:600;font-size:14px;cursor:pointer;padding:0;display:inline-flex;align-items:center;gap:6px;align-self:flex-start;border-bottom:1.5px solid var(--accent)}
.detail{grid-column:1/-1;border-top:1px solid var(--line);padding-top:16px}
.pubtile{padding:10px 26px}
footer{color:var(--muted);font-size:13px;padding:56px 0}
.theme-dark-safe .proj .cover{background:linear-gradient(135deg,#2a1a12,#2a2112)}
{{ p.base_css() }}
@media (max-width:960px){
  .bento,.projects{grid-template-columns:repeat(2,1fr)}
  .hero,.photo,.stack,.edu,.contact,.proj,.proj.big{grid-column:span 2}
  .photo{grid-row:span 1}
  .proj.big{grid-template-columns:1fr}
  .stat{grid-column:span 1}
  nav.top a{display:none}
}
</style>
</head>
<body>
<div class="wrap">
<nav class="top"><span class="logo">{{ profile.name }}<span style="color:var(--accent)">.</span></span>
  <a href="#projects">프로젝트</a><a href="#publications">논문</a><a href="#contact">연락처</a>
  <button id="theme" type="button">테마</button></nav>

<div class="bento">
  <div class="tile hero">
    <span class="hello"><i></i> {{ profile.title }}</span>
    <h1>복잡한 지구과학 데이터를<br><em>딥러닝과 분석</em>으로 풀어냅니다</h1>
    <p>{{ profile.summary|truncate(150) }}</p>
    <div class="cta"><a class="btn solid" href="resume.pdf" download>{{ p.icon('doc', 16) }} 이력서</a><a class="btn ghost" href="#projects">프로젝트 보기 {{ p.icon('arrow', 14) }}</a></div>
  </div>
  <div class="tile photo">{{ p.avatar(profile) }}<div class="namecard"><b>{{ profile.name }} · {{ profile.name_en }}</b><span>전북대 석사 · ADsP</span></div></div>
  {% for h in highlights %}<div class="tile stat {{ 'dark' if loop.index == 1 else 'accent' if loop.index == 2 else '' }}"><b>{{ h.value }}</b><span>{{ h.label }}</span></div>{% endfor %}
  <div class="tile stack"><h3>기술 스택</h3><div class="chips">{% for s in skills[:2] %}{% for i in s['items'] %}<span class="chip">{{ i }}</span>{% endfor %}{% endfor %}</div></div>
  <div class="tile edu"><h3>학력 · 교육</h3><ul>{% for e in education %}<li><b>{{ e.school }}</b><span>{{ e.major }} {{ e.degree }} · {{ e.period_str }}</span></li>{% endfor %}</ul></div>
  <div class="tile contact" id="contact"><h3>연락하기</h3><p style="margin:0 0 12px;font-size:14px;color:var(--muted)">데이터·AI 엔지니어 포지션 기회를 기다리고 있어요.</p>
    <div class="social">{% for l in profile.links %}<a href="{{ l.url }}" target="_blank" rel="noopener">{{ p.link_icon(l.label) }}{{ l.label }}</a>{% endfor %}</div></div>
</div>

<h2 class="sec" id="projects">프로젝트 <small>{{ featured|length }}개</small></h2>
<div class="projects">
{% for a in featured %}
  <article class="tile proj {{ 'big' if loop.first else '' }}">
    <div class="cover">{% if a.image %}<img src="{{ a.image }}" alt="{{ a.image_caption or a.title }}" loading="lazy">{% elif a.gallery %}<img src="{{ a.gallery[0].src }}" alt="{{ a.gallery[0].caption }}" loading="lazy" style="object-fit:cover">{% else %}<span class="ic">{{ a.icon }}</span>{% endif %}</div>
    <div style="display:flex;flex-direction:column;gap:12px">
      <span class="badge">{{ a.type }} · {{ a.period_str }}</span>
      <h3>{{ a.title }}</h3>
      <p>{{ a.summary }}</p>
      {% if a.kpi %}<div class="kpirow"><b>{{ a.kpi.value }}</b><span>{{ a.kpi.label }}</span></div>{% endif %}
      <div class="chips">{% for t in a.tags %}<span class="chip">{{ t }}</span>{% endfor %}</div>
      <button class="more" type="button" data-expand="d-{{ a.id }}" aria-expanded="false"><span>자세히 보기</span> {{ p.icon('arrow', 14) }}</button>
    </div>
    <div class="detail" id="d-{{ a.id }}" hidden>{{ p.star(a) }}</div>
  </article>
{% endfor %}
</div>

<h2 class="sec" id="publications">논문 · 발표 <small>논문 {{ papers|length }} · 발표 {{ talks|length }}</small></h2>
<div class="tile pubtile">{{ p.pubs(papers, talks) }}</div>

<h2 class="sec">수상 · 자격</h2>
<div class="projects">{% for x in awards %}<div class="tile" style="grid-column:span 2">🏆<b style="display:block;margin-top:8px">{{ x.name }}</b><span style="color:var(--muted);font-size:13px">{{ x.org }}{% if x.date %} · {{ x.date }}{% endif %}</span></div>{% endfor %}{% for x in certifications %}<div class="tile" style="grid-column:span 2">📜<b style="display:block;margin-top:8px">{{ x.name }}</b><span style="color:var(--muted);font-size:13px">{{ x.org }}</span></div>{% endfor %}</div>

<footer>© {{ profile.name_en }} · data/portfolio.yaml 에서 자동 생성</footer>
</div>
{{ p.theme_script() }}
</body>
</html>
