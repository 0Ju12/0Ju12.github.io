{% import "layouts/_parts.j2" as p %}
{% import "layouts/_v2.j2" as v %}
{% set byid = {} %}{% for x in projects_index %}{% set _ = byid.update({x.id: x}) %}{% endfor %}
{% set order = ['heritage', 'thread', 'vqa', 'pospeak', 'masters', 'wildfire', 'co2'] %}
{% set sections = {'heritage': 'Engineering', 'thread': 'Engineering', 'vqa': 'Modeling', 'pospeak': 'Modeling', 'masters': 'Research', 'wildfire': 'Modeling', 'co2': 'Research'} %}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ profile.name }} — 작업 기록</title>
<meta name="description" content="{{ profile.title }} · {{ profile.headline }}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;600;900&family=Noto+Sans+KR:wght@400;500;700&family=Playfair+Display:ital,wght@0,700;1,500&display=swap" rel="stylesheet">
<style>
:root{--bg:#fffdf8;--text:#161514;--muted:#6f6a62;--line:#1a1918;--soft:#e7e2d8;--accent:#c2410c;--panel:#f5f0e6;--paper:#ffffff}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#141311;--text:#efebe4;--muted:#a39d93;--line:#efebe4;--soft:#2c2a26;--accent:#fb923c;--panel:#1c1a17}}
:root[data-theme="dark"]{--bg:#141311;--text:#efebe4;--muted:#a39d93;--line:#efebe4;--soft:#2c2a26;--accent:#fb923c;--panel:#1c1a17}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.75 "Noto Sans KR",system-ui,sans-serif;-webkit-font-smoothing:antialiased;word-break:keep-all}
a{color:inherit}
.serif{font-family:"Noto Serif KR",serif}
.w{max-width:1200px;margin:0 auto;padding:0 28px}
#progress{position:fixed;top:0;left:0;height:3px;width:0;background:var(--accent);z-index:50}

/* 제호 */
.mast{display:grid;grid-template-columns:1fr auto 1fr;align-items:end;padding:22px 0 12px;border-bottom:1px solid var(--line)}
.mast .l,.mast .r{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.mast .r{justify-self:end;display:flex;gap:18px}
.mast .r a{text-decoration:none;color:var(--text)}
.nameplate{text-align:center;text-decoration:none}
.nameplate b{display:block;font-family:"Playfair Display","Noto Serif KR",serif;font-weight:700;font-size:clamp(34px,5vw,60px);line-height:1;letter-spacing:-.02em}
.nameplate small{display:block;font-family:"Noto Serif KR",serif;font-size:13px;color:var(--muted);margin-top:6px;letter-spacing:.3em}
#theme{background:none;border:0;color:inherit;font:inherit;letter-spacing:inherit;text-transform:inherit;cursor:pointer;padding:0}
.issue{display:flex;justify-content:space-between;gap:16px;padding:8px 0;border-bottom:3px double var(--line);font-size:12px;color:var(--muted);letter-spacing:.06em}
.secnav{display:flex;justify-content:center;gap:28px;padding:10px 0;border-bottom:1px solid var(--soft);font-size:13px;font-weight:700;letter-spacing:.04em}
.secnav a{text-decoration:none}.secnav a:hover{color:var(--accent)}

/* 표지 */
.cover{display:grid;grid-template-columns:1.25fr 1fr 260px;gap:40px;padding:44px 0 48px;border-bottom:1px solid var(--line)}
.kick{font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}
.cover h1{font-family:"Noto Serif KR",serif;font-weight:900;font-size:clamp(36px,4.6vw,62px);line-height:1.12;letter-spacing:-.04em;margin:14px 0 22px}
.cover h1 em{font-family:"Playfair Display",serif;font-style:italic;font-weight:500;color:var(--accent)}
.cover .dek{font-family:"Noto Serif KR",serif;font-size:18.5px;line-height:1.7;margin:0 0 22px}
.by{font-size:13px;color:var(--muted);border-top:1px solid var(--soft);padding-top:12px}
.by a{color:var(--accent);text-decoration:none;font-weight:700}
.cover figure{margin:0}
.cover .avatar{width:100%;aspect-ratio:4/5;object-fit:cover;display:block;font-size:72px;filter:contrast(1.03)}
.cover figcaption{font-size:12px;color:var(--muted);margin-top:8px;font-style:italic;font-family:"Noto Serif KR",serif}
.inside{border-left:1px solid var(--soft);padding-left:24px}
.inside h2{font-family:"Playfair Display",serif;font-style:italic;font-weight:500;font-size:24px;margin:0 0 10px}
.inside a{display:grid;grid-template-columns:30px 1fr;gap:8px;padding:10px 0;border-top:1px solid var(--soft);text-decoration:none}
.inside a:hover b{color:var(--accent)}
.inside .pg{font-family:"Playfair Display",serif;font-size:20px;color:var(--accent);line-height:1.2}
.inside small{display:block;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.inside b{font-family:"Noto Serif KR",serif;font-size:14.5px;font-weight:600;line-height:1.45}

/* 편집자의 글 */
.letter{display:grid;grid-template-columns:200px 1fr;gap:40px;padding:56px 0;border-bottom:1px solid var(--line)}
.letter h2{font-family:"Playfair Display",serif;font-style:italic;font-weight:500;font-size:28px;margin:0;line-height:1.2}
.letter h2 small{display:block;font-family:"Noto Sans KR",sans-serif;font-style:normal;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:8px}
.letter .body{columns:2;column-gap:40px;font-family:"Noto Serif KR",serif;font-size:17px;line-height:1.85}
.letter .body p{margin:0 0 14px}
.letter .body p:first-child::first-letter{float:left;font-family:"Playfair Display",serif;font-size:4.2em;line-height:.85;padding:6px 10px 0 0;color:var(--accent)}
.sign{font-family:"Playfair Display",serif;font-style:italic;font-size:20px;margin-top:6px}

/* 기사 */
section{scroll-margin-top:12px}
.sec{display:flex;align-items:baseline;gap:16px;border-top:3px solid var(--line);padding-top:10px;margin:72px 0 8px}
.sec h2{font-family:"Playfair Display","Noto Serif KR",serif;font-size:36px;font-weight:700;letter-spacing:-.01em;margin:0}
.sec span{font-size:12px;color:var(--muted);letter-spacing:.08em;text-transform:uppercase}
.lead{padding:28px 0 48px;border-bottom:1px solid var(--line)}
.lead .vis img{aspect-ratio:21/9}
.lead .cols{display:grid;grid-template-columns:1.1fr 1fr 1fr;gap:36px;margin-top:24px}
.lead h3{font-family:"Noto Serif KR",serif;font-weight:900;font-size:clamp(28px,3.4vw,44px);line-height:1.18;letter-spacing:-.035em;margin:8px 0 0}
.story{display:grid;grid-template-columns:1fr 1fr;gap:48px;padding:44px 0;border-bottom:1px solid var(--soft)}
.story.flip .art{order:-1}
.story h3{font-family:"Noto Serif KR",serif;font-size:clamp(24px,2.6vw,34px);font-weight:900;line-height:1.25;letter-spacing:-.03em;margin:8px 0 14px}
.fno{display:flex;gap:10px;align-items:baseline}
.fno i{font-family:"Playfair Display",serif;font-style:italic;font-size:15px;color:var(--muted)}
.dek2{font-family:"Noto Serif KR",serif;font-size:18px;line-height:1.75;margin:0 0 18px}
.dek2::first-letter{font-weight:900;color:var(--accent)}
.pts{margin:0 0 18px;padding:0;list-style:none;font-size:14.5px}
.pts li{margin-bottom:10px;padding-left:16px;position:relative}
.pts li::before{content:"■";position:absolute;left:0;top:.1em;font-size:8px;color:var(--accent)}
.story .pts{columns:2;column-gap:28px}.story .pts li{break-inside:avoid}
.meta{font-size:12.5px;color:var(--muted);letter-spacing:.02em;margin-bottom:12px;border-top:1px solid var(--soft);padding-top:10px}
.plinks{display:flex;flex-wrap:wrap;gap:6px 18px;font-size:14px;font-weight:700}
.plinks a{color:var(--accent);text-decoration:none}.plinks a:hover{text-decoration:underline}
.vis{margin:0}
.vis img{width:100%;display:block;aspect-ratio:4/3;object-fit:cover;object-position:top;background:var(--paper);border:1px solid var(--soft)}
.vis figcaption{font-size:12.5px;color:var(--muted);margin-top:8px;font-style:italic;font-family:"Noto Serif KR",serif;padding-left:10px;border-left:2px solid var(--accent)}
.vis.flow{background:var(--panel);padding:28px 30px;border-top:4px solid var(--accent)}
.flow-l{display:block;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:14px}
.flow-l::after{content:" — 이렇게 접근했습니다";letter-spacing:0;text-transform:none;font-weight:400;color:var(--muted);font-family:"Noto Serif KR",serif;font-style:italic}
.vis.flow ol{margin:0;padding:0;list-style:none;font-family:"Noto Serif KR",serif;font-size:19px;line-height:1.5}
.vis.flow li{display:flex;gap:14px;padding:11px 0;border-bottom:1px solid var(--soft)}
.vis.flow li:last-child{border-bottom:0;font-weight:600}
.vis.flow li i{font-family:"Playfair Display",serif;font-style:italic;color:var(--accent);min-width:18px}
.quote{font-family:"Noto Serif KR",serif;font-size:clamp(24px,3vw,38px);line-height:1.45;letter-spacing:-.02em;text-align:center;max-width:880px;margin:56px auto;padding:36px 0}
.quote::before{content:"“";display:block;font-family:"Playfair Display",serif;font-size:96px;line-height:.5;color:var(--accent);margin-bottom:12px}
.quote cite{display:block;margin-top:18px;font-size:13px;font-style:normal;color:var(--muted);letter-spacing:.1em;text-transform:uppercase}

/* 에세이 */
.essays{display:grid;grid-template-columns:1.3fr 1fr;gap:48px;padding-top:28px}
.feat-post{text-decoration:none;display:block;border-top:4px solid var(--accent);padding-top:18px}
.feat-post small{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);font-weight:700}
.feat-post b{display:block;font-family:"Noto Serif KR",serif;font-size:clamp(24px,2.8vw,34px);font-weight:900;line-height:1.3;letter-spacing:-.03em;margin:10px 0 14px}
.feat-post p{font-family:"Noto Serif KR",serif;font-size:17px;line-height:1.75;margin:0 0 14px;color:var(--muted)}
.feat-post span{font-weight:700;color:var(--accent);font-size:14px}
.feat-post:hover b{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:6px}
.post{display:grid;grid-template-columns:28px 1fr;gap:10px;padding:14px 0;border-top:1px solid var(--soft);text-decoration:none}
.post i{font-family:"Playfair Display",serif;font-style:italic;color:var(--accent);font-size:18px}
.post small{display:block;font-size:12px;color:var(--muted)}
.post b{font-family:"Noto Serif KR",serif;font-size:16px;line-height:1.5;font-weight:600}
.post:hover b{color:var(--accent)}

/* 필자 소개 */
.author{display:grid;grid-template-columns:200px 1fr;gap:40px;padding-top:28px}
.author .avatar{width:200px;aspect-ratio:1;object-fit:cover;filter:grayscale(1) contrast(1.05);display:block;font-size:56px}
.author .bio{font-family:"Noto Serif KR",serif;font-size:17px;line-height:1.8;margin:0 0 24px}
.author .bio b{font-weight:900}
.cv{display:grid;grid-template-columns:repeat(3,1fr);gap:0 28px}
.cv h4{font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin:0 0 8px}
.cv .it{padding:10px 0;border-top:1px solid var(--soft);font-size:14px}
.cv .it small{display:block;color:var(--muted);font-size:12.5px}
.cv .it a{text-decoration:none}.cv .it a:hover{color:var(--accent)}
footer{margin-top:88px;border-top:3px double var(--line);padding:28px 0 56px;display:grid;grid-template-columns:1fr 1fr;gap:24px}
footer .sign2{font-family:"Noto Serif KR",serif;font-size:28px;font-weight:900;letter-spacing:-.02em;line-height:1.3}
footer .sign2 a{color:var(--accent);text-decoration:none;font-size:18px;font-weight:600;display:block;margin-top:8px}
footer .colophon{font-size:12.5px;color:var(--muted);line-height:1.7;align-self:end}
footer .colophon b{display:block;font-family:"Playfair Display",serif;font-style:italic;font-weight:500;font-size:16px;color:var(--text)}
@media (max-width:1000px){.cover{grid-template-columns:1fr 1fr}.inside{grid-column:1/-1;border-left:0;padding-left:0;display:grid;grid-template-columns:1fr 1fr;gap:0 24px}.inside h2{grid-column:1/-1}}
@media (max-width:760px){
  .w{padding:0 18px}
  .mast{grid-template-columns:1fr auto}.mast .l{display:none}.nameplate{text-align:left}.nameplate small{letter-spacing:.15em}
  .issue span:nth-child(2){display:none}
  .secnav{justify-content:flex-start;overflow-x:auto;gap:20px;white-space:nowrap}
  .cover,.letter,.story,.lead .cols,.essays,.author,footer{grid-template-columns:1fr;gap:22px}
  .cover .avatar{aspect-ratio:1;max-width:240px}
  .inside{grid-template-columns:1fr}
  .letter .body{columns:1}
  .story.flip .art{order:0}
  .story .pts{columns:1}
  .lead .vis img{aspect-ratio:4/3}
  .cv{grid-template-columns:1fr}
  .author .avatar{width:140px}
}
</style>
</head>
<body>
<div id="progress" aria-hidden="true"></div>
<div class="w">
  <div class="mast"><span class="l">Data · AI · Research</span><a class="nameplate" href="#"><b>The Work of Lee</b><small>이영주의 작업 기록</small></a><span class="r">{% if alt_lang %}<a href="{{ alt_lang.url }}">{{ alt_lang.label }}</a>{% endif %}<a href="resume-1page.pdf" download>PDF</a>{{ v.theme_btn() }}</span></div>
  <div class="issue"><span>2026년 11월호 · Vol. 1</span><span>지구물리 연구실에서 LLM 엔지니어링까지</span><span>{{ profile.title }}</span></div>
  <nav class="secnav" aria-label="섹션"><a href="#letter">편집자의 글</a><a href="#features">Features</a><a href="#essays">Essays</a><a href="#author">필자 소개</a><a href="#contact">연락</a></nav>

  <header class="cover">
    <div>
      <span class="kick">Cover Story</span>
      <h1>데이터를 모으고, 모델을 검증하고, <em>결과로 증명합니다.</em></h1>
      <p class="dek">{{ v.intro() }}</p>
      <div class="by">글·작업 {{ profile.name }} · <a href="resume-1page.pdf" download>이력서 PDF</a>{% for l in profile.links %} · <a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }}</a>{% endfor %}</div>
    </div>
    <figure>{{ p.avatar(profile) }}<figcaption>{{ profile.name }} — 전북대 석사(2026), SSAFY 16기</figcaption></figure>
    <nav class="inside" aria-label="이번 호">
      <h2>In this issue</h2>
      {% for id in order %}{% set x = byid[id] %}<a href="#s-{{ id }}"><span class="pg">{{ loop.index }}</span><span><small>{{ sections[id] }}</small><b>{{ x.title.split(' — ')[0] }}</b></span></a>{% endfor %}
    </nav>
  </header>

  <section class="letter" id="letter">
    <h2><small>Editor's Letter</small>이번 호를<br>펴내며</h2>
    <div class="body">
      <p>지구물리 연구실에서 처음 배운 것은, 데이터를 해석하기 전에 그 데이터가 어떻게 만들어졌는지를 먼저 보는 일이었습니다. 겹쳐 있는 두 신호를 가르는 지표를 설계할 때도, 결과를 독립된 모델과 다시 비교하고 나서야 확신할 수 있었습니다.</p>
      <p>지금은 같은 습관으로 LLM 서비스를 만듭니다. 모델이 고른 번호, 모델이 붙인 인용을 그대로 쓰지 않고 코드로 한 번 더 확인합니다. 이번 호에는 그 방식으로 만든 일곱 개의 작업을 실었습니다 — 엔지니어링, 모델링, 연구 순서로 읽으셔도 좋고, 관심 가는 기사부터 펼치셔도 좋습니다.</p>
      <div class="sign">— {{ profile.name_en }}</div>
    </div>
  </section>

  <section id="features">
    <div class="sec"><h2>Features</h2><span>일곱 편의 작업</span></div>
    {% for id in order %}{% set x = byid[id] %}
    {% if loop.first %}
    <article class="lead" id="s-{{ id }}">
      {{ v.visual(x) }}
      <div class="cols">
        <div><div class="fno"><span class="kick">{{ sections[id] }} · Feature 01</span></div><h3>{{ x.title }}</h3></div>
        <div><p class="dek2">{{ x.oneliner }}</p><div class="meta">{{ x.org }} · {{ x.period }} · {{ x.team }}</div><div class="plinks">{{ v.links(x, posts) }}</div></div>
        <div><ul class="pts">{% for t in x.points %}<li>{{ t }}</li>{% endfor %}</ul><div class="meta">{{ x.stack|join(' / ') }}</div></div>
      </div>
    </article>
    {% else %}
    <article class="story{% if loop.index is odd %} flip{% endif %}" id="s-{{ id }}">
      <div>
        <div class="fno"><span class="kick">{{ sections[id] }}</span><i>Feature {{ '%02d'|format(loop.index) }}</i></div>
        <h3>{{ x.title }}</h3>
        <p class="dek2">{{ x.oneliner }}</p>
        <ul class="pts">{% for t in x.points %}<li>{{ t }}</li>{% endfor %}</ul>
        <div class="meta">{{ x.org }} · {{ x.period }} · {{ x.team }} · {{ x.stack|join(' / ') }}</div>
        <div class="plinks">{{ v.links(x, posts) }}</div>
      </div>
      <div class="art">{{ v.visual(x) }}</div>
    </article>
    {% endif %}
    {% if loop.index == 3 %}<blockquote class="quote">LLM에는 판단만 맡기고,<br>결과는 코드로 다시 확인한다.<cite>ThRead · 국보 가이드 · VQA에 공통으로 적용한 원칙</cite></blockquote>{% endif %}
    {% endfor %}
  </section>

  {% if posts %}
  <section id="essays">
    <div class="sec"><h2>Essays</h2><span>설계 결정과 실패의 기록 · {{ posts|length }}편</span></div>
    <div class="essays">
      {% set f = posts[0] %}
      <a class="feat-post" href="posts/{{ f.slug }}.html"><small>Latest Essay · {{ f.date }}</small><b>{{ f.title }}</b><p>{{ f.summary }}</p><span>전문 읽기 →</span></a>
      <div>{% for w in posts[1:] %}<a class="post" href="posts/{{ w.slug }}.html"><i>{{ loop.index + 1 }}</i><span><small>{{ w.date }}</small><b>{{ w.title }}</b></span></a>{% endfor %}</div>
    </div>
  </section>
  {% endif %}

  <section id="author">
    <div class="sec"><h2>About the Author</h2><span>필자 소개</span></div>
    <div class="author">
      {{ p.avatar(profile) }}
      <div>
        <p class="bio"><b>{{ profile.name }}</b>은 전북대학교 환경에너지융합학과에서 석사 학위를 받았고(2026), 캐나다 캘거리대학교 파견과 3개 기관 공동연구로 SPE Journal에 제1저자 논문을 냈습니다. 포스코 청년 AI·BigData 아카데미를 거쳐 지금은 SSAFY 16기에서 LLM 파이프라인과 RAG를 만들고 있습니다.</p>
        <div class="cv">
          <div><h4>Education</h4>{% for e in education %}<div class="it">{{ e.school }}<small>{{ e.major }} {{ e.degree }} · {{ e.period_str }}</small></div>{% endfor %}</div>
          <div><h4>Publications</h4>{% for x in papers %}<div class="it">{% if x.url %}<a href="{{ x.url }}" target="_blank" rel="noopener">{{ x.title }}</a>{% else %}{{ x.title }}{% endif %}<small>{{ x.venue }} · {{ x.year }}</small></div>{% endfor %}<div class="it"><small>학회 발표 {{ talks|length }}건</small></div></div>
          <div><h4>Awards · Skills</h4>{% for x in awards + certifications %}<div class="it">{{ x.name }}<small>{{ x.org }} · {{ x.date }}</small></div>{% endfor %}{% for s in skills[:3] %}<div class="it">{{ s.category }}<small>{{ s['items']|join(', ') }}</small></div>{% endfor %}</div>
        </div>
      </div>
    </div>
  </section>

  <footer id="contact">
    <div class="sign2">다음 호를 함께 만들 곳을<br>찾고 있습니다.{% if profile.email %}<a href="mailto:{{ profile.email }}">{{ profile.email }} →</a>{% endif %}</div>
    <div class="colophon"><b>Colophon</b>본문 Noto Serif KR · 제호 Playfair Display. 이 사이트와 이력서는 data/portfolio.yaml 하나에서 자동으로 만들어집니다.{% if study_notes %} SSAFY 강의 노트 {{ study_notes|length }}편은 <a href="study/index.html">학습 공간</a>에.{% endif %}<br>© {{ profile.name_en }} · <a href="private/index.html" rel="nofollow">Private</a></div>
  </footer>
</div>
{{ p.theme_script() }}
<script>
