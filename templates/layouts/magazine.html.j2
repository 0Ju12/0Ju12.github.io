{% import "layouts/_parts.j2" as p %}
{% import "layouts/_v2.j2" as v %}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ profile.name }} — {{ profile.title }}</title>
<meta name="description" content="{{ profile.title }} · {{ profile.headline }}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;600;900&family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#fffdf8;--text:#161514;--muted:#6f6a62;--line:#1a1918;--soft:#e7e2d8;--accent:#1d4ed8;--panel:#f5f1e8}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#141311;--text:#efebe4;--muted:#a39d93;--line:#efebe4;--soft:#2c2a26;--accent:#7ea2ff;--panel:#1c1a17}}
:root[data-theme="dark"]{--bg:#141311;--text:#efebe4;--muted:#a39d93;--line:#efebe4;--soft:#2c2a26;--accent:#7ea2ff;--panel:#1c1a17}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.75 "Noto Sans KR",system-ui,sans-serif;-webkit-font-smoothing:antialiased;word-break:keep-all}
a{color:inherit}
.serif{font-family:"Noto Serif KR",serif}
.w{max-width:1200px;margin:0 auto;padding:0 28px}
.mast{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:16px 0;border-bottom:1px solid var(--line);font-size:12.5px;letter-spacing:.06em;text-transform:uppercase}
.mast .logo{font-family:"Noto Serif KR",serif;font-weight:900;font-size:26px;letter-spacing:-.02em;text-transform:none;text-decoration:none}
.mast .r{justify-self:end;display:flex;gap:18px}
.mast a{text-decoration:none}
#theme{background:none;border:0;color:inherit;font:inherit;letter-spacing:inherit;text-transform:inherit;cursor:pointer;padding:0}
.issue{display:flex;justify-content:space-between;padding:8px 0;border-bottom:3px double var(--line);font-size:12px;color:var(--muted);letter-spacing:.04em}
.cover{display:grid;grid-template-columns:1.25fr 1fr;gap:48px;padding:48px 0 56px;border-bottom:1px solid var(--line)}
.kick{font-size:12.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}
.cover h1{font-family:"Noto Serif KR",serif;font-weight:900;font-size:clamp(38px,5.6vw,70px);line-height:1.08;letter-spacing:-.04em;margin:16px 0 24px}
.cover .dek{font-family:"Noto Serif KR",serif;font-size:20px;line-height:1.65;color:var(--text);margin:0 0 24px;max-width:600px}
.by{font-size:13.5px;color:var(--muted)}
.by a{color:var(--accent);text-decoration:none;font-weight:700}
.cover figure{margin:0}
.cover .avatar{width:100%;aspect-ratio:4/5;object-fit:cover;display:block;font-size:72px}
.cover figcaption{font-size:12.5px;color:var(--muted);margin-top:8px;border-top:1px solid var(--soft);padding-top:8px}
.toc{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--line)}
.toc a{padding:18px 20px 22px 0;text-decoration:none;border-right:1px solid var(--soft)}
.toc a+a{padding-left:20px}.toc a:last-child{border-right:0}
.toc small{display:block;font-size:11.5px;color:var(--accent);font-weight:700;letter-spacing:.08em}
.toc b{font-family:"Noto Serif KR",serif;font-size:17px;line-height:1.4;display:block;margin-top:4px}
.toc a:hover b{text-decoration:underline}
section{padding:72px 0 0;scroll-margin-top:12px}
.sec{display:flex;align-items:baseline;gap:16px;border-top:3px solid var(--line);padding-top:10px;margin-bottom:36px}
.sec h2{font-family:"Noto Serif KR",serif;font-size:32px;font-weight:900;letter-spacing:-.03em;margin:0}
.sec span{font-size:12.5px;color:var(--muted);letter-spacing:.06em;text-transform:uppercase}
.story{display:grid;grid-template-columns:1fr 1fr;gap:48px;padding:40px 0;border-bottom:1px solid var(--soft)}
.story.lead{grid-template-columns:1.3fr 1fr}
.story:nth-of-type(odd):not(.lead) .art{order:-1}
.story h3{font-family:"Noto Serif KR",serif;font-size:clamp(24px,2.8vw,36px);font-weight:900;line-height:1.25;letter-spacing:-.03em;margin:10px 0 14px}
.story .dek2{font-family:"Noto Serif KR",serif;font-size:18px;line-height:1.7;margin:0 0 18px}
.story .pts{columns:2;column-gap:28px;margin:0 0 18px;padding:0;list-style:none;font-size:14.5px}
.story .pts li{break-inside:avoid;margin-bottom:10px;padding-left:14px;position:relative}
.story .pts li::before{content:"";position:absolute;left:0;top:.75em;width:6px;height:1px;background:var(--text)}
.story .stack{font-size:12.5px;color:var(--muted);letter-spacing:.02em;margin-bottom:12px}
.story .plinks{display:flex;flex-wrap:wrap;gap:6px 18px;font-size:14px;font-weight:700}
.story .plinks a{color:var(--accent);text-decoration:none}.story .plinks a:hover{text-decoration:underline}
.art{margin:0}
.vis{margin:0}
.vis img{width:100%;display:block;aspect-ratio:4/3;object-fit:cover;object-position:top;background:#fff;border:1px solid var(--soft)}
.vis figcaption{font-size:12.5px;color:var(--muted);margin-top:8px;font-style:italic;font-family:"Noto Serif KR",serif}
.vis.flow{background:var(--panel);padding:28px;border-top:3px solid var(--line)}
.flow-l{display:block;font-size:11.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-bottom:12px}
.vis.flow ol{margin:0;padding:0;list-style:none;font-family:"Noto Serif KR",serif;font-size:19px;line-height:1.5}
.vis.flow li{display:flex;gap:14px;padding:10px 0;border-bottom:1px solid var(--soft)}
.vis.flow li i{font-style:italic;color:var(--muted);min-width:18px}
.quote{font-family:"Noto Serif KR",serif;font-size:clamp(24px,3vw,36px);line-height:1.45;letter-spacing:-.02em;text-align:center;max-width:860px;margin:72px auto 0;padding:32px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.quote::before{content:"“";display:block;font-size:64px;line-height:.6;color:var(--accent)}
.cols3{display:grid;grid-template-columns:repeat(3,1fr);gap:0 32px}
.post{display:block;padding:18px 0;border-top:1px solid var(--soft);text-decoration:none}
.post small{font-size:12px;color:var(--muted);letter-spacing:.04em}
.post b{display:block;font-family:"Noto Serif KR",serif;font-size:18px;line-height:1.45;margin:4px 0 6px}
.post p{margin:0;font-size:14px;color:var(--muted)}
.post:hover b{color:var(--accent)}
.cv{display:grid;grid-template-columns:repeat(3,1fr);gap:0 32px}
.cv h4{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin:0 0 8px}
.cv .it{padding:12px 0;border-top:1px solid var(--soft);font-size:14.5px}
.cv .it small{display:block;color:var(--muted);font-size:13px}
.cv .it a{text-decoration:none}.cv .it a:hover{color:var(--accent)}
footer{margin-top:88px;border-top:3px double var(--line);padding:28px 0 56px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px}
footer .sign{font-family:"Noto Serif KR",serif;font-size:28px;font-weight:900;letter-spacing:-.02em}
footer a{color:var(--accent)}
footer small{color:var(--muted)}
@media (max-width:900px){
  .w{padding:0 18px}
  .mast{grid-template-columns:1fr auto}.mast .l{display:none}.mast .logo{font-size:21px}
  .issue span:nth-child(2){display:none}
  .cover,.story,.story.lead{grid-template-columns:1fr;gap:24px}
  .cover{padding-top:28px}
  .cover .avatar{aspect-ratio:1;max-width:220px}
  .story:nth-of-type(odd):not(.lead) .art{order:0}
  .story .pts{columns:1}
  .toc{grid-template-columns:1fr 1fr}.toc a{border-right:0;padding-left:0!important;border-bottom:1px solid var(--soft)}
  .cols3,.cv{grid-template-columns:1fr}
}
</style>
</head>
<body>
<div class="w">
  <div class="mast"><span class="l">Data · AI · Research</span><a class="logo" href="#">{{ profile.name }}의 작업</a><span class="r">{% if alt_lang %}<a href="{{ alt_lang.url }}">{{ alt_lang.label }}</a>{% endif %}{{ v.theme_btn() }}</span></div>
  <div class="issue"><span>Portfolio · Vol. 2026</span><span>지구물리 연구에서 LLM 엔지니어링까지</span><span>{{ profile.title }}</span></div>

  <header class="cover">
    <div>
      <span class="kick">Cover Story</span>
      <h1>데이터를 모으고,<br>모델로 검증하고,<br>결과로 증명합니다.</h1>
      <p class="dek">{{ v.intro() }}</p>
      <div class="by">글·작업 {{ profile.name }} · <a href="resume-1page.pdf" download>이력서 PDF</a>{% for l in profile.links %} · <a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }}</a>{% endfor %}</div>
    </div>
    <figure>{{ p.avatar(profile) }}<figcaption>{{ profile.name }} · 전북대 석사(2026) · SSAFY 16기</figcaption></figure>
  </header>

  <nav class="toc" aria-label="이번 호 목차">{% for x in projects_index[:4] %}<a href="#s-{{ x.id }}"><small>{{ '%02d'|format(loop.index) }}</small><b>{{ x.title }}</b></a>{% endfor %}</nav>

  <section id="work">
    <div class="sec"><h2>Features</h2><span>{{ projects_index|length }} stories</span></div>
    {% for x in projects_index %}
    <article class="story{% if loop.first %} lead{% endif %}" id="s-{{ x.id }}">
      <div>
        <span class="kick">{{ x.org }}</span>
        <h3>{{ x.title }}</h3>
        <p class="dek2">{{ x.oneliner }}</p>
        <ul class="pts">{% for t in x.points %}<li>{{ t }}</li>{% endfor %}</ul>
        <div class="stack">{{ x.period }} · {{ x.team }} · {{ x.stack|join(' / ') }}</div>
        <div class="plinks">{{ v.links(x, posts) }}</div>
      </div>
      <div class="art">{{ v.visual(x) }}</div>
    </article>
    {% if loop.index == 3 %}<blockquote class="quote">LLM에는 판단만 맡기고,<br>결과는 코드로 다시 확인한다.</blockquote>{% endif %}
    {% endfor %}
  </section>

  {% if posts %}
  <section id="writing">
    <div class="sec"><h2>Essays</h2><span>{{ posts|length }} pieces</span></div>
    <div class="cols3">{% for w in posts %}<a class="post" href="posts/{{ w.slug }}.html"><small>{{ w.date }}</small><b>{{ w.title }}</b><p>{{ w.summary|truncate(70) }}</p></a>{% endfor %}</div>
  </section>
  {% endif %}

  <section id="cv">
    <div class="sec"><h2>About the Author</h2></div>
    <div class="cv">
      <div><h4>Education</h4>{% for e in education %}<div class="it">{{ e.school }}<small>{{ e.major }} {{ e.degree }} · {{ e.period_str }}</small></div>{% endfor %}</div>
      <div><h4>Publications</h4>{% for x in papers %}<div class="it">{% if x.url %}<a href="{{ x.url }}" target="_blank" rel="noopener">{{ x.title }}</a>{% else %}{{ x.title }}{% endif %}<small>{{ x.venue }} · {{ x.year }}</small></div>{% endfor %}<div class="it"><small>학회 발표 {{ talks|length }}건</small></div></div>
      <div><h4>Awards · Skills</h4>{% for x in awards + certifications %}<div class="it">{{ x.name }}<small>{{ x.org }} · {{ x.date }}</small></div>{% endfor %}{% for s in skills %}<div class="it">{{ s.category }}<small>{{ s['items']|join(', ') }}</small></div>{% endfor %}</div>
    </div>
  </section>

  <footer id="contact"><div><div class="sign">함께 일할 기회를 기다립니다.</div>{% if profile.email %}<a href="mailto:{{ profile.email }}">{{ profile.email }}</a>{% endif %}</div><small>© {{ profile.name_en }} · data/portfolio.yaml 에서 자동 생성 · <a href="private/index.html" rel="nofollow">Private</a></small></footer>
</div>
{{ p.theme_script() }}
</body>
</html>
