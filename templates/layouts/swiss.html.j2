{% import "layouts/_parts.j2" as p %}
{% import "layouts/_v2.j2" as v %}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ profile.name }} — {{ profile.title }}</title>
<meta name="description" content="{{ profile.title }} · {{ profile.headline }}">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<style>
:root{--bg:#f4f3ef;--text:#111;--muted:#6a6a66;--line:#111;--soft:#d6d4cd;--accent:#e2231a;--card:#fff}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#121212;--text:#f1f0ec;--muted:#9a9993;--line:#f1f0ec;--soft:#34332f;--accent:#ff4a3d;--card:#1b1b1b}}
:root[data-theme="dark"]{--bg:#121212;--text:#f1f0ec;--muted:#9a9993;--line:#f1f0ec;--soft:#34332f;--accent:#ff4a3d;--card:#1b1b1b}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font:15.5px/1.6 "Pretendard Variable",Pretendard,"Helvetica Neue",Arial,sans-serif;-webkit-font-smoothing:antialiased;word-break:keep-all}
a{color:inherit}
.w{max-width:1280px;margin:0 auto;padding:0 32px}
.g{display:grid;grid-template-columns:repeat(12,1fr);gap:0 24px}
.top{border-bottom:2px solid var(--line);padding:18px 0;font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.04em}
.top .g>*{align-self:center}
.top .tl{grid-column:1/4}.top .nav{grid-column:4/9;display:flex;gap:24px}.top .tr{grid-column:9/13;justify-self:end;display:flex;gap:20px}
.top a{text-decoration:none}.top a:hover{color:var(--accent)}
#theme{background:none;border:0;padding:0;color:inherit;font:inherit;cursor:pointer;text-transform:uppercase;justify-self:end}
.hero{padding:64px 0 40px;border-bottom:2px solid var(--line)}
.name{grid-column:1/-1;font-size:clamp(56px,12vw,176px);line-height:.88;letter-spacing:-.06em;font-weight:800;margin:0}
.name span{color:var(--accent)}
.meta{margin-top:40px}
.meta .lab{font-size:11.5px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);font-weight:700;margin-bottom:8px}
.meta p{margin:0}
.c1{grid-column:1/4}.c2{grid-column:4/9}.c3{grid-column:9/13}
.meta .c2 p{font-size:19px;line-height:1.55;font-weight:500;letter-spacing:-.01em}
.meta .avatar{width:100%;max-width:220px;aspect-ratio:1;object-fit:cover;filter:grayscale(1) contrast(1.05);display:block;font-size:48px}
.links{display:flex;flex-direction:column;gap:2px;font-weight:600}
.links a{text-decoration:none;border-bottom:1px solid var(--soft);padding:6px 0;display:flex;justify-content:space-between}
.links a:hover{color:var(--accent);border-color:var(--accent)}
section{padding:72px 0 0;scroll-margin-top:12px}
.sh{border-top:2px solid var(--line);padding-top:14px;margin-bottom:32px}
.sh h2{grid-column:1/4;margin:0;font-size:13px;text-transform:uppercase;letter-spacing:.08em}
.sh p{grid-column:4/13;margin:0;font-size:clamp(22px,2.6vw,34px);line-height:1.25;letter-spacing:-.03em;font-weight:700}
.pj{border-top:1px solid var(--soft);padding:28px 0}
.pj .no{grid-column:1/2;font-weight:800;font-size:14px;color:var(--accent)}
.pj .hd{grid-column:2/7}
.pj h3{margin:0 0 8px;font-size:clamp(20px,2vw,26px);line-height:1.3;letter-spacing:-.03em}
.pj .org{font-size:13px;color:var(--muted);font-weight:600}
.pj .one{margin:14px 0 0;font-size:15.5px}
.pj .bd{grid-column:7/10;font-size:14px}
.pj .bd .pts{margin:0;padding-left:16px}.pj .bd .pts li{margin:0 0 6px}
.pj .bd .stack{display:flex;flex-wrap:wrap;gap:4px 10px;margin:12px 0 0;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;color:var(--muted)}
.pj .bd .plinks{display:flex;flex-direction:column;gap:2px;margin-top:12px}
.pj .bd .plinks a{color:var(--accent);text-decoration:none;font-weight:600}.pj .bd .plinks a:hover{text-decoration:underline}
.pj .vis{grid-column:10/13;margin:0}
.vis img{width:100%;aspect-ratio:4/3;object-fit:cover;object-position:top;display:block;background:#fff;border:1px solid var(--soft)}
.vis figcaption{font-size:11.5px;color:var(--muted);margin-top:6px}
.vis.flow{border:1px solid var(--line);padding:16px;background:var(--card)}
.flow-l{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.08em;font-weight:800;color:var(--accent);margin-bottom:10px}
.vis.flow ol{list-style:none;margin:0;padding:0;font-size:13.5px;font-weight:600}
.vis.flow li{display:flex;gap:10px;padding:6px 0;border-top:1px solid var(--soft)}
.vis.flow li i{font-style:normal;color:var(--muted);width:14px}
.wl a{grid-column:4/13;display:grid;grid-template-columns:110px 1fr;gap:16px;padding:14px 0;border-top:1px solid var(--soft);text-decoration:none}
.wl a:hover b{color:var(--accent)}
.wl .d{font-size:13px;color:var(--muted);font-weight:600}
.wl b{font-size:17px;letter-spacing:-.02em}
.cv{grid-column:4/13;display:grid;grid-template-columns:1fr 1fr;gap:0 24px}
.cv h4{font-size:11.5px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin:0 0 8px}
.cv .it{border-top:1px solid var(--soft);padding:10px 0;font-size:14.5px}
.cv .it small{display:block;color:var(--muted)}
.cv .it a{text-decoration:none}.cv .it a:hover{color:var(--accent)}
footer{margin-top:96px;border-top:2px solid var(--line);padding:24px 0 56px}
footer .big{grid-column:1/9;font-size:clamp(32px,5vw,72px);font-weight:800;letter-spacing:-.05em;line-height:1}
footer .big a{text-decoration:none}footer .big a:hover{color:var(--accent)}
footer small{grid-column:9/13;align-self:end;color:var(--muted);font-size:12.5px}
@media (max-width:900px){
  .w{padding:0 18px}
  .g{grid-template-columns:1fr;gap:0}
  .c1,.c2,.c3,.sh h2,.sh p,.pj .no,.pj .hd,.pj .bd,.pj .vis,.wl a,.cv,footer .big,footer small{grid-column:1/-1}
  .top .g{grid-template-columns:1fr auto}.top .nav{display:none}.top .tl,.top .tr{grid-column:auto}
  .meta>*{margin-bottom:24px}.meta .avatar{max-width:140px}
  .sh p{margin-top:8px}
  .pj .bd,.pj .vis{margin-top:16px}
  .cv{grid-template-columns:1fr}
  .wl a{grid-template-columns:1fr;gap:2px}
  footer small{margin-top:16px}
}
</style>
</head>
<body>
<div class="top"><div class="w g"><span class="tl">{{ profile.name_en }}</span><span class="nav"><a href="#work">Work</a><a href="#writing">Writing</a><a href="#cv">CV</a><a href="#contact">Contact</a></span><span class="tr">{% if alt_lang %}<a href="{{ alt_lang.url }}">{{ alt_lang.label }}</a>{% endif %}{{ v.theme_btn('Theme') }}</span></div></div>

<header class="hero"><div class="w">
  <div class="g"><h1 class="name">Lee<br>Young-Ju<span>.</span></h1></div>
  <div class="g meta">
    <div class="c1">{{ p.avatar(profile) }}</div>
    <div class="c2"><div class="lab">{{ profile.title }} · {{ profile.name }}</div><p>{{ v.intro() }}</p></div>
    <div class="c3"><div class="lab">Links</div><div class="links"><a href="resume-1page.pdf" download>이력서 PDF <span>↓</span></a>{% for l in profile.links %}<a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }} <span>↗</span></a>{% endfor %}{% if profile.email %}<a href="mailto:{{ profile.email }}">Email <span>→</span></a>{% endif %}</div></div>
  </div>
</div></header>

<main class="w">
<section id="work">
  <div class="g sh"><h2>Selected Work</h2><p>연구에서 출발해 LLM 서비스까지, 문제를 정의하고 확인하는 방식은 같습니다.</p></div>
  {% for x in projects_index %}
  <article class="g pj">
    <span class="no">{{ '%02d'|format(loop.index) }}</span>
    <div class="hd"><h3>{{ x.title }}</h3><div class="org">{{ x.org }} · {{ x.period }} · {{ x.team }}</div><p class="one">{{ x.oneliner }}</p></div>
    <div class="bd"><ul class="pts">{% for t in x.points %}<li>{{ t }}</li>{% endfor %}</ul><div class="stack">{% for s in x.stack %}<span>{{ s }}</span>{% endfor %}</div><div class="plinks">{{ v.links(x, posts) }}</div></div>
    {{ v.visual(x) }}
  </article>
  {% endfor %}
</section>

{% if posts %}
<section id="writing">
  <div class="g sh"><h2>Writing</h2><p>프로젝트에서 내린 설계 결정과 실패를 기록합니다.</p></div>
  <div class="g wl">{% for w in posts %}<a href="posts/{{ w.slug }}.html"><span class="d">{{ w.date }}</span><b>{{ w.title }}</b></a>{% endfor %}</div>
</section>
{% endif %}

<section id="cv">
  <div class="g sh"><h2>CV</h2><p>학력 · 논문 · 수상</p></div>
  <div class="g"><div class="cv">
    <div><h4>Education</h4>{% for e in education %}<div class="it">{{ e.school }}<small>{{ e.major }} {{ e.degree }} · {{ e.period_str }}</small></div>{% endfor %}<h4 style="margin-top:24px">Awards · Certifications</h4>{% for x in awards + certifications %}<div class="it">{{ x.name }}<small>{{ x.org }} · {{ x.date }}</small></div>{% endfor %}</div>
    <div><h4>Publications</h4>{% for x in papers %}<div class="it">{% if x.url %}<a href="{{ x.url }}" target="_blank" rel="noopener">{{ x.title }}</a>{% else %}{{ x.title }}{% endif %}<small>{{ x.venue }} · {{ x.year }}</small></div>{% endfor %}<div class="it"><small>학회 발표 {{ talks|length }}건</small></div><h4 style="margin-top:24px">Skills</h4>{% for s in skills %}<div class="it">{{ s.category }}<small>{{ s['items']|join(', ') }}</small></div>{% endfor %}</div>
  </div></div>
</section>

<footer id="contact"><div class="g"><div class="big">{% if profile.email %}<a href="mailto:{{ profile.email }}">Let's talk →</a>{% else %}Let's talk.{% endif %}</div><small>© {{ profile.name_en }} · data/portfolio.yaml 에서 자동 생성 · <a href="private/index.html" rel="nofollow">Private</a></small></div></footer>
</main>
{{ p.theme_script() }}
</body>
</html>
