{% import "layouts/_parts.j2" as p %}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ profile.name }} 포트폴리오</title>
<meta name="description" content="{{ profile.title }} · {{ profile.headline }}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;900&display=swap" rel="stylesheet">
<style>
:root{--bg:#ffffff;--surface:#f7f7f8;--text:#0d0d0f;--muted:#5d5f66;--line:#e7e7ea;--accent:#0a7c66;--accent-2:#14b8a6;--on-accent:#fff;--chip:#eef2f1;--hero:#0d0d0f;--hero-text:#f4f4f5}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#0d0d0f;--surface:#17171a;--text:#f4f4f5;--muted:#a1a1aa;--line:#26262b;--accent:#2dd4bf;--accent-2:#5eead4;--on-accent:#0d0d0f;--chip:#1f2422;--hero:#000}}
:root[data-theme="dark"]{--bg:#0d0d0f;--surface:#17171a;--text:#f4f4f5;--muted:#a1a1aa;--line:#26262b;--accent:#2dd4bf;--accent-2:#5eead4;--on-accent:#0d0d0f;--chip:#1f2422;--hero:#000}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.7 "Noto Sans KR",system-ui,sans-serif;-webkit-font-smoothing:antialiased}
a{color:var(--accent)}
.wrap{max-width:1120px;margin:0 auto;padding:0 20px}
header.hero{background:var(--hero);color:var(--hero-text);position:relative;overflow:hidden}
header.hero::after{content:"";position:absolute;inset:auto -10% -40% 40%;height:520px;background:radial-gradient(closest-side,rgba(20,184,166,.35),transparent);pointer-events:none}
.topbar{display:flex;align-items:center;gap:22px;padding:24px 0;position:relative;z-index:1}
.topbar .logo{font-weight:900;margin-right:auto;letter-spacing:-.02em}
.topbar a{color:#a1a1aa;text-decoration:none;font-size:14px;font-weight:500}.topbar a:hover{color:#fff}
#theme{background:none;border:1px solid #3f3f46;color:#a1a1aa;border-radius:999px;padding:4px 12px;font:inherit;font-size:12px;cursor:pointer}
.herobody{display:grid;grid-template-columns:1fr auto;gap:40px;align-items:end;padding:80px 0 56px;position:relative;z-index:1}
.herobody .role{color:var(--accent-2);font-weight:700;letter-spacing:.08em;font-size:14px}
.herobody h1{font-size:clamp(34px,5.4vw,68px);line-height:1.08;letter-spacing:-.04em;margin:14px 0 22px;font-weight:900}
.herobody h1 span{color:var(--accent-2)}
.herobody p{color:#a1a1aa;max-width:620px;margin:0 0 28px;font-size:17px}
.herobody .avatar{width:180px;height:180px;border-radius:28px;object-fit:cover;font-size:52px;transform:rotate(3deg);box-shadow:0 20px 60px rgba(0,0,0,.5)}
.cta{display:flex;flex-wrap:wrap;gap:10px}
.hero .btn.ghost{background:transparent;color:#f4f4f5;border-color:#3f3f46}
.kpis{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #27272a;position:relative;z-index:1}
.kpis div{padding:26px 22px 30px;border-right:1px solid #27272a}
.kpis div:last-child{border-right:0}
.kpis b{display:block;font-size:30px;font-weight:900;letter-spacing:-.03em}
.kpis span{font-size:13px;color:#a1a1aa}
section{padding:96px 0 0;scroll-margin-top:20px}
.sechead{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:40px;border-bottom:2px solid var(--text);padding-bottom:16px}
.sechead h2{font-size:clamp(28px,4vw,44px);letter-spacing:-.03em;margin:0;font-weight:900;line-height:1.1}
.sechead span{color:var(--muted);font-size:14px}
.case{display:grid;grid-template-columns:1.1fr 1fr;gap:56px;align-items:center;padding:48px 0;border-bottom:1px solid var(--line)}
.case:nth-of-type(even) .visual{order:2}
.visual{border-radius:24px;background:var(--surface);aspect-ratio:4/3;display:grid;place-items:center;overflow:hidden;position:relative;border:1px solid var(--line)}
.visual img{width:100%;height:100%;object-fit:contain;background:#fff}
.visual .ph{text-align:center}
.visual .ph .ic{font-size:64px;line-height:1}
.visual .ph b{display:block;font-size:44px;font-weight:900;letter-spacing:-.03em;margin-top:10px;background:linear-gradient(90deg,var(--accent),var(--accent-2));-webkit-background-clip:text;background-clip:text;color:transparent}
.visual .ph span{color:var(--muted);font-size:14px}
.case .num{font-size:14px;font-weight:900;color:var(--accent);letter-spacing:.1em}
.case h3{font-size:clamp(22px,2.6vw,30px);line-height:1.3;letter-spacing:-.02em;margin:8px 0 10px;font-weight:900}
.case .meta{color:var(--muted);font-size:14px;margin-bottom:16px}
.case p.sum{font-size:17px;margin:0 0 18px}
.case .kpi{display:inline-flex;align-items:baseline;gap:10px;background:var(--chip);border-radius:14px;padding:10px 16px;margin-bottom:16px}
.case .kpi b{font-size:22px;color:var(--accent);font-weight:900}
.case .kpi span{font-size:13px;color:var(--muted)}
.more{background:var(--text);color:var(--bg);border:0;font:inherit;font-weight:700;font-size:14px;cursor:pointer;padding:10px 18px;border-radius:999px;display:inline-flex;align-items:center;gap:8px;margin-top:18px}
.detail{grid-column:1/-1;background:var(--surface);border-radius:20px;padding:26px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:22px}
.card h4{margin:0 0 10px;font-size:15px}
.timeline{display:grid;gap:0}
.tl{display:grid;grid-template-columns:160px 1fr;gap:20px;padding:18px 0;border-bottom:1px solid var(--line)}
.tl .when{color:var(--muted);font-size:14px;font-weight:500}
.tl b{display:block}.tl small{color:var(--muted)}
footer{padding:96px 0 48px;color:var(--muted);font-size:13px}
.contactband{margin-top:96px;background:var(--hero);color:var(--hero-text);border-radius:28px;padding:48px;display:flex;flex-wrap:wrap;gap:20px;align-items:center;justify-content:space-between}
.contactband h2{margin:0;font-size:clamp(24px,3vw,36px);letter-spacing:-.03em;font-weight:900}
.contactband .mail{display:inline-block;margin-top:8px;color:var(--accent-2);font-size:18px;font-weight:700;text-decoration:none}
.contactband .btn.ghost{background:transparent;color:#f4f4f5;border-color:#3f3f46}
.posts{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.post{display:flex;flex-direction:column;gap:10px;background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:24px;text-decoration:none;color:var(--text);transition:transform .15s,border-color .15s}
.post:hover{transform:translateY(-3px);border-color:var(--accent)}
.post .pdate{font-size:13px;color:var(--accent);font-weight:700}
.post b{font-size:19px;line-height:1.4;letter-spacing:-.02em}
.post p{margin:0;color:var(--muted);font-size:14.5px;flex:1}
.post .read{display:inline-flex;align-items:center;gap:6px;font-weight:700;font-size:14px;color:var(--accent)}
.studyband{display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between;margin-top:16px;padding:24px 28px;border-radius:22px;background:var(--hero);color:var(--hero-text);text-decoration:none}
.studyband .pdate{font-size:13px;color:var(--accent-2);font-weight:700}
.studyband b{display:block;font-size:20px;letter-spacing:-.02em;margin:4px 0}
.studyband p{margin:0;color:#a1a1aa;font-size:14.5px}
.studyband .read{display:inline-flex;align-items:center;gap:6px;font-weight:700;color:var(--accent-2)}
.postlink{display:inline-flex;margin:18px 0 0 10px;font-size:14px;font-weight:700;text-decoration:none;color:var(--accent)}
{{ p.base_css() }}
@media (max-width:900px){
  .herobody{grid-template-columns:1fr;padding:48px 0 40px}
  .herobody .avatar{width:120px;height:120px;order:-1}
  .kpis{grid-template-columns:repeat(2,1fr)}
  .kpis div:nth-child(2){border-right:0}
  .kpis div:nth-child(-n+2){border-bottom:1px solid #27272a}
  .case{grid-template-columns:1fr;gap:24px}
  .case:nth-of-type(even) .visual{order:0}
  .grid3,.posts{grid-template-columns:1fr}
  .postlink{margin-left:0;display:flex}
  .tl{grid-template-columns:1fr;gap:4px}
  .topbar a{display:none}
  .contactband{padding:32px 24px}
}
</style>
</head>
<body>
<header class="hero">
  <div class="wrap">
    <div class="topbar"><span class="logo">{{ profile.name_en }}</span><a href="#work">Work</a>{% if posts %}<a href="#writing">Writing</a>{% endif %}{% if study_notes %}<a href="study/index.html">Study</a>{% endif %}<a href="#publications">Publications</a><a href="#about">About</a><a href="#contact">Contact</a>{% if alt_lang %}<a href="{{ alt_lang.url }}" hreflang="{{ alt_lang.code }}">{{ alt_lang.label }}</a>{% endif %}<button id="theme" type="button">테마</button></div>
    <div class="herobody">
      <div>
        <div class="role">{{ profile.title|upper }} · {{ profile.name }}</div>
        <h1>지구과학 데이터를<br><span>딥러닝</span>으로 풀어냅니다.</h1>
        <p>{{ profile.summary|truncate(160) }}</p>
        <div class="cta"><a class="btn solid" href="#work">대표 프로젝트 {{ p.icon('arrow', 14) }}</a><a class="btn ghost" href="resume-1page.pdf" download>{{ p.icon('doc', 16) }} 이력서 (1장)</a><a class="btn ghost" href="resume.pdf" download>{{ p.icon('doc', 16) }} 상세 이력서</a>{% for l in profile.links if 'github' in l.label|lower or 'linkedin' in l.label|lower %}<a class="btn ghost" href="{{ l.url }}" target="_blank" rel="noopener">{{ p.link_icon(l.label) }} {{ l.label }}</a>{% endfor %}{% if profile.email %}<a class="btn ghost" href="mailto:{{ profile.email }}">{{ p.icon('mail', 16) }} 이메일</a>{% endif %}</div>
      </div>
      {{ p.avatar(profile) }}
    </div>
  </div>
  <div class="wrap"><div class="kpis">{% for h in highlights %}<div><b>{{ h.value }}</b><span>{{ h.label }}</span></div>{% endfor %}</div></div>
</header>

<main class="wrap">
  <section id="work">
    <div class="sechead"><h2>Selected Work</h2><span>{{ featured|length }}개 프로젝트 · 문제 → 역할 → 결과</span></div>
    {% for a in featured %}
    <article class="case">
      <div class="visual">{% if a.image %}<img src="{{ a.image }}" alt="{{ a.image_caption or a.title }}" loading="lazy">{% elif a.gallery %}<img src="{{ a.gallery[0].src }}" alt="{{ a.gallery[0].caption }}" loading="lazy" style="object-fit:contain;background:var(--surface)">{% else %}<div class="ph"><div class="ic">{{ a.icon }}</div>{% if a.kpi %}<b>{{ a.kpi.value }}</b><span>{{ a.kpi.label }}</span>{% endif %}</div>{% endif %}</div>
      <div>
        <div class="num">{{ '%02d'|format(loop.index) }} — {{ a.type }}</div>
        <h3>{{ a.title }}</h3>
        <div class="meta">{{ a.period_str }} · {{ a.role }}</div>
        <p class="sum">{{ a.summary }}</p>
        {% if a.kpi and (a.image or a.gallery) %}<div class="kpi"><b>{{ a.kpi.value }}</b><span>{{ a.kpi.label }}</span></div>{% endif %}
        <div class="chips">{% for t in a.tags %}<span class="chip">{{ t }}</span>{% endfor %}</div>
        <button class="more" type="button" data-expand="d-{{ a.id }}" aria-expanded="false"><span>자세히 보기</span> {{ p.icon('arrow', 14) }}</button>{% for w in posts if w.project in a.project_ids %}<a class="postlink" href="posts/{{ w.slug }}.html">✍️ 글: {{ w.title }}</a>{% endfor %}
      </div>
      <div class="detail" id="d-{{ a.id }}" hidden>{{ p.star(a) }}</div>
    </article>
    {% endfor %}
  </section>

  {% if posts %}
  <section id="writing">
    <div class="sechead"><h2>Writing</h2><span>프로젝트에서 배운 것 · {{ posts|length }}편</span></div>
    <div class="posts">{% for w in posts %}<a class="post" href="posts/{{ w.slug }}.html"><span class="pdate">{{ w.date }}</span><b>{{ w.title }}</b><p>{{ w.summary }}</p><div class="chips">{% for t in w.tags[:3] %}<span class="chip">{{ t }}</span>{% endfor %}</div><span class="read">읽기 {{ p.icon('arrow', 14) }}</span></a>{% endfor %}</div>
    {% if study_notes %}<a class="studyband" href="study/index.html"><div><span class="pdate">STUDY NOTES</span><b>SSAFY 강의 노트 {{ study_notes|length }}편 · 실습 프로그램</b><p>WEB · Django · DB · 알고리즘 · AI를 주제별로 다시 정리한 학습 공간</p></div><span class="read">학습 공간 열기 {{ p.icon('arrow', 14) }}</span></a>{% endif %}
  </section>
  {% endif %}

  <section id="publications">
    <div class="sechead"><h2>Publications</h2><span>논문 {{ papers|length }} · 학회 발표 {{ talks|length }}</span></div>
    {{ p.pubs(papers, talks) }}
  </section>

  <section id="about">
    <div class="sechead"><h2>About</h2><span>역량 · 학력 · 수상</span></div>
    <div class="grid3">{% for s in skills[:3] %}<div class="card"><h4>{{ s.category }}</h4><div class="chips">{% for i in s['items'] %}<span class="chip">{{ i }}</span>{% endfor %}</div></div>{% endfor %}</div>
    <div class="timeline" style="margin-top:32px">
      {% for e in education %}<div class="tl"><span class="when">{{ e.period_str }}</span><div><b>{{ e.school }} · {{ e.major }} {{ e.degree }}</b>{% for n in (e.notes or [])[:1] %}<small>{{ n }}</small>{% endfor %}</div></div>{% endfor %}
      {% for x in awards %}<div class="tl"><span class="when">🏆 {{ x.date }}</span><div><b>{{ x.name }}</b><small>{{ x.org }}</small></div></div>{% endfor %}
      {% for x in certifications %}<div class="tl"><span class="when">📜 자격</span><div><b>{{ x.name }}</b><small>{{ x.org }}</small></div></div>{% endfor %}
    </div>
  </section>

  <div class="contactband" id="contact"><div><h2>함께 일할 기회를 기다립니다.</h2>{% if profile.email %}<a class="mail" href="mailto:{{ profile.email }}">{{ profile.email }}</a>{% endif %}</div><div class="cta">{% if profile.email %}<a class="btn solid" href="mailto:{{ profile.email }}">{{ p.icon('mail', 16) }} 메일 보내기</a>{% endif %}{% for l in profile.links %}<a class="btn ghost" href="{{ l.url }}" target="_blank" rel="noopener">{{ p.link_icon(l.label) }} {{ l.label }}</a>{% endfor %}</div></div>
  <footer>© {{ profile.name_en }} · data/portfolio.yaml 에서 자동 생성 · <a href="private/index.html" rel="nofollow">🔒 Private</a></footer>
</main>
{{ p.theme_script() }}
</body>
</html>
