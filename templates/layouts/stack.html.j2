{% import "layouts/_parts.j2" as p %}
{% import "layouts/_v2.j2" as v %}
{% set tints = ['#eef2ff', '#ecfdf5', '#fff7ed', '#fdf2f8', '#f0f9ff', '#f7fee7', '#faf5ff'] %}
{% set tints_d = ['#1a1e2e', '#132520', '#2a1f14', '#2a1622', '#13222c', '#1d2414', '#221a2c'] %}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ profile.name }} — {{ profile.title }}</title>
<meta name="description" content="{{ profile.title }} · {{ profile.headline }}">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<style>
:root{--bg:#fafafa;--text:#18181b;--muted:#63636b;--faint:#9b9ba3;--line:#e6e6ea;--card:#fff;--ink:#18181b;--on-ink:#fafafa{% for t in tints %};--t{{ loop.index }}:{{ t }}{% endfor %}}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#0e0e10;--text:#f4f4f5;--muted:#a1a1aa;--faint:#71717a;--line:#27272a;--card:#18181b;--ink:#f4f4f5;--on-ink:#0e0e10{% for t in tints_d %};--t{{ loop.index }}:{{ t }}{% endfor %}}}
:root[data-theme="dark"]{--bg:#0e0e10;--text:#f4f4f5;--muted:#a1a1aa;--faint:#71717a;--line:#27272a;--card:#18181b;--ink:#f4f4f5;--on-ink:#0e0e10{% for t in tints_d %};--t{{ loop.index }}:{{ t }}{% endfor %}}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.7 "Pretendard Variable",Pretendard,system-ui,sans-serif;-webkit-font-smoothing:antialiased;word-break:keep-all}
a{color:inherit;text-decoration:none}
.w{max-width:1120px;margin:0 auto;padding:0 24px}
.top{position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:50;display:flex;align-items:center;gap:6px;padding:6px;border-radius:999px;background:color-mix(in srgb,var(--card) 80%,transparent);backdrop-filter:blur(14px);border:1px solid var(--line);box-shadow:0 8px 30px rgba(0,0,0,.06);font-size:14px;font-weight:600}
.top a,.top button{padding:7px 14px;border-radius:999px;color:var(--muted);background:none;border:0;font:inherit;cursor:pointer}
.top a:hover,.top button:hover{background:var(--bg);color:var(--text)}
.top .me{background:var(--ink);color:var(--on-ink)}
.top .me:hover{background:var(--ink);color:var(--on-ink)}
.hero{min-height:88vh;display:grid;place-items:center;text-align:center;padding:120px 0 40px}
.hero .avatar{width:96px;height:96px;border-radius:28px;object-fit:cover;margin:0 auto 24px;display:block;font-size:30px;box-shadow:0 12px 40px rgba(0,0,0,.12)}
.hero .k{font-size:14px;font-weight:700;color:var(--muted)}
.hero h1{font-size:clamp(40px,7vw,88px);line-height:1.04;letter-spacing:-.055em;margin:14px 0 22px;font-weight:800}
.hero h1 em{font-style:normal;color:var(--faint)}
.hero p{color:var(--muted);font-size:18px;max-width:620px;margin:0 auto 30px}
.cta{display:flex;flex-wrap:wrap;gap:10px;justify-content:center}
.btn{display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 22px;border-radius:999px;font-weight:700;font-size:15px;border:1px solid var(--line);background:var(--card)}
.btn.pri{background:var(--ink);color:var(--on-ink);border-color:var(--ink)}
.scroll{margin-top:56px;font-size:13px;color:var(--faint)}
.sec-t{text-align:center;margin:40px 0 32px}
.sec-t h2{font-size:clamp(28px,4vw,44px);letter-spacing:-.045em;margin:0}
.sec-t p{color:var(--muted);margin:6px 0 0}
.deck{position:relative;padding-bottom:40px}
.card{position:sticky;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;min-height:520px;padding:44px;border-radius:32px;border:1px solid var(--line);margin-bottom:48px;box-shadow:0 -10px 40px rgba(0,0,0,.05)}
.card .n{font-size:13px;font-weight:800;color:var(--muted);letter-spacing:.08em}
.card h3{font-size:clamp(26px,3vw,38px);line-height:1.2;letter-spacing:-.045em;margin:10px 0 14px}
.card .one{color:var(--muted);font-size:16.5px;margin:0 0 18px}
.card .pts{list-style:none;margin:0 0 18px;padding:0;font-size:14.5px}
.card .pts li{padding:8px 0;border-top:1px solid color-mix(in srgb,var(--text) 10%,transparent)}
.card .meta{font-size:13px;color:var(--muted);margin-bottom:14px}
.card .plinks{display:flex;flex-wrap:wrap;gap:8px}
.card .plinks a{font-size:13.5px;font-weight:700;padding:8px 14px;border-radius:999px;background:var(--card);border:1px solid var(--line)}
.card .plinks a:hover{border-color:var(--text)}
.vis{margin:0}
.vis img{width:100%;aspect-ratio:4/3;object-fit:cover;object-position:top;border-radius:20px;display:block;background:#fff;box-shadow:0 20px 50px rgba(0,0,0,.12)}
.vis figcaption{font-size:12.5px;color:var(--muted);margin-top:10px;text-align:center}
.vis.flow{background:var(--card);border-radius:24px;padding:28px;box-shadow:0 20px 50px rgba(0,0,0,.08)}
.flow-l{display:block;font-size:12.5px;font-weight:800;letter-spacing:.08em;color:var(--muted);margin-bottom:14px}
.vis.flow ol{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.vis.flow li{display:flex;gap:14px;align-items:center;font-weight:700;font-size:16px}
.vis.flow li i{font-style:normal;width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:var(--bg);font-size:13px;flex:none}
.posts{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.post{background:var(--card);border:1px solid var(--line);border-radius:24px;padding:24px;display:flex;flex-direction:column;gap:8px;transition:transform .2s}
.post:hover{transform:translateY(-4px)}
.post small{color:var(--faint);font-weight:600}
.post b{font-size:17px;line-height:1.45;letter-spacing:-.025em}
.info{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.info .box{background:var(--card);border:1px solid var(--line);border-radius:24px;padding:24px}
.info h4{margin:0 0 10px;font-size:14px;color:var(--muted)}
.info .it{padding:8px 0;border-top:1px solid var(--line);font-size:14.5px}
.info .it:first-of-type{border-top:0}
.info .it small{display:block;color:var(--faint);font-size:13px}
.end{text-align:center;padding:120px 0 64px}
.end h2{font-size:clamp(32px,5vw,60px);letter-spacing:-.05em;margin:0 0 14px;line-height:1.1}
.end p{color:var(--muted);margin:0 0 28px}
footer{text-align:center;color:var(--faint);font-size:13px;padding-bottom:40px}
section{scroll-margin-top:80px}
@media (max-width:860px){
  .top{font-size:13px}.top a.n{display:none}
  .hero{min-height:auto;padding-top:110px}
  .card{grid-template-columns:1fr;gap:20px;padding:26px;min-height:0;border-radius:24px;position:relative;top:auto!important}
  .posts,.info{grid-template-columns:1fr}
}
</style>
</head>
<body>
<nav class="top"><a class="me" href="#">{{ profile.name }}</a><a class="n" href="#work">작업</a>{% if posts %}<a class="n" href="#writing">글</a>{% endif %}<a class="n" href="#about">이력</a>{% if alt_lang %}<a href="{{ alt_lang.url }}">{{ alt_lang.label }}</a>{% endif %}{{ v.theme_btn() }}</nav>

<div class="w">
  <header class="hero"><div>
    {{ p.avatar(profile) }}
    <div class="k">{{ profile.title }} · {{ profile.name_en }}</div>
    <h1>데이터를 모으고,<br>모델로 검증하고,<br><em>결과로 증명합니다.</em></h1>
    <p>{{ v.intro() }}</p>
    <div class="cta"><a class="btn pri" href="#work">작업 보기</a><a class="btn" href="resume-1page.pdf" download>이력서 PDF</a>{% if profile.email %}<a class="btn" href="mailto:{{ profile.email }}">메일</a>{% endif %}</div>
    <div class="scroll">아래로 스크롤하면 프로젝트 카드가 한 장씩 쌓입니다 ↓</div>
  </div></header>

  <section id="work">
    <div class="sec-t"><h2>작업</h2><p>연구부터 LLM 서비스까지 {{ projects_index|length }}개 프로젝트</p></div>
    <div class="deck">
    {% for x in projects_index %}
      <article class="card" style="top:{{ 80 + loop.index0 * 16 }}px;background:var(--t{{ loop.index }})">
        <div>
          <div class="n">{{ '%02d'|format(loop.index) }} / {{ '%02d'|format(projects_index|length) }}</div>
          <h3>{{ x.title }}</h3>
          <p class="one">{{ x.oneliner }}</p>
          <ul class="pts">{% for t in x.points[:3] %}<li>{{ t }}</li>{% endfor %}</ul>
          <div class="meta">{{ x.org }} · {{ x.period }} · {{ x.stack|join(' · ') }}</div>
          <div class="plinks">{{ v.links(x, posts) }}</div>
        </div>
        {{ v.visual(x) }}
      </article>
    {% endfor %}
    </div>
  </section>

  {% if posts %}
  <section id="writing">
    <div class="sec-t"><h2>글</h2><p>프로젝트에서 배운 것</p></div>
    <div class="posts">{% for w in posts %}<a class="post" href="posts/{{ w.slug }}.html"><small>{{ w.date }}</small><b>{{ w.title }}</b></a>{% endfor %}</div>
  </section>
  {% endif %}

  <section id="about" style="padding-top:80px">
    <div class="sec-t"><h2>이력</h2></div>
    <div class="info">
      <div class="box"><h4>학력 · 교육</h4>{% for e in education %}<div class="it">{{ e.school }}<small>{{ e.major }} {{ e.degree }} · {{ e.period_str }}</small></div>{% endfor %}</div>
      <div class="box"><h4>논문</h4>{% for x in papers %}<div class="it">{% if x.url %}<a href="{{ x.url }}" target="_blank" rel="noopener">{{ x.title }}</a>{% else %}{{ x.title }}{% endif %}<small>{{ x.venue }} · {{ x.year }}</small></div>{% endfor %}</div>
      <div class="box"><h4>수상 · 자격</h4>{% for x in awards + certifications %}<div class="it">{{ x.name }}<small>{{ x.org }} · {{ x.date }}</small></div>{% endfor %}</div>
    </div>
  </section>

  <div class="end" id="contact"><h2>함께 일할 기회를<br>기다립니다.</h2><p>{{ profile.email }}</p><div class="cta">{% if profile.email %}<a class="btn pri" href="mailto:{{ profile.email }}">메일 보내기</a>{% endif %}{% for l in profile.links %}<a class="btn" href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }}</a>{% endfor %}</div></div>
  <footer>© {{ profile.name_en }} · data/portfolio.yaml 에서 자동 생성 · <a href="private/index.html" rel="nofollow">Private</a></footer>
</div>
{{ p.theme_script() }}
</body>
</html>
