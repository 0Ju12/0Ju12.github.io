{% import "layouts/_parts.j2" as p %}
{% import "layouts/_v2.j2" as v %}
{% set tints = ['#eef1ff', '#eafaf3', '#fff4e8', '#fdf0f6', '#ebf6fd', '#f3fae6', '#f6f0fd'] %}
{% set tints_d = ['#1a1e2e', '#132520', '#2a1f14', '#2a1622', '#13222c', '#1d2414', '#221a2c'] %}
{% set dots = ['#5b6cff', '#16a34a', '#ea7a0c', '#db2777', '#0284c7', '#65a30d', '#9333ea'] %}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ profile.name }} — {{ profile.title }}</title>
<meta name="description" content="{{ profile.title }} · {{ profile.headline }}">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<style>
:root{--bg:#f7f7f8;--text:#18181b;--muted:#5f5f68;--faint:#9b9ba3;--line:#e4e4e8;--card:#fff;--ink:#18181b;--on-ink:#fafafa;--shadow:0 1px 2px rgba(0,0,0,.04),0 18px 48px -18px rgba(0,0,0,.16){% for t in tints %};--t{{ loop.index }}:{{ t }}{% endfor %}}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#0d0d10;--text:#f4f4f5;--muted:#a1a1aa;--faint:#71717a;--line:#27272a;--card:#17171a;--ink:#f4f4f5;--on-ink:#0d0d10;--shadow:0 18px 48px -18px rgba(0,0,0,.6){% for t in tints_d %};--t{{ loop.index }}:{{ t }}{% endfor %}}}
:root[data-theme="dark"]{--bg:#0d0d10;--text:#f4f4f5;--muted:#a1a1aa;--faint:#71717a;--line:#27272a;--card:#17171a;--ink:#f4f4f5;--on-ink:#0d0d10;--shadow:0 18px 48px -18px rgba(0,0,0,.6){% for t in tints_d %};--t{{ loop.index }}:{{ t }}{% endfor %}}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.7 "Pretendard Variable",Pretendard,system-ui,sans-serif;-webkit-font-smoothing:antialiased;word-break:keep-all}
a{color:inherit;text-decoration:none}
.w{max-width:1160px;margin:0 auto;padding:0 24px}

/* 떠 있는 메뉴 */
.top{position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:50;display:flex;align-items:center;gap:2px;padding:6px;border-radius:999px;background:color-mix(in srgb,var(--card) 78%,transparent);backdrop-filter:blur(16px) saturate(1.4);border:1px solid var(--line);box-shadow:var(--shadow);font-size:14px;font-weight:600}
.top a,.top button{padding:7px 14px;border-radius:999px;color:var(--muted);background:none;border:0;font:inherit;cursor:pointer;transition:background .2s,color .2s}
.top a:hover,.top button:hover{color:var(--text)}
.top a.on{background:var(--bg);color:var(--text)}
.top .me{background:var(--ink);color:var(--on-ink);display:flex;align-items:center;gap:8px}
.top .me:hover{color:var(--on-ink)}
.top .me .avatar{width:22px;height:22px;border-radius:50%;object-fit:cover;font-size:9px}

/* 히어로 */
.hero{position:relative;min-height:92vh;display:grid;place-items:center;text-align:center;padding:120px 0 48px;isolation:isolate}
.blobs{position:absolute;inset:0;z-index:-1;overflow:hidden;pointer-events:none}
.blobs i{position:absolute;width:520px;height:520px;border-radius:50%;filter:blur(80px);opacity:.45;animation:drift 18s ease-in-out infinite alternate}
.blobs i:nth-child(1){background:var(--t1);left:-120px;top:40px;opacity:.9}
.blobs i:nth-child(2){background:var(--t3);right:-140px;top:120px;animation-delay:-6s;opacity:.9}
.blobs i:nth-child(3){background:var(--t2);left:30%;bottom:-200px;animation-delay:-12s;opacity:.9}
@keyframes drift{to{transform:translate(60px,-40px) scale(1.1)}}
@media (prefers-reduced-motion: reduce){.blobs i{animation:none}html{scroll-behavior:auto}}
.hero .avatar.big{width:104px;height:104px;border-radius:30px;object-fit:cover;margin:0 auto 22px;display:block;font-size:32px;box-shadow:var(--shadow);border:4px solid var(--card)}
.hero .k{display:inline-flex;align-items:center;gap:8px;font-size:13.5px;font-weight:700;color:var(--muted);background:var(--card);border:1px solid var(--line);border-radius:999px;padding:5px 14px 5px 10px}
.hero .k::before{content:"";width:8px;height:8px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 4px rgba(34,197,94,.18)}
.hero h1{font-size:clamp(40px,7vw,88px);line-height:1.04;letter-spacing:-.055em;margin:20px 0 22px;font-weight:800}
.hero h1 em{font-style:normal;background:linear-gradient(90deg,#5b6cff,#db2777 55%,#ea7a0c);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{color:var(--muted);font-size:18px;max-width:620px;margin:0 auto 26px}
.areas{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:0 0 30px}
.areas span{font-size:13.5px;font-weight:600;padding:6px 14px;border-radius:999px;background:var(--card);border:1px solid var(--line)}
.areas span i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:7px;vertical-align:1px}
.cta{display:flex;flex-wrap:wrap;gap:10px;justify-content:center}
.btn{display:inline-flex;align-items:center;gap:8px;height:50px;padding:0 24px;border-radius:999px;font-weight:700;font-size:15px;border:1px solid var(--line);background:var(--card);transition:transform .15s}
.btn:hover{transform:translateY(-2px)}
.btn.pri{background:var(--ink);color:var(--on-ink);border-color:var(--ink)}
.scroll{margin-top:52px;font-size:13px;color:var(--faint);display:flex;flex-direction:column;align-items:center;gap:8px}
.scroll::after{content:"";width:1px;height:36px;background:linear-gradient(var(--faint),transparent)}

/* 섹션 제목 */
section{scroll-margin-top:80px}
.sec-t{display:flex;align-items:end;justify-content:space-between;gap:20px;margin:48px 0 28px}
.sec-t h2{font-size:clamp(30px,4vw,48px);letter-spacing:-.05em;margin:0;line-height:1.1}
.sec-t p{color:var(--muted);margin:0;max-width:360px;text-align:right;font-size:15px}

/* 카드 스택 */
.deck{position:relative;padding-bottom:24px}
.card{position:sticky;display:grid;grid-template-columns:1fr 1.05fr;gap:44px;align-items:center;min-height:540px;padding:44px;border-radius:32px;border:1px solid color-mix(in srgb,var(--text) 6%,transparent);margin-bottom:56px;box-shadow:0 -12px 40px -12px rgba(0,0,0,.08);transform-origin:center top;will-change:transform}
.card .head{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.card .n{font-size:13px;font-weight:800;letter-spacing:.06em}
.card .org{font-size:12.5px;font-weight:600;color:var(--muted);background:color-mix(in srgb,var(--card) 70%,transparent);border-radius:999px;padding:3px 10px}
.card h3{font-size:clamp(26px,3vw,38px);line-height:1.2;letter-spacing:-.045em;margin:14px 0 14px}
.card .one{color:var(--muted);font-size:16.5px;margin:0 0 18px}
.card .pts{list-style:none;margin:0 0 18px;padding:0;font-size:14.5px}
.card .pts li{display:grid;grid-template-columns:20px 1fr;gap:8px;padding:8px 0;border-top:1px solid color-mix(in srgb,var(--text) 9%,transparent)}
.card .pts svg{margin-top:4px}
.card .tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px}
.card .tags span{font-size:12.5px;font-weight:600;padding:3px 10px;border-radius:8px;background:color-mix(in srgb,var(--card) 75%,transparent);color:var(--muted)}
.card .plinks{display:flex;flex-wrap:wrap;gap:8px}
.card .plinks a{font-size:13.5px;font-weight:700;padding:9px 15px;border-radius:999px;background:var(--card);border:1px solid var(--line);transition:border-color .15s}
.card .plinks a:first-child{background:var(--ink);color:var(--on-ink);border-color:var(--ink)}
.card .plinks a:hover{border-color:var(--text)}
.window{border-radius:18px;overflow:hidden;background:var(--card);box-shadow:0 30px 60px -20px rgba(0,0,0,.25);border:1px solid var(--line)}
.window .bar{display:flex;gap:6px;align-items:center;height:32px;padding:0 14px;border-bottom:1px solid var(--line)}
.window .bar i{width:10px;height:10px;border-radius:50%;background:var(--line)}
.window .bar i:nth-child(1){background:#ff5f57}.window .bar i:nth-child(2){background:#febc2e}.window .bar i:nth-child(3){background:#28c840}
.window .bar span{margin-left:8px;font-size:12px;color:var(--faint);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.vis{margin:0}
.vis img{width:100%;aspect-ratio:4/3;object-fit:cover;object-position:top;display:block;background:#fff}
.vis figcaption{font-size:12.5px;color:var(--muted);padding:10px 14px;border-top:1px solid var(--line)}
.window .vis.flow{padding:26px 26px 22px}
.flow-l{display:block;font-size:12.5px;font-weight:800;letter-spacing:.08em;color:var(--muted);margin-bottom:16px}
.vis.flow ol{list-style:none;margin:0;padding:0;display:grid;gap:10px;position:relative}
.vis.flow li{display:flex;gap:14px;align-items:center;font-weight:700;font-size:16px;padding:10px 14px;border-radius:14px;background:var(--bg)}
.vis.flow li i{font-style:normal;width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:var(--card);font-size:12.5px;flex:none;border:1px solid var(--line)}
.vis.flow li:last-child{background:var(--ink);color:var(--on-ink)}
.vis.flow li:last-child i{background:var(--on-ink);color:var(--ink);border-color:transparent}

/* 진행 표시 */
.rail{position:fixed;right:28px;top:50%;transform:translateY(-50%);z-index:40;display:flex;flex-direction:column;gap:10px;opacity:0;transition:opacity .3s;pointer-events:none}
.rail.show{opacity:1;pointer-events:auto}
.rail a{width:10px;height:10px;border-radius:50%;background:var(--line);transition:transform .2s,background .2s}
.rail a.on{transform:scale(1.5)}

/* 글 캐러셀 */
.carousel{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 32px)/3);gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 2px 18px;scrollbar-width:thin}
.post{scroll-snap-align:start;background:var(--card);border:1px solid var(--line);border-radius:26px;padding:26px;display:flex;flex-direction:column;gap:10px;min-height:250px;transition:transform .2s,box-shadow .2s}
.post:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
.post .tag{align-self:flex-start;font-size:12px;font-weight:700;padding:3px 10px;border-radius:999px}
.post b{font-size:18px;line-height:1.45;letter-spacing:-.03em}
.post p{margin:0;color:var(--muted);font-size:14px;flex:1}
.post small{color:var(--faint);font-weight:600}
.carr{display:flex;gap:8px}
.carr button{width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:var(--card);color:var(--text);font:inherit;font-size:18px;cursor:pointer}
.carr button:hover{border-color:var(--text)}

/* 이력 */
.bento{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.box{background:var(--card);border:1px solid var(--line);border-radius:26px;padding:26px}
.box.wide{grid-column:1/-1}
.box h4{margin:0 0 12px;font-size:14px;color:var(--muted);display:flex;align-items:center;gap:8px}
.box h4 i{width:8px;height:8px;border-radius:50%;display:inline-block}
.box .it{padding:9px 0;border-top:1px solid var(--line);font-size:14.5px}
.box .it:first-of-type{border-top:0}
.box .it small{display:block;color:var(--faint);font-size:13px}
.box .it a:hover{text-decoration:underline}
.skills{display:grid;grid-template-columns:repeat(2,1fr);gap:4px 28px}
.skills div{padding:8px 0;border-top:1px solid var(--line);font-size:14px}
.skills b{display:block;font-size:13px;color:var(--muted);font-weight:600}

/* 연락 */
.end{margin:120px 0 0;border-radius:36px;background:var(--ink);color:var(--on-ink);padding:72px 40px;text-align:center;position:relative;overflow:hidden;isolation:isolate}
.end::before{content:"";position:absolute;inset:-40%;z-index:-1;background:conic-gradient(from 180deg,#5b6cff33,#db277733,#ea7a0c33,#16a34a33,#5b6cff33);filter:blur(60px)}
.end h2{font-size:clamp(32px,5vw,60px);letter-spacing:-.05em;margin:0 0 14px;line-height:1.1}
.end p{opacity:.7;margin:0 0 28px}
.end .btn{background:var(--on-ink);color:var(--ink);border-color:transparent}
.end .btn.ghost{background:transparent;color:var(--on-ink);border-color:color-mix(in srgb,var(--on-ink) 30%,transparent)}
footer{text-align:center;color:var(--faint);font-size:13px;padding:32px 0 40px}
@media (max-width:900px){
  .top{font-size:13px;top:12px}.top a.n{display:none}
  .hero{min-height:auto;padding-top:104px}
  .sec-t{flex-direction:column;align-items:flex-start}.sec-t p{text-align:left}
  .card{grid-template-columns:1fr;gap:22px;padding:24px;min-height:0;border-radius:26px;position:relative;top:auto!important;transform:none!important;filter:none!important;margin-bottom:20px}
  .rail{display:none}
  .carousel{grid-auto-columns:82%}
  .bento,.skills{grid-template-columns:1fr}
  .end{padding:48px 22px;border-radius:28px}
}
</style>
</head>
<body>
<nav class="top" aria-label="메뉴"><a class="me" href="#top">{{ p.avatar(profile) }}{{ profile.name }}</a><a class="n" href="#work">작업</a>{% if posts %}<a class="n" href="#writing">글</a>{% endif %}<a class="n" href="#about">이력</a>{% if alt_lang %}<a href="{{ alt_lang.url }}">{{ alt_lang.label }}</a>{% endif %}{{ v.theme_btn() }}</nav>

<div class="w" id="top">
  <header class="hero">
    <div class="blobs" aria-hidden="true"><i></i><i></i><i></i></div>
    <div>
      {{ p.avatar(profile, 'avatar big') }}
      <span class="k">{{ profile.title }} · 함께 일할 곳을 찾고 있습니다</span>
      <h1>데이터를 모으고,<br>모델로 검증하고,<br><em>결과로 증명합니다.</em></h1>
      <p>{{ v.intro() }}</p>
      <div class="areas">{% for t, c in [('지구물리 데이터 연구', dots[0]), ('국제 공동연구', dots[1]), ('LLM · RAG 엔지니어링', dots[3]), ('딥러닝 모델링', dots[2])] %}<span><i style="background:{{ c }}"></i>{{ t }}</span>{% endfor %}</div>
      <div class="cta"><a class="btn pri" href="#work">작업 보기</a><a class="btn" href="resume-1page.pdf" download>이력서 PDF</a>{% for l in profile.links if 'github' in l.label|lower %}<a class="btn" href="{{ l.url }}" target="_blank" rel="noopener">{{ p.icon('github', 16) }} GitHub</a>{% endfor %}</div>
      <div class="scroll">스크롤하면 카드가 한 장씩 쌓입니다</div>
    </div>
  </header>

  <section id="work">
    <div class="sec-t"><h2>작업</h2><p>연구 프로젝트부터 LLM 서비스까지 — 무엇을 만들었고 어떻게 확인했는지</p></div>
    <div class="deck">
    {% for x in projects_index %}
      <article class="card" id="c{{ loop.index }}" style="top:{{ 96 + loop.index0 * 14 }}px;background:var(--t{{ loop.index }})">
        <div>
          <div class="head"><span class="n" style="color:{{ dots[loop.index0] }}">{{ '%02d'|format(loop.index) }} / {{ '%02d'|format(projects_index|length) }}</span><span class="org">{{ x.org }}</span><span class="org">{{ x.period }}</span></div>
          <h3>{{ x.title }}</h3>
          <p class="one">{{ x.oneliner }}</p>
          {% set ci = loop.index0 %}<ul class="pts">{% for t in x.points[:3] %}<li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color:{{ dots[ci] }}"><path d="M5 12.5l4.2 4.2L19 7"/></svg><span>{{ t }}</span></li>{% endfor %}</ul>
          <div class="tags">{% for s in x.stack %}<span>{{ s }}</span>{% endfor %}<span>{{ x.team }}</span></div>
          <div class="plinks">{{ v.links(x, posts) }}</div>
        </div>
        <div class="window"><div class="bar"><i></i><i></i><i></i><span>{{ x.title.split(' — ')[0] }}</span></div>{{ v.visual(x) }}</div>
      </article>
    {% endfor %}
    </div>
  </section>

  {% if posts %}
  <section id="writing">
    <div class="sec-t"><h2>글</h2><div class="carr"><button type="button" data-dir="-1" aria-label="이전 글">←</button><button type="button" data-dir="1" aria-label="다음 글">→</button></div></div>
    <div class="carousel" id="carousel">{% for w in posts %}{% set c = dots[loop.index0 % 7] %}<a class="post" href="posts/{{ w.slug }}.html"><span class="tag" style="color:{{ c }};background:color-mix(in srgb,{{ c }} 12%,transparent)">{{ (w.tags or ['글'])[0] }}</span><b>{{ w.title }}</b><p>{{ w.summary|truncate(90) }}</p><small>{{ w.date }} · 읽기 →</small></a>{% endfor %}</div>
  </section>
  {% endif %}

  <section id="about">
    <div class="sec-t"><h2>이력</h2><p>학력 · 논문 · 수상 · 기술</p></div>
    <div class="bento">
      <div class="box"><h4><i style="background:{{ dots[0] }}"></i>학력 · 교육</h4>{% for e in education %}<div class="it">{{ e.school }}<small>{{ e.major }} {{ e.degree }} · {{ e.period_str }}</small></div>{% endfor %}</div>
      <div class="box"><h4><i style="background:{{ dots[3] }}"></i>논문</h4>{% for x in papers %}<div class="it">{% if x.url %}<a href="{{ x.url }}" target="_blank" rel="noopener">{{ x.title }}</a>{% else %}{{ x.title }}{% endif %}<small>{{ x.venue }} · {{ x.year }}</small></div>{% endfor %}<div class="it"><small>학회 발표 {{ talks|length }}건</small></div></div>
      <div class="box"><h4><i style="background:{{ dots[2] }}"></i>수상 · 자격</h4>{% for x in awards + certifications %}<div class="it">{{ x.name }}<small>{{ x.org }} · {{ x.date }}</small></div>{% endfor %}</div>
      <div class="box wide"><h4><i style="background:{{ dots[1] }}"></i>기술</h4><div class="skills">{% for s in skills %}<div><b>{{ s.category }}</b>{{ s['items']|join(', ') }}</div>{% endfor %}</div></div>
    </div>
  </section>

  <div class="end" id="contact"><h2>함께 일할 기회를<br>기다립니다.</h2><p>{{ profile.email }}</p><div class="cta">{% if profile.email %}<a class="btn" href="mailto:{{ profile.email }}">메일 보내기</a>{% endif %}<a class="btn ghost" href="resume.pdf" download>상세 이력서</a>{% for l in profile.links if 'linkedin' in l.label|lower %}<a class="btn ghost" href="{{ l.url }}" target="_blank" rel="noopener">LinkedIn</a>{% endfor %}</div></div>
  <footer>© {{ profile.name_en }} · data/portfolio.yaml 에서 자동 생성{% if study_notes %} · <a href="study/index.html">학습 노트</a>{% endif %} · <a href="private/index.html" rel="nofollow">Private</a></footer>
</div>
<nav class="rail" id="rail" aria-label="프로젝트 위치">{% for x in projects_index %}<a href="#c{{ loop.index }}" style="--c:{{ dots[loop.index0] }}" aria-label="{{ x.title }}"></a>{% endfor %}</nav>
{{ p.theme_script() }}
<script>
(function(){
var cards=[].slice.call(document.querySelectorAll('.card')),rail=document.getElementById('rail'),dots=rail?[].slice.call(rail.children):[];
var deck=document.querySelector('.deck'),wide=matchMedia('(min-width:901px)'),reduce=matchMedia('(prefers-reduced-motion: reduce)');
function tick(){
  if(!wide.matches)return;
  var cur=0;
  cards.forEach(function(c,i){
    var next=cards[i+1],r=c.getBoundingClientRect();
    if(r.top<window.innerHeight*0.5)cur=i;
    if(!next||reduce.matches){c.style.transform='';c.style.filter='';return;}
    var nr=next.getBoundingClientRect(),stick=parseFloat(c.style.top)||0;
    var p=Math.min(1,Math.max(0,1-(nr.top-stick)/r.height));
    c.style.transform='scale('+(1-p*0.06)+')';c.style.filter='brightness('+(1-p*0.12)+')';
  });
  var d=deck.getBoundingClientRect();rail.classList.toggle('show',d.top<window.innerHeight*0.5&&d.bottom>window.innerHeight*0.5);
  dots.forEach(function(a,i){a.classList.toggle('on',i===cur);a.style.background=i===cur?a.style.getPropertyValue('--c'):''});
}
document.addEventListener('scroll',function(){requestAnimationFrame(tick)},{passive:true});window.addEventListener('resize',tick);tick();
var car=document.getElementById('carousel');document.querySelectorAll('.carr button').forEach(function(b){b.addEventListener('click',function(){car.scrollBy({left:car.clientWidth*0.9*(+b.dataset.dir),behavior:reduce.matches?'auto':'smooth'})})});
var links=document.querySelectorAll('.top a.n');if('IntersectionObserver' in window){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)links.forEach(function(a){a.classList.toggle('on',a.getAttribute('href')==='#'+e.target.id)})})},{rootMargin:'-45% 0px -50% 0px'});document.querySelectorAll('section[id]').forEach(function(s){io.observe(s)});}
})();
</script>
</body>
</html>
