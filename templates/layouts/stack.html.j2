{% import "layouts/_parts.j2" as p %}
{% import "layouts/_v2.j2" as v %}
{% import "_head.j2" as h %}
{# Card Stack — 석사 / 학부 / 부트캠프 3개 묶음(featured 활동)을 카드로 쌓고, 카드 안에서 세부 프로젝트를 탭으로 보여 줌 #}
{% set en = alt_lang is defined and alt_lang and alt_lang.code == 'ko' %}
{% set T = {
  'avail': 'Open to new opportunities' if en else '함께 일할 곳을 찾고 있습니다',
  'h1': 'Collect the data,<br>verify with models,<br><em>prove it with results.</em>' if en else '데이터를 모으고,<br>모델로 검증하고,<br><em>결과로 증명합니다.</em>',
  'intro': 'M.S. (2026) in geophysical data analysis with a first-author SCIE paper. Now building LLM pipelines, RAG and model ensembles at the Samsung SW·AI Academy (SSAFY). I don\'t take a model\'s answer as-is — I check it again with code and tests.' if en else v.intro(),
  'areas': ['Geophysical data research', 'International collaboration', 'LLM · RAG engineering', 'Deep learning modeling'] if en else ['지구물리 데이터 연구', '국제 공동연구', 'LLM · RAG 엔지니어링', '딥러닝 모델링'],
  'work': 'Work' if en else '작업',
  'work_sub': 'Three chapters — graduate research, undergraduate research and bootcamps. Use the tabs inside each card for individual projects.' if en else '석사 · 학부 · 부트캠프 세 묶음입니다. 카드 안의 탭에서 세부 프로젝트를 볼 수 있습니다.',
  'see': 'See work' if en else '작업 보기',
  'resume': 'Resume PDF' if en else '이력서 PDF',
  'scroll': 'Scroll — the cards stack one by one' if en else '스크롤하면 카드가 한 장씩 쌓입니다',
  'detail': 'Full story' if en else '자세히',
  'post': 'Related post' if en else '관련 글',
  'close': 'Close' if en else '닫기',
  'writing': 'Writing' if en else '글',
  'read': 'Read →' if en else '읽기 →',
  'about': 'Background' if en else '이력',
  'about_sub': 'Education · publications · awards · skills' if en else '학력 · 논문 · 수상 · 기술',
  'edu': 'Education' if en else '학력 · 교육',
  'pubs': 'Publications' if en else '논문',
  'talks': 'conference talks' if en else '학회 발표',
  'awards': 'Awards · Certifications' if en else '수상 · 자격',
  'skills': 'Skills' if en else '기술',
  'end': 'Looking forward to<br>working together.' if en else '함께 일할 기회를<br>기다립니다.',
  'mail': 'Send email' if en else '메일 보내기',
  'full': 'Full resume' if en else '상세 이력서',
  'notes': 'Study notes' if en else '학습 노트',
  'gen': 'generated from data/portfolio.yaml' if not en else 'generated from data/portfolio.en.yaml',
  'theme': 'Theme' if en else '테마',
  'roles': 'By role (1 page):' if en else '직무별 이력서(1장):',
  'r_data': 'Data Engineer' if en else '데이터 엔지니어',
  'r_ai': 'AI/ML Engineer' if en else 'AI·ML 엔지니어',
  'want': 'Looking for' if en else '희망 직무',
  'loc': 'Location' if en else '근무 지역',
  'start': 'Available' if en else '입사 가능',
  'demo': 'Demo' if en else '데모',
} %}
{% set tints = ['#eef1ff', '#eafaf3', '#fff4e8'] %}
{% set tints_d = ['#1a1e2e', '#132520', '#2a1f14'] %}
{% set dots = ['#5b6cff', '#16a34a', '#ea7a0c', '#db2777', '#0284c7', '#65a30d', '#9333ea'] %}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ profile.name }} — {{ profile.title }}</title>
{{ h.meta(profile.name ~ ' — ' ~ profile.title, ('Data & AI engineer — geophysical research to LLM pipelines and RAG.' if en else profile.headline), ('en.html' if en else ''), '', en) }}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<style>
:root{--bg:#f7f7f8;--text:#18181b;--muted:#5f5f68;--faint:#9b9ba3;--line:#e4e4e8;--card:#fff;--ink:#18181b;--on-ink:#fafafa;--shadow:0 1px 2px rgba(0,0,0,.04),0 18px 48px -18px rgba(0,0,0,.16){% for t in tints %};--t{{ loop.index }}:{{ t }}{% endfor %}}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#0d0d10;--text:#f4f4f5;--muted:#a1a1aa;--faint:#71717a;--line:#27272a;--card:#17171a;--ink:#f4f4f5;--on-ink:#0d0d10;--shadow:0 18px 48px -18px rgba(0,0,0,.6){% for t in tints_d %};--t{{ loop.index }}:{{ t }}{% endfor %}}}
:root[data-theme="dark"]{--bg:#0d0d10;--text:#f4f4f5;--muted:#a1a1aa;--faint:#71717a;--line:#27272a;--card:#17171a;--ink:#f4f4f5;--on-ink:#0d0d10;--shadow:0 18px 48px -18px rgba(0,0,0,.6){% for t in tints_d %};--t{{ loop.index }}:{{ t }}{% endfor %}}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.7 "Pretendard Variable",Pretendard,system-ui,sans-serif;-webkit-font-smoothing:antialiased;word-break:keep-all;overflow-wrap:anywhere}
a{color:inherit;text-decoration:none}
.w{max-width:1180px;margin:0 auto;padding:0 24px}

/* 떠 있는 메뉴 */
.top{position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:50;display:flex;align-items:center;gap:2px;padding:6px;border-radius:999px;background:color-mix(in srgb,var(--card) 78%,transparent);backdrop-filter:blur(16px) saturate(1.4);border:1px solid var(--line);box-shadow:var(--shadow);font-size:14px;font-weight:600;white-space:nowrap}
.top a,.top button{padding:7px 14px;border-radius:999px;color:var(--muted);background:none;border:0;font:inherit;cursor:pointer;transition:background .2s,color .2s}
.top a:hover,.top button:hover{color:var(--text)}
.top a.on{background:var(--bg);color:var(--text)}
.top .me{background:var(--ink);color:var(--on-ink);display:flex;align-items:center;gap:8px}
.top .me:hover{color:var(--on-ink)}
.top .me .avatar{width:22px;height:22px;border-radius:50%;object-fit:cover;font-size:9px}

/* 히어로 */
.hero{position:relative;min-height:92vh;display:grid;place-items:center;text-align:center;padding:120px 0 48px;isolation:isolate}
.blobs{position:absolute;inset:0;z-index:-1;overflow:hidden;pointer-events:none}
.blobs i{position:absolute;width:520px;height:520px;border-radius:50%;filter:blur(80px);opacity:.9;animation:drift 18s ease-in-out infinite alternate}
.blobs i:nth-child(1){background:var(--t1);left:-120px;top:40px}
.blobs i:nth-child(2){background:var(--t3);right:-140px;top:120px;animation-delay:-6s}
.blobs i:nth-child(3){background:var(--t2);left:30%;bottom:-200px;animation-delay:-12s}
@keyframes drift{to{transform:translate(60px,-40px) scale(1.1)}}
@media (prefers-reduced-motion: reduce){.blobs i{animation:none}html{scroll-behavior:auto}}
.hero .avatar.big{width:104px;height:104px;border-radius:30px;object-fit:cover;margin:0 auto 22px;display:block;font-size:32px;box-shadow:var(--shadow);border:4px solid var(--card)}
.hero .k{display:inline-flex;align-items:center;gap:8px;font-size:13.5px;font-weight:700;color:var(--muted);background:var(--card);border:1px solid var(--line);border-radius:999px;padding:5px 14px 5px 10px}
.hero .k::before{content:"";width:8px;height:8px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 4px rgba(34,197,94,.18)}
.hero h1{font-size:clamp(40px,7vw,88px);line-height:1.04;letter-spacing:-.055em;margin:20px 0 22px;font-weight:800}
.hero h1 em{font-style:normal;background:linear-gradient(90deg,#5b6cff,#db2777 55%,#ea7a0c);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{color:var(--muted);font-size:18px;max-width:640px;margin:0 auto 26px}
.areas{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:0 0 30px}
.areas span{font-size:13.5px;font-weight:600;padding:6px 14px;border-radius:999px;background:var(--card);border:1px solid var(--line)}
.areas span i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:7px;vertical-align:1px}
.cta{display:flex;flex-wrap:wrap;gap:10px;justify-content:center}
.btn{display:inline-flex;align-items:center;gap:8px;height:50px;padding:0 24px;border-radius:999px;font-weight:700;font-size:15px;border:1px solid var(--line);background:var(--card);color:var(--text);transition:transform .15s}
.btn:hover{transform:translateY(-2px)}
.btn.pri{background:var(--ink);color:var(--on-ink);border-color:var(--ink)}
.avail{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 18px;margin-top:22px;font-size:13.5px;color:var(--muted)}
.avail b{color:var(--faint);font-weight:600;margin-right:6px}
.avail .roles a{color:var(--text);font-weight:700;border-bottom:1px solid var(--line);margin-right:10px}
.avail .roles a:hover{border-color:var(--text)}
.scroll{margin-top:44px;font-size:13px;color:var(--faint);display:flex;flex-direction:column;align-items:center;gap:8px}
.scroll::after{content:"";width:1px;height:36px;background:linear-gradient(var(--faint),transparent)}

/* 섹션 제목 */
section{scroll-margin-top:80px}
.sec-t{display:flex;align-items:end;justify-content:space-between;gap:20px;margin:48px 0 28px}
.sec-t h2{font-size:clamp(30px,4vw,48px);letter-spacing:-.05em;margin:0;line-height:1.1}
.sec-t p{color:var(--muted);margin:0;max-width:420px;text-align:right;font-size:15px}

/* 묶음 카드 */
.deck{position:relative;padding-bottom:24px}
.card{position:sticky;display:grid;grid-template-columns:1fr 1.08fr;gap:36px;align-items:start;padding:32px 34px;border-radius:32px;border:1px solid color-mix(in srgb,var(--text) 6%,transparent);margin-bottom:64px;box-shadow:0 -12px 40px -12px rgba(0,0,0,.08);transform-origin:center top;will-change:transform}
.card.flat{position:relative;top:auto!important}
.card .head{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.card .n{font-size:13px;font-weight:800;letter-spacing:.06em;margin-right:4px}
.chip{font-size:12.5px;font-weight:600;color:var(--muted);background:color-mix(in srgb,var(--card) 70%,transparent);border-radius:999px;padding:3px 10px}
.card h3{font-size:clamp(22px,2.2vw,29px);line-height:1.25;letter-spacing:-.04em;margin:12px 0 10px}
.card .one{color:var(--muted);font-size:15px;line-height:1.65;margin:0 0 12px}
.card .pts{list-style:none;margin:0 0 12px;padding:0;font-size:13.5px}
.card .pts li{display:grid;grid-template-columns:18px 1fr;gap:6px;padding:6px 0;border-top:1px solid color-mix(in srgb,var(--text) 9%,transparent);line-height:1.6}
.card .pts svg{margin-top:4px}
.tags{display:flex;flex-wrap:wrap;gap:6px}
.tags span{font-size:12px;font-weight:600;padding:3px 10px;border-radius:8px;background:color-mix(in srgb,var(--card) 75%,transparent);color:var(--muted)}

/* 카드 안 세부 프로젝트 탭 */
.window{border-radius:20px;overflow:hidden;background:var(--card);box-shadow:0 30px 60px -20px rgba(0,0,0,.22);border:1px solid var(--line)}
.tabs{display:flex;gap:4px;padding:8px;border-bottom:1px solid var(--line);overflow-x:auto;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tabs button{flex:none;border:0;background:none;font:inherit;font-size:13.5px;font-weight:700;color:var(--muted);padding:8px 14px;border-radius:12px;cursor:pointer;white-space:nowrap}
.tabs button[aria-selected="true"]{background:var(--bg);color:var(--text)}
.tabs button i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:7px;vertical-align:1px;background:var(--line)}
.tabs button[aria-selected="true"] i{background:var(--c)}
.panel{padding:0}
.panel .shot{position:relative;background:var(--bg);border-bottom:1px solid var(--line)}
.panel .shot img{width:100%;height:190px;object-fit:cover;object-position:top;display:block;background:#fff}
.panel .shot figcaption{position:absolute;left:10px;bottom:10px;font-size:11.5px;font-weight:600;background:rgba(17,17,20,.72);color:#fff;border-radius:8px;padding:3px 9px;backdrop-filter:blur(4px);max-width:calc(100% - 20px)}
.panel .pb{padding:16px 20px 18px}
.panel h4{margin:0 0 4px;font-size:17px;line-height:1.4;letter-spacing:-.02em}
.panel .meta{font-size:12.5px;color:var(--faint);margin-bottom:10px}
.panel .sum{font-size:14px;color:var(--muted);margin:0 0 10px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.panel .res{list-style:none;margin:0 0 12px;padding:0;font-size:13px}
.panel .res li{padding:5px 0 5px 14px;position:relative;border-top:1px solid var(--line);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.panel .res li::before{content:"";position:absolute;left:0;top:14px;width:6px;height:6px;border-radius:50%;background:var(--c)}
.acts{display:flex;flex-wrap:wrap;gap:8px}
.acts a,.acts button{font:inherit;font-size:12.5px;font-weight:700;padding:7px 12px;border-radius:999px;background:var(--card);border:1px solid var(--line);color:var(--text);cursor:pointer;transition:border-color .15s}
.acts a.go{background:var(--ink);color:var(--on-ink);border-color:var(--ink)}
.acts a:hover{border-color:var(--text)}

/* 자세히 (STAR) */
{{ p.base_css() }}
.star{gap:16px}
.star dt{color:var(--muted)}
.gallery img{border-radius:12px}
.links .btn{height:auto;padding:8px 14px;font-size:13.5px}

/* 진행 표시 */
.rail{position:fixed;right:28px;top:50%;transform:translateY(-50%);z-index:40;display:flex;flex-direction:column;gap:12px;opacity:0;transition:opacity .3s;pointer-events:none}
.rail.show{opacity:1;pointer-events:auto}
.rail a{display:flex;align-items:center;justify-content:flex-end;gap:10px;font-size:12px;font-weight:700;color:var(--faint)}
.rail a span{opacity:0;transition:opacity .2s}
.rail a:hover span,.rail a.on span{opacity:1}
.rail a i{width:10px;height:10px;border-radius:50%;background:var(--line);transition:transform .2s}
.rail a.on{color:var(--text)}
.rail a.on i{transform:scale(1.4);background:var(--c)}

/* 글 캐러셀 */
.carousel{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 32px)/3);gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 2px 18px;scrollbar-width:thin}
.post{scroll-snap-align:start;background:var(--card);border:1px solid var(--line);border-radius:26px;padding:26px;display:flex;flex-direction:column;gap:10px;min-height:250px;transition:transform .2s,box-shadow .2s}
.post:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
.post .tag{align-self:flex-start;font-size:12px;font-weight:700;padding:3px 10px;border-radius:999px}
.post b{font-size:18px;line-height:1.45;letter-spacing:-.03em}
.post p{margin:0;color:var(--muted);font-size:14px;flex:1}
.post small{color:var(--faint);font-weight:600}
.carr{display:flex;gap:8px}
.carr button{width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:var(--card);color:var(--text);font:inherit;font-size:18px;cursor:pointer}
.carr button:hover{border-color:var(--text)}
.studylink{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-top:14px;padding:20px 24px;border-radius:22px;background:var(--card);border:1px solid var(--line);font-weight:700}
.studylink small{display:block;font-weight:500;color:var(--muted);font-size:13.5px}

/* 이력 */
.bento{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.box{background:var(--card);border:1px solid var(--line);border-radius:26px;padding:26px}
.box.wide{grid-column:1/-1}
.box h4{margin:0 0 12px;font-size:14px;color:var(--muted);display:flex;align-items:center;gap:8px}
.box h4 i{width:8px;height:8px;border-radius:50%;display:inline-block}
.box .it{padding:9px 0;border-top:1px solid var(--line);font-size:14.5px}
.box .it:first-of-type{border-top:0}
.box .it small{display:block;color:var(--faint);font-size:13px}
.box .it a:hover{text-decoration:underline}
.skills{display:grid;grid-template-columns:repeat(2,1fr);gap:4px 28px}
.skills div{padding:8px 0;border-top:1px solid var(--line);font-size:14px}
.skills b{display:block;font-size:13px;color:var(--muted);font-weight:600}

/* 연락 */
.end{margin:120px 0 0;border-radius:36px;background:var(--ink);color:var(--on-ink);padding:72px 40px;text-align:center;position:relative;overflow:hidden;isolation:isolate}
.end::before{content:"";position:absolute;inset:-40%;z-index:-1;background:conic-gradient(from 180deg,#5b6cff33,#db277733,#ea7a0c33,#16a34a33,#5b6cff33);filter:blur(60px)}
.end h2{font-size:clamp(32px,5vw,60px);letter-spacing:-.05em;margin:0 0 14px;line-height:1.1}
.end p{opacity:.7;margin:0 0 28px}
.end .btn{background:var(--on-ink);color:var(--ink);border-color:transparent}
.end .btn.ghost{background:transparent;color:var(--on-ink);border-color:color-mix(in srgb,var(--on-ink) 30%,transparent)}
footer{text-align:center;color:var(--faint);font-size:13px;padding:32px 0 40px}
footer a:hover{color:var(--text)}
@media (max-width:960px){
  .top{font-size:13px;top:12px}.top a.n{display:none}
  .hero{min-height:auto;padding-top:104px}
  .sec-t{flex-direction:column;align-items:flex-start}.sec-t p{text-align:left}
  .card{grid-template-columns:1fr;gap:22px;padding:22px;border-radius:26px;position:relative;top:auto!important;transform:none!important;filter:none!important;margin-bottom:20px}
  .panel .shot img{height:190px}
  .rail{display:none}
  .carousel{grid-auto-columns:82%}
  .bento,.skills{grid-template-columns:1fr}
  .end{padding:48px 22px;border-radius:28px}
}
</style>
</head>
<body>
<nav class="top" aria-label="menu"><a class="me" href="#top">{{ p.avatar(profile) }}{{ profile.name }}</a><a class="n" href="#work">{{ T.work }}</a>{% if posts %}<a class="n" href="#writing">{{ T.writing }}</a>{% endif %}<a class="n" href="#about">{{ T.about }}</a>{% if alt_lang %}<a href="{{ alt_lang.url }}" hreflang="{{ alt_lang.code }}">{{ alt_lang.label }}</a>{% endif %}<button id="theme" type="button">{{ T.theme }}</button></nav>

<div class="w" id="top">
  <header class="hero">
    <div class="blobs" aria-hidden="true"><i></i><i></i><i></i></div>
    <div>
      {{ p.avatar(profile, 'avatar big') }}
      <span class="k">{{ profile.title }} · {{ T.avail }}</span>
      <h1>{{ T.h1|safe }}</h1>
      <p>{{ T.intro }}</p>
      <div class="areas">{% for t in T.areas %}<span><i style="background:{{ [dots[0], dots[1], dots[3], dots[2]][loop.index0] }}"></i>{{ t }}</span>{% endfor %}</div>
      <div class="cta"><a class="btn pri" href="#work">{{ T.see }}</a><a class="btn" href="resume-1page.pdf" download>{{ T.resume }}</a>{% for l in profile.links if 'github' in l.label|lower %}<a class="btn" href="{{ l.url }}" target="_blank" rel="noopener">{{ p.icon('github', 16) }} GitHub</a>{% endfor %}</div>
      {% set av = profile.availability or {} %}
      <div class="avail">{% if av.role %}<span><b>{{ T.want }}</b>{{ av.role }}</span>{% endif %}{% if av.location %}<span><b>{{ T.loc }}</b>{{ av.location }}</span>{% endif %}{% if av.start %}<span><b>{{ T.start }}</b>{{ av.start }}</span>{% endif %}{% if not en %}<span class="roles"><b>{{ T.roles }}</b><a href="resume-data.pdf" download>{{ T.r_data }}</a><a href="resume-ai.pdf" download>{{ T.r_ai }}</a></span>{% endif %}</div>
      <div class="scroll">{{ T.scroll }}</div>
    </div>
  </header>

  <section id="work">
    <div class="sec-t"><h2>{{ T.work }}</h2><p>{{ T.work_sub }}</p></div>
    <div class="deck">
    {% for a in featured %}{% set ci = loop.index0 %}{% set c = dots[ci] %}
      <article class="card" id="c{{ loop.index }}" style="top:{{ 96 + ci * 14 }}px;background:var(--t{{ (ci % 3) + 1 }});--c:{{ c }}">
        <div>
          <div class="head"><span class="n" style="color:{{ c }}">{{ '%02d'|format(loop.index) }} / {{ '%02d'|format(featured|length) }}</span><span class="chip">{{ a.type }}</span><span class="chip">{{ a.period_str }}</span></div>
          <h3>{{ a.title }}</h3>
          <p class="one">{{ a.summary }}</p>
          <ul class="pts">{% for t in (a.brief or a.star.result or [])[:4] %}<li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color:{{ c }}"><path d="M5 12.5l4.2 4.2L19 7"/></svg><span>{{ t }}</span></li>{% endfor %}</ul>
          <div class="tags">{% for t in a.tags[:8] %}<span>{{ t }}</span>{% endfor %}</div>
        </div>
        {% set subs = a.projects or [a] %}
        <div class="window">
          <div class="tabs" role="tablist" aria-label="{{ a.title }}">{% for sp in subs %}<button type="button" role="tab" id="tab-{{ sp.id }}" aria-controls="pn-{{ sp.id }}" aria-selected="{{ 'true' if loop.first else 'false' }}"><i></i>{{ sp.short or sp.title }}</button>{% endfor %}</div>
          {% for sp in subs %}{% set ns = namespace(img=none) %}{% for kw in ['Fig11', '결과화면', '질의응답', '포스터발표', '현장측정'] %}{% for g in sp.gallery or [] %}{% if ns.img is none and kw in g.src %}{% set ns.img = g %}{% endif %}{% endfor %}{% endfor %}{% set img = ns.img or (sp.gallery or [])|first %}
          <div class="panel" role="tabpanel" id="pn-{{ sp.id }}" aria-labelledby="tab-{{ sp.id }}"{% if not loop.first %} hidden{% endif %}>
            {% if img %}<figure class="shot" style="margin:0"><img{% if 'ssafy-16' not in img.src %} style="object-position:center 45%"{% endif %} src="{{ img.src }}" alt="{{ img.caption }}" loading="lazy"><figcaption>{{ img.caption }}</figcaption></figure>
            {% elif loop.first and a.image %}<figure class="shot" style="margin:0"><img src="{{ a.image }}" alt="{{ a.image_caption or a.title }}" loading="lazy">{% if a.image_caption %}<figcaption>{{ a.image_caption }}</figcaption>{% endif %}</figure>{% endif %}
            <div class="pb">
              <h4>{{ sp.title }}</h4>
              <div class="meta">{{ sp.period_str }}{% if sp.org %} · {{ sp.org }}{% endif %}{% if sp.role %} · {{ sp.role }}{% endif %}{% if sp.team %} · {{ sp.team }}{% endif %}</div>
              {% if sp.summary %}<p class="sum">{{ sp.summary }}</p>{% endif %}
              <ul class="res">{% for r in (sp.star.result or [])[:2] %}<li>{{ r }}</li>{% endfor %}</ul>
              <div class="acts"><a class="go" href="projects/{{ sp.id }}{{ '-en' if en else '' }}.html">{{ T.detail }} →</a>{% if sp.case and sp.case.demo %}<a href="projects/{{ sp.id }}{{ '-en' if en else '' }}.html#demo">▶ {{ T.demo }}</a>{% endif %}{% for l in sp.links or [] %}<a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }} ↗</a>{% endfor %}{% for w in posts if w.project == sp.id %}<a href="posts/{{ w.slug }}.html" title="{{ w.title }}">✎ {{ T.post }}{% if loop.length > 1 %} {{ loop.index }}{% endif %}</a>{% endfor %}</div>
            </div>
          </div>
          {% endfor %}
        </div>
      </article>
    {% endfor %}
    </div>

  </section>

  {% if posts %}
  <section id="writing">
    <div class="sec-t"><h2>{{ T.writing }}</h2><div class="carr"><button type="button" data-dir="-1" aria-label="이전 글">←</button><button type="button" data-dir="1" aria-label="다음 글">→</button></div></div>
    <div class="carousel" id="carousel">{% for w in posts %}{% set c = dots[loop.index0 % 7] %}<a class="post" href="posts/{{ w.slug }}.html"><span class="tag" style="color:{{ c }};background:color-mix(in srgb,{{ c }} 12%,transparent)">{{ (w.tags or ['글'])[0] }}</span><b>{{ w.title }}</b><p>{{ w.summary|truncate(90) }}</p><small>{{ w.date }} · {{ T.read }}</small></a>{% endfor %}</div>
    {% if study_notes %}<a class="studylink" href="study/index.html"><span>SSAFY 강의 노트 {{ study_notes|length }}편 · 실습 프로그램<small>Web · Django · DB · 알고리즘 · AI를 주제별로 다시 정리한 학습 공간</small></span><span>→</span></a>{% endif %}
  </section>
  {% endif %}

  <section id="about">
    <div class="sec-t"><h2>{{ T.about }}</h2><p>{{ T.about_sub }}</p></div>
    <div class="bento">
      <div class="box"><h4><i style="background:{{ dots[0] }}"></i>{{ T.edu }}</h4>{% for e in education %}<div class="it">{{ e.school }}<small>{{ e.major }} {{ e.degree }} · {{ e.period_str }}</small></div>{% endfor %}</div>
      <div class="box"><h4><i style="background:{{ dots[3] }}"></i>{{ T.pubs }}</h4>{% for x in papers %}<div class="it">{% if x.url %}<a href="{{ x.url }}" target="_blank" rel="noopener">{{ x.title }}</a>{% else %}{{ x.title }}{% endif %}<small>{{ x.venue }} · {{ x.year }}</small></div>{% endfor %}<div class="it"><small>{{ T.talks }} {{ talks|length }}</small></div></div>
      <div class="box"><h4><i style="background:{{ dots[2] }}"></i>{{ T.awards }}</h4>{% for x in awards + certifications %}<div class="it">{{ x.name }}<small>{{ x.org }} · {{ x.date }}</small></div>{% endfor %}</div>
      <div class="box wide"><h4><i style="background:{{ dots[1] }}"></i>{{ T.skills }}</h4><div class="skills">{% for s in skills %}<div><b>{{ s.category }}</b>{{ s['items']|join(', ') }}</div>{% endfor %}</div></div>
    </div>
  </section>

  <div class="end" id="contact"><h2>{{ T.end|safe }}</h2><p>{{ profile.email }}</p><div class="cta">{% if profile.email %}<a class="btn" href="mailto:{{ profile.email }}">{{ T.mail }}</a>{% endif %}<a class="btn ghost" href="resume.pdf" download>{{ T.full }}</a>{% if not en %}<a class="btn ghost" href="resume-data.pdf" download>{{ T.r_data }} 이력서</a><a class="btn ghost" href="resume-ai.pdf" download>{{ T.r_ai }} 이력서</a>{% endif %}{% for l in profile.links if 'linkedin' in l.label|lower %}<a class="btn ghost" href="{{ l.url }}" target="_blank" rel="noopener">LinkedIn</a>{% endfor %}</div></div>
  <footer>© {{ profile.name_en }} · {{ T.gen }}{% if study_notes %} · <a href="study/index.html">{{ T.notes }}</a>{% endif %} · <a href="private/index.html" rel="nofollow">Private</a></footer>
</div>
<nav class="rail" id="rail" aria-label="chapters">{% for a in featured %}<a href="#c{{ loop.index }}" style="--c:{{ dots[loop.index0] }}"><span>{{ a.type }}</span><i></i></a>{% endfor %}</nav>
{{ p.theme_script() }}
<script>
(function(){
var cards=[].slice.call(document.querySelectorAll('.card')),rail=document.getElementById('rail'),dots=rail?[].slice.call(rail.children):[];
var deck=document.querySelector('.deck'),wide=matchMedia('(min-width:961px)'),reduce=matchMedia('(prefers-reduced-motion: reduce)');
function fit(){cards.forEach(function(c){if(!c.dataset.top)c.dataset.top=parseFloat(c.style.top)||0;var base=+c.dataset.top;c.style.top=Math.min(base,window.innerHeight-c.offsetHeight-16+(base-96))+'px';});}
function tick(){
  if(!wide.matches)return;
  var cur=0;
  cards.forEach(function(c,i){
    var next=cards[i+1],r=c.getBoundingClientRect();
    if(r.top<window.innerHeight*0.5)cur=i;
    if(!next||reduce.matches||c.classList.contains('flat')){c.style.transform='';c.style.filter='';return;}
    var nr=next.getBoundingClientRect(),stick=parseFloat(c.style.top)||0;
    var pr=Math.min(1,Math.max(0,1-(nr.top-stick)/r.height));
    c.style.transform='scale('+(1-pr*0.05)+')';c.style.filter='brightness('+(1-pr*0.12)+')';
  });
  var d=deck.getBoundingClientRect();rail.classList.toggle('show',d.top<window.innerHeight*0.5&&d.bottom>window.innerHeight*0.5);
  dots.forEach(function(a,i){a.classList.toggle('on',i===cur)});
}
document.addEventListener('scroll',function(){requestAnimationFrame(tick)},{passive:true});
window.addEventListener('resize',function(){fit();tick()});fit();tick();
/* 탭 */
document.querySelectorAll('.tabs').forEach(function(tl){
  var tabs=[].slice.call(tl.querySelectorAll('[role=tab]'));
  function sel(t){tabs.forEach(function(x){var on=x===t;x.setAttribute('aria-selected',on);x.tabIndex=on?0:-1;document.getElementById(x.getAttribute('aria-controls')).hidden=!on;});fit();}
  tabs.forEach(function(t,i){t.tabIndex=i?-1:0;t.addEventListener('click',function(){sel(t)});t.addEventListener('keydown',function(e){var k=e.key==='ArrowRight'?1:e.key==='ArrowLeft'?-1:0;if(k){var n=tabs[(i+k+tabs.length)%tabs.length];sel(n);n.focus();}});});
});
/* 글 넘기기 */
var car=document.getElementById('carousel');document.querySelectorAll('.carr button').forEach(function(b){b.addEventListener('click',function(){car.scrollBy({left:car.clientWidth*0.9*(+b.dataset.dir),behavior:reduce.matches?'auto':'smooth'})})});
var links=document.querySelectorAll('.top a.n');if('IntersectionObserver' in window){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)links.forEach(function(a){a.classList.toggle('on',a.getAttribute('href')==='#'+e.target.id)})})},{rootMargin:'-45% 0px -50% 0px'});document.querySelectorAll('section[id]').forEach(function(s){io.observe(s)});}
})();
</script>
</body>
</html>
