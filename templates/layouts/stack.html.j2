{% import "layouts/_parts.j2" as p %}
{% import "layouts/_v2.j2" as v %}
{% import "_head.j2" as h %}
{# Card Stack — 석사 / 학부 / 부트캠프 3개 묶음(featured 활동)을 카드로 쌓고, 카드 안에서 세부 프로젝트를 탭으로 보여 줌 #}
{% set en = alt_lang is defined and alt_lang and alt_lang.code == 'ko' %}
{% set T = {
  'avail': 'Open to new opportunities' if en else '함께 일할 곳을 찾고 있습니다',
  'h1': (pitch.h1[0] ~ '<br>' ~ pitch.h1[1] ~ '<br><em>' ~ pitch.h1[2] ~ '</em>') if pitch and pitch.h1 else ('Collect the data,<br>verify with models,<br><em>prove it with results.</em>' if en else '데이터를 모으고,<br>모델을 검증하고,<br><em>결과로 증명합니다.</em>'),
  'intro': pitch.body if pitch and pitch.body else ('I\'m an engineer who starts by asking where the data came from. I check a model\'s answer another way before relying on it, and I value being able to explain why a result is right over a result that merely looks good.' if en else '데이터가 어디서 왔는지부터 확인합니다. 모델이 낸 답은 다른 방법으로 한 번 더 검증하고, 좋아 보이는 결과보다 왜 맞는지 설명할 수 있는 결과를 더 중요하게 여깁니다.'),
  'areas': ['Geophysical data research', 'International collaboration', 'LLM · RAG engineering', 'Deep learning modeling'] if en else ['지구물리 데이터 연구', '국제 공동연구', 'LLM · RAG 엔지니어링', '딥러닝 모델링'],
  'work': 'Projects' if en else '프로젝트',
  'work_sub': 'Four chapters — graduate research, undergraduate research, bootcamps and personal projects. Use the tabs inside each card for individual projects.' if en else '석사·학부·부트캠프·개인 프로젝트, 네 묶음으로 정리했습니다. 카드 안의 탭을 누르면 세부 프로젝트가 나옵니다.',
  'see': 'See projects' if en else '프로젝트 보기',
  'resume': 'Resume PDF' if en else '이력서 PDF',
  'scroll': 'Scroll — the cards stack one by one' if en else '스크롤하면 카드가 한 장씩 쌓입니다',
  'detail': 'Full story' if en else '자세히',
  'post': 'Related post' if en else '관련 글',
  'close': 'Close' if en else '닫기',
  'writing': 'Writing' if en else '글',
  'read': 'Read →' if en else '읽기 →',
  'about': 'Background' if en else '이력',
  'about_sub': 'Education · publications · awards · skills' if en else '학력 · 논문 · 수상 · 기술',
  'edu': 'Education' if en else '학력 · 교육',
  'pubs': 'Publications' if en else '논문',
  'talks': 'conference talks' if en else '학회 발표',
  'awards': 'Awards · Certifications' if en else '수상 · 자격',
  'skills': 'Skills' if en else '기술',
  'end': 'Looking forward to<br>working together.' if en else '함께 일할 기회를<br>기다립니다.',
  'mail': 'Send email' if en else '메일 보내기',
  'full': 'Full resume' if en else '상세 이력서',
  'notes': 'Lecture notes' if en else '강의 노트',
  'gen': 'data/portfolio.yaml 에서 자동 생성' if not en else 'generated from data/portfolio.en.yaml',
  'theme': 'Theme' if en else '테마',
  'roles': 'By role (1 page):' if en else '직무별 이력서(1장):',
  'r_data': 'Data Engineer · Analyst' if en else '데이터 엔지니어·분석가',
  'r_ai': 'AI/ML Engineer' if en else 'AI·ML 엔지니어',
  'want': 'Looking for' if en else '희망 직무',
  'loc': 'Location' if en else '근무 지역',
  'start': 'Available' if en else '입사 가능',
  'demo': 'Demo' if en else '데모',
  'role_all': 'All' if en else '전체 보기',
  'role_aria': 'View by role' if en else '직무별 보기',
  'role_note': 'Order, highlights and skills are tailored to this role.' if en else '이 직무에 맞게 순서와 핵심 문장, 기술을 다시 정리한 보기입니다.',
  'ev_title': 'Where I used' if en else '근거',
  'ev_none': 'No project or post on this site mentions it yet.' if en else '이 기술이 나오는 프로젝트·글이 아직 없습니다.',
  'ev_p': 'Project' if en else '프로젝트',
  'ev_w': 'Post' if en else '글',
  'ev_hint': 'Click a skill to see where I used it' if en else '기술을 누르면 실제로 쓴 프로젝트·글이 나옵니다',
} %}
{% set tints = ['#eef1ff', '#eafaf3', '#fff4e8'] %}
{% set tints_d = ['#1a1e2e', '#132520', '#2a1f14'] %}
{% set dots = ['#5b6cff', '#16a34a', '#ea7a0c', '#db2777', '#0284c7', '#65a30d', '#9333ea'] %}
<!doctype html>
<html lang="{{ 'en' if en else 'ko' }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ profile.name }} — {{ profile.title }}</title>
{{ h.meta(profile.name ~ ' — ' ~ profile.title, profile.headline, ('en.html' if en else ''), '', en) }}
{% set ld = {'@context': 'https://schema.org', '@type': 'Person', 'name': profile.name, 'alternateName': profile.name_en, 'jobTitle': profile.title, 'description': profile.headline, 'url': 'https://0ju12.github.io/' ~ ('en.html' if en else ''), 'image': 'https://0ju12.github.io/assets/photos/profile.jpg', 'sameAs': (profile.links or [])|map(attribute='url')|list, 'alumniOf': (education or [])|map(attribute='school')|unique|list} %}<script type="application/ld+json">{{ ld|tojson }}</script>
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<style>
:root{--bg:#f7f7f8;--text:#18181b;--muted:#5f5f68;--faint:#6a6a74;--mixc:#000;--line:#e4e4e8;--card:#fff;--ink:#18181b;--on-ink:#fafafa;--shadow:0 1px 2px rgba(0,0,0,.04),0 18px 48px -18px rgba(0,0,0,.16){% for t in tints %};--t{{ loop.index }}:{{ t }}{% endfor %}}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#0d0d10;--mixc:#fff;--text:#f4f4f5;--muted:#a1a1aa;--faint:#8e8e98;--line:#27272a;--card:#17171a;--ink:#f4f4f5;--on-ink:#0d0d10;--shadow:0 18px 48px -18px rgba(0,0,0,.6){% for t in tints_d %};--t{{ loop.index }}:{{ t }}{% endfor %}}}
:root[data-theme="dark"]{--bg:#0d0d10;--mixc:#fff;--text:#f4f4f5;--muted:#a1a1aa;--faint:#8e8e98;--line:#27272a;--card:#17171a;--ink:#f4f4f5;--on-ink:#0d0d10;--shadow:0 18px 48px -18px rgba(0,0,0,.6){% for t in tints_d %};--t{{ loop.index }}:{{ t }}{% endfor %}}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.7 "Pretendard Variable",Pretendard,system-ui,sans-serif;-webkit-font-smoothing:antialiased;word-break:keep-all;overflow-wrap:anywhere}
a{color:inherit;text-decoration:none}
.w{max-width:1180px;margin:0 auto;padding:0 24px}

/* 떠 있는 메뉴 */
.top{position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:50;display:flex;align-items:center;gap:2px;padding:6px;border-radius:999px;background:color-mix(in srgb,var(--card) 78%,transparent);backdrop-filter:blur(16px) saturate(1.4);border:1px solid var(--line);box-shadow:var(--shadow);font-size:14px;font-weight:600;white-space:nowrap}
.top a,.top button{padding:7px 14px;border-radius:999px;color:var(--muted);background:none;border:0;font:inherit;cursor:pointer;transition:background .2s,color .2s}
.top a:hover,.top button:hover{color:var(--text)}
.top a.on{background:var(--bg);color:var(--text)}
.top .me{background:var(--ink);color:var(--on-ink);display:flex;align-items:center;gap:8px}
.top .me:hover{color:var(--on-ink)}
.top .me .avatar{width:22px;height:22px;border-radius:50%;object-fit:cover;font-size:9px}

/* 히어로 */
.hero{position:relative;padding:120px 0 64px;display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:48px;align-items:end}
.try{display:flex;flex-direction:column;gap:10px;padding:20px;border-radius:20px;background:var(--card);border:1px solid var(--line);text-decoration:none;color:var(--text);transition:border-color .2s,transform .2s}
.try:hover{border-color:var(--text);transform:translateY(-2px)}
.try .tl{font-size:12.5px;font-weight:700;color:var(--muted)}
.try b{font-size:17px;line-height:1.45;letter-spacing:-.02em}
.try code{display:block;font:13px/1.6 ui-monospace,Menlo,Consolas,monospace;background:var(--bg);border-radius:10px;padding:10px 12px;color:var(--text)}
.try s{color:#c2410c}
.try .tx{font-size:13.5px;color:var(--muted)}
.trys{display:flex;flex-direction:column;min-width:0;align-self:start;margin-top:86px}
.try .ops{font-size:12.5px;color:var(--muted);line-height:1.5}.try .ops b{font-size:inherit;color:var(--text);font-weight:700;letter-spacing:0}
.hero .proof-h{margin:30px 0 0;font-size:12.5px;line-height:1.4;font-weight:800;letter-spacing:.02em;color:var(--muted)}.hero .proof-h+.proof{margin-top:10px}
.try2{margin-top:10px;padding:12px 16px!important;gap:4px!important}
.hero-in{max-width:900px}
.who{display:flex;align-items:center;gap:14px;margin:0 0 30px}
.who span{display:flex;flex-direction:column;font-size:14.5px;color:var(--muted);line-height:1.45}
.who b{font-size:17px;color:var(--text);letter-spacing:-.01em}
@media (prefers-reduced-motion: reduce){html{scroll-behavior:auto}}
.hero .avatar.big{width:56px;height:56px;border-radius:16px;object-fit:cover;display:block;font-size:20px;flex:none}
.hero .k{display:inline-flex;align-items:center;gap:8px;font-size:13.5px;font-weight:700;color:var(--muted);background:var(--card);border:1px solid var(--line);border-radius:999px;padding:5px 14px 5px 10px}
.hero .k::before{content:"";width:8px;height:8px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 4px rgba(34,197,94,.18)}
.hero h1{font-size:clamp(38px,5.6vw,68px);line-height:1.08;letter-spacing:-.05em;margin:0 0 22px;font-weight:800;text-wrap:balance}
.hero h1 em{font-style:normal}
.hero p{color:var(--muted);font-size:18px;line-height:1.75;max-width:62ch;margin:0 0 30px}
.areas{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:0 0 30px}
.areas span{font-size:13.5px;font-weight:600;padding:6px 14px;border-radius:999px;background:var(--card);border:1px solid var(--line)}
.areas span i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:7px;vertical-align:1px}
.cta{display:flex;flex-wrap:wrap;gap:10px}
.proof{list-style:none;margin:26px 0 0;padding:0;max-width:680px;border-top:1px solid var(--line)}
.proof a{display:grid;grid-template-columns:72px 1fr 18px;gap:12px;align-items:baseline;padding:11px 2px;border-bottom:1px solid var(--line);font-size:15px;line-height:1.55;color:var(--text);transition:background .2s}
.proof a:hover{background:color-mix(in srgb,var(--card) 70%,transparent)}.proof a:hover i{transform:translateX(3px)}
.proof b{font-size:12.5px;font-weight:800;letter-spacing:.02em;color:var(--muted)}
.proof i{font-style:normal;color:var(--faint);transition:transform .2s}
@media (max-width:600px){.proof a{grid-template-columns:1fr 18px;gap:2px 10px}.proof b{grid-column:1/-1}}
.btn{display:inline-flex;align-items:center;gap:8px;height:50px;padding:0 24px;border-radius:999px;font-weight:700;font-size:15px;border:1px solid var(--line);background:var(--card);color:var(--text);transition:transform .15s}
.btn:hover{transform:translateY(-2px)}
.btn.pri{background:var(--ink);color:var(--on-ink);border-color:var(--ink)}
.avail{display:flex;flex-wrap:wrap;gap:6px 18px;margin-top:22px;font-size:13.5px;color:var(--muted)}
.avail b{color:var(--faint);font-weight:600;margin-right:6px}
.avail .roles a{color:var(--text);font-weight:700;border-bottom:1px solid var(--line);margin-right:10px}
.avail .roles a:hover{border-color:var(--text)}
.asklink{display:inline-flex;align-items:center;gap:8px;margin-top:22px;border:1px dashed var(--line);background:color-mix(in srgb,var(--card) 70%,transparent);color:var(--muted);font:inherit;font-size:14px;font-weight:600;padding:9px 16px;border-radius:999px;cursor:pointer}
.asklink:hover{color:var(--text);border-color:var(--text)}
.scroll{margin-top:44px;font-size:13px;color:var(--faint);display:flex;flex-direction:column;align-items:center;gap:8px}
.scroll::after{content:"";width:1px;height:36px;background:linear-gradient(var(--faint),transparent)}

/* 섹션 제목 */
section{scroll-margin-top:80px}
.sec-t{display:flex;align-items:end;justify-content:space-between;gap:20px;margin:48px 0 28px}
.sec-t h2{font-size:clamp(30px,4vw,48px);letter-spacing:-.05em;margin:0;line-height:1.1}
.sec-t p{color:var(--muted);margin:0;max-width:420px;text-align:right;font-size:15px}

/* 묶음 카드 */
.deck{position:relative;padding-bottom:24px}
.card{position:sticky;display:grid;grid-template-columns:1fr 1.08fr;gap:36px;align-items:start;padding:32px 34px;border-radius:32px;border:1px solid color-mix(in srgb,var(--text) 6%,transparent);margin-bottom:64px;box-shadow:0 -12px 40px -12px rgba(0,0,0,.08);transform-origin:center top;will-change:transform}
.card.flat{position:relative;top:auto!important}
.card .head{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.card .n{font-size:13px;font-weight:800;letter-spacing:.06em;margin-right:4px}
.chip{font-size:12.5px;font-weight:600;color:var(--muted);background:color-mix(in srgb,var(--card) 70%,transparent);border-radius:999px;padding:3px 10px}
.card h3{font-size:clamp(22px,2.2vw,29px);line-height:1.25;letter-spacing:-.04em;margin:12px 0 10px}
.card .one{color:var(--text);font-size:15.5px;font-weight:600;line-height:1.6;margin:0 0 8px}
.card .desc{color:var(--muted);font-size:14.5px;line-height:1.7;margin:0 0 14px;max-width:52ch}
.card .pts{list-style:none;margin:0 0 12px;padding:0;font-size:13.5px}
.card .pts li{display:grid;grid-template-columns:18px 1fr;gap:6px;padding:6px 0;border-top:1px solid color-mix(in srgb,var(--text) 9%,transparent);line-height:1.6}
.card .pts svg{margin-top:4px}
.tags{display:flex;flex-wrap:wrap;gap:6px}
.tags span{font-size:12px;font-weight:600;padding:3px 10px;border-radius:8px;background:color-mix(in srgb,var(--card) 75%,transparent);color:var(--muted)}

/* 카드 안 세부 프로젝트 탭 */
.window{border-radius:20px;overflow:hidden;background:var(--card);box-shadow:0 14px 28px -16px rgba(0,0,0,.22);border:1px solid var(--line)}
.tabs{display:flex;gap:4px;padding:8px;border-bottom:1px solid var(--line);overflow-x:auto;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tabs.more{-webkit-mask-image:linear-gradient(90deg,#000 85%,transparent);mask-image:linear-gradient(90deg,#000 85%,transparent)}
:focus-visible{outline:2px solid var(--text);outline-offset:3px}
.top a:focus-visible,.top button:focus-visible,.btn:focus-visible,.tabs button:focus-visible,.roleswitch button:focus-visible{outline-offset:2px;border-radius:999px}
.js .rise{opacity:0;transform:translateY(18px);transition:opacity .6s ease,transform .6s cubic-bezier(.2,.7,.2,1)}.js .rise.in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){.js .rise{opacity:1;transform:none;transition:none}}
.tabs button{flex:none;border:0;background:none;font:inherit;font-size:13.5px;font-weight:700;color:var(--muted);padding:8px 14px;border-radius:12px;cursor:pointer;white-space:nowrap}
.tabs button[aria-selected="true"]{background:var(--bg);color:var(--text)}
.tabs button i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:7px;vertical-align:1px;background:var(--line)}
.tabs button[aria-selected="true"] i{background:var(--c)}
.panel{padding:0}
.panel .shot{position:relative;background:var(--bg);border-bottom:1px solid var(--line)}
.panel .shot img{width:100%;height:190px;object-fit:cover;object-position:top;display:block;background:#fff}
/* 다크 모드: 흰 배경 그림이 튀지 않게 살짝 낮추고 테두리로 감쌈 */
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]) :is(.panel .shot img,.gallery img){filter:brightness(.86) contrast(1.04);background:#e9e9ec}}
:root[data-theme="dark"] :is(.panel .shot img,.gallery img){filter:brightness(.86) contrast(1.04);background:#e9e9ec}

.panel .shot figcaption{position:absolute;left:10px;bottom:10px;font-size:11.5px;font-weight:600;background:rgba(17,17,20,.72);color:#fff;border-radius:8px;padding:3px 9px;backdrop-filter:blur(4px);max-width:calc(100% - 20px)}
.panel .pb{padding:16px 20px 18px}
.panel h4{margin:0 0 4px;font-size:17px;line-height:1.4;letter-spacing:-.02em}
.panel .meta{font-size:12.5px;color:var(--faint);margin-bottom:10px}
.panel .sum .why{display:inline-block;font-size:11.5px;font-weight:800;color:color-mix(in srgb,var(--c) 68%,var(--mixc));background:color-mix(in srgb,var(--c) 12%,transparent);border-radius:6px;padding:0 6px;margin-right:6px;vertical-align:1px}
.panel .sum{font-size:14px;color:var(--muted);margin:0 0 10px}
.panel .res{list-style:none;margin:0 0 12px;padding:0;font-size:13px}
.panel .res li{padding:5px 0 5px 14px;position:relative;border-top:1px solid var(--line);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.panel .res li::before{content:"";position:absolute;left:0;top:14px;width:6px;height:6px;border-radius:50%;background:var(--c)}
.card .keys{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px;padding:0;list-style:none}
.card .keys li{display:inline-flex;align-items:center;gap:7px;font-size:13.5px;font-weight:650;padding:7px 12px;border-radius:999px;background:color-mix(in srgb,var(--card) 70%,transparent);border:1px solid color-mix(in srgb,var(--text) 10%,transparent)}
.card .keys li i{width:7px;height:7px;border-radius:50%;background:var(--c);flex:none}
.card .pts.rv li span{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.panel .key{display:flex;gap:8px;align-items:flex-start;font-size:13.5px;font-weight:650;margin:0 0 14px;padding:9px 12px;border-radius:12px;background:color-mix(in srgb,var(--c) 9%,transparent)}
.panel .key i{width:7px;height:7px;border-radius:50%;background:var(--c);flex:none;margin-top:7px}
.acts{display:flex;flex-wrap:wrap;gap:8px}
.acts a,.acts button{font:inherit;font-size:12.5px;font-weight:700;padding:7px 12px;border-radius:999px;background:var(--card);border:1px solid var(--line);color:var(--text);cursor:pointer;transition:border-color .15s}
.acts a.go{background:var(--ink);color:var(--on-ink);border-color:var(--ink)}
.acts a:hover{border-color:var(--text)}

/* 자세히 (STAR) */
{{ p.base_css() }}
.star{gap:16px}
.star dt{color:var(--muted)}
.gallery img{border-radius:12px}
.links .btn{height:auto;padding:8px 14px;font-size:13.5px}

/* 진행 표시 */
.rail{position:fixed;right:28px;top:50%;transform:translateY(-50%);z-index:40;display:flex;flex-direction:column;gap:12px;opacity:0;transition:opacity .3s;pointer-events:none}
.rail.show{opacity:1;pointer-events:auto}
.rail a{display:flex;align-items:center;justify-content:flex-end;gap:10px;font-size:12px;font-weight:700;color:var(--faint)}
.rail a span{opacity:0;transition:opacity .2s}
.rail a:hover span,.rail a.on span{opacity:1}
.rail a i{width:10px;height:10px;border-radius:50%;background:var(--line);transition:transform .2s}
.rail a.on{color:var(--text)}
.rail a.on i{transform:scale(1.4);background:var(--c)}

/* 글 캐러셀 */
.pinb{font-style:normal;font-size:11.5px;font-weight:700;color:var(--muted);margin-left:8px;letter-spacing:.2px}
footer .own{font-size:12px;opacity:.75}
.carousel{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 32px)/3);gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 2px 18px;scrollbar-width:thin}
.post{scroll-snap-align:start;background:var(--card);border:1px solid var(--line);border-radius:26px;padding:26px;display:flex;flex-direction:column;gap:10px;min-height:250px;transition:transform .2s,box-shadow .2s}
.post:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
.post .tag{align-self:flex-start;font-size:12px;font-weight:700;padding:3px 10px;border-radius:999px}
.post b{font-size:18px;line-height:1.45;letter-spacing:-.03em}
.post p{margin:0;color:var(--muted);font-size:14px;flex:1}
.post small{color:var(--faint);font-weight:600}
.carr{display:flex;gap:8px}
.carr button{width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:var(--card);color:var(--text);font:inherit;font-size:18px;cursor:pointer}
.carr button:hover{border-color:var(--text)}

/* 이력 */
.bento{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.box{background:var(--card);border:1px solid var(--line);border-radius:26px;padding:26px}
.box.wide{grid-column:1/-1}
.box h3,.box h4{margin:0 0 14px;font-size:17px;font-weight:700;letter-spacing:-.02em;color:var(--text);display:flex;align-items:center;gap:8px}
.box h3 i,.box h4 i{width:8px;height:8px;border-radius:50%;display:inline-block}
.box .it{padding:9px 0;border-top:1px solid var(--line);font-size:14.5px}
.box .it:first-of-type{border-top:0}
.box .it small{display:block;color:var(--faint);font-size:13px}
.box .it a:hover{text-decoration:underline}
.skills{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 40px}
.skills div{padding:18px 0 20px;border-top:1px solid var(--line);font-size:14px}
.skills b{display:flex;align-items:center;gap:8px;font-size:14.5px;color:var(--text);font-weight:700;letter-spacing:-.015em;margin:0 0 4px}
.skills b i{width:6px;height:6px;border-radius:2px;flex:none}
.skills b small{font-size:12.5px;font-weight:600;color:var(--faint);font-variant-numeric:tabular-nums}
/* 일하는 방식: 설계 → 구현 → 검증, 위쪽 선 하나로 잇는 3단 */
.flow3{list-style:none;margin:6px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 36px}
.flow3 li{position:relative;padding:26px 0 4px}
.flow3 li::before{content:"";position:absolute;left:0;right:-36px;top:5px;height:1px;background:var(--line)}
.flow3 li:last-child::before{right:0}
.flow3 li::after{content:"";position:absolute;left:0;top:0;width:7px;height:7px;border-radius:50%;background:var(--card);border:2px solid var(--wc)}
.flow3 b{display:block;font-size:16.5px;font-weight:700;letter-spacing:-.025em;line-height:1.4;color:var(--text);margin:0 0 8px;text-wrap:balance}
.flow3 span{display:block;font-size:14.5px;line-height:1.7;color:var(--muted);text-wrap:pretty}

/* 연락 */
.end{margin:120px 0 0;border-radius:36px;background:var(--ink);color:var(--on-ink);padding:72px 40px;text-align:center;position:relative;overflow:hidden;isolation:isolate}
.end::before{content:"";position:absolute;inset:-40%;z-index:-1;background:conic-gradient(from 180deg,#5b6cff33,#db277733,#ea7a0c33,#16a34a33,#5b6cff33);filter:blur(60px)}
.end h2{font-size:clamp(32px,5vw,60px);letter-spacing:-.05em;margin:0 0 14px;line-height:1.1}
.end p{opacity:.7;margin:0 0 28px}
.end .btn{background:var(--on-ink);color:var(--ink);border-color:transparent}
.end .cta{justify-content:center}.end .sub{margin:18px 0 0;font-size:13.5px;opacity:.75}.end .sub a{color:inherit;text-decoration:underline;text-underline-offset:3px}
.end .btn.ghost{background:transparent;color:var(--on-ink);border-color:color-mix(in srgb,var(--on-ink) 30%,transparent)}
footer{text-align:center;color:var(--faint);font-size:13px;padding:32px 0 40px}
footer a:hover{color:var(--text)}

/* 직무 보기 */
.rv{display:none}
body.role-all .rv-all,body.role-data .rv-data,body.role-ai .rv-ai{display:block}
body.role-all .skills.rv-all,body.role-data .skills.rv-data,body.role-ai .skills.rv-ai{display:grid}
.roleswitch{display:inline-flex;gap:4px;padding:5px;border-radius:999px;background:var(--card);border:1px solid var(--line);margin:-8px 0 22px;max-width:100%;overflow-x:auto;scrollbar-width:none}.roleswitch::-webkit-scrollbar{display:none}
.roleswitch button{flex:none;white-space:nowrap;border:0;background:none;font:inherit;font-size:14px;font-weight:700;color:var(--muted);padding:8px 16px;border-radius:999px;cursor:pointer;transition:background .2s,color .2s}
.roleswitch button[aria-pressed="true"]{background:var(--ink);color:var(--on-ink)}
.rolehead{max-width:680px;margin:0 0 30px}
.rolehead b{display:block;font-size:20px;color:var(--text);letter-spacing:-.02em;line-height:1.45}
.rolehead small{display:block;font-size:14px;color:var(--faint);margin-top:6px}
/* 기술 → 근거 */
button.ev{font:inherit;cursor:pointer;border:0;transition:background .15s,color .15s}
.tags button.ev{font-size:12px;font-weight:600;padding:3px 10px;border-radius:8px;background:color-mix(in srgb,var(--card) 75%,transparent);color:var(--muted)}
.tags button.ev:hover,.skills button.ev:hover,button.ev.on{background:var(--ink);color:var(--on-ink)}
.skills div{display:flex;flex-wrap:wrap;gap:8px 7px;align-items:center;align-content:flex-start}
.skills b{flex-basis:100%}
.skills button.ev{font-size:13px;font-weight:600;line-height:1.35;padding:6px 12px;border-radius:999px;background:var(--card);color:var(--text);border:1px solid var(--line);transition:background .15s,color .15s,border-color .15s,transform .15s}
.skills button.ev:hover{transform:translateY(-1px)}
.skills button.ev:focus-visible{outline:2px solid var(--text);outline-offset:2px}
.skills button.ev:hover,.skills button.ev.on{border-color:var(--ink)}
.evhint{margin:-4px 0 10px;font-size:13px;color:var(--faint)}
.evp{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);z-index:60;width:min(460px,calc(100% - 24px));max-height:min(60vh,420px);overflow:auto;background:var(--card);border:1px solid var(--line);border-radius:22px;box-shadow:0 24px 70px rgba(0,0,0,.28)}
.evh{position:sticky;top:0;display:flex;justify-content:space-between;align-items:center;gap:10px;padding:14px 16px 10px 20px;background:var(--card);border-bottom:1px solid var(--line);font-weight:700}
.evh small{color:var(--faint);font-weight:600;margin-left:6px}
#evx{width:32px;height:32px;border-radius:50%;border:1px solid var(--line);background:var(--bg);color:var(--text);cursor:pointer;font:inherit}
#evl{list-style:none;margin:0;padding:6px 8px 10px}
#evl li a{display:flex;gap:10px;align-items:baseline;padding:10px 12px;border-radius:12px;font-size:14.5px;line-height:1.45}
#evl li a:hover{background:var(--bg)}
#evl li a i{flex:none;font-style:normal;font-size:11.5px;font-weight:700;padding:2px 8px;border-radius:999px;background:var(--chip,#f1f1f4);color:var(--muted)}
#evl li.none{padding:12px 14px;color:var(--muted);font-size:14px}
/* 영문 페이지: 라틴 글자에 맞춘 자간·줄바꿈 */
html[lang="en"] .hero h1{letter-spacing:-.035em;font-size:clamp(36px,5.4vw,68px);line-height:1.06}
html[lang="en"] .sec-t h2{letter-spacing:-.03em}
html[lang="en"] .card h3{letter-spacing:-.02em;line-height:1.22}
html[lang="en"] body{word-break:normal;overflow-wrap:break-word;hyphens:auto}
html[lang="en"] .hero p,html[lang="en"] .card .desc,html[lang="en"] .card .one{text-wrap:pretty}
@media (max-width:960px){
  .top{font-size:13px;top:12px;max-width:calc(100vw - 24px);overflow-x:auto;scrollbar-width:none;-webkit-mask-image:linear-gradient(90deg,#000 88%,transparent);mask-image:linear-gradient(90deg,#000 88%,transparent)}.top::-webkit-scrollbar{display:none}.top a,.top button{flex:none;padding:7px 11px}.top .me{font-size:0;gap:0;padding:5px}.top .me .avatar{width:24px;height:24px}
  .hero{padding:104px 0 48px;grid-template-columns:1fr;gap:28px}.trys{margin-top:0}.try2{display:none!important}
  .sec-t{flex-direction:column;align-items:flex-start}.sec-t p{text-align:left}
  .card{grid-template-columns:1fr;gap:22px;padding:22px;border-radius:26px;position:relative;top:auto!important;transform:none!important;filter:none!important;margin-bottom:20px}
  .panel .shot img{height:190px}
  .rail{display:none}
  .carousel{grid-auto-columns:82%}
  .bento,.skills{grid-template-columns:1fr}
  .flow3{grid-template-columns:1fr;gap:0}
  .flow3 li{padding:0 0 22px 24px}
  .flow3 li:last-child{padding-bottom:2px}
  .flow3 li::before{left:5px;right:auto;top:12px;bottom:-2px;width:1px;height:auto}
  .flow3 li:last-child::before{display:none}
  .flow3 li::after{top:4px}
  .end{padding:48px 22px;border-radius:28px}
}
/* Reading-first portfolio layout for local review. */
.card{position:relative!important;top:auto!important;transform:none!important;opacity:1!important;border-radius:18px;box-shadow:none;margin-bottom:28px}
.rail{display:none!important}.hero h1{letter-spacing:-.035em}.btn{border-radius:10px}
#selected-cases article{border-radius:14px!important}#work .sec-t p{max-width:580px}

/* ── 가독성 다듬기 (2026-11-25): 훑어볼 때 제목·핵심 숫자가 먼저 보이게 ── */
:root{--muted:#52525b}
.num{font-weight:800;color:var(--text);font-variant-numeric:tabular-nums}
.sec-t{margin:64px 0 26px}
.sec-t p{color:var(--muted)}
/* 히어로: 직접 내린 판단 3가지 */
.hero .proof-h{font-size:13px;color:var(--text);letter-spacing:0}
.proof{border-top:0;display:grid;gap:8px;max-width:700px}
.proof a{grid-template-columns:62px 1fr 18px;align-items:start;padding:14px 16px 14px 14px;border:1px solid var(--line);border-radius:16px;background:var(--card);font-size:14.5px;line-height:1.6;color:var(--muted);transition:border-color .2s,transform .2s,box-shadow .2s}
.proof a:hover{background:var(--card);border-color:color-mix(in srgb,var(--c) 45%,var(--line));transform:translateY(-1px);box-shadow:var(--shadow)}
.proof b.lab{justify-self:start;margin-top:1px;font-size:12px;font-weight:800;letter-spacing:.01em;padding:2px 9px;border-radius:999px;color:color-mix(in srgb,var(--c) 68%,var(--mixc));background:color-mix(in srgb,var(--c) 13%,transparent)}
.proof em{display:block;font-style:normal;font-weight:700;font-size:15.5px;color:var(--text);letter-spacing:-.015em;margin:0 0 2px}
.proof .num{color:color-mix(in srgb,var(--c) 72%,var(--mixc))}
.proof i{margin-top:2px}
@media (max-width:600px){.proof a{grid-template-columns:1fr 18px}.proof b.lab{grid-column:1/-1;margin-bottom:4px}}
/* 먼저 볼 프로젝트 */
.sc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,270px),1fr));gap:14px}
.sc{position:relative;display:flex;flex-direction:column;gap:0;padding:22px 22px 20px;border:1px solid var(--line);border-radius:20px;background:var(--card);min-width:0;overflow:hidden;transition:transform .2s,box-shadow .2s,border-color .2s}
.sc::before{content:"";position:absolute;inset:0 0 auto 0;height:4px;background:var(--c)}
.sc:hover{transform:translateY(-3px);box-shadow:var(--shadow);border-color:color-mix(in srgb,var(--c) 40%,var(--line))}
.sc .sc-k{display:flex;align-items:center;gap:10px;font-size:12.5px;font-weight:700;color:var(--muted)}
.sc .sc-n{font-size:13px;font-weight:800;color:color-mix(in srgb,var(--c) 75%,var(--mixc));font-variant-numeric:tabular-nums}
.sc h3{font-size:21px;line-height:1.3;letter-spacing:-.03em;margin:12px 0 8px}
.sc h3 a::after{content:"";position:absolute;inset:0}
.sc .sc-t{font-size:14.5px;line-height:1.6;color:var(--muted);margin:0}
.sc .sc-r{font-size:12.5px;color:var(--faint);margin:10px 0 0}
.sc .sc-key{margin:16px 0 0;padding:12px 14px;border-radius:14px;background:color-mix(in srgb,var(--c) 8%,var(--card));font-size:14px;line-height:1.6;color:var(--text)}
.sc .sc-key small{display:block;font-size:11.5px;font-weight:800;letter-spacing:.04em;color:color-mix(in srgb,var(--c) 70%,var(--mixc));margin:0 0 3px}
.sc .sc-key .num{font-size:15px;color:color-mix(in srgb,var(--c) 78%,var(--mixc))}
.sc .sc-go{margin-top:auto;padding-top:16px;font-size:14px;font-weight:700;color:var(--text);display:inline-flex;gap:6px;align-items:center}
.sc .sc-go i{font-style:normal;transition:transform .2s}.sc:hover .sc-go i{transform:translateX(3px)}
/* 글 */
.carousel{scrollbar-width:none;padding-bottom:6px}.carousel::-webkit-scrollbar{display:none}
.post{position:relative;overflow:hidden;border-radius:22px;padding:24px;gap:10px;min-height:240px}
.post::before{content:"";position:absolute;inset:0 auto 0 0;width:4px;background:var(--c);opacity:.85}
.post .ptop{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.post .pinb{margin-left:0;color:#b45309;font-size:11.5px}
.post>b{font-size:18.5px;font-weight:750;line-height:1.42}
.post p b.num,.proof span b.num,.sc .sc-key b.num{letter-spacing:0;line-height:inherit}
.post p b.num,.proof span b.num{font-size:inherit}
.post p{flex:none;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;font-size:14px;line-height:1.65}
.post p .num{font-weight:700}
.post small{margin-top:auto;display:flex;justify-content:space-between;align-items:center;padding-top:12px;border-top:1px solid var(--line)}
/* 기술: 분류마다 색 */
.skills div{padding:20px 0 22px}
.skills b{font-size:15.5px}
.skills b i{width:9px;height:9px;border-radius:3px;background:var(--c)!important}
.skills b small{background:color-mix(in srgb,var(--c) 12%,transparent);color:color-mix(in srgb,var(--c) 70%,var(--mixc));padding:0 8px;border-radius:999px;font-size:12px;line-height:1.6}
.skills button.ev{background:color-mix(in srgb,var(--c) 7%,var(--card));border-color:color-mix(in srgb,var(--c) 24%,var(--line));color:var(--text)}
.skills button.ev:hover,.skills button.ev.on{background:var(--c);border-color:var(--c);color:#fff}

/* ── 프로젝트 합치기 + 디자인 정리 (2026-11-25) ── */
.hero{grid-template-columns:minmax(0,1fr);padding:116px 0 40px}
.hero-in{max-width:860px}
.hero p.lede{font-size:17.5px}
.avail{margin-top:20px}
.live{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:26px 0 0;padding:14px 0 0;border-top:1px solid var(--line)}
.live-h{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:700;color:var(--text);margin-right:6px}
.live-h i{width:8px;height:8px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 4px rgba(34,197,94,.18)}
.live a{display:inline-flex;align-items:center;gap:5px;font-size:13.5px;font-weight:600;padding:6px 12px;border-radius:999px;background:var(--card);border:1px solid var(--line);color:var(--text);transition:border-color .2s,transform .2s}
.live a i{font-style:normal;color:var(--faint);font-size:12px}
.live a:hover{border-color:var(--text);transform:translateY(-1px)}
#work .sec-t{margin-top:40px}
.themes{display:flex;flex-direction:column;gap:18px}
body.role-data .th{order:var(--o-data,9)}body.role-ai .th{order:var(--o-ai,9)}
.th{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.08fr);gap:28px;padding:28px;border:1px solid var(--line);border-radius:24px;background:var(--card);overflow:hidden}
.th::before{content:"";position:absolute;inset:0 auto 0 0;width:5px;background:var(--c)}
.th-k{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:700;color:var(--muted)}
.th-n{font-size:13px;font-weight:800;color:color-mix(in srgb,var(--c) 75%,var(--mixc));font-variant-numeric:tabular-nums;padding:2px 9px;border-radius:999px;background:color-mix(in srgb,var(--c) 12%,transparent)}
.th h3{font-size:clamp(22px,2.4vw,28px);line-height:1.25;letter-spacing:-.035em;margin:14px 0 10px}
.th-lead{margin:0;font-size:15.5px;line-height:1.7;color:var(--muted)}
.th-m{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin:22px 0 0}
.th-m div{padding:12px 14px;border-radius:14px;background:color-mix(in srgb,var(--c) 8%,var(--card))}
.th-m dt{font-size:21px;font-weight:800;letter-spacing:-.03em;line-height:1.2;color:color-mix(in srgb,var(--c) 78%,var(--mixc));font-variant-numeric:tabular-nums}
.th-m dd{margin:4px 0 0;font-size:12.5px;line-height:1.45;color:var(--muted)}
.th-links{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0 0}
.th-links a{display:inline-flex;align-items:center;gap:6px;font-size:14px;font-weight:700;padding:9px 16px;border-radius:999px;border:1px solid var(--line);background:var(--card);color:var(--text);transition:transform .15s,border-color .15s}
.th-links a.pri{background:var(--ink);color:var(--on-ink);border-color:var(--ink)}
.th-links a:hover{transform:translateY(-1px);border-color:var(--text)}
.th-links a i{font-style:normal}
.th-side{display:flex;flex-direction:column;gap:12px;min-width:0}
.th-img{margin:0;border-radius:16px;overflow:hidden;border:1px solid var(--line);aspect-ratio:16/7;background:var(--bg)}
.th-img img{width:100%;height:100%;object-fit:cover;display:block}
.th-rows{list-style:none;margin:0;padding:0;display:grid;gap:8px}
.th-rows a{display:grid;grid-template-columns:minmax(0,1fr) 16px;gap:4px 10px;padding:12px 14px;border-radius:14px;border:1px solid var(--line);transition:border-color .2s,background .2s}
.th-rows a:hover{border-color:color-mix(in srgb,var(--c) 50%,var(--line));background:color-mix(in srgb,var(--c) 4%,var(--card))}
.th-rt{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 8px}
.th-rt b{font-size:15px;letter-spacing:-.015em;line-height:1.4}
.th-rt small{font-size:12px;color:var(--faint);font-variant-numeric:tabular-nums}
.th-rx{grid-column:1;font-size:13.5px;line-height:1.6;color:var(--muted)}
.th-rx b.num{color:color-mix(in srgb,var(--c) 75%,var(--mixc));font-size:inherit}
.th-rows i{grid-column:2;grid-row:1;font-style:normal;color:var(--faint);transition:transform .2s}
.th-rows a:hover i{transform:translateX(3px);color:var(--text)}
.others{margin:22px 0 0}
.others h3{font-size:15px;margin:0 0 10px;color:var(--muted);font-weight:700}
.others ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.others a{display:grid;grid-template-columns:minmax(0,1fr) 16px;gap:2px 10px;padding:12px 16px;border-radius:14px;background:var(--card);border:1px solid var(--line);transition:border-color .2s}
.others a:hover{border-color:var(--text)}
.others b{font-size:14.5px;line-height:1.4}
.others span{grid-column:1;font-size:12.5px;color:var(--faint)}
.others i{grid-column:2;grid-row:1/3;align-self:center;font-style:normal;color:var(--faint)}
@media (max-width:900px){.th{grid-template-columns:1fr;padding:22px 20px 22px 24px;gap:20px}.others ul{grid-template-columns:1fr}}
@media (max-width:600px){.hero{padding:96px 0 32px}.th-m dt{font-size:19px}}
</style>
</head>
<body class="role-all">
<nav class="top" aria-label="menu"><a class="me" href="#top">{{ p.avatar(profile) }}{{ profile.name }}</a><a class="n" href="#work">{{ T.work }}</a>{% if posts %}<a class="n" href="#writing">{{ T.writing }}</a>{% endif %}<a class="n" href="#about">{{ T.about }}</a><a class="n" href="#map">{{ 'Map' if en else '지도' }}</a>{% if alt_lang %}<a href="{{ alt_lang.url }}" hreflang="{{ alt_lang.code }}">{{ alt_lang.label }}</a>{% endif %}</nav>

<div class="w" id="top">
  <header class="hero">
    <div class="hero-in">
      <div class="who">{{ p.avatar(profile, 'avatar big') }}<span><b>{{ profile.name }}</b>{{ profile.title }}{% if profile.background %} · {{ profile.background }}{% endif %} · {{ T.avail }}</span></div>
      <h1>{{ T.h1|safe }}</h1>
      {% set RV = {} if en else (role_variants or {}) %}
      <p class="rv rv-all lede">{{ T.intro }}</p>
      {% for k, rv in RV.items() %}<p class="rv rv-{{ k }} rolehead"><b>{{ rv.headline }}</b><small>{{ T.role_note }}</small></p>{% endfor %}
      <div class="cta"><a class="btn pri" href="#work">{{ T.see }}</a><a class="btn" id="resume-btn" href="resume-1page.pdf" data-all="resume-1page.pdf"{% for k in RV %} data-{{ k }}="resume-{{ k }}.pdf"{% endfor %} download>{{ T.resume }}</a>{% for l in profile.links if 'github' in l.label|lower %}<a class="btn" href="{{ l.url }}" target="_blank" rel="noopener">{{ p.icon('github', 16) }} GitHub</a>{% endfor %}</div>
      {% set av = profile.availability or {} %}
      <div class="avail">{% if av.role %}<span><b>{{ T.want }}</b>{{ av.role }}</span>{% endif %}{% if av.location %}<span><b>{{ T.loc }}</b>{{ av.location }}</span>{% endif %}{% if av.start %}<span><b>{{ T.start }}</b>{{ av.start }}</span>{% endif %}</div>
      {% set LV = (showcase or {}).live or [] %}{% if LV %}<div class="live"><span class="live-h"><i></i>{{ 'Running every day' if en else '지금 매일 돌아가는 대시보드' }}</span>{% for l in LV %}<a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label_en if en and l.label_en else l.label }}<i aria-hidden="true">↗</i></a>{% endfor %}</div>{% endif %}
    </div>
  </header>

  {% include "_showcase.j2" %}

  {% if posts %}
  <section id="writing">
    <div class="sec-t"><h2>{{ T.writing }}</h2><div class="carr"><button type="button" data-dir="-1" aria-label="이전 글">←</button><button type="button" data-dir="1" aria-label="다음 글">→</button></div></div>
    {% set pins = ['2026-11-rag-citation-verify', '2026-11-vqa-ensemble-fixes-breaks', '2026-11-wavenumber-correlation'] %}{% set ordered = [] %}{% for sl in pins %}{% for w in posts if w.slug == sl %}{% set _ = ordered.append(w) %}{% endfor %}{% endfor %}{% for w in posts if w.slug not in pins %}{% set _ = ordered.append(w) %}{% endfor %}
    <div class="carousel" id="carousel">{% for w in ordered %}{% set c = dots[loop.index0 % 7] %}<a class="post" href="posts/{{ w.slug }}.html" style="--c:{{ c }}"><span class="ptop"><span class="tag" style="color:color-mix(in srgb,{{ c }} 62%,var(--mixc));background:color-mix(in srgb,{{ c }} 12%,transparent)">{{ (w.tags or ['글'])[0] }}</span>{% if w.slug in pins %}<i class="pinb">{{ '★ Featured' if en else '★ 대표 글' }}</i>{% endif %}</span><b>{{ w.title }}</b><p>{{ w.summary|truncate(110)|hl }}</p><small>{{ w.date }}{% if w.minutes and not en %} · {{ w.minutes }}분{% endif %} · {{ T.read }}</small></a>{% endfor %}</div>
    {% if trend_posts and not en %}<p style="margin:14px 0 0;font-size:14.5px"><a href="posts/ai-trend.html" style="font-weight:700">AI 트렌드 노트 · {{ trend_posts|length }}편 →</a> <span style="color:var(--muted)">에이전트 개념부터 순서대로 정리한 학습 노트입니다{% if (trend_posts|last).date %} (최근 {{ (trend_posts|last).date }}){% endif %}</span></p>{% endif %}
    <p style="margin:8px 0 0;font-size:14.5px"><a href="learning-demo.html" style="font-weight:700">{{ 'Algorithm study app (public demo) →' if en else '알고리즘 학습 앱 공개 체험 →' }}</a></p>
  </section>
  {% endif %}

  <section id="about">
    <div class="sec-t"><h2>{{ T.about }}</h2><p>{{ T.about_sub }}</p></div>
    <div class="bento">
      <div class="box"><h3><i style="background:{{ dots[0] }}"></i>{{ T.edu }}</h3>{% for e in education %}<div class="it">{{ e.school }}<small>{{ e.major }} {{ e.degree }} · {{ e.period_str }}</small></div>{% endfor %}</div>
      <div class="box"><h3><i style="background:{{ dots[3] }}"></i>{{ T.pubs }}</h3>{% for x in papers %}<div class="it">{% if x.url %}<a href="{{ x.url }}" target="_blank" rel="noopener">{{ x.title }}</a>{% else %}{{ x.title }}{% endif %}<small>{{ x.venue }} · {{ x.year }}</small></div>{% endfor %}<div class="it"><small>{{ T.talks }} {{ talks|length }}</small></div></div>
      <div class="box"><h3><i style="background:{{ dots[2] }}"></i>{{ T.awards }}</h3>{% for x in awards + certifications %}<div class="it">{{ x.name }}<small>{{ x.org }} · {{ x.date }}</small></div>{% endfor %}</div>
      {% if workstyle %}<div class="box wide"><h3><i style="background:{{ dots[4] }}"></i>{{ 'How I work' if en else '일하는 방식' }}</h3><ol class="flow3" style="--wc:{{ dots[4] }}">{% for w in workstyle %}{% set parts = w.split(': ', 1) %}<li>{% if parts|length == 2 %}<b>{{ parts[0] }}</b><span>{{ parts[1] }}</span>{% else %}<span>{{ w }}</span>{% endif %}</li>{% endfor %}</ol></div>{% endif %}
      <div class="box wide"><h3><i style="background:{{ dots[1] }}"></i>{{ T.skills }}</h3><p class="evhint">{{ T.ev_hint }}</p><div class="skills rv rv-all">{% for s in skills %}<div style="--c:{{ dots[loop.index0 % 7] }}"><b><i style="background:{{ dots[loop.index0 % 7] }}"></i>{{ s.category }}<small>{{ s['items']|length }}</small></b>{% for i in s['items'] %}<button type="button" class="ev">{{ i }}</button>{% endfor %}</div>{% endfor %}</div>{% for k, rv in RV.items() %}<div class="skills rv rv-{{ k }}">{% for s in rv.skills %}<div style="--c:{{ dots[loop.index0 % 7] }}"><b><i style="background:{{ dots[loop.index0 % 7] }}"></i>{{ s.category }}<small>{{ s['items']|length }}</small></b>{% for i in s['items'] %}<button type="button" class="ev">{{ i }}</button>{% endfor %}</div>{% endfor %}</div>{% endfor %}</div>
    </div>
  </section>

  {% include "_map.j2" %}

  <div class="end" id="contact"><h2>{{ T.end|safe }}</h2><p>{{ profile.email }}</p><div class="cta">{% if profile.email %}<a class="btn" href="mailto:{{ profile.email }}">{{ T.mail }}</a>{% endif %}<a class="btn ghost" href="resume.pdf" download>{{ T.full }}</a>{% for l in profile.links if 'linkedin' in l.label|lower %}<a class="btn ghost" href="{{ l.url }}" target="_blank" rel="noopener">LinkedIn</a>{% endfor %}</div><p class="sub">{% if en %}Also: <a href="resume-1page-en.pdf" download>one-page résumé</a> · <a href="brief-en.html">30-second brief</a>{% else %}직무별 1쪽 이력서: <a href="resume-data.pdf" download>{{ T.r_data }}</a> · <a href="resume-ai.pdf" download>{{ T.r_ai }}</a> · <a href="brief.html">30초 소개</a>{% endif %}</p></div>
  <footer>© {{ profile.name_en if en else profile.name }} · {{ T.gen }} · <button id="theme" type="button" style="font:inherit;color:inherit;background:none;border:0;padding:0;text-decoration:underline;cursor:pointer">{{ T.theme }}</button><br><span class="own" hidden>{{ 'Owner only (locked)' if en else '본인용 (잠김)' }} — {% if study_notes or interview_ready %}<a href="study/index.html" rel="nofollow">{{ 'Prep space (study · interview)' if en else '준비 공간 (공부·면접)' }}</a> · {% endif %}<a href="desk/index.html" rel="nofollow">{{ 'Personal assistant' if en else '개인 비서 업무실' }}</a> · <a href="private/index.html" rel="nofollow">{{ 'Private files' if en else '비공개 자료' }}</a></span></footer>
</div>
<div class="evp" id="evp" role="dialog" aria-modal="false" aria-labelledby="evt" hidden><div class="evh"><span id="evt"></span><button type="button" id="evx" aria-label="{{ T.close }}">✕</button></div><ul id="evl"></ul></div>
<script type="application/json" id="ev-data">{{ evidence|default([])|tojson }}</script>
{% set ro = {} %}{% for k, rv in (RV or {}).items() %}{% set _ = ro.update({k: rv.order}) %}{% endfor %}<script type="application/json" id="rv-data">{{ ro|tojson }}</script>
{% include "_ask.j2" %}
{{ p.theme_script() }}
<script>
(function(){
var reduce=matchMedia('(prefers-reduced-motion: reduce)');
/* 섹션 제목·글 카드·이력 카드가 화면에 들어올 때 살짝 올라오며 나타남 (스크립트가 없으면 그대로 보임) */
if('IntersectionObserver' in window&&!reduce.matches){document.documentElement.classList.add('js');var rio=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');rio.unobserve(e.target)}})},{rootMargin:'0px 0px -8% 0px'});
  document.querySelectorAll('.sec-t,.th,.others,#writing .carousel,#about .bento>*,#about .skills').forEach(function(el){el.classList.add('rise');rio.observe(el)})}
/* 직무 보기 */
var RO=JSON.parse((document.getElementById('rv-data')||{}).textContent||'{}');
var rbtn=document.getElementById('resume-btn');
function setRole(r,keep){
  if(r!=='all'&&!RO[r])r='all';
  document.body.className=document.body.className.replace(/\brole-\w+/,'').trim()+' role-'+r;
  document.querySelectorAll('.roleswitch button').forEach(function(b){b.setAttribute('aria-pressed',b.dataset.role===r)});
  if(rbtn)rbtn.href=rbtn.getAttribute('data-'+r)||rbtn.getAttribute('data-all');
  document.querySelectorAll('.th .th-n').forEach(function(n){var th=n.closest('.th'),o=getComputedStyle(th).getPropertyValue('--o-'+r).trim();if(o)n.textContent=('0'+o).slice(-2)});
  if(!keep){var u=new URL(location.href);if(r==='all')u.searchParams.delete('role');else u.searchParams.set('role',r);history.replaceState(null,'',u);}
}
document.querySelectorAll('.roleswitch button').forEach(function(b){b.addEventListener('click',function(){setRole(b.dataset.role)})});
var q=new URLSearchParams(location.search).get('role');if(q)setRole(q,true);
/* 기술 → 근거 */
var EV=JSON.parse((document.getElementById('ev-data')||{}).textContent||'[]'),evp=document.getElementById('evp'),evl=document.getElementById('evl'),evt=document.getElementById('evt'),evOn=null;
var LBL={p:'{{ T.ev_p }}',w:'{{ T.ev_w }}'};
function keys(t){var out=[];t.toLowerCase().split(/[\/·,()]+/).forEach(function(x){x=x.trim();if(x.length<2)return;out.push(x);var w=x.split(/\s+/);if(w.length>2)out.push(w.slice(0,2).join(' '));});return out;}
function rx(k){var e=k.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');return /^[a-z0-9 .+#\-]+$/.test(k)?new RegExp('(^|[^a-z0-9])'+e+'([^a-z0-9]|$)'):new RegExp(e);}
function evidence(t){var rs=keys(t).map(rx);return EV.filter(function(it){return rs.some(function(r){return r.test(it.s)})});}
function esc(s){return s.replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
function showEv(btn){
  var t=btn.textContent.trim(),hits=evidence(t);
  if(evOn)evOn.classList.remove('on');evOn=btn;btn.classList.add('on');
  evt.innerHTML='‘'+esc(t)+'’ {{ T.ev_title }}<small>'+hits.length+'</small>';
  evl.innerHTML=hits.length?hits.map(function(h){return '<li><a href="'+h.u+'"><i>'+LBL[h.k]+'</i><span>'+esc(h.t)+'</span></a></li>'}).join(''):'<li class="none">{{ T.ev_none }}</li>';
  evp.hidden=false;
}
function hideEv(){evp.hidden=true;if(evOn){evOn.classList.remove('on');evOn=null;}}
document.querySelectorAll('button.ev').forEach(function(b){b.addEventListener('click',function(e){e.stopPropagation();if(evOn===b){hideEv();return;}showEv(b)})});
document.getElementById('evx').addEventListener('click',hideEv);
document.addEventListener('keydown',function(e){if(e.key==='Escape')hideEv()});
document.addEventListener('click',function(e){if(!evp.hidden&&!evp.contains(e.target))hideEv()});
/* 본인 기기에서만 비공개 링크 표시 (방문 집계 제외용 ?nostat=1 표시를 같이 씀) */
try{if(localStorage.getItem('nostat')){var own=document.querySelector('footer .own');if(own)own.hidden=false}}catch(e){}
/* 글 넘기기 */
var car=document.getElementById('carousel');document.querySelectorAll('.carr button').forEach(function(b){b.addEventListener('click',function(){car.scrollBy({left:car.clientWidth*0.9*(+b.dataset.dir),behavior:reduce.matches?'auto':'smooth'})})});
var links=document.querySelectorAll('.top a.n');if('IntersectionObserver' in window){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)links.forEach(function(a){a.classList.toggle('on',a.getAttribute('href')==='#'+e.target.id)})})},{rootMargin:'-45% 0px -50% 0px'});document.querySelectorAll('section[id]').forEach(function(s){io.observe(s)});}
})();
</script>
</body>
</html>
