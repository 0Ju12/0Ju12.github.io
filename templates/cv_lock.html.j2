<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>이력서 · Resume</title>
<meta name="description" content="이영주 이력서 — 암호를 입력하면 열립니다 · Resume (password protected)">
{% if goatcounter %}<script data-goatcounter="https://{{ goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>{% endif %}
<style>
:root{--bg:#f6f7f9;--card:#fff;--text:#1c2128;--muted:#5f6670;--faint:#9aa1ab;--line:#e2e5ea;--ink:#1f3a5f;--on-ink:#fff;--err:#c2410c}
@media (prefers-color-scheme: dark){:root{--bg:#0e1116;--card:#171b22;--text:#eef1f5;--muted:#a3abb7;--faint:#6f7884;--line:#2a313b;--ink:#9db8dd;--on-ink:#0e1116;--err:#fb923c}}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;display:grid;place-items:center;background:var(--bg);color:var(--text);font:16px/1.6 -apple-system,BlinkMacSystemFont,"Pretendard","Apple SD Gothic Neo","Noto Sans KR","Malgun Gothic",sans-serif;padding:20px;word-break:keep-all}
.box{width:min(460px,100%);background:var(--card);border:1px solid var(--line);border-radius:22px;padding:30px 28px;box-shadow:0 18px 48px -20px rgba(0,0,0,.2)}
h1{font-size:21px;letter-spacing:-.02em;margin:0 0 4px}
h1 small{font-size:13px;color:var(--faint);font-weight:500;margin-left:6px}
p{margin:0 0 18px;color:var(--muted);font-size:14.5px}
form{display:flex;gap:8px}
input{flex:1;min-width:0;height:46px;border:1px solid var(--line);border-radius:12px;background:var(--bg);color:var(--text);font:inherit;padding:0 14px}
input:focus,button:focus-visible{outline:2px solid var(--ink);outline-offset:1px}
button{height:46px;border:0;border-radius:12px;background:var(--ink);color:var(--on-ink);font:inherit;font-weight:700;padding:0 18px;cursor:pointer}
button:disabled{opacity:.6;cursor:wait}
.msg{min-height:22px;margin-top:10px;font-size:13.5px;color:var(--err)}
ul{list-style:none;margin:6px 0 0;padding:0}
li{display:flex;align-items:center;gap:8px;padding:12px 0;border-top:1px solid var(--line)}
li span{flex:1;min-width:0;font-size:15px;font-weight:600}
li small{display:block;font-size:12.5px;color:var(--faint);font-weight:400}
li button{height:34px;padding:0 12px;font-size:13px;border-radius:9px}
li button.alt{background:transparent;color:var(--ink);border:1px solid var(--line)}
.back{display:inline-block;margin-top:10px;padding:8px 0;font-size:14px;color:var(--muted)}
</style>
</head>
<body>
<main class="box">
  <h1>이력서<small>Resume</small></h1>
  <div id="lock">
  {% if box %}
    <p>이력서는 암호를 입력해야 볼 수 있습니다. 암호는 지원 서류나 메일로 안내드립니다.<br><span style="font-size:13px">Enter the password shared with you to open the resume.</span></p>
    <form id="f"><input id="pw" type="password" autocomplete="current-password" placeholder="암호 · Password" aria-label="암호" required autofocus><button id="go" type="submit">열기</button></form>
    <div class="msg" id="msg" role="alert"></div>
  {% else %}
    <p>이 빌드에는 암호가 설정되지 않아 이력서 파일을 넣지 않았습니다. 배포된 사이트에서 암호로 열 수 있습니다.</p>
  {% endif %}
  </div>
  <ul id="list" hidden>{% for it in items %}<li><span>{{ it.label }}<small>{{ it.sub }}</small></span><button type="button" class="alt" data-view="{{ it.name }}">보기</button><button type="button" data-pdf="{{ it.name }}">PDF</button></li>{% endfor %}</ul>
  <a class="back" href="index.html">← 포트폴리오로 돌아가기</a>
</main>
{% if box %}
<script id="box" type="application/json">{{ box|tojson }}</script>
<script>
(function(){
var box=JSON.parse(document.getElementById('box').textContent),K='cv-key:'+box.salt,KEY=null;
function b(s){return Uint8Array.from(atob(s),function(c){return c.charCodeAt(0)})}
function e(u){var s='';new Uint8Array(u).forEach(function(x){s+=String.fromCharCode(x)});return btoa(s)}
async function imp(raw){return crypto.subtle.importKey('raw',raw,'AES-GCM',false,['decrypt'])}
async function dec(key,o){return crypto.subtle.decrypt({name:'AES-GCM',iv:b(o.iv)},key,b(o.ct))}
async function derive(pw){var base=await crypto.subtle.importKey('raw',new TextEncoder().encode(pw),'PBKDF2',false,['deriveBits']);return crypto.subtle.deriveBits({name:'PBKDF2',salt:b(box.salt),iterations:box.iter,hash:'SHA-256'},base,256)}
function open_(){document.getElementById('lock').hidden=true;document.getElementById('list').hidden=false}
async function unlock(raw){var key=await imp(raw);await dec(key,box.check);KEY=key;try{sessionStorage.setItem(K,e(raw))}catch(_){}open_()}
async function file(name,ext){var r=await fetch('cv/'+name+'.'+ext+'.enc');var o=await r.json();return dec(KEY,o)}
document.getElementById('list').addEventListener('click',async function(ev){var t=ev.target.closest('button');if(!t||!KEY)return;t.disabled=true;
  try{if(t.dataset.view){var w=window.open('','_blank');var h=await file(t.dataset.view,'html');var u=URL.createObjectURL(new Blob([h],{type:'text/html'}));if(w){w.location=u}else{location.href=u}}
  else{var p=await file(t.dataset.pdf,'pdf');var a=document.createElement('a');a.href=URL.createObjectURL(new Blob([p],{type:'application/pdf'}));a.download='Young-Ju_Lee_'+t.dataset.pdf+'.pdf';document.body.appendChild(a);a.click();a.remove()}}
  catch(_){alert('파일을 열지 못했습니다. 다시 시도해 주세요.')}t.disabled=false});
var saved=null;try{saved=sessionStorage.getItem(K)}catch(_){}
if(saved){unlock(b(saved)).catch(function(){try{sessionStorage.removeItem(K)}catch(_){}})}
document.getElementById('f').addEventListener('submit',async function(ev){ev.preventDefault();var go=document.getElementById('go'),msg=document.getElementById('msg');go.disabled=true;msg.textContent='';
  try{await unlock(await derive(document.getElementById('pw').value))}catch(_){msg.textContent='암호가 맞지 않습니다.';go.disabled=false}});
})();
</script>
{% endif %}
</body>
</html>
