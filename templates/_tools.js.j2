/* 최근 N주 활동 잔디 (GitHub·LeetCode 식) — m: {날짜: 개수} */
function heat(m,weeks,label){var end=new Date(today()+'T00:00:00'),start=new Date(end);start.setDate(start.getDate()-end.getDay()-7*(weeks-1));var cells='',tot=0,days=0,max=1;Object.keys(m).forEach(function(k){max=Math.max(max,m[k])});
