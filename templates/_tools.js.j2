  speed:function(){var v1=ri(3,8)*10,v2=v1+ri(1,4)*10,t=ri(2,5),d=(v1+v2)*t;return {cat:'응용수리',q:'두 지점 사이 거리가 '+d+'km이다. A는 시속 '+v1+'km, B는 시속 '+v2+'km로 두 지점에서 서로를 향해 동시에 출발했다. 두 사람이 만나는 데 걸리는 시간은?',a:t,c:choices(t,function(x){return x+'시간'},1),ex:'만날 때까지 두 사람이 달린 거리의 합 = '+d+'km, 속력의 합 = '+(v1+v2)+'km/h → '+d+' ÷ '+(v1+v2)+' = '+t+'시간'}},
  conc:function(){var w1=ri(2,6)*50,p1=ri(2,8),w2=ri(2,6)*50,p2=ri(9,15),salt=w1*p1/100+w2*p2/100,ans=Math.round(salt/(w1+w2)*1000)/10;return {cat:'응용수리',q:p1+'% 소금물 '+w1+'g과 '+p2+'% 소금물 '+w2+'g을 섞었다. 섞은 소금물의 농도는? (소수 첫째 자리까지)',a:ans,c:choices(ans,function(x){return x+'%'},0.7),ex:'소금 = '+w1+'×'+p1+'% + '+w2+'×'+p2+'% = '+(Math.round(salt*10)/10)+'g, 전체 '+(w1+w2)+'g → '+ans+'%'}},
  work:function(){var a=[4,6,8,10,12][ri(0,4)],b=[6,8,12,15,24][ri(0,4)];if(a===b)b=a*2;var ans=Math.round(a*b/(a+b)*10)/10;return {cat:'응용수리',q:'어떤 일을 A가 혼자 하면 '+a+'일, B가 혼자 하면 '+b+'일 걸린다. 둘이 함께 하면 며칠 걸리는가? (소수 첫째 자리까지)',a:ans,c:choices(ans,function(x){return x+'일'},0.8),ex:'하루 일의 양 1/'+a+' + 1/'+b+' → '+a+'×'+b+' ÷ ('+a+'+'+b+') = '+ans+'일'}},
  price:function(){var c=ri(4,20)*1000,m=ri(2,5)*10,dc=ri(1,3)*10,sell=c*(1+m/100)*(1-dc/100),ans=Math.round(sell-c);return {cat:'응용수리',q:'원가 '+c.toLocaleString()+'원인 상품에 원가의 '+m+'%를 이익으로 붙여 정가를 정했다가, 정가의 '+dc+'%를 할인해 팔았다. 한 개를 팔 때 이익은?',a:ans,c:choices(ans,function(x){return Math.round(x).toLocaleString()+'원'},Math.max(100,Math.round(c*0.02/100)*100)),ex:'판매가 = '+c.toLocaleString()+' × '+(1+m/100)+' × '+(1-dc/100)+' = '+Math.round(sell).toLocaleString()+'원 → 이익 '+ans.toLocaleString()+'원'}},
  comb:function(){var n=ri(5,8),k=ri(2,3),f=function(x){return x<=1?1:x*f(x-1)},ans=f(n)/(f(k)*f(n-k));return {cat:'응용수리',q:'팀원 '+n+'명 중 발표자 '+k+'명을 뽑는 방법의 수는? (순서 상관없음)',a:ans,c:choices(ans,function(x){return x+'가지'},Math.max(2,Math.round(ans/6))),ex:n+'C'+k+' = '+ans}},
  table:function(){var base=ri(80,160)*10,ys=[2022,2023,2024,2025],vals=[base];for(var i=1;i<4;i++)vals.push(Math.round(vals[i-1]*(1+ri(-8,18)/100)));var j=ri(1,3),ans=Math.round((vals[j]-vals[j-1])/vals[j-1]*1000)/10;
    return {cat:'자료해석',q:'연도별 데이터 처리 건수가 다음과 같다. '+ys[j]+'년의 전년 대비 증가율은? (소수 첫째 자리까지)',tbl:[ys,vals],a:ans,c:choices(ans,function(x){return x+'%'},1.5),ex:'('+vals[j]+' − '+vals[j-1]+') ÷ '+vals[j-1]+' × 100 = '+ans+'%'}},
  share:function(){var items=['서울','부산','대전','광주'],v=items.map(function(){return ri(12,60)*10}),tot=v.reduce(function(a,b){return a+b},0),j=ri(0,3),ans=Math.round(v[j]/tot*1000)/10;
