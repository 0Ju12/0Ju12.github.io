function amockPick(){var st={},done={};S.algo.forEach(function(a){(a.t||[]).forEach(function(t){var o=st[t]||(st[t]={n:0,bad:0});o.n++;if(a.r!=='ok')o.bad++});var m=/^(\d{3,5})/.exec(a.n||'');if(m&&a.r==='ok')done[m[1]]=1});
