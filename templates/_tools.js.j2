  comb:function(){var n=ri(5,8),k=ri(2,3),f=function(x){return x<=1?1:x*f(x-1)},ans=f(n)/(f(k)*f(n-k));return {cat:'응용수리',q:'팀원 '+n+'명 중 발표자 '+k+'명을 뽑는 방법의 수는? (순서 상관없음)',a:ans,c:choices(ans,function(x){return x+'가지'},Math.max(2,Math.round(ans/6))),ex:n+'C'+k+' = '+ans}},
  table:function(){var base=ri(80,160)*10,ys=[2022,2023,2024,2025],vals=[base];for(var i=1;i<4;i++)vals.push(Math.round(vals[i-1]*(1+ri(-8,18)/100)));var j=ri(1,3),ans=Math.round((vals[j]-vals[j-1])/vals[j-1]*1000)/10;
    return {cat:'자료해석',q:'연도별 데이터 처리 건수가 다음과 같다. '+ys[j]+'년의 전년 대비 증가율은? (소수 첫째 자리까지)',tbl:[ys,vals],a:ans,c:choices(ans,function(x){return x+'%'},1.5),ex:'('+vals[j]+' − '+vals[j-1]+') ÷ '+vals[j-1]+' × 100 = '+ans+'%'}},
  share:function(){var items=['서울','부산','대전','광주'],v=items.map(function(){return ri(12,60)*10}),tot=v.reduce(function(a,b){return a+b},0),j=ri(0,3),ans=Math.round(v[j]/tot*1000)/10;
    return {cat:'자료해석',q:'지역별 지원자 수가 다음과 같다. 전체에서 '+items[j]+' 지원자가 차지하는 비율은? (소수 첫째 자리까지)',tbl:[items,v],a:ans,c:choices(ans,function(x){return x+'%'},2),ex:v[j]+' ÷ '+tot+' × 100 = '+ans+'%'}}
};
var LOGIC=[
  {q:'모든 데이터 엔지니어는 SQL을 쓴다. 어떤 SQL 사용자는 Python을 쓰지 않는다. 다음 중 반드시 참인 것은?',c:['모든 데이터 엔지니어는 Python을 쓴다','어떤 데이터 엔지니어는 Python을 쓰지 않는다','SQL을 쓰지 않는 사람은 데이터 엔지니어가 아니다','Python을 쓰는 사람은 모두 SQL을 쓴다'],a:2,ex:'"모든 A는 B"의 대우 "B가 아니면 A가 아니다"만 반드시 참입니다.'},
  {q:'A, B, C, D 네 명이 일렬로 앉는다. A는 B 바로 왼쪽, C는 맨 오른쪽, D는 B와 이웃하지 않는다. 맨 왼쪽에 앉은 사람은?',c:['A','B','C','D'],a:3,ex:'C가 맨 오른쪽이고 A-B가 붙어야 하므로 A B D C 또는 D A B C. D는 B와 이웃하면 안 되므로 D A B C → 맨 왼쪽은 D.'},
  {q:'"비가 오면 행사가 취소된다"가 참일 때, 반드시 참인 것은?',c:['행사가 취소되면 비가 온 것이다','비가 오지 않으면 행사가 열린다','행사가 열렸다면 비가 오지 않은 것이다','행사가 취소되지 않으면 비가 온다'],a:2,ex:'p→q 의 대우 ¬q→¬p 만 항상 참입니다.'},
  {q:'세 사람 중 한 명만 진실을 말한다. 갑: "을이 범인이다." 을: "나는 범인이 아니다." 병: "나는 범인이 아니다." 범인은? (범인은 한 명)',c:['갑','을','병','알 수 없음'],a:2,ex:'병이 범인이라고 두면 갑은 거짓, 을은 참, 병은 거짓 → 진실 1명으로 조건 충족. 갑·을이 범인인 경우는 진실이 2명이 됩니다.'},
  {q:'수열 2, 6, 12, 20, 30, ( ) 의 빈칸은?',c:['38','40','42','44'],a:2,ex:'차이가 4, 6, 8, 10, 12로 늘어남 → 30 + 12 = 42 (n(n+1) 꼴).'},
  {q:'수열 3, 5, 9, 17, 33, ( ) 의 빈칸은?',c:['49','57','63','65'],a:3,ex:'앞 수 × 2 − 1 → 33 × 2 − 1 = 65.'},
  {q:'어떤 프로젝트의 일정: 설계는 개발보다 먼저, 테스트는 개발 다음, 배포는 테스트 다음, 문서화는 설계 다음이고 배포보다 먼저다. 반드시 참인 것은?',c:['문서화는 개발보다 먼저다','설계가 가장 먼저다','테스트가 문서화보다 먼저다','개발이 두 번째다'],a:1,ex:'설계 → 개발 → 테스트 → 배포, 문서화는 설계 뒤·배포 앞. 모든 일보다 앞선 것은 설계뿐입니다.'},
  {q:'시계가 3시 30분을 가리킬 때 시침과 분침이 이루는 작은 각은?',c:['75°','80°','90°','105°'],a:0,ex:'분침 180°, 시침 90° + 30분×0.5° = 105° → 차이 75°.'},
  {q:'5명이 서로 한 번씩 악수하면 악수는 모두 몇 번?',c:['8','10','12','20'],a:1,ex:'5C2 = 10.'},
  {q:'A는 B보다 크고, C는 D보다 작으며, B는 D보다 크다. C와 A 중 큰 쪽은?',c:['A','C','같다','알 수 없음'],a:0,ex:'A > B > D > C 이므로 A가 큽니다.'},
  {q:'"데이터를 검증하지 않는 팀은 사고를 낸다. 우리 팀은 사고를 내지 않았다." 이로부터 알 수 있는 것은?',c:['우리 팀은 데이터를 검증했다','우리 팀은 운이 좋았다','사고를 낸 팀은 검증하지 않았다','검증하는 팀은 사고를 내지 않는다'],a:0,ex:'"검증하지 않으면 사고" 의 대우 "사고가 없으면 검증했다".'}
