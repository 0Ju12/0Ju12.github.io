  var bi={};for(var i=0;i+1<w.length;i++){var k=w[i]+' '+w[i+1];bi[k]=(bi[k]||0)+1}
  var rep=Object.keys(bi).filter(function(k){return bi[k]>1&&k.length>3}).sort(function(a,b){return bi[b]-bi[a]}).slice(0,4).map(function(k){return [k,bi[k]]});
