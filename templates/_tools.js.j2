var ncsS=null;
function ncsMake(n){var g=Object.keys(GEN),out=[];for(var i=0;i<n;i++){if(i%3===2){var L=LOGIC[ri(0,LOGIC.length-1)];out.push({cat:'논리·추리',q:L.q,c:L.c.map(function(t,k){return {v:k,t:t}}),a:L.a,ex:L.ex})}else out.push(GEN[g[ri(0,g.length-1)]]())}return out}
function ncs(){
  if(ncsS&&ncsS.i<ncsS.qs.length)return ncsPlay();
  var h='<div class="hd"><div><span class="eyebrow">NCS · 인적성</span><h1 style="margin-top:6px">NCS · 인적성 연습</h1><p class="sub" style="margin:0">응용수리(속력·농도·일률·이익·경우의 수) · 자료해석(증가율·비율) · 논리·추리를 섞은 10문항입니다. 수리 문제는 매번 숫자가 새로 만들어집니다. 실제 시험(PSAT형·모듈형 등)은 기관마다 다르니 공고의 출제 유형을 확인하세요.</p></div><span class="row"><button class="btn" id="ngo">10문항 시작</button><a class="btn ghost" href="#/tools">← 도구</a></span></div>';
  if(S.ncs.length){var L=S.ncs.slice(-10);h+='<h2>최근 세트</h2><div class="card"><table style="width:100%;border-collapse:collapse;font-size:14px">'+L.slice().reverse().map(function(r){return '<tr><td style="padding:6px 0">'+esc(r.d)+'</td><td>'+r.ok+' / '+r.n+'</td><td>'+fmt(r.sec)+' (문항당 '+Math.round(r.sec/r.n)+'초)</td><td class="small muted">'+Object.keys(r.cat||{}).map(function(k){return k+' '+r.cat[k][0]+'/'+r.cat[k][1]}).join(' · ')+'</td></tr>'}).join('')+'</table></div>'}
  $('#app').innerHTML=h;$('#ngo').onclick=function(){ncsS={qs:ncsMake(10),i:0,res:[],t0:Date.now(),pick:null};ncsPlay()};
}
function ncsPlay(){var s=ncsS,q=s.qs[s.i];
  var h='<div class="q"><div class="row" style="justify-content:space-between"><span class="muted small">'+(s.i+1)+' / '+s.qs.length+' · '+esc(q.cat)+'</span><span class="muted small" id="nclk">'+fmt(Math.floor((Date.now()-s.t0)/1000))+'</span></div><div class="prompt" style="font-size:18px">'+esc(q.q)+'</div>';
  if(q.tbl)h+='<div class="card" style="overflow-x:auto;margin-bottom:12px;padding:10px 14px"><table style="width:100%;border-collapse:collapse;font-size:14px;text-align:center"><tr>'+q.tbl[0].map(function(x){return '<th style="padding:4px">'+esc(x)+'</th>'}).join('')+'</tr><tr>'+q.tbl[1].map(function(x){return '<td style="padding:4px">'+esc(Number(x).toLocaleString())+'</td>'}).join('')+'</tr></table></div>';
  h+='<div class="grid" style="gap:8px">'+q.c.map(function(c,k){var cls='';if(s.pick!=null){if(c.v===q.a)cls=' g-ok';else if(k===s.pick)cls=' g-bad'}return '<button class="ncs-o'+cls+'" data-k="'+k+'"'+(s.pick!=null?' disabled':'')+'>'+'①②③④'[k]+' '+esc(c.t)+'</button>'}).join('')+'</div>';
  if(s.pick!=null)h+='<div class="guide" style="margin-top:12px">'+esc(q.ex)+'</div><div class="row" style="justify-content:flex-end;margin-top:12px"><button class="btn" id="nnext">'+(s.i+1<s.qs.length?'다음':'결과 보기')+' →</button></div>';
  h+='<div class="row" style="margin-top:18px"><button class="btn ghost sm" id="nquit">그만하기</button></div></div>';
  $('#app').innerHTML=h;
  if(timer)clearInterval(timer);timer=setInterval(function(){var c=$('#nclk');if(c)c.textContent=fmt(Math.floor((Date.now()-s.t0)/1000))},1000);
  $$('[data-k]').forEach(function(b){b.onclick=function(){if(s.pick!=null)return;s.pick=+b.dataset.k;s.res.push(q.c[s.pick].v===q.a);ncsPlay()}});
  var nx=$('#nnext');if(nx)nx.onclick=function(){s.i++;s.pick=null;if(s.i<s.qs.length)ncsPlay();else ncsDone()};
  $('#nquit').onclick=function(){ncsS=null;ncs()};
  keyHandler=function(e){if(s.pick==null&&/^[1-4]$/.test(e.key)){var b=$('[data-k="'+(e.key-1)+'"]');if(b)b.click()}else if(s.pick!=null&&(e.key==='Enter'||e.key===' ')){e.preventDefault();if(nx)nx.click()}};
}
function ncsDone(){var s=ncsS,sec=Math.round((Date.now()-s.t0)/1000),cat={};s.qs.forEach(function(q,i){var c=cat[q.cat]||(cat[q.cat]=[0,0]);c[1]++;if(s.res[i])c[0]++});
  var ok=s.res.filter(Boolean).length;S.ncs.push({d:today(),n:s.qs.length,ok:ok,sec:sec,cat:cat});if(S.ncs.length>200)S.ncs=S.ncs.slice(-200);ncsS=null;wadd('apt',1);
  if(timer){clearInterval(timer);timer=null}
  $('#app').innerHTML='<div class="q"><h1>'+ok+' / '+s.qs.length+'</h1><p class="sub">'+fmt(sec)+' · 문항당 '+Math.round(sec/s.qs.length)+'초 · 이번 주 인적성 +1</p><div class="grid g3">'+Object.keys(cat).map(function(k){return '<div class="card kpi"><b>'+cat[k][0]+'/'+cat[k][1]+'</b><span>'+esc(k)+'</span></div>'}).join('')+'</div><div class="row" style="margin-top:18px"><button class="btn" id="nagain">한 세트 더</button><a class="btn ghost" href="#/tools">도구로</a></div></div>';
  $('#nagain').onclick=function(){ncsS={qs:ncsMake(10),i:0,res:[],t0:Date.now(),pick:null};ncsPlay()}}
