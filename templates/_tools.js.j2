function ri(a,b){return a+Math.floor(Math.random()*(b-a+1))}
function choices(ans,fmtf,spread){var set=[ans],guard=0;while(set.length<4&&guard++<50){var d=ans+(ri(1,4)*(Math.random()<.5?-1:1))*spread;d=Math.round(d*100)/100;if(d>0&&set.indexOf(d)<0)set.push(d)}while(set.length<4)set.push(ans+set.length*spread);return shuffle(set).map(function(v){return {v:v,t:fmtf(v)}})}
