{# 공통 head 메타: 링크 미리보기(Open Graph)·파비콘. root 는 docs/ 기준 상대경로 접두("" 또는 "../") #}
{% macro meta(title, desc, path='', root='', en=false, image=none) -%}
<meta name="description" content="{{ desc }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ 'Young-Ju Lee — Portfolio' if en else '이영주 포트폴리오' }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ desc }}">
<meta property="og:url" content="https://0ju12.github.io/{{ path }}">
<meta property="og:image" content="https://0ju12.github.io/{{ image or ('og-en.png' if en else 'og.png') }}">
<meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
<meta property="og:locale" content="{{ 'en_US' if en else 'ko_KR' }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="{{ root }}favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="{{ root }}apple-touch-icon.png">
<meta name="theme-color" content="#18181b">
{% include '_analytics.j2' %}
{%- endmacro %}
